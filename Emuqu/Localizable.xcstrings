    "Standard deviation along the line of identity in the Poincaré plot. Measures longer-term variability patterns." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الانحراف المعياري على طول خط الهوية في مخطط بوانكاريه. يقيس أنماط التباين طويلة المدى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardafvigelsen langs identitetslinjen i Poincaré-plottet. Måler variabilitetsmønstre på længere sigt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardabweichung entlang der Identitätslinie im Poincaré-Diagramm. Misst längerfristige Variabilitätsmuster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desviación estándar a lo largo de la línea de identidad en el gráfico de Poincaré. Mide patrones de variabilidad a más largo plazo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keskihajonta identiteettilinjaa pitkin Poincaré-kuvaajassa. Mittaa pidemmän aikavälin vaihtelukuvioita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écart-type le long de la ligne d’identité dans le diagramme de Poincaré. Mesure les schémas de variabilité à plus long terme."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
