          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmuuskopiointi epäonnistui: %@. Tarkista iCloud-yhteytesi ja yritä uudelleen."
          }
        },
        "fr" : {
