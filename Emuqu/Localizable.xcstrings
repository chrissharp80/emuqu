    "cadence %lld — outside the healthy 165–190 band" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإيقاع %lld — خارج النطاق الصحي 165–190"
          }
        },
        "da" : {
