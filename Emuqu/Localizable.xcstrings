        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi valori rientrano in un intervallo spesso associato a quell'andamento. Una sola misurazione non basta, da sola, a stabilire uno stato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの数値は、そのパターンとよく関連づけられる範囲にあります。1回の測定だけで状態を確定することはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수치가 그 패턴과 흔히 연관되는 범위에 있습니다. 한 번의 측정만으로는 상태를 확정할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallene dine ligger i et område som ofte forbindes med det mønsteret. Én måling kan ikke alene fastslå en tilstand."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je waarden liggen in een bereik dat vaak met dat patroon wordt geassocieerd. Eén meting kan op zichzelf geen toestand vaststellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus números estão em uma faixa frequentemente associada a esse padrão. Uma única leitura não consegue estabelecer um estado por si só."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши показатели находятся в диапазоне, который часто связывают с этой закономерностью. Одно измерение само по себе не может установить состояние."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina värden ligger i ett intervall som ofta förknippas med det mönstret. En enda mätning kan inte ensam fastställa ett tillstånd."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的数值处于通常与该模式相关的范围内。仅凭一次读数无法确定某种状态。"
