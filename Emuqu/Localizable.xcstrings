    "Foster monotony %.1f over the last 7 days. Mixing intensities (one easy day, one hard day) helps your body absorb the work." : {
      "comment" : "Monotony banner explanation",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرتابة %.1f خلال الأيام السبعة الماضية. مزج الشدّات (يوم سهل ويوم صعب) يساعد جسمك على استيعاب الحِمل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monotoni på %.1f over de seneste 7 dage. At blande intensiteter (en let dag, en hård dag) hjælper kroppen med at optage træningen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monotonie von %.1f in den letzten 7 Tagen. Eine Mischung der Intensitäten (ein leichter Tag, ein harter Tag) hilft deinem Körper, die Arbeit zu verarbeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monotonía de %.1f en los últimos 7 días. Alternar intensidades (un día suave, un día duro) ayuda a tu cuerpo a asimilar el trabajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monotonia %.1f viimeisten 7 päivän aikana. Tehojen vaihtelu (yksi kevyt päivä, yksi kova päivä) auttaa kehoasi sulattamaan kuormituksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monotonie de %.1f sur les 7 derniers jours. Varier les intensités (un jour facile, un jour difficile) aide votre corps à assimiler le travail."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einhæfni upp á %.1f síðustu 7 dagana. Að blanda ákefð (einn léttan dag, einn erfiðan dag) hjálpar líkamanum að taka inn álagið."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monotonia di %.1f negli ultimi 7 giorni. Alternare le intensità (un giorno facile, uno duro) aiuta il corpo ad assimilare il lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去7日間のモノトニーは %.1f です。強度を変える（軽い日と強い日を混ぜる）ことで、体が負荷を吸収しやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지난 7일간 모노토니가 %.1f입니다. 강도를 섞으면(쉬운 날 하나, 힘든 날 하나) 몸이 운동량을 흡수하는 데 도움이 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monotoni på %.1f de siste 7 dagene. Å blande intensiteter (en lett dag, en hard dag) hjelper kroppen med å ta opp arbeidet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monotonie van %.1f over de afgelopen 7 dagen. Het afwisselen van intensiteiten (één rustige dag, één zware dag) helpt je lichaam de belasting te verwerken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monotonia de %.1f nos últimos 7 dias. Variar as intensidades (um dia leve, um dia difícil) ajuda seu corpo a assimilar o esforço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Монотонность %.1f за последние 7 дней. Чередование интенсивности (один лёгкий день, один тяжёлый) помогает организму усвоить нагрузку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monotoni på %.1f de senaste 7 dagarna. Att variera intensiteterna (en lätt dag, en hård dag) hjälper kroppen att ta upp arbetet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "过去 7 天的单调度为 %.1f。混合强度（一天轻松、一天高强度）有助于身体吸收训练负荷。"
          }
        }
      }
    },
