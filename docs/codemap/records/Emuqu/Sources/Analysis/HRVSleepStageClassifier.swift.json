{
 "file": "Emuqu/Sources/Analysis/HRVSleepStageClassifier.swift",
 "hash": "61abbd4976877e05",
 "role": "RR-interval based sleep-stage classifier: slices the sleep span into 5-min windows, computes HR/RMSSD/SDNN/CV/DFA-a1/LF-HF/HF features, rank-normalises them within the night, scores deep/REM/awake with weighted linear combos plus temporal priors, and returns stage intervals and per-stage minutes. Used standalone (HRSleepEstimator, SleepResolver row 2) and for Watch augmentation (+Watch extension).",
 "types": [
  "HRVSleepStageClassifier: enum (namespace) — classifier",
  "ClassificationResult: struct — intervals + deep/rem/core/awake minutes",
  "WindowScores: struct — per-window deep/rem/awake scores, classified stage, hasFreqDomain (this window had LF/HF), remEvidence (REM score before the first-hour suppression)",
  "AugmentationResult: struct — augmented intervals, minutes, augmentation list",
  "Augmentation: struct — one overridden epoch",
  "FeatureWindow: struct — one 5-min window's features",
  "FeatureRanks: private struct — per-feature rank arrays plus which windows had their own LF/HF"
 ],
 "state": [
  "mem:HRVSleepStageClassifier.windowSizeMs = 300000",
  "mem:HRVSleepStageClassifier.minPointsPerWindow = 10",
  "mem:HRVSleepStageClassifier.minValidRRsPerWindow = 8",
  "mem:HRVSleepStageClassifier.minWindowsForClassification = 6",
  "mem:HRVSleepStageClassifier.minBeatsForDFA = 64",
