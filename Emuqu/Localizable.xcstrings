    "Outdoor sky view improves accuracy" : {
      "comment" : "A description below the map that explains how having an outdoor view can improve GPS accuracy.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرؤية المفتوحة للسماء في الهواء الطلق تحسّن الدقة"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frit udsyn til himlen udendørs forbedrer nøjagtigheden"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freie Sicht zum Himmel im Freien verbessert die Genauigkeit"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vista despejada del cielo al aire libre mejora la precisión"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esteetön näkymä taivaalle ulkona parantaa tarkkuutta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une vue dégagée sur le ciel en extérieur améliore la précision"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frítt útsýni til himins utandyra bætir nákvæmni"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vista libera del cielo all'aperto migliora la precisione"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屋外で空がよく見える場所では精度が向上します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "야외에서 하늘이 트인 곳에서는 정확도가 향상됩니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fri sikt til himmelen utendørs forbedrer nøyaktigheten"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een vrij zicht op de lucht buiten verbetert de nauwkeurigheid"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma vista desobstruída do céu ao ar livre melhora a precisão"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
