   "does": "Returns the reported night (newest overnight whose entry date >= cutoff, lightweight-decoded) followed by older overnights, newest first, until they hold baselineNightLimit (60) baseline nights: distinct nightKeys before the reported night's with a session BaselineTracker.isBaselineCandidate admits (other sessions are appended but don't count). DailyLoopAnalysis then selects from them with the score's own rule.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Storage/Archive.swift::func SessionArchive.retrieveLightweightOrLog(_:caller:)",
    "Emuqu/Sources/Models/SleepSchedule.swift::func SleepSchedule.nightKey(for:)",
    "Emuqu/Sources/Analysis/BaselineTracker.swift::func BaselineTracker.isBaselineCandidate(_:)"
   ],
   "reads": [
    "archive:SessionArchive.entries",
    "archive:SessionArchive.retrieveLightweight"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+5",
     "cond": "reported entry exists and decodes",
     "effect": "flatMap/map → [night]; ?? [] when none or decode failed"
    },
    {
     "at": "+7",
     "cond": "no reported entry",
     "effect": "reported night key = distantFuture (every earlier night counts)"
    },
    {
     "at": "+9",
     "cond": "entries with date < reported date",
     "effect": "loop bound: reported nil → ?? .distantFuture so all overnights are walked"
    },
    {
     "at": "+10",
     "cond": "baseline nights < 60",
     "effect": "false: break"
    },
    {
     "at": "+11",
     "cond": "lightweight retrieve succeeds",
     "effect": "false: continue (skip)"
    },
    {
     "at": "+14",
     "cond": "night before the reported one and isBaselineCandidate",
     "effect": "its nightKey counts toward the 60 (a split night once)"
    }
   ],
