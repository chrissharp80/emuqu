            "value" : "Gemini est surchargé en ce moment. Réessayez dans un instant."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini er yfirhlaðið núna. Reyndu aftur eftir smástund."
          }
        },
        "it" : {
