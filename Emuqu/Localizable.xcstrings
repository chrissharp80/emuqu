    "%lld of %lld sessions were exported. The others couldn't be read — unlock your iPhone and export again to include them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تصدير %1$lld من أصل %2$lld جلسة. تعذّرت قراءة الباقي — افتح قفل iPhone وصدّر مرة أخرى لتضمينها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld af %2$lld sessioner blev eksporteret. De øvrige kunne ikke læses — lås din iPhone op, og eksportér igen for at få dem med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld von %2$lld Sitzungen wurden exportiert. Die übrigen konnten nicht gelesen werden — entsperre dein iPhone und exportiere erneut, um sie einzuschließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se exportaron %1$lld de %2$lld sesiones. Las demás no se pudieron leer: desbloquea tu iPhone y vuelve a exportar para incluirlas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld/%2$lld harjoitusta vietiin. Muita ei voitu lukea — avaa iPhonen lukitus ja vie uudelleen, jotta ne tulevat mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld séances sur %2$lld ont été exportées. Les autres n’ont pas pu être lues — déverrouillez votre iPhone et exportez à nouveau pour les inclure."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld af %2$lld lotum voru fluttar út. Ekki tókst að lesa hinar — opnaðu iPhone og flyttu út aftur til að taka þær með."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono state esportate %1$lld sessioni su %2$lld. Le altre non sono state lette: sblocca l’iPhone ed esporta di nuovo per includerle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld 件中 %1$lld 件のセッションを書き出しました。残りは読み取れませんでした。iPhone のロックを解除して、もう一度書き出すと含められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld개 중 %1$lld개 세션을 내보냈습니다. 나머지는 읽을 수 없었습니다. iPhone 잠금을 해제하고 다시 내보내면 포함됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld av %2$lld økter ble eksportert. De andre kunne ikke leses — lås opp iPhone og eksporter på nytt for å ta dem med."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld van de %2$lld sessies zijn geëxporteerd. De rest kon niet worden gelezen — ontgrendel je iPhone en exporteer opnieuw om ze mee te nemen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld de %2$lld sessões foram exportadas. As outras não puderam ser lidas — desbloqueie o iPhone e exporte de novo para incluí-las."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспортировано сессий: %1$lld из %2$lld. Остальные не удалось прочитать — разблокируйте iPhone и экспортируйте снова, чтобы включить их."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld av %2$lld pass exporterades. De övriga kunde inte läsas — lås upp din iPhone och exportera igen för att få med dem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已导出 %2$lld 个记录中的 %1$lld 个。其余的无法读取——请解锁 iPhone 后重新导出以包含它们。"
          }
        }
      }
    },
