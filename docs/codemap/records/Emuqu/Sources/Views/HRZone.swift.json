 "role": "Five-zone heart-rate model keyed to % of the user's effective max HR (50/60/70/80/90%), with English and localized labels and per-zone colours; used by the live recording view, mile-marker speech and AI workout context.",
 "types": [
  "HRZone: enum (Int) — z1…z5"
 ],
 "state": [],
 "toplevel": "Header comment documents max-HR resolution (override → Tanaka 208−0.7×age → 180), which matches UserSettings.effectiveMaxHR, and states the zone fractions are the Edwards TRIMP layout (Lucia is a different three-zone model).",
 "units": [
  {
   "key": "func HRZone.classify(hr:userMaxHR:)",
   "hash": "7a4b11bbb2ca8680",
   "does": "Classifies hr against userMaxHR: nil if either ≤0 or HR <50 % of max; z1 50–60 %, z2 60–70 %, z3 70–80 %, z4 80–90 %, z5 ≥90 % (open-ended).",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "userMaxHR > 0 and hr > 0",
     "effect": "false → nil"
    },
    {
     "at": "+4",
     "cond": "0.50 ≤ frac < 0.60",
     "effect": "→ .z1"
    },
    {
     "at": "+5",
     "cond": "0.60 ≤ frac < 0.70",
     "effect": "→ .z2"
    },
    {
     "at": "+6",
     "cond": "0.70 ≤ frac < 0.80",
     "effect": "→ .z3"
    },
    {
     "at": "+7",
     "cond": "0.80 ≤ frac < 0.90",
     "effect": "→ .z4"
    },
    {
     "at": "+10",
     "cond": "frac ≥ 0.90",
     "effect": "→ .z5 (also above max)"
    },
    {
     "at": "+11",
     "cond": "default (frac < 0.50)",
     "effect": "→ nil (no zone, neutral colour)"
    }
   ],
   "deps": {}
  },
