   "key": "func HealthKitWorkoutExport.activeEnergySamples(from:startDate:bodyWeightKg:)",
   "hash": "716638a00ce8c64a",
   "does": "Builds per-tick active-energy samples: kcal = METs × 3.5 × bodyWeightKg × minutes / 200 over the interval since the previous tick (since the workout start for the first tick), skipping non-positive/non-finite METs and windows ≤ 0.01 kcal.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Collection/HealthKitWorkoutExport.swift::func HealthKitWorkoutExport.inTimeOrder(_:)",
    "Emuqu/Sources/Collection/HealthSampleFactory.swift::func HealthSampleFactory.quantitySample(type:value:unit:start:end:metadata:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+5",
     "cond": "activeEnergyBurned type unavailable",
     "effect": "returns []"
    },
    {
     "at": "+9",
     "cond": "loop over time-ordered ticks",
     "effect": "per-tick processing"
    },
    {
     "at": "+10",
     "cond": "mets nil, <= 0 or not finite",
     "effect": "tick skipped"
    },
    {
     "at": "+12",
     "cond": "idx > 0",
     "effect": "window starts at the previous tick; the first tick's window starts at the workout start (a tick at offset 0 still gets max(1,0) = 1 s)"
    },
    {
     "at": "+16",
     "cond": "kcal <= 0.01",
     "effect": "tick skipped; otherwise sample built"
    },
    {
     "at": "+22",
     "cond": "factory returned a sample",
     "effect": "appended; nil dropped"
    }
   ],
