        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niitä käytetään HRV-mittareiden, palautumispisteiden, harjoituskuorman ja unianalyysin laskemiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles servent à calculer les métriques HRV, les scores de récupération, la charge d’entraînement et l’analyse du sommeil."
          }
        },
        "is" : {
          "stringUnit" : {
