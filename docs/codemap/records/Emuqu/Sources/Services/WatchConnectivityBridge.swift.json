{
 "file": "Emuqu/Sources/Services/WatchConnectivityBridge.swift",
 "hash": "198b72adfa7fbfb5",
 "role": "iOS side of the iPhone<->Apple Watch WatchConnectivity link: a process-wide @Observable @MainActor singleton that pushes live workout ticks, strap state and start/stop commands to the Watch, caches the last live snapshot for Watch relaunch restoration, and holds wrist-HR / Watch-strap samples received from the Watch (delegate callbacks live in WatchConnectivityBridge+Session.swift).",
 "types": [
  "Notification.Name: extension — five Watch control notification names",
  "WatchConnectivityBridge: class — WCSession owner/delegate singleton, outbound transport and inbound sample store",
  "WatchConnectivityBridge.MessageKey: enum — wire keys",
  "WatchConnectivityBridge.MessageType: enum — wire message types",
  "WatchConnectivityBridge.LiveState: struct — one live tick parameter object",
  "WatchConnectivityBridge.LiveTotals: struct — elapsed/distance/elevation totals",
  "WatchConnectivityBridge.StrapSnapshot: struct (private) — connected/name/battery read from PolarManager",
  "WatchControlRefusal: enum — reason codes for refusing Watch control messages"
 ],
 "state": [
  "notif:FlowRecoveryWatchRequestedWorkoutStart (watchRequestedWorkoutStart)",
  "notif:FlowRecoveryWatchRequestedWorkoutStop",
  "notif:FlowRecoveryWatchRequestedWorkoutPause",
  "notif:FlowRecoveryWatchRequestedWorkoutResume",
  "notif:FlowRecoveryWatchAcknowledgedFinished",
  "mem:WatchConnectivityBridge.shared (static singleton)",
