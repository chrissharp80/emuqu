    "Cadence high, settle the rhythm" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإيقاع مرتفع، هدّئ الوتيرة"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kadencen er høj, find rytmen"
          }
        },
        "de" : {
          "stringUnit" : {
