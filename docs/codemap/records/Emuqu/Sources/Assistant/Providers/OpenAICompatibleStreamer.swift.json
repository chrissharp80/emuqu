  "OutgoingToolCall/OutgoingTool/RequestBody/PendingToolCall/StreamState/ParsedOpenAIError: structs — wire/accumulator shapes"
 ],
 "state": [
  "net:api.openai.com/v1/chat/completions",
  "net:api.x.ai/v1/chat/completions",
