   "key": "def classify",
   "hash": "42c55f27b62ac2a7",
   "does": "Classifies one RR against its local median: outside 300-2000 ms -> technical(1.0); below 0.7*median -> extra if below 0.5*median else ectopic (artifact only if ratio > 0.20); above 1.2*median -> missed if above 1.5*median else ectopic; otherwise ectopic if ratio > 0.20 else clean.",
   "entry": null,
   "calls": [
    "Tools/validation/port_artifact_detection.py::def _flag"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "rr outside 300...2000",
     "effect": "technical, confidence 1"
    },
    {
     "at": "+5",
     "cond": "rr < median*(1-0.30)",
     "effect": "short-beat path"
    },
    {
     "at": "+7",
     "cond": "rr < median*0.5",
     "effect": "extra; else ectopic flagged only when ratio > 0.20"
    },
    {
     "at": "+10",
     "cond": "rr > median*1.20",
     "effect": "long-beat path"
    },
    {
     "at": "+11",
     "cond": "rr > median*1.5",
     "effect": "missed with confidence ratio/0.5; else ectopic with ratio/0.2"
    },
    {
     "at": "+14",
     "cond": "ratio > 0.20",
     "effect": "ectopic; else CLEAN copy"
    }
   ],
   "flags": [],
   "deps": {
    "Tools/validation/port_artifact_detection.py::def _flag": "b2294a2932deea8e"
   }
