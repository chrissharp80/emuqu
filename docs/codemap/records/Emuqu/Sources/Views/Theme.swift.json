 "role": "Central design tokens: AppTheme colour palette (theme- and colour-theme-aware via the settings singleton), Wong status colours and their text variants, metric/HRV/readiness/data-source/tag colour and label helpers, layout constants, View card/background modifiers, and Zen button styles.",
 "types": [
  "AppTheme: enum — static palette and helper functions",
  "View: extension — zenCard/elevatedCard/heroCard/gradientForeground/zenBackground/zenFormBackground/sectionHeader modifiers",
  "ZenButtonStyle: struct (ButtonStyle) — filled button with white label and drawn disabled state",
  "ZenSecondaryButtonStyle: struct (ButtonStyle) — outlined secondary button",
  "ButtonStyle: extension where Self == ZenButtonStyle — .zen(_:) factory",
  "ButtonStyle: extension where Self == ZenSecondaryButtonStyle — .zenSecondary"
 ],
 "state": [
  "mem:AppTheme.wongOptimal/wongGood/wongCaution/wongAttention (static let, fixed Wong 2011 colours)",
  "mem:AppTheme.sage/terracotta/dustyRose/softGold/mist (static let)",
  "mem:AppTheme.secondary/accent(=terracotta)/warning/alert (static let)",
  "mem:AppTheme.cornerRadius 16/smallCornerRadius 10/padding 16/cardShadowRadius 12 (static let)"
 ],
 "toplevel": "Static let colour constants listed in state; line 681 note says Color hex extension lives in HRVSession.swift. All theme-aware computed colours read AppDependencies.current.app.settingsManager.settings (colorTheme, appearanceTheme) at call time; SwiftUI re-renders only when an observing view re-evaluates.",
