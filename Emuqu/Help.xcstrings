    "You need at least 2 sessions to see trends. The more data you have, the more meaningful the patterns become." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتاج إلى جلستين على الأقل لرؤية الاتجاهات. كلما زادت بياناتك، أصبحت الأنماط ذات معنى أكبر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du skal have mindst 2 sessioner for at se tendenser. Jo flere data du har, jo mere meningsfulde bliver mønstrene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du brauchst mindestens 2 Sitzungen, um Trends zu sehen. Je mehr Daten du hast, desto aussagekräftiger werden die Muster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitas al menos 2 sesiones para ver tendencias. Cuantos más datos tengas, más sentido tendrán los patrones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarvitset vähintään 2 istuntoa nähdäksesi trendejä. Mitä enemmän tietoja on, sitä merkityksellisemmiksi kuviot muuttuvat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il faut au moins 2 sessions pour voir des tendances. Plus vous avez de données, plus les schémas deviennent significatifs."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú þarft að minnsta kosti 2 lotur til að sjá þróun. Því meiri gögn sem þú hefur, því marktækari verða mynstrin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servono almeno 2 sessioni per vedere le tendenze. Più dati hai, più gli schemi diventano significativi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレンドを見るには、2 回以上のセッションが必要です。データが多いほど、パターンの意味は大きくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추세를 보려면 세션이 최소 2개 필요합니다. 데이터가 많을수록 패턴이 더 의미 있어집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du trenger minst 2 økter for å se trender. Jo mer data du har, desto mer meningsfulle blir mønstrene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt minstens 2 sessies nodig om trends te zien. Hoe meer gegevens je hebt, hoe betekenisvoller de patronen worden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você precisa de pelo menos 2 sessões para ver tendências. Quanto mais dados você tiver, mais significativos os padrões ficam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы видеть тренды, нужно не менее 2 сессий. Чем больше данных, тем осмысленнее закономерности."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du behöver minst 2 sessioner för att se trender. Ju mer data du har, desto mer meningsfulla blir mönstren."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少需要 2 条记录才能看到趋势。数据越多，规律就越有意义。"
          }
        }
      }
    },
