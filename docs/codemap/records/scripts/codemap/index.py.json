    "scripts/codemap/graph.py::def Resolver.resolve_file",
    "scripts/codemap/graph.py::def Resolver.protocol_edges",
    "scripts/codemap/graph.py::def wiring_edges"
   ],
   "reads": [
    "file:changed in-scope files",
    "file:build/codemap-index.sqlite"
   ],
   "writes": [
    "file:build/codemap-index.sqlite (files, units, refkeys, edges)"
   ],
   "branches": [
    {
     "at": "+12",
     "cond": "Swift file still present",
     "effect": "references, parameters, conformances and closures parsed"
    },
    {
     "at": "+24",
     "cond": "unit added, removed or re-signed",
     "effect": "its name and type marked affected"
    },
    {
     "at": "+33",
     "cond": "conformances differ",
     "effect": "type marked changed"
    },
    {
     "at": "+45",
