    "Silent audio playback (completely inaudible) keeps the app process running" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشغيل صوت صامت (غير مسموع تمامًا) يُبقي عملية التطبيق قيد التشغيل"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lydløs lydafspilning (fuldstændig uhørlig) holder appens proces kørende"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stille Audiowiedergabe (völlig unhörbar) hält den App-Prozess aktiv"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reproducción de audio silencioso (totalmente inaudible) mantiene en marcha el proceso de la app"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiljainen äänentoisto (täysin kuulumaton) pitää sovelluksen prosessin käynnissä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lecture d’un audio silencieux (totalement inaudible) maintient le processus de l’app actif"
          }
        },
        "is" : {
          "stringUnit" : {
