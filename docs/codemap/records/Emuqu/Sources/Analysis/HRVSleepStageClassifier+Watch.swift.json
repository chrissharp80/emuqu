   "key": "func HRVSleepStageClassifier.smoothStages(_:)",
   "hash": "20ac4157cba5eb9c",
   "does": "Replaces a non-awake stage sandwiched between two equal neighbours with the neighbour stage (in-place, left-to-right, so an earlier change feeds the next comparison); awake windows are never smoothed.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "stages.count >= 3",
     "effect": "false: return input"
    },
    {
     "at": "+4",
     "cond": "for each interior index",
     "effect": "examine prev/curr/next"
    },
    {
     "at": "+9",
     "cond": "curr == .awake",
     "effect": "skip (awake preserved)"
    },
    {
     "at": "+10",
     "cond": "prev == next && curr != prev",
     "effect": "true: curr = prev; false: unchanged"
    }
   ],
   "deps": {}
  },
