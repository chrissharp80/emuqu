    "Message not sent — you must agree to share data with this provider before its first message." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تُرسل الرسالة — يجب أن توافق على مشاركة البيانات مع هذا المزوّد قبل رسالته الأولى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskeden blev ikke sendt — du skal acceptere at dele data med denne udbyder før den første besked."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachricht nicht gesendet — du musst der Datenweitergabe an diesen Anbieter vor der ersten Nachricht zustimmen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensaje no enviado — debes aceptar compartir datos con este proveedor antes de su primer mensaje."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viestiä ei lähetetty — sinun täytyy hyväksyä tietojen jakaminen tälle palveluntarjoajalle ennen ensimmäistä viestiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Message non envoyé — vous devez accepter de partager vos données avec ce fournisseur avant son premier message."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skilaboð ekki send — þú þarft að samþykkja að deila gögnum með þessari þjónustu áður en fyrstu skilaboðin eru send."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Messaggio non inviato — devi accettare di condividere i dati con questo fornitore prima del suo primo messaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージは送信されませんでした — 最初のメッセージの前に、このプロバイダーとのデータ共有に同意する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메시지가 전송되지 않았습니다 — 첫 메시지를 보내기 전에 이 제공업체와의 데이터 공유에 동의해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen ble ikke sendt — du må godta å dele data med denne leverandøren før den første meldingen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bericht niet verzonden — je moet eerst akkoord gaan met het delen van gegevens met deze aanbieder voordat je het eerste bericht stuurt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensagem não enviada — você precisa concordar em compartilhar dados com este provedor antes da primeira mensagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщение не отправлено — перед первым сообщением нужно согласиться на передачу данных этому провайдеру."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meddelandet skickades inte — du måste godkänna att dela data med den här leverantören före första meddelandet."
          }
        },
