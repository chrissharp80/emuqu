    "Recompute recovery scores and analysis using the latest algorithms. Use a date range to limit to recent sessions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد حساب درجات التعافي والتحليل باستخدام أحدث الخوارزميات. استخدم نطاقاً زمنياً لتقييد الجلسات الحديثة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genberegn restitutionsscorer og analyse med de nyeste algoritmer. Brug et datointerval for at begrænse til seneste sessioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholungs-Scores und Analysen mit den neuesten Algorithmen neu berechnen. Verwende einen Zeitraum, um auf aktuelle Sitzungen zu beschränken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recalcular las puntuaciones de recuperación y el análisis con los algoritmos más recientes. Usa un rango de fechas para limitar a sesiones recientes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laske palautumispisteet ja analyysit uudelleen uusimmilla algoritmeilla. Käytä aikaväliä rajoittaaksesi viimeaikaisiin istuntoihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recalculer les scores de récupération et l'analyse avec les derniers algorithmes. Utilisez une plage de dates pour limiter aux sessions récentes."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurreiknaðu batastig og greiningu með nýjustu reikniritum. Notaðu dagsetningasvið til að takmarka við nýlegar lotur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricalcolare i punteggi di recupero e l'analisi con gli ultimi algoritmi. Utilizzare un intervallo di date per limitare alle sessioni recenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新のアルゴリズムを使用して回復スコアと分析を再計算します。日付範囲を使用して最近のセッションに限定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최신 알고리즘을 사용하여 회복 점수와 분석을 재계산합니다. 날짜 범위를 사용하여 최근 세션으로 제한할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beregn restitusjonsscorer og analyse på nytt med de nyeste algoritmene. Bruk et datointervall for å begrense til nylige økter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herbereken herstelscores en analyses met de nieuwste algoritmen. Gebruik een datumbereik om te beperken tot recente sessies."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
