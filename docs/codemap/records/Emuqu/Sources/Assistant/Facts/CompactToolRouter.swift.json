   ],
   "reads": [
    "mem:CompactToolRouter.allowedActionNames"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+3",
     "cond": "resolveReadTool returned non-nil (name is a compact read tool)",
     "effect": "returns gatedReadResult(value)"
    },
    {
     "at": "+8",
     "cond": "name not in allowedActionNames",
     "effect": "returns missing(invalidParameter, 'unknown tool'); else registry.resolveTool"
    }
