    "Emuqu/Sources/Storage/Archive+Batch.swift::func ArchiveStore.postBatchChangeNotifications(_:)"
   ],
   "reads": [
    "mem:SessionArchive.index",
    "mem:SessionArchive.deletedSessionIds"
   ],
   "writes": [
    "mem:SessionArchive.index",
    "file:<archiveDirectory>/index.json",
    "file:<archiveDirectory>/<uuid>.json",
    "notif:flowRecoveryArchiveChanged",
    "ud:storage.pendingReencryption.sessionIDs",
    "mem:SessionArchive.sortedEntriesCache",
    "mem:SessionArchive.sessionIdLookup"
   ],
   "branches": [
    {
     "at": "+5",
     "cond": "for each session",
     "effect": "archiveOne; a throw jumps to catch"
    },
    {
     "at": "+8",
     "cond": "catch: archiveOne threw (file write or merge failure)",
     "effect": "savePartialBatch(newEntries) then rethrow; notifications are not posted"
    },
    {
     "at": "+12",
     "cond": "newEntries non-empty",
     "effect": "saveIndex (throws; files stay written, in-memory index already holds them); else skip save"
    }
   ],
