    "You were above anaerobic threshold the entire session (%lld min at α1 < 0.50). Very hard physiological cost — short, intense efforts only." : {
      "comment" : "This string should be updated when the",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كنت فوق العتبة اللاهوائية طوال الجلسة (%lld دقيقة عند α1 < 0.50). كلفة فسيولوجية عالية جدًا — جهود قصيرة ومكثفة فقط."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du var over den anaerobe tærskel hele sessionen (%lld min ved α1 < 0,50). Meget høj fysiologisk omkostning — kun korte, intense indsatser."
