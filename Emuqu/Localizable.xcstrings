          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bon stimulus thermique (%lld%% d’une dose complète) — cette sortie a fait progresser votre acclimatation à la chaleur."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traust hitaáreiti (%lld%% af fullum skammti) — þessi æfing kom hitaaðlöguninni þinni áfram."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno stimolo termico solido (%lld%% di una dose piena) — questa uscita ha fatto progredire il tuo adattamento al caldo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しっかりした暑熱刺激（フル用量の %lld%%）— このランで暑熱順化が前進しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확실한 열 자극(전체 용량의 %lld%%) — 이번 달리기로 열순화가 진전되었습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En solid varmestimulus (%lld%% av en full dose) — denne økten flyttet varmetilvenningen din framover."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een stevige hitteprikkel (%lld%% van een volledige dosis) — deze run bracht je hitteacclimatisatie vooruit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um bom estímulo de calor (%lld%% de uma dose completa) — esta corrida avançou sua aclimatação ao calor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хороший тепловой стимул (%lld%% полной дозы) — эта пробежка продвинула вашу тепловую акклиматизацию."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En rejäl värmestimulus (%lld%% av en full dos) — det här passet flyttade fram din värmeacklimatisering."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
