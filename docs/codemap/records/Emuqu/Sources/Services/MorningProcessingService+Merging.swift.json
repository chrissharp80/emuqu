    "archive:SessionArchive.entries (index)"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+4",
     "cond": "sessionType != .overnight or merge mode .off",
     "effect": "return without linking"
    },
    {
     "at": "+6",
     "cond": "newSession.endDate nil or before start",
     "effect": "span end = max(endDate ?? startDate, startDate), i.e. collapses to start"
    },
    {
     "at": "+8",
     "cond": "linkedSessionIds nil",
     "effect": "empty set of existing links"
    },
    {
     "at": "+9",
     "cond": "rrSeries nil",
     "effect": "newBeatCount = 0 (which newSessionMayClaimNight treats as 'may claim')"
    },
    {
     "at": "+10",
     "cond": "for each same-night archive entry",
     "effect": "loop over sameNightEntries"
    },
    {
     "at": "+11",
     "cond": "entry already linked, or gap > merge gap, or new session may not claim",
     "effect": "continue (skip entry); otherwise link it"
    },
    {
     "at": "+15",
     "cond": "linkedSessionIds nil when appending",
     "effect": "starts from [] then appends entry.sessionId"
    }
   ],
