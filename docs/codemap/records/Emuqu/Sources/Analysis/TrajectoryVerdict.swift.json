   "key": "func TrajectoryVerdict.ctlSlopePerWeek(_:)",
   "hash": "39ba805bd29bad0e",
   "does": "OLS slope of the last ≤14 daily CTL values ×7 (CTL points/week); 0 when fewer than 8 values or zero x-variance.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "≥ 8 values",
     "effect": "false → 0"
    },
    {
     "at": "+8",
     "cond": "loop over window",
     "effect": "accumulates covariance/variance"
    },
    {
     "at": "+13",
     "cond": "den > 0",
     "effect": "true → slope×7; false → 0"
    }
   ],
   "flags": [
    {
     "kind": "fragile",
     "sev": "low",
     "text": "Assumes the series is one value per consecutive day (x = index); a series with missing days would be regressed per-sample, not per-day.",
