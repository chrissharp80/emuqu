    "Or just go — record now, save the path as a route at the end." : {
      "comment" : "A description below the route picker, encouraging users to either start a new walk or save their current path as a route.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أو انطلق فحسب — سجّل الآن، واحفظ المسار كمسار في النهاية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller bare af sted — optag nu, og gem ruten som en rute til sidst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder leg einfach los – zeichne jetzt auf und speichere die Strecke am Ende als Route."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O simplemente ve — graba ahora y guarda el recorrido como ruta al final."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai lähde vain liikkeelle — tallenna nyt ja tallenna reitti lopuksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou partez tout simplement — enregistrez maintenant et sauvegardez le tracé comme itinéraire à la fin."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eða bara af stað — taktu upp núna og vistaðu leiðina sem leið í lokin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppure parti e basta — registra ora e salva il percorso come itinerario alla fine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あるいはそのまま出発 — 今すぐ記録し、最後にその経路をルートとして保存。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아니면 그냥 출발하세요 — 지금 기록하고, 끝에서 경로를 루트로 저장하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller bare dra — ta opp nå, og lagre løypa som en rute til slutt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of ga gewoon — neem nu op en sla het pad aan het einde op als route."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou simplesmente vá — grave agora e salve o trajeto como uma rota no final."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или просто отправляйтесь — записывайте сейчас, а в конце сохраните путь как маршрут."
          }
        },
        "sv" : {
          "stringUnit" : {
