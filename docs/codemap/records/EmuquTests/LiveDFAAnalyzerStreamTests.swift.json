     "at": "+2",
     "cond": "while a notification is due by this tick",
     "effect": "processes it and advances by 1 s"
    },
    {
     "at": "+5",
     "cond": "while the next beat ended by this notification",
     "effect": "consumes it"
    },
    {
     "at": "+8",
     "cond": "notification is lost (in dropout or after death)",
     "effect": "beat consumed but not delivered and cumulativeMs not advanced"
