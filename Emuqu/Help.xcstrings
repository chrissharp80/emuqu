          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização iCloud vai para o SEU contêiner privado do CloudKit — sem servidores de terceiros"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация iCloud идёт в ВАШ личный контейнер CloudKit — без сторонних серверов"
          }
        },
        "sv" : {
          "stringUnit" : {
