          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søvnstadierne afspejler, hvad uret registrerede (dyb, REM, kerne, vågen)"
          }
        },
        "de" : {
          "stringUnit" : {
