    "Refines Apple Watch sleep stages using chest-strap HRV." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحسّن مراحل النوم في Apple Watch باستخدام HRV من الحزام."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forfiner Apple Watch-søvnstadier ved hjælp af HRV fra brystrem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfeinert die Apple-Watch-Schlafphasen mithilfe der HRV des Brustgurts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refina las fases de sueño de Apple Watch usando la HRV de la banda pectoral."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarkentaa Apple Watchin univaiheita rintapannan HRV:n avulla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affine les phases de sommeil de l'Apple Watch à l'aide de la HRV de la ceinture pectorale."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fínstillir svefnstig Apple Watch með HRV frá brjóstbelti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affina le fasi del sonno di Apple Watch usando l'HRV della fascia toracica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "胸ストラップのHRVを使用してApple Watchの睡眠ステージを精緻化します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "흉부 스트랩 HRV를 사용하여 Apple Watch 수면 단계를 정교하게 다듬습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbedrer Apple Watch-søvnstadier ved hjelp av HRV fra brystbelte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfijnt de slaapfasen van Apple Watch met behulp van de HRV van de borstband."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Refina as fases de sono do Apple Watch usando o HRV da cinta peitoral."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уточняет фазы сна Apple Watch с помощью ВСР нагрудного ремня."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förfinar Apple Watch-sömnstadier med hjälp av HRV från bröstband."
