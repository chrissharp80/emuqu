        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストラップのセットアップが完了しませんでした。装着したまま iPhone の近くに置いて、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스트랩 설정이 완료되지 않았습니다. 착용한 상태로 휴대폰 가까이에 둔 후 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
