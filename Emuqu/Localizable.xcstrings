        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu necesita Bluetooth para conectar con tu banda Polar. Actívalo para Emuqu en Ajustes y vuelve — el emparejamiento no puede funcionar hasta entonces."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu tarvitsee Bluetoothia Polar-pannan tavoittamiseen. Ota se käyttöön Emuqulle asetuksissa ja palaa takaisin — pariliitos ei onnistu sitä ennen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu a besoin du Bluetooth pour atteindre votre ceinture Polar. Activez-le pour Emuqu dans Réglages, puis revenez — l’association ne peut pas fonctionner avant."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu þarf Bluetooth til að ná í Polar-ólina þína. Kveiktu á því fyrir Emuqu í Stillingum og komdu svo aftur — pörun getur ekki virkað fyrr en þá."
          }
        },
        "it" : {
          "stringUnit" : {
