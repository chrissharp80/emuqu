        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'app corregge automaticamente gli artefatti lievi con interpolazione e sostituzione con la mediana, e il selettore della finestra non usa finestre con più del 15% di artefatti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリは軽度のアーチファクトを補間と中央値置換で自動補正します。また、ウィンドウ選択ではアーチファクトが 15% を超えるウィンドウは使いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
