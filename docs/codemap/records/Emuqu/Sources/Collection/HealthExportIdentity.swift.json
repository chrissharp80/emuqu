 "file": "Emuqu/Sources/Collection/HealthExportIdentity.swift",
 "hash": "e5dbf35af0d3670e",
 "role": "The HKMetadataKeyExternalUUID naming scheme for samples and workouts the app writes to Apple Health and the exact/prefix predicates re-exports use to delete their own prior samples; the metadata every export carries (the identity again as HKMetadataKeySyncIdentifier, with a monotonic HKMetadataKeySyncVersion) so HealthKit replaces a re-exported object instead of keeping both; plus RRPoint.exportTimeMs (wall clock or beat-sum).",
 "types": [
  "HealthExportIdentity: enum — ID builders, match predicates, export metadata and sync versions",
  "HealthExportIdentity.Metric: enum (String, CaseIterable) — hr, rhr, sdnn, rmssd, sleep, workout",
  "RRPoint: extension — exportTimeMs"
 ],
 "state": [
  "ExternalUUID formats: '<uuid>-<metric>' (summary), '<uuid>-<metric>-<n|suffix>' (series); the same string is the sync identifier",
  "mem:HealthExportIdentity.lastSyncVersion (OSAllocatedUnfairLock<Int>, last sync version handed out)"
 ],
