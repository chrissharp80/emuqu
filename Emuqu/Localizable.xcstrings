    "You spent %lld minutes on this %@, %lld%% of it below the aerobic threshold. Tomorrow's recovery score will tell you how much this session cost." : {
      "comment" : "Default narrative text for the \"How you did?\" card in the workout summary. The first argument is the duration of the workout in minutes. The second argument is the percentage of the workout that was done below the aerobic threshold.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قضيت %lld دقيقة في هذا %@، منها %lld%% دون العتبة الهوائية. ستخبرك درجة تعافي الغد بكلفة هذه الجلسة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du brugte %lld minutter på denne %@, hvoraf %lld%% var under den aerobe tærskel. Morgendagens restitutionsscore fortæller, hvad sessionen kostede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast %lld Minuten bei dieser Einheit (%@) verbracht, davon %lld%% unter der aeroben Schwelle. Der Erholungs-Score von morgen zeigt, was diese Einheit gekostet hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You spent %1$lld minutes on this %2$@, %3$lld%% of it below the aerobic threshold. Tomorrow's recovery score will tell you how much this session cost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dedicaste %lld minutos a esta sesión de %@, un %lld%% de ellos por debajo del umbral aeróbico. La puntuación de recuperación de mañana te dirá cuánto costó esta sesión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytit tähän %2$@ %1$lld minuuttia, joista %3$lld%% aerobisen kynnyksen alapuolella. Huomisen palautumispisteet kertovat, mitä tämä harjoitus maksoi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez passé %lld minutes sur cette séance (%@), dont %lld%% sous le seuil aérobie. Le score de récupération de demain vous dira ce que cette séance a coûté."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú varðir %lld mínútum í þetta %@, þar af %lld%% undir loftháðum þröskuldi. Endurheimtarstig morgundagsins segir hvað lotan kostaði."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai dedicato %lld minuti a questo %@, di cui il %lld%% sotto la soglia aerobica. Il punteggio di recupero di domani ti dirà quanto è costata questa sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この%2$@に %1$lld 分を費やし、そのうち %3$lld%% が有酸素性作業閾値以下でした。明日の回復スコアが、このセッションの代償を教えてくれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 %2$@에 %1$lld분을 썼고, 그중 %3$lld%%는 유산소 역치 아래였습니다. 내일의 회복 점수가 이번 세션의 대가를 알려줄 것입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du brukte %lld minutter på denne %@, hvorav %lld%% under aerob terskel. Morgendagens restitusjonsscore forteller hva økten kostet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je besteedde %lld minuten aan deze %@, waarvan %lld%% onder de aerobe drempel. De herstelscore van morgen laat zien wat deze sessie kostte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você passou %lld minutos neste %@, sendo %lld%% abaixo do limiar aeróbio. A pontuação de recuperação de amanhã dirá quanto essa sessão custou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы провели %lld минут в этом %@, из них %lld%% ниже аэробного порога. Завтрашняя оценка восстановления покажет, во что обошлась эта сессия."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du lade %lld minuter på detta %@, varav %lld%% under aerob tröskel. Morgondagens återhämtningspoäng visar vad passet kostade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在这次%2$@上花了 %1$lld 分钟，其中 %3$lld%% 处于有氧阈以下。明天的恢复评分会告诉你这次训练的代价。"
          }
        }
      }
    },
    "You stayed below aerobic threshold for the full %lld min — pure Zone-2 base work, α1 never crossed 0.75. Ideal aerobic-base session." : {
      "comment" : "This string should be presented to a user when the alpha1 analysis indicates that they have been consistently below the aerobic threshold for the entire session.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بقيت دون العتبة الهوائية طوال %lld دقيقة — عمل قاعدي خالص في المنطقة 2، ولم يهبط α1 دون 0.75 أبدًا. جلسة قاعدة هوائية مثالية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
