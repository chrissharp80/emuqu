        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高いほど良好です。R² > 0.95 は α1 測定が信頼できることを示します。値が低い場合はノイズやアーチファクトが疑われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
