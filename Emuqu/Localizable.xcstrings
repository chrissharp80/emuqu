    "Saved as \"%@\". The coach will recognise this on future workouts — same direction or reversed." : {
      "comment" : "A note below the button that",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم الحفظ باسم \"%@\". سيتعرّف المدرّب على هذا في التمارين المستقبلية — بالاتجاه نفسه أو معكوسًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemt som \"%@\". Træneren vil genkende dette i fremtidige træninger — samme retning eller omvendt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeichert als „%@“. Der Coach erkennt dies bei zukünftigen Trainings – in gleicher Richtung oder umgekehrt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado como \"%@\". El entrenador lo reconocerá en futuros entrenamientos — en la misma dirección o a la inversa."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennettu nimellä \"%@\". Valmentaja tunnistaa tämän tulevissa harjoituksissa — samaan suuntaan tai käänteisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré sous « %@ ». Le coach le reconnaîtra lors de prochaines séances — dans le même sens ou inversé."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vistað sem „%@“. Þjálfarinn mun þekkja þetta í framtíðaræfingum — sömu átt eða öfugt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvato come \"%@\". Il coach lo riconoscerà nei prossimi allenamenti — nella stessa direzione o invertito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」として保存しました。コーチは今後のワークアウトでこれを認識します — 同じ方向でも逆方向でも。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\"(으)로 저장했습니다. 코치가 향후 운동에서 이를 인식합니다 — 같은 방향 또는 반대 방향으로."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lagret som «%@». Treneren vil gjenkjenne dette på fremtidige økter — samme retning eller motsatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opgeslagen als \"%@\". De coach herkent dit bij toekomstige trainingen — in dezelfde richting of omgekeerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvo como \"%@\". O treinador reconhecerá isto em treinos futuros — na mesma direção ou no sentido inverso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранено как «%@». Тренер распознает это в будущих тренировках — в том же направлении или в обратном."
          }
        },
        "sv" : {
          "stringUnit" : {
