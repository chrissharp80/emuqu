        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existem vários caminhos de recuperação, dependendo do que aconteceu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
