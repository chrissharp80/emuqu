    },
    "Only %@ of sleep — chronic short sleep degrades adaptation and recovery from training." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ نوم فقط — قلة النوم المزمنة تُضعف التكيّف والتعافي من التدريب."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun %@ søvn — kronisk kort søvn forringer tilpasning og restitution efter træning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur %@ Schlaf — chronisch kurzer Schlaf verschlechtert Anpassung und Erholung vom Training."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo %@ de sueño — el sueño corto crónico deteriora la adaptación y la recuperación del entrenamiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain %@ unta — krooninen lyhytuni heikentää adaptaatiota ja harjoittelusta palautumista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement %@ de sommeil — un sommeil chroniquement court dégrade l’adaptation et la récupération."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aðeins %@ svefn — langvarandi stuttur svefn dregur úr aðlögun og endurheimt eftir æfingar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo %@ di sonno — il sonno breve cronico peggiora adattamento e recupero dall’allenamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠はわずか %@ — 慢性的な睡眠不足は適応とトレーニングからの回復を損ないます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면이 %@에 불과 — 만성적인 수면 부족은 적응과 훈련 회복을 저해합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare %@ søvn — kronisk kort søvn svekker tilpasning og restitusjon etter trening."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slechts %@ slaap — chronisch kort slapen verslechtert adaptatie en herstel van training."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas %@ de sono — sono curto crônico prejudica a adaptação e a recuperação do treino."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всего %@ сна — хронический недосып ухудшает адаптацию и восстановление после тренировок."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara %@ sömn — kroniskt kort sömn försämrar anpassning och återhämtning från träning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅睡了 %@ — 长期睡眠不足会削弱适应和训练后的恢复。"
          }
        }
      }
    },
    "Only the live HR + live cycling power, only while the workout is active." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نبض القلب المباشر + قدرة ركوب الدراجة المباشرة فقط، وفقط أثناء التمرين النشط."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun live-puls + live-cykelwatt, og kun mens træningen er aktiv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Live-HF + Live-Radleistung, nur während das Training läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo la FC en directo + la potencia de ciclismo en directo, y solo mientras el entrenamiento está activo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain reaaliaikainen syke + pyöräilyteho, ja vain harjoituksen ollessa käynnissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement la FC en direct + la puissance vélo en direct, et uniquement pendant l’entraînement."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aðeins púls í rauntíma + hjólaafl í rauntíma, og aðeins á meðan æfingin er í gangi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo FC in tempo reale + potenza in tempo reale, e solo durante l’allenamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブ心拍数とライブのサイクリングパワーのみを、ワークアウト中のみ送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 심박수 + 실시간 사이클링 파워만, 운동이 진행 중일 때만 전송됩니다."
