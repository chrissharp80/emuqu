    "Barometric readings have random noise. Per-sample differencing accumulates bias (√N × noise) over a session." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للقراءات البارومترية ضوضاء عشوائية. الفرق بين كل عينة والتي تليها يراكم انحيازًا (√N × الضوضاء) على مدى الجلسة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barometriske målinger har tilfældig støj. Differensberegning pr. prøve ophober bias (√N × støj) over en session."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barometrische Messwerte enthalten zufälliges Rauschen. Differenzen von Messwert zu Messwert summieren über eine Sitzung einen Fehler auf (√N × Rauschen)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las lecturas barométricas tienen ruido aleatorio. Diferenciar muestra a muestra acumula sesgo (√N × ruido) a lo largo de una sesión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barometrisissa lukemissa on satunnaista kohinaa. Näytekohtainen erotus kerryttää harhaa (√N × kohina) istunnon aikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lectures barométriques comportent un bruit aléatoire. La différenciation échantillon par échantillon accumule un biais (√N × bruit) au cours d’une session."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loftþrýstingsmælingar hafa slembisuð. Mismunur sýni fyrir sýni safnar upp skekkju (√N × suð) yfir lotuna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le letture barometriche hanno un rumore casuale. Sommare le differenze campione per campione accumula un errore (√N × rumore) nel corso di una sessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気圧の測定値にはランダムなノイズが含まれます。サンプルごとの差分を積み上げると、セッション全体でバイアス（√N × ノイズ）が蓄積します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기압 측정값에는 무작위 노이즈가 있습니다. 샘플마다 차이를 구하면 세션 동안 편향(√N × 노이즈)이 누적됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barometriske målinger har tilfeldig støy. Differanse per prøve akkumulerer skjevhet (√N × støy) gjennom en økt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barometrische metingen bevatten willekeurige ruis. Verschillen per sample stapelen over een sessie een afwijking op (√N × ruis)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As leituras barométricas têm ruído aleatório. A diferenciação amostra a amostra acumula viés (√N × ruído) ao longo de uma sessão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Барометрические показания содержат случайный шум. Поотсчётное дифференцирование накапливает смещение (√N × шум) за сессию."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Barometriska mätningar har slumpmässigt brus. Differentiering per prov ackumulerar bias (√N × brus) under en session."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "气压读数存在随机噪声。逐样本差分会在一次记录中累积偏差（√N × 噪声）。"
          }
        }
      }
    },
