    "Training load and trajectory are shown separately, on their own surface, and do not affect your recovery score." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُعرض عبء التدريب والمنحى بشكل منفصل، على واجهتهما الخاصة، ولا يؤثران في درجة التعافي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træningsbelastning og udvikling vises separat, på deres egen flade, og påvirker ikke din restitutionsscore."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trainingsbelastung und Entwicklung werden separat in einer eigenen Ansicht gezeigt und beeinflussen deinen Erholungs-Score nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carga de entrenamiento y la trayectoria se muestran por separado, en su propia vista, y no afectan a tu puntuación de recuperación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harjoituskuorma ja kehityssuunta näytetään erikseen omalla näkymällään, eivätkä ne vaikuta palautumispisteisiisi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La charge d'entraînement et la trajectoire sont affichées séparément, sur leur propre vue, et n'affectent pas votre score de récupération."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Æfingaálag og þróun eru sýnd sér, á eigin fleti, og hafa ekki áhrif á batastigið þitt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il carico di allenamento e la traiettoria sono mostrati separatamente, in una vista dedicata, e non influiscono sul tuo punteggio di recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレーニング負荷と推移は別の画面に個別に表示され、回復スコアには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "훈련 부하와 추이는 별도 화면에 따로 표시되며 회복 점수에 영향을 주지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treningsbelastning og utvikling vises separat, på en egen flate, og påvirker ikke restitusjonsskåren din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trainingsbelasting en verloop worden apart getoond, op een eigen scherm, en hebben geen invloed op je herstelscore."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A carga de treino e a trajetória são mostradas separadamente, em uma área própria, e não afetam sua pontuação de recuperação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировочная нагрузка и динамика показываются отдельно, в своём разделе, и не влияют на оценку восстановления."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Träningsbelastning och utveckling visas separat, på en egen yta, och påverkar inte din återhämtningspoäng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "训练负荷和轨迹在单独的界面上显示，不影响你的恢复评分。"
          }
        }
      }
    },
    "Training load is turned off, or you're on a training break. Change it in Settings → Training." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حمل التدريب متوقف، أو أنك في استراحة من التدريب. غيّر ذلك في الإعدادات ← التدريب."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træningsbelastning er slået fra, eller du holder træningspause. Skift det under Indstillinger → Træning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Trainingsbelastung ist ausgeschaltet oder du machst eine Trainingspause. Ändere das unter Einstellungen → Training."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carga de entrenamiento está desactivada o estás en un descanso de entrenamiento. Cámbialo en Ajustes → Entrenamiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harjoituskuorma on pois päältä tai pidät harjoittelutaukoa. Muuta tätä kohdassa Asetukset → Harjoittelu."
