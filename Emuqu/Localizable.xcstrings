      }
    },
    "This session and its backups will be removed for good. This cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُزال هذه الجلسة ونسخها الاحتياطية نهائيًا. لا يمكن التراجع عن ذلك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessionen og dens sikkerhedskopier fjernes for altid. Det kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Sitzung und ihre Backups werden endgültig entfernt. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sesión y sus copias de seguridad se eliminarán para siempre. No se puede deshacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä istunto ja sen varmuuskopiot poistetaan lopullisesti. Toimintoa ei voi kumota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette séance et ses sauvegardes seront supprimées pour de bon. Action irréversible."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þessari lotu og afritum hennar verður eytt fyrir fullt og allt. Ekki er hægt að afturkalla þetta."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa sessione e i suoi backup verranno rimossi per sempre. L'operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセッションとそのバックアップは完全に削除されます。元に戻すことはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 세션과 백업이 영구적으로 삭제됩니다. 되돌릴 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økten og sikkerhetskopiene fjernes for godt. Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze sessie en de back-ups ervan worden definitief verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta sessão e seus backups serão removidos para sempre. Não é possível desfazer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта сессия и её резервные копии будут удалены навсегда. Отменить это нельзя."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessionen och dess säkerhetskopior tas bort för gott. Det går inte att ångra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此记录及其备份将被永久删除，且无法撤销。"
          }
        }
      }
    },
