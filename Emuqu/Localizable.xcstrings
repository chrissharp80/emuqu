    "Removed corrupted files and rebuilt the index.\nSessions recovered: %lld" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُزيلت الملفات التالفة وأُعيد بناء الفهرس.\nالجلسات المستردة: %lld"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beskadigede filer er fjernet, og indekset er genopbygget.\nSessioner gendannet: %lld"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschädigte Dateien entfernt und Index neu aufgebaut.\nWiederhergestellte Sitzungen: %lld"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminaron los archivos dañados y se reconstruyó el índice.\nSesiones recuperadas: %lld"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vioittuneet tiedostot poistettiin ja hakemisto rakennettiin uudelleen.\nPalautetut istunnot: %lld"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichiers corrompus supprimés et index reconstruit.\nSessions récupérées : %lld"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skemmdar skrár fjarlægðar og atriðaskrá endurbyggð.\nLotur endurheimtar: %lld"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File danneggiati rimossi e indice ricostruito.\nSessioni recuperate: %lld"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "破損したファイルを削除し、インデックスを再構築しました。\n復元したセッション：%lld"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손상된 파일을 삭제하고 색인을 다시 만들었습니다.\n복구된 세션: %lld"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skadde filer er fjernet og indeksen bygget opp på nytt.\nØkter gjenopprettet: %lld"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beschadigde bestanden verwijderd en index opnieuw opgebouwd.\nSessies hersteld: %lld"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos corrompidos removidos e índice reconstruído.\nSessões recuperadas: %lld"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повреждённые файлы удалены, индекс перестроен.\nВосстановлено сессий: %lld"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skadade filer har tagits bort och indexet byggts om.\nSessioner återställda: %lld"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已删除损坏的文件并重建索引。\n已恢复的记录：%lld"
          }
        }
      }
    },
