   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "dfaAlpha1 nil",
     "effect": "returns nil"
    },
    {
     "at": "+2",
     "cond": "α1 within [0.75, 1.0]",
     "effect": "returns (.alphaBalanced, +5)"
    },
    {
     "at": "+5",
     "cond": "α1 > dfaAlpha1Fatigue (1.2)",
     "effect": "returns (.alphaStrained, -5)"
    },
    {
     "at": "+8",
     "cond": "α1 < dfaAlpha1FlexibleLower (0.60)",
     "effect": "returns (.alphaReduced, -3); otherwise (0.60-0.75 or 1.0-1.2) returns nil"
    }
   ],
