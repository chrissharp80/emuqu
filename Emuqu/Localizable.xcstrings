    "Crossed the aerobic threshold at %@ (%lld bpm). %@ at threshold, %@ easy." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجاوزت العتبة الهوائية عند %1$@ (%2$lld نبضة/دقيقة). ‏%3$@ عند العتبة، و%4$@ سهل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krydsede den aerobe tærskel ved %@ (%lld bpm). %@ ved tærsklen, %@ let."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aerobe Schwelle bei %@ (%lld bpm) überschritten. %@ an der Schwelle, %@ locker."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cruzaste el umbral aeróbico a los %@ (%lld lpm). %@ en el umbral, %@ suave."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ylitit aerobisen kynnyksen ajassa %@ (%lld bpm). %@ kynnyksellä, %@ kevyesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuil aérobie franchi à %@ (%lld bpm). %@ au seuil, %@ facile."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fórst yfir loftháða þröskuldinn á %@ (%lld slög/mín). %@ við þröskuld, %@ létt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai superato la soglia aerobica a %@ (%lld bpm). %@ in soglia, %@ facile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@（%2$lld bpm）で有酸素閾値を超えました。閾値%3$@、イージー%4$@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@(%2$lld bpm)에 유산소 역치를 넘었습니다. 역치 %3$@, 쉬움 %4$@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krysset den aerobe terskelen ved %@ (%lld bpm). %@ ved terskelen, %@ lett."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aerobe drempel overschreden op %@ (%lld bpm). %@ op drempel, %@ licht."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cruzou o limiar aeróbico em %@ (%lld bpm). %@ no limiar, %@ leve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аэробный порог пройден на %@ (%lld уд/мин). %@ на пороге, %@ легко."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passerade den aeroba tröskeln vid %@ (%lld bpm). %@ vid tröskeln, %@ lätt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %1$@（%2$lld bpm）越过有氧阈值。阈值 %3$@，轻松 %4$@。"
          }
        }
      }
    },
    "Crossed the aerobic threshold at %@ (%lld bpm). %@ very hard (α1 under 0.50). Mixed-intensity session." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجاوزت العتبة الهوائية عند %1$@ (%2$lld نبضة/دقيقة). ‏%3$@ بشدة عالية جدًا (α1 أقل من 0.50). جلسة متنوعة الشدة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krydsede den aerobe tærskel ved %@ (%lld bpm). %@ meget hårdt (α1 under 0,50). Session med blandet intensitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aerobe Schwelle bei %@ (%lld bpm) überschritten. %@ sehr hart (α1 unter 0,50). Einheit mit gemischter Intensität."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cruzaste el umbral aeróbico a los %@ (%lld lpm). %@ muy duro (α1 por debajo de 0,50). Sesión de intensidad mixta."
          }
