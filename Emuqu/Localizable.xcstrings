          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aos %lld anos, alguma elevação da linha de base em relação a adultos mais jovens é esperada — compare com a SUA média, não com normas populacionais."
          }
        },
        "ru" : {
