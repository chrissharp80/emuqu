          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동 데이터가 있으면 링 아래에 훈련 준비 상태를 보여 주는 가로 구간 막대가 나타납니다: 휴식 / 피로 / 보통 / 준비 완료."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
