    "Every recent night already has a recording, so no sample nights were added." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل الليالي الأخيرة لديها تسجيل بالفعل، لذا لم تُضَف أي ليالٍ تجريبية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle de seneste nætter har allerede en optagelse, så der blev ikke tilføjet nogen eksempelnætter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für jede der letzten Nächte gibt es bereits eine Aufzeichnung, daher wurden keine Beispielnächte hinzugefügt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
