          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В ваших данных заметна необычная закономерность. Причину вам стоит выяснить самостоятельно."
          }
        },
        "sv" : {
          "stringUnit" : {
