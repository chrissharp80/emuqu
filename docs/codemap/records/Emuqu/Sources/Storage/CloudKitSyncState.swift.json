{
 "file": "Emuqu/Sources/Storage/CloudKitSyncState.swift",
 "hash": "c17aadfc78013dc8",
 "role": "Value type holding CloudKit sync bookkeeping (uploaded / pending / quarantined / local-only id sets and in-memory failure counts) and persisting each set as a JSON array of UUID strings next to sync_state.json.",
 "types": [
  "CloudKitSyncState: struct — durable sync bookkeeping with load/save/mutation helpers"
 ],
 "state": [
  "file:sync_state.json (uploadedSessionIds)",
  "file:pending_uploads.json (pendingUploadIds)",
  "file:quarantined_uploads.json (quarantinedSessionIds)",
  "file:local_only_sessions.json (localOnlySessionIds)",
  "mem:CloudKitSyncState.uploadFailureCounts (NOT persisted)",
  "mem:CloudKitSyncState.isLoaded",
  "ud:UserDefaultsKeys.cloudKitChangeToken (only removed, legacy cleanup)",
  "mem:CloudKitSyncState.uploadedRemovedBeforeLoad / pendingRemovedBeforeLoad (ids removed before loadAll; kept out of the load's merge, cleared by loadAll/resetAll)"
 ],
 "toplevel": "All sets default empty; isLoaded false until loadAll or resetAll. The three sibling file URLs are derived from syncStateURL's directory. uploadFailureCounts is in memory only (documented): backoff restarts at each launch.",
