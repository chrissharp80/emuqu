    "Saved as partial after an interrupted session. You're seeing what was captured before the interruption." : {
      "comment" : "Explanation of why a workout that was partially saved (i.e. not fully completed) is displayed in the summary view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حُفظت كجزئية بعد جلسة متقطعة. ما تراه هو ما التُقط قبل الانقطاع."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemt som delvis efter en afbrudt session. Du ser det, der blev registreret før afbrydelsen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einer unterbrochenen Sitzung als Teilaufzeichnung gespeichert. Du siehst, was vor der Unterbrechung erfasst wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardada como parcial tras una sesión interrumpida. Ves lo que se capturó antes de la interrupción."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennettu osittaisena keskeytyneen istunnon jälkeen. Näet sen, mitä ehdittiin tallentaa ennen keskeytystä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré comme partiel après une séance interrompue. Vous voyez ce qui a été capté avant l’interruption."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vistað sem hluti eftir rofna lotu. Þú sérð það sem náðist fyrir rofið."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvata come parziale dopo una sessione interrotta. Vedi ciò che è stato acquisito prima dell’interruzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
