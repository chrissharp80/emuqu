    "Adults: 20–80 ms (huge person-to-person variability). Athletes often 60–120 ms." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البالغون: 20–80 مللي ثانية (تباين هائل بين الأشخاص). الرياضيون غالبًا 60–120 مللي ثانية."
          }
        },
        "da" : {
          "stringUnit" : {
