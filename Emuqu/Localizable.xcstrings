    "Typical range: 0.2-0.5. Low ratios suggest reduced parasympathetic modulation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النطاق المعتاد: 0.2-0.5. النسب المنخفضة تشير إلى تعديل نظير ودي أقل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typisk interval: 0,2-0,5. Lave forhold tyder på nedsat parasympatisk modulation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typischer Bereich: 0,2-0,5. Niedrige Verhältnisse deuten auf verringerte parasympathische Modulation hin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rango típico: 0,2-0,5. Los cocientes bajos sugieren menor modulación parasimpática."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyypillinen vaihteluväli: 0,2-0,5. Matalat suhteet viittaavat heikentyneeseen parasympaattiseen säätelyyn."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plage typique : 0,2-0,5. Des rapports faibles suggèrent une modulation parasympathique réduite."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dæmigert bil: 0,2-0,5. Lág hlutföll benda til minnkaðrar sefkerfisstjórnunar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervallo tipico: 0,2-0,5. Rapporti bassi suggeriscono una ridotta modulazione parasimpatica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "典型的な範囲: 0.2-0.5。比が低い場合は副交感神経の調節低下を示唆します。"
          }
        },
        "ko" : {
          "stringUnit" : {
