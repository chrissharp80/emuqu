          }
        }
      }
    },
    "Tap a suggestion below. Apple Intelligence answers on this device; voice conversations, and some questions depending on your routing setting, go to a cloud model you've accepted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على اقتراح أدناه. يجيب Apple Intelligence على هذا الجهاز؛ أما المحادثات الصوتية وبعض الأسئلة، حسب إعداد التوجيه، فتذهب إلى نموذج سحابي قبلته."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på et forslag nedenfor. Apple Intelligence svarer på denne enhed; stemmesamtaler og nogle spørgsmål, afhængigt af din routingindstilling, går til en cloudmodel, du har accepteret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe unten auf einen Vorschlag. Apple Intelligence antwortet auf diesem Gerät; Sprachgespräche und je nach Routing-Einstellung einige Fragen gehen an ein Cloud-Modell, das du akzeptiert hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una sugerencia abajo. Apple Intelligence responde en este dispositivo; las conversaciones de voz y algunas preguntas, según tu ajuste de enrutamiento, van a un modelo en la nube que hayas aceptado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta ehdotusta alla. Apple Intelligence vastaa tällä laitteella; puhekeskustelut ja reititysasetuksesta riippuen osa kysymyksistä menevät hyväksymällesi pilvimallille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une suggestion ci-dessous. Apple Intelligence répond sur cet appareil ; les conversations vocales et certaines questions, selon votre réglage de routage, vont à un modèle cloud que vous avez accepté."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ýttu á tillögu hér fyrir neðan. Apple Intelligence svarar á þessu tæki; raddsamtöl og sumar spurningar, eftir leiðarstillingunni, fara til skýjalíkans sem þú hefur samþykkt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un suggerimento qui sotto. Apple Intelligence risponde su questo dispositivo; le conversazioni vocali e alcune domande, in base all’impostazione di instradamento, vanno a un modello cloud che hai accettato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下の候補をタップしてください。Apple Intelligence はこのデバイス上で回答します。音声での会話と、ルーティング設定によっては一部の質問が、同意したクラウドモデルに送られます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래 제안을 탭하세요. Apple Intelligence는 이 기기에서 답변하며, 음성 대화와 라우팅 설정에 따른 일부 질문은 동의한 클라우드 모델로 전송됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på et forslag nedenfor. Apple Intelligence svarer på denne enheten; talesamtaler og noen spørsmål, avhengig av rutingsinnstillingen, går til en skymodell du har godtatt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik hieronder op een suggestie. Apple Intelligence antwoordt op dit apparaat; spraakgesprekken en sommige vragen, afhankelijk van je routeringsinstelling, gaan naar een cloudmodel dat je hebt geaccepteerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em uma sugestão abaixo. O Apple Intelligence responde neste dispositivo; conversas por voz e algumas perguntas, conforme seu ajuste de roteamento, vão para um modelo na nuvem que você aceitou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите подсказку ниже. Apple Intelligence отвечает на этом устройстве; голосовые разговоры и часть вопросов, в зависимости от настройки маршрутизации, уходят в облачную модель, которую вы приняли."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på ett förslag nedan. Apple Intelligence svarar på den här enheten; röstsamtal och vissa frågor, beroende på routningsinställningen, går till en molnmodell som du har godkänt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按下方的建议。Apple Intelligence 在此设备上回答；语音对话以及部分问题（取决于路由设置）会发送到你已接受的云端模型。"
          }
        }
      }
    },
