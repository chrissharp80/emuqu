    "Delete All My Data asks you to type a confirmation phrase and confirm once more before it erases anything." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطلب منك خيار «حذف جميع بياناتي» كتابة عبارة تأكيد ثم التأكيد مرة أخرى قبل أن يمسح أي شيء."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slet alle mine data beder dig skrive en bekræftelsessætning og bekræfte én gang til, før der slettes noget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Alle meine Daten löschen“ verlangt, dass du einen Bestätigungssatz eintippst und noch einmal bestätigst, bevor etwas gelöscht wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Eliminar todos mis datos» te pide escribir una frase de confirmación y confirmar una vez más antes de borrar nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista kaikki tietoni pyytää kirjoittamaan vahvistuslauseen ja vahvistamaan vielä kerran ennen kuin mitään poistetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Supprimer toutes mes données » vous demande de saisir une phrase de confirmation et de confirmer une dernière fois avant d'effacer quoi que ce soit."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Eyða öllum gögnunum mínum“ biður þig að slá inn staðfestingarsetningu og staðfesta einu sinni enn áður en nokkru er eytt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Elimina tutti i miei dati» ti chiede di digitare una frase di conferma e di confermare ancora una volta prima di cancellare qualsiasi cosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「すべてのデータを削除」は、何かを消去する前に確認用の語句の入力と、もう一度の確認を求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'내 데이터 모두 삭제'는 무엇이든 지우기 전에 확인 문구를 입력하고 한 번 더 확인하도록 요청합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slett alle dataene mine ber deg skrive inn en bekreftelsesfrase og bekrefte én gang til før noe slettes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Al mijn gegevens verwijderen' vraagt je een bevestigingszin te typen en nog één keer te bevestigen voordat er iets wordt gewist."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Excluir todos os meus dados\" pede que você digite uma frase de confirmação e confirme mais uma vez antes de apagar qualquer coisa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Удалить все мои данные» просит ввести фразу подтверждения и подтвердить ещё раз, прежде чем что-либо стереть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radera alla mina data ber dig skriva en bekräftelsefras och bekräfta en gång till innan något raderas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“删除我的所有数据”会要求你输入确认短语并再次确认，然后才会清除任何内容。"
          }
        }
      }
    },
