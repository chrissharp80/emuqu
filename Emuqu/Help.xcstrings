        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu on kertaostos — maksa kerran, omista ikuisesti. Ei tilauksia, ei toistuvia maksuja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu utilise un achat unique à vie — payez une fois, possédez-la pour toujours. Pas d’abonnement, pas de frais récurrents."
          }
        },
        "is" : {
