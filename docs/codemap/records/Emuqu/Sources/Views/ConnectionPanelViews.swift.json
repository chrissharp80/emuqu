   "key": "func ConnectionStatusBadge.linked(feed:heartRate:)",
   "hash": "7d9d5003b043f1bd",
   "does": "For a connected strap: live feed → green '<hr> bpm' (or 'Connected' with no HR); stalled → orange 'No heart rate from strap'; settingUp/waitingForStrap → orange 'Setting up'.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Services/LanguageManager.swift::var LanguageManager.appBundle"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "feed .live",
     "effect": "green; see 125"
    },
    {
     "at": "+3",
     "cond": "heartRate is nil (guard)",
     "effect": "green 'Connected'; else green '<hr> bpm'"
    },
    {
     "at": "+5",
     "cond": "feed .stalled",
     "effect": "orange 'No heart rate from strap'"
    },
    {
     "at": "+7",
     "cond": "feed .settingUp or .waitingForStrap",
     "effect": "orange 'Setting up'"
    }
   ],
