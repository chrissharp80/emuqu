          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze signalen zijn waarnemingen van je fysiologie, geen tekenen van een aandoening."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses sinais são observações da sua fisiologia, não indícios de nenhuma condição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти сигналы — наблюдения за вашей физиологией, а не признаки какого-либо состояния."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De här signalerna är observationer av din fysiologi, inte tecken på något tillstånd."
          }
        },
        "zh-Hans" : {
