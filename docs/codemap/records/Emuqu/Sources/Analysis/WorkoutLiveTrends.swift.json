  {
   "key": "func WorkoutLiveTrends.efficiency(in:)",
   "hash": "82b16566863e330e",
   "does": "Nested helper: filters a slice to samples with HR>0 and pace>0, returns avg speed (m/s) / avg HR.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "HR ?? 0 > 0 and pace ?? 0 > 0 (nil-coalesced to 0)",
     "effect": "sample kept only when both present and positive"
    },
    {
     "at": "+2",
     "cond": "fewer than 30 valid samples",
     "effect": "return nil"
    },
    {
     "at": "+4",
     "cond": "pace ?? 1 fallback",
     "effect": "pace is never nil here (filtered at 71) so the 1 fallback is never used"
    },
    {
     "at": "+8",
     "cond": "avg HR <= 0",
     "effect": "return nil; else ratio"
    }
   ],
   "deps": {}
  },
