   ],
   "reads": [
    "archive:SessionArchive.retrieve"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "snapshot nil and the archive holds this session id",
     "effect": "true: copy the archived snapshot (may itself be nil); false: skip"
    },
    {
     "at": "+4",
     "cond": "snapshot still nil",
     "effect": "true: fill from fresh context / cache; false: keep existing"
    },
    {
     "at": "+5",
     "cond": "freshContext ?? createTrainingContext()",
     "effect": "fallback to the synchronous cached context when freshContext is nil; may still be nil"
    },
    {
     "at": "+7",
     "cond": "a frozen snapshot exists",
