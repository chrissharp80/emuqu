        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aggiungi una chiave Tavily per la ricerca web, le query di ricerca scritte dall’assistente vanno a Tavily."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウェブ検索用に Tavily キーを追加すると、アシスタントが作成する検索クエリが Tavily に送信されます。"
