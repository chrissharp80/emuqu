     "cond": "!reduceMotion",
     "effect": "continue to animated path; when Reduce Motion is on, jump to final values and return"
    },
    {
     "at": "+3",
     "cond": "(reduce-motion path) state is .default",
     "effect": "displayedScore = score; other states leave 0"
    },
