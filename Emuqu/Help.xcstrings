          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-synkronointi menee SINUN yksityiseen CloudKit-säiliöösi — ei kolmansien osapuolten palvelimia"
          }
        },
        "fr" : {
          "stringUnit" : {
