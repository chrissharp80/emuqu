        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um sinal vital está fora da sua faixa habitual. Vale a pena observar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один из показателей вышел за ваш обычный диапазон. Стоит обратить внимание."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett vitalt tecken ligger utanför ditt vanliga intervall. Värt att notera."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有一项生命体征超出了你的常规范围，值得留意。"
          }
        }
      }
    },
    "One-time purchase. Restorable with your Apple ID." : {
