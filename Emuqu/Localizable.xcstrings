    "Apple Intelligence couldn't answer that. Try again, or ask it another way." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتمكن Apple Intelligence من الإجابة. حاول مرة أخرى، أو اطرح السؤال بطريقة أخرى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence kunne ikke svare på det. Prøv igen, eller spørg på en anden måde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence konnte darauf nicht antworten. Versuch es erneut oder frag anders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence no ha podido responder. Inténtalo de nuevo o pregúntalo de otra forma."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence ei pystynyt vastaamaan. Yritä uudelleen tai kysy toisin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence n'a pas pu répondre. Réessayez ou formulez autrement."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence gat ekki svarað þessu. Reyndu aftur eða spurðu á annan hátt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence non è riuscita a rispondere. Riprova o chiedilo in un altro modo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence はその質問に答えられませんでした。もう一度試すか、別の聞き方をしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence가 답변하지 못했습니다. 다시 시도하거나 다른 방식으로 질문해 보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence kunne ikke svare på det. Prøv igjen, eller spør på en annen måte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence kon dit niet beantwoorden. Probeer het opnieuw of stel je vraag anders."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Apple Intelligence não conseguiu responder. Tente de novo ou pergunte de outro jeito."
          }
        },
        "ru" : {
