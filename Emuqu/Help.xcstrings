    "Width of the cloud. Captures rapid beat-to-beat variation — mathematically equivalent to RMSSD/√2. This is your parasympathetic signature." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
