   "hash": "095aa91d48c9dfa6",
   "does": "Mirrors ScoreBreakdownCopy's 'Go hard' conditions: true only when the rounded composite >= 90, no penalties, no baseline drift (gapFromFactors <= 5), every weighted factor >= 60, and the HRV factor >= 72 unless HRV is the only weighted factor.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Analysis/RecoveryScoreCalculator.swift::var RecoveryScoreCalculator.ScoreBreakdown.gapFromFactors"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "rounded composite < 90, any penalty, or gapFromFactors > 5",
     "effect": "false"
    },
    {
     "at": "+4",
     "cond": "a weighted factor < 60",
     "effect": "false"
    },
    {
     "at": "+6",
     "cond": "weighted HRV factor < 72 and other weighted factors exist",
     "effect": "false; otherwise true"
    }
   ],
