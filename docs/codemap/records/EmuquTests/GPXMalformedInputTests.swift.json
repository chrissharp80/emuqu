   "flags": [
    {
     "kind": "test-defect",
     "sev": "med",
     "text": "Only one-point tracks are encoded, so the delta step is never exercised: scaledInt saturates huge finite values to Int.max/Int.min, and the following `scaled - prev` / `lat - prevLat` subtraction traps on overflow when consecutive points saturate in opposite directions (e.g. altitudes [-greatestFiniteMagnitude, +greatestFiniteMagnitude]); the 'encoder cannot crash regardless of what reaches it' claim is untested and false. Also `scaled <= Double(Int.max)` admits exactly 2^63, which Int() traps on.",
     "evidence": [
      "EmuquTests/GPXMalformedInputTests.swift:79",
      "Emuqu/Sources/Analysis/WorkoutAnalyzer.swift:719",
      "Emuqu/Sources/Analysis/WorkoutAnalyzer.swift:732",
      "Emuqu/Sources/Analysis/WorkoutAnalyzer.swift:745"
     ],
     "found": "first read, upheld on second"
    }
   ],
   "deps": {
    "Emuqu/Sources/Analysis/WorkoutAnalyzer.swift::func WorkoutAnalyzer.encodePolyline(track:)": "f42191bee7fea21e"
   }
  },
