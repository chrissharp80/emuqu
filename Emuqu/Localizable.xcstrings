        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare puls i sanntid + sykkelwatt i sanntid, og bare mens økten pågår."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen live hartslag + live fietsvermogen, en alleen tijdens de training."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas a FC ao vivo + a potência de ciclismo ao vivo, e apenas enquanto o treino estiver ativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только текущий пульс + текущая мощность и только во время тренировки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara puls i realtid + cykeleffekt i realtid, och bara medan passet pågår."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅发送实时心率 + 实时骑行功率，且仅在体能训练进行期间。"
          }
        }
      }
    },
    "Open Flo on your iPhone once to turn on voice chat." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح Flo على iPhone مرة واحدة لتفعيل الدردشة الصوتية."
