  {
   "key": "func EmuquApp.claimRecovery(_:)",
   "hash": "c657be3da06a41ea",
   "does": "Within one overall limit (autoRecoveryWaitLimit, 150 s from the first call): waits for launch auto-recovery of the session for what is left of the limit (savedByAutoRecovery) and returns its saved message when it archived it; otherwise claims the session (InterruptedWorkoutAutoRecovery.claim) and returns nil, the caller then recovering it and releasing the claim. When auto-recovery claimed it between the wait and the claim, waits again for the time left. Once the limit has passed with auto-recovery still holding the session, returns a message that the workout is still being recovered in the background and where to recover it if it does not appear; nothing else rebuilds it.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Services/AppLaunchRecovery.swift::func EmuquApp.savedByAutoRecovery(_:waitingAtMost:)",
    "Emuqu/Sources/Collection/RRCollector+BackupRecovery.swift::func InterruptedWorkoutAutoRecovery.claim(_:)",
    "Emuqu/Sources/Services/LanguageManager.swift::var LanguageManager.bundle"
   ],
   "reads": [
    "mem:InterruptedWorkoutAutoRecovery.running",
    "archive:SessionArchive.exists"
   ],
   "writes": [
    "mem:InterruptedWorkoutAutoRecovery.running",
    "ud:UserDefaultsKeys.persistedRecordingState (cleared when auto-recovery saved it)"
   ],
   "branches": [
    {
     "at": "+4",
     "cond": "auto-recovery saved it",
     "effect": "return the saved message"
    },
    {
     "at": "+5",
     "cond": "claim succeeded",
     "effect": "return nil"
    },
    {
     "at": "+6",
     "cond": "the overall limit has passed (claim failed: auto-recovery still holds it)",
     "effect": "return the still-being-recovered message; else loop and wait again for the time left"
    }
   ],
   "deps": {
    "Emuqu/Sources/Collection/RRCollector+BackupRecovery.swift::func InterruptedWorkoutAutoRecovery.claim(_:)": "6034523983edd0aa",
    "Emuqu/Sources/Services/AppLaunchRecovery.swift::func EmuquApp.savedByAutoRecovery(_:waitingAtMost:)": "f7fdc6b23f79844f",
    "Emuqu/Sources/Services/LanguageManager.swift::var LanguageManager.bundle": "3599ff0cc93f0144"
   }
  },
