    "Efficiency factor %@ — strong pace-per-beat output, aerobic economy in good shape." : {
      "comment" : "\"Efficiency factor\" is a term used in some sports to describe how efficiently a person is using their heart rate to produce work. A value above 1.0 generally indicates that the person is using their heart rate The argument is the string “%.2f”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عامل الكفاءة %@ — إنتاج قوي للوتيرة لكل نبضة، والاقتصاد الهوائي في حالة جيدة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effektivitetsfaktor %@ — stærk fart per slag, den aerobe økonomi er i god form."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effizienzfaktor %@ — starke Pace pro Schlag, die aerobe Ökonomie ist in guter Form."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Factor de eficiencia %@ — buen ritmo por latido, la economía aeróbica está en buena forma."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tehokkuuskerroin %@ — vahva vauhti per lyönti, aerobinen taloudellisuus hyvässä kunnossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facteur d’efficacité %@ — bonne allure par battement, l’économie aérobie est en forme."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skilvirknistuðull %@ — sterkur hraði á hvert slag, loftháð hagkvæmni í góðu formi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fattore di efficienza %@ — buon passo per battito, l’economia aerobica è in forma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "効率係数 %@ — 1 拍あたりのペース出力が高く、有酸素エコノミーは良好です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "효율 지수 %@ — 박동당 페이스 출력이 좋고 유산소 경제성이 양호합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effektivitetsfaktor %@ — sterk fart per slag, den aerobe økonomien er i god form."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efficiëntiefactor %@ — sterk tempo per hartslag, de aerobe economie is in goede vorm."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fator de eficiência %@ — bom ritmo por batimento, a economia aeróbia está em boa forma."
          }
        },
        "ru" : {
