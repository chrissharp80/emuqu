    "Higher is better. R² > 0.95 indicates reliable α1 measurement. Lower values suggest noisy data or artifacts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأعلى أفضل. R² > 0.95 يدل على قياس α1 موثوق. القيم الأدنى توحي ببيانات مشوّشة أو تشوّهات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
