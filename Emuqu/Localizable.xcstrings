    "Active. Refuses AFib / arrhythmia / symptom queries before any provider call." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نشط. يرفض الاستفسارات عن AFib/اضطراب النظم/الأعراض قبل أي اتصال بمزوّد."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiv. Afviser forespørgsler om AFib/arytmi/symptomer før ethvert kald til en udbyder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiv. Lehnt Anfragen zu AFib/Arrhythmie/Symptomen ab, bevor ein Anbieter kontaktiert wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activo. Rechaza consultas sobre AFib/arritmia/síntomas antes de cualquier llamada a un proveedor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiivinen. Kieltäytyy AFib-/rytmihäiriö-/oirekyselyistä ennen mitään palveluntarjoajan kutsua."
          }
        },
