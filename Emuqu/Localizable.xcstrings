    "Moderate — could benefit from more deep sleep (avoid alcohol, screen time before bed)" : {
      "comment" : "Text describing a moderate level of deep sleep, suggesting that more deep sleep might be beneficial.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوسط — قد يستفيد من نوم عميق أكثر (تجنّب الكحول والشاشات قبل النوم)"
