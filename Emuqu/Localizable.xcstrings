    "A reading from the same time is already in your history, so this one wasn't saved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توجد قراءة من الوقت نفسه في سجلك بالفعل، لذا لم يتم حفظ هذه القراءة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der findes allerede en måling fra samme tidspunkt i din historik, så denne blev ikke gemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Messung vom selben Zeitpunkt ist bereits in deinem Verlauf, daher wurde diese nicht gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya hay una lectura de la misma hora en tu historial, así que esta no se guardó."
