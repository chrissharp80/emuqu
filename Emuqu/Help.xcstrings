        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viimeaikainen harjoittelu vastaa pidemmän aikavälin pohjaasi. Kestävällä alueella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’entraînement récent est en ligne avec votre base à long terme. Zone soutenable."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nýlegar æfingar eru í samræmi við langtímagrunninn þinn. Sjálfbært svæði."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'allenamento recente è in linea con la tua base a lungo termine. Territorio sostenibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近のトレーニングは長期的な土台と釣り合っています。持続可能な範囲です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 훈련이 장기 기반과 비슷합니다. 지속 가능한 영역입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nylig trening er i tråd med det langsiktige grunnlaget ditt. Bærekraftig område."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je recente training past bij je basis op langere termijn. Houdbaar terrein."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O treino recente está alinhado com sua base de longo prazo. Território sustentável."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недавние тренировки соответствуют вашей долгосрочной базе. Устойчивая зона."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den senaste träningen ligger i linje med din långsiktiga bas. Hållbart läge."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近期训练与你的长期基础相当。处于可持续的范围。"
          }
        }
      }
    },
    "Recent training is lower than your fitness base. Could be a taper, a rest week, illness, or natural variation." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التدريب الحديث أقل من قاعدة لياقتك. قد تكون فترة تخفيف أو أسبوع راحة أو مرضًا أو تفاوتًا طبيعيًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nylig træning er lavere end dit formgrundlag. Kan være en nedtrapning, en hvileuge, sygdom eller naturlig variation."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein jüngstes Training liegt unter deiner Fitnessbasis. Das kann ein Tapering, eine Erholungswoche, Krankheit oder eine natürliche Schwankung sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El entrenamiento reciente es menor que tu base de forma física. Puede ser una puesta a punto, una semana de descanso, una enfermedad o variación natural."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viimeaikainen harjoittelu on kuntopohjaasi kevyempää. Voi olla keventely, lepoviikko, sairaus tai luonnollista vaihtelua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’entraînement récent est inférieur à votre base de forme. Il peut s’agir d’un affûtage, d’une semaine de repos, d’une maladie ou d’une variation naturelle."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nýlegar æfingar eru minni en þrekgrunnurinn þinn. Gæti verið niðurtröppun, hvíldarvika, veikindi eða eðlileg sveifla."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'allenamento recente è inferiore alla tua base di forma. Può essere uno scarico, una settimana di riposo, una malattia o una variazione naturale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近のトレーニングが体力の土台を下回っています。テーパー、休養週、体調不良、または自然な変動の可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 훈련이 체력 기반보다 적습니다. 테이퍼, 휴식 주간, 질병, 또는 자연스러운 변동일 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nylig trening er lavere enn formgrunnlaget ditt. Kan være nedtrapping, en hvileuke, sykdom eller naturlig variasjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je recente training is lager dan je fitheidsbasis. Kan een taperperiode, een rustweek, ziekte of natuurlijke variatie zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O treino recente está abaixo da sua base de condicionamento. Pode ser um polimento, uma semana de descanso, doença ou variação natural."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Недавние тренировки ниже вашей базы. Это может быть снижение нагрузки перед стартом, неделя отдыха, болезнь или естественные колебания."
          }
        },
        "sv" : {
          "stringUnit" : {
