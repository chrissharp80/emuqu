    "drifted %@%% higher for the same pace — could be fueling, heat, or just a long day. Easing off for a bit is an option." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انجرف النبض أعلى بـ %@%% للسرعة نفسها — قد يكون السبب التغذية أو الحرارة أو مجرد يوم طويل. التخفيف قليلًا خيار متاح."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%% højere ved samme tempo — det kan være energi, varme eller bare en lang dag. Du kan godt sætte lidt ned et stykke tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei gleichem Tempo %@%% höher — vielleicht Verpflegung, Hitze oder einfach ein langer Tag. Etwas Tempo rauszunehmen ist eine Option."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un %@%% más alta al mismo ritmo — puede ser la alimentación, el calor o simplemente un día largo. Aflojar un poco es una opción."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%% korkeampi samalla vauhdilla — syynä voi olla tankkaus, kuumuus tai vain pitkä päivä. Voit hellittää hetkeksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "a dérivé de %@%% à la hausse pour la même allure — peut-être l'alimentation, la chaleur ou simplement une longue journée. Lever un peu le pied est une option."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%% hærri á sama hraða — gæti verið næring, hiti eða bara langur dagur. Það er möguleiki að slaka aðeins á."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più alta del %@%% allo stesso ritmo — forse alimentazione, caldo o solo una lunga giornata. Rallentare un po' è un'opzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じペースで %@%% 上昇しています — 補給、暑さ、あるいは単に長い一日のせいかもしれません。少し緩めるのも一つの手です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "같은 페이스에서 %@%% 더 높아졌습니다 — 보급, 더위, 아니면 그냥 긴 하루 때문일 수 있어요. 잠시 늦추는 것도 방법입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%% høyere i samme tempo — kan være energiinntak, varme eller bare en lang dag. Du kan godt roe ned en stund."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%% hoger bij hetzelfde tempo — kan voeding zijn, warmte, of gewoon een lange dag. Even gas terugnemen kan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%% mais alta para o mesmo ritmo — pode ser alimentação, calor ou só um dia longo. Aliviar um pouco é uma opção."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "на %@%% выше при том же темпе — может быть питание, жара или просто долгий день. Можно немного сбавить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@%% högre i samma tempo — det kan vara energiintaget, värmen eller bara en lång dag. Du kan ta det lite lugnare en stund."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同样配速下高了 %@%% — 可能是补给、炎热，或只是漫长的一天。可以考虑放松一会儿。"
          }
        }
      }
    },
