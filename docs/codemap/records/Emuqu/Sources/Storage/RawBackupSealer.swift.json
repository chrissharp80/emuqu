    "ext:Data.write",
    "Emuqu/Sources/Storage/PendingEncryptionLedger.swift::func PendingEncryptionLedger.clear(_:in:)"
   ],
   "reads": [
    "ud:storage.pendingReencryption.rawBackupIDs"
   ],
   "writes": [
    "file:RRBackup/<uuid>_<ms>.json",
    "ud:storage.pendingReencryption.rawBackupIDs",
    "file:Application Support/PendingEncryption/<store key>.json (no file protection)"
   ],
   "branches": [
    {
     "at": "+3",
     "cond": "not encrypted",
     "effect": "ledger.record before the write"
    },
    {
     "at": "+4",
     "cond": "encoded.encrypted",
     "effect": "true: BackupProtection.appendable; false: BackupProtection.plaintext"
    },
    {
     "at": "+7",
     "cond": "write throws",
     "effect": "id not pending before: ledger.clear; pending before: left queued; rethrow"
    },
    {
     "at": "+10",
     "cond": "encrypted and written",
     "effect": "ledger.clear"
    }
   ],
