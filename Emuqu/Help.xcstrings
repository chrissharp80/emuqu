          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När du har minst en signal för vitala tecken (andningsfrekvens, handledstemperatur eller syremättnad). De sammansatta vikterna är HRV 60 %, Sömn 25 % och Vitala tecken 15 %."
          }
