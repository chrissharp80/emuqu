    "Power in the high frequency band, strongly associated with parasympathetic (vagal) activity and respiratory sinus arrhythmia." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القدرة في النطاق عالي التردد، وترتبط بقوة بالنشاط نظير الودي (المبهمي) واضطراب النظم الجيبي التنفسي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effekten i højfrekvensbåndet, stærkt forbundet med parasympatisk (vagal) aktivitet og respiratorisk sinusarytmi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leistung im Hochfrequenzband, stark mit parasympathischer (vagaler) Aktivität und respiratorischer Sinusarrhythmie verknüpft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potencia en la banda de alta frecuencia, muy asociada a la actividad parasimpática (vagal) y a la arritmia sinusal respiratoria."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teho korkeataajuuskaistalla, vahvasti yhteydessä parasympaattiseen (vagaaliseen) aktiivisuuteen ja hengityksen sinusarytmiaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puissance dans la bande haute fréquence, fortement associée à l’activité parasympathique (vagale) et à l’arythmie sinusale respiratoire."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afl í hátíðnibandi, sterklega tengt sefkerfisvirkni (vagus) og öndunartengdri sínustruflun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potenza nella banda ad alta frequenza, fortemente associata all’attività parasimpatica (vagale) e all’aritmia sinusale respiratoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高周波帯のパワー。副交感神経（迷走神経）活動および呼吸性洞性不整脈と強く関連します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고주파 대역의 파워. 부교감(미주) 활동 및 호흡성 동성 부정맥과 밀접히 연관됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effekt i høyfrekvensbåndet, sterkt knyttet til parasympatisk (vagal) aktivitet og respiratorisk sinusarytmi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermogen in de hoogfrequente band, sterk geassocieerd met parasympathische (vagale) activiteit en respiratoire sinusaritmie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potência na banda de alta frequência, fortemente associada à atividade parassimpática (vagal) e à arritmia sinusal respiratória."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мощность в высокочастотном диапазоне, тесно связанная с парасимпатической (вагусной) активностью и дыхательной синусовой аритмией."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effekt i högfrekvensbandet, starkt kopplad till parasympatisk (vagal) aktivitet och respiratorisk sinusarytmi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高频带的功率，与副交感（迷走）活动及呼吸性窦性心律不齐密切相关。"
          }
        }
      }
    },
    "Power in the low frequency band. Reflects a mix of sympathetic and parasympathetic activity, including baroreceptor activity." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القدرة في النطاق منخفض التردد. تعكس مزيجًا من النشاط الودي ونظير الودي، بما في ذلك نشاط مستقبلات الضغط."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effekten i lavfrekvensbåndet. Afspejler en blanding af sympatisk og parasympatisk aktivitet, herunder baroreceptoraktivitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leistung im Niederfrequenzband. Spiegelt eine Mischung aus sympathischer und parasympathischer Aktivität wider, einschließlich Barorezeptoraktivität."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potencia en la banda de baja frecuencia. Refleja una mezcla de actividad simpática y parasimpática, incluida la de los barorreceptores."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teho matalataajuuskaistalla. Heijastaa sympaattisen ja parasympaattisen aktiivisuuden sekoitusta, mukaan lukien baroreseptoritoiminta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puissance dans la bande basse fréquence. Reflète un mélange d’activité sympathique et parasympathique, y compris l’activité barorécepteur."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afl í lágtíðnibandi. Endurspeglar blöndu drif- og sefkerfisvirkni, þar með talið virkni þrýstinema."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potenza nella banda a bassa frequenza. Riflette un mix di attività simpatica e parasimpatica, inclusa quella dei barocettori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低周波帯のパワー。圧受容器の活動を含む、交感神経と副交感神経の混合した活動を反映します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저주파 대역의 파워. 압수용체 활동을 포함해 교감과 부교감 활동이 섞인 상태를 반영합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effekt i lavfrekvensbåndet. Gjenspeiler en blanding av sympatisk og parasympatisk aktivitet, inkludert baroreseptoraktivitet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermogen in de laagfrequente band. Weerspiegelt een mix van sympathische en parasympathische activiteit, inclusief baroreceptoractiviteit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potência na banda de baixa frequência. Reflete uma mistura de atividade simpática e parassimpática, incluindo a dos barorreceptores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мощность в низкочастотном диапазоне. Отражает смесь симпатической и парасимпатической активности, включая барорецепторную."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effekt i lågfrekvensbandet. Speglar en blandning av sympatisk och parasympatisk aktivitet, inklusive baroreceptoraktivitet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低频带的功率。反映交感与副交感活动的混合，包括压力感受器活动。"
          }
        }
      }
    },
    "Power in the very low frequency band. Associated with thermoregulation, hormonal fluctuations, and long-term regulatory mechanisms." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القدرة في النطاق منخفض التردد جدًا. ترتبط بتنظيم الحرارة والتقلبات الهرمونية وآليات التنظيم طويلة المدى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effekten i det meget lave frekvensbånd. Forbundet med termoregulering, hormonelle udsving og langsigtede reguleringsmekanismer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leistung im sehr niedrigen Frequenzband. Verbunden mit Thermoregulation, hormonellen Schwankungen und langfristigen Regulationsmechanismen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potencia en la banda de muy baja frecuencia. Asociada a la termorregulación, las fluctuaciones hormonales y los mecanismos reguladores a largo plazo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teho hyvin matalan taajuuden kaistalla. Liittyy lämmönsäätelyyn, hormonaalisiin vaihteluihin ja pitkän aikavälin säätelymekanismeihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puissance dans la bande de très basse fréquence. Associée à la thermorégulation, aux fluctuations hormonales et aux mécanismes de régulation à long terme."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afl í mjög lágtíðnibandi. Tengt hitastjórnun, hormónasveiflum og langtíma stjórnkerfum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potenza nella banda a frequenza molto bassa. Associata a termoregolazione, fluttuazioni ormonali e meccanismi regolatori a lungo termine."
