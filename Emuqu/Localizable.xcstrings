    "No strap paired to Watch — workout will start but HR may rely on the wrist sensor" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد حزام مُقترن بالساعة — سيبدأ التمرين لكن قد يعتمد النبض على مستشعر المعصم"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen rem parret med uret — træningen starter, men pulsen kan komme fra håndledssensoren"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Gurt mit der Watch gekoppelt — das Training startet, die Herzfrequenz kommt aber evtl. vom Handgelenkssensor"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguna banda emparejada al reloj: el entrenamiento empezará, pero la FC puede venir del sensor de muñeca"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kelloon ei ole paritettu vyötä — harjoitus alkaa, mutta syke voi tulla rannemittarista"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune ceinture associée à la montre — la séance démarrera, mais la FC pourra venir du capteur au poignet"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
