    "Recording continues without heart rate. Move the strap closer to the phone or replace the battery." : {
      "comment" : "A description of what happens when a user's fitness tracker (e.g. Apple Watch) is disconnected mid-workout.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستمر عملية التسجيل دون معدل ضربات القلب. قرِّب الحزام من الهاتف أو استبدل البطارية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optagelsen fortsætter uden puls. Flyt remmen tættere på telefonen, eller udskift batteriet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufzeichnung wird ohne Herzfrequenz fortgesetzt. Bringe den Gurt näher ans Telefon oder tausche die Batterie aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación continúa sin frecuencia cardíaca. Acerca la banda al teléfono o cambia la pila."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennus jatkuu ilman sykettä. Siirrä panta lähemmäs puhelinta tai vaihda paristo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enregistrement se poursuit sans fréquence cardiaque. Rapprochez la ceinture du téléphone ou remplacez la pile."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upptaka heldur áfram án hjartsláttar. Færðu beltið nær símanum eða skiptu um rafhlöðu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione continua senza frequenza cardiaca. Avvicina la fascia al telefono o sostituisci la batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心拍数なしで記録を続けています。ストラップを携帯電話に近づけるか、電池を交換してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심박수 없이 기록을 계속합니다. 스트랩을 휴대폰에 더 가까이 두거나 배터리를 교체하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opptaket fortsetter uten puls. Flytt beltet nærmere telefonen eller bytt batteriet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opname gaat door zonder hartslag. Breng de band dichter bij de telefoon of vervang de batterij."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação continua sem frequência cardíaca. Aproxime a cinta do telefone ou troque a bateria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись продолжается без пульса. Поднесите ремень ближе к телефону или замените батарейку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inspelningen fortsätter utan puls. Flytta bandet närmare telefonen eller byt batteri."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录将在没有心率的情况下继续。请将心率带靠近手机或更换电池。"
          }
        }
      }
    },
