    "Type **%@** below to unlock the delete button." : {
      "comment" : "A prompt below the text field that asks the user to type a magic phrase to trigger the data purge action",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب **%@** أدناه لإلغاء قفل زر الحذف."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriv **%@** nedenfor for at låse sletteknappen op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib unten **%@** ein, um die Löschen-Schaltfläche freizugeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe **%@** abajo para desbloquear el botón de eliminar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoita **%@** alle avataksesi poistopainikkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapez **%@** ci-dessous pour déverrouiller le bouton de suppression."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sláðu inn **%@** hér að neðan til að opna fyrir eyða-hnappinn."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita **%@** qui sotto per sbloccare il pulsante di eliminazione."
          }
        },
        "ja" : {
