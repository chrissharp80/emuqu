   "key": "func WorkoutRecoveryService.trimTrailingRest(_:)",
   "hash": "0a7352054cc51933",
   "does": "Splits beats into 20-beat windows of mean HR, takes the 10th/90th percentile as rest/peak, and when peak−rest >= 10 bpm and at least 4 windows after the last window at/above rest+35% of the range fall below it, cuts the beats at two windows past the last active window.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Services/WorkoutRecoveryService.swift::func WorkoutRecoveryService.windowedHeartRates(_:windowBeats:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "points.count <= 160",
     "effect": "return points untouched"
    },
    {
     "at": "+5",
     "cond": "<= 8 windows with HR > 0",
     "effect": "return points untouched"
    },
    {
     "at": "+8",
     "cond": "peakHR - restHR < 10",
     "effect": "return points (too flat)"
    },
    {
     "at": "+11",
     "cond": "window hr >= threshold",
     "effect": "records idx as lastActiveWindow (loop)"
    },
    {
     "at": "+12",
     "cond": "no active window, or last window is active",
     "effect": "return points"
    },
    {
     "at": "+13",
     "cond": "fewer than 4 windows after the last active one",
     "effect": "return points; else truncate to (lastActive+3)*20 beats"
    }
   ],
