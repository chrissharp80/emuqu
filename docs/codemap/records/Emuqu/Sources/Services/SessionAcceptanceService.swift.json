   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+9",
     "cond": "baselineStats nil",
     "effect": "baselineRmssd = 0 (so every RMSSD-below-baseline rule is false)"
    },
    {
     "at": "+10",
     "cond": "insufficientDataDecision returned a decision",
     "effect": "true: return .insufficient; false: continue"
    },
    {
     "at": "+13",
