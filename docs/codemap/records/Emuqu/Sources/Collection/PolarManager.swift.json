  {
   "key": "func PolarManager.applyFirmwareRevisionUpdate(from:uuid:value:)",
   "hash": "ed4fdfc7d95cd3c5",
   "does": "Applies a DIS revision callback from the active device: software revision (2A28) always wins and latches hasReceivedSoftwareRevision; firmware revision (2A26) is used only until a software revision has arrived; other UUIDs ignored.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Collection/PolarManager.swift::func PolarManager.setFirmwareVersion(_:label:)",
    "Emuqu/Sources/Collection/PolarManager.swift::func PolarManager.isActiveDeviceInfoSource(_:)"
   ],
   "reads": [
    "mem:PolarManager.connectedDeviceId",
    "mem:PolarManager.hasReceivedSoftwareRevision"
   ],
   "writes": [
    "mem:PolarManager.firmwareVersion",
    "mem:PolarManager.hasReceivedSoftwareRevision"
   ],
   "branches": [
    {
     "at": "+2",
     "cond": "callback identifier is not the connected device",
     "effect": "return, nothing applied"
    },
    {
     "at": "+3",
     "cond": "uuid == 2A28 (software revision)",
     "effect": "set firmwareVersion, latch hasReceivedSoftwareRevision=true, return"
    },
    {
     "at": "+8",
     "cond": "uuid == 2A26 and no software revision yet",
     "effect": "true → set firmwareVersion as fallback; false (other UUID or software already received) → return"
    }
   ],
   "deps": {
    "Emuqu/Sources/Collection/PolarManager.swift::func PolarManager.isActiveDeviceInfoSource(_:)": "adbf9f7d75365ac4",
    "Emuqu/Sources/Collection/PolarManager.swift::func PolarManager.setFirmwareVersion(_:label:)": "d7cc82132c078fb6"
   }
  },
