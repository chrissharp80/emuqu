          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0,75–1,0: het referentiebereik in rust van de app, waar de meeste rustmetingen liggen. 0,60–0,75: daaronder. ~0,5: intervallen bijna ongecorreleerd. >1,0: sterker gecorreleerd dan het bereik — bij stress en bij langzaam ademen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
