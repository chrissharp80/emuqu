   "key": "func WorkoutZoneBreakdown.compute(samples:userMaxHR:)",
   "hash": "61dca7ae4cf225ef",
   "does": "Bins each sample's time delta (offset minus previous offset, first sample measured from 0) into the HR zone of that sample (fraction of userMaxHR); samples without HR or below 50 % max add nothing. Returns per-zone seconds, total, and the zone with the most seconds; on a tie the LOWER zone wins because Sequence.max(by:) keeps the first maximal element.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Analysis/WorkoutLiveTrends.swift::func WorkoutZoneBreakdown.zoneIndex(fractionOfMax:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "userMaxHR <= 0 or samples empty",
     "effect": "return .empty"
    },
    {
     "at": "+4",
     "cond": "for each sample",
     "effect": "accumulate dt=max(0,offset-prev)"
    },
    {
     "at": "+7",
     "cond": "sample has no HR or zoneIndex nil (<50 % max)",
     "effect": "skip sample; its time not binned"
    },
    {
     "at": "+16",
     "cond": "total > 0",
     "effect": "dominantZone = 1-based index of max bin; else nil"
    }
   ],
   "deps": {
