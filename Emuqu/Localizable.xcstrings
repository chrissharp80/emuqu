    "Recovery or warm-up effort. Zone 1 builds aerobic base without fatigue cost." : {
      "comment" : "Plain-English interpretation of a workout zone, describing its nature and physiological impact.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جهد تعافٍ أو إحماء. تبني المنطقة 1 القاعدة الهوائية دون كلفة إرهاق."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restitutions- eller opvarmningsindsats. Zone 1 bygger aerob base uden træthedsomkostning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholungs- oder Aufwärmbelastung. Zone 1 baut die aerobe Basis ohne Ermüdungskosten auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esfuerzo de recuperación o calentamiento. La Zona 1 construye base aeróbica sin coste de fatiga."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palautus- tai lämmittelyvauhti. Alue 1 rakentaa aerobista pohjaa ilman väsymyskustannusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effort de récupération ou d’échauffement. La Zone 1 construit la base aérobie sans coût de fatigue."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurheimtar- eða upphitunarátak. Svæði 1 byggir loftháðan grunn án þreytukostnaðar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sforzo di recupero o riscaldamento. La Zona 1 costruisce base aerobica senza costo di fatica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復またはウォームアップ強度。ゾーン 1 は疲労コストなしで有酸素ベースを築きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복 또는 워밍업 강도. 존1은 피로 비용 없이 유산소 기초를 쌓습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restitusjons- eller oppvarmingsinnsats. Sone 1 bygger aerob base uten trettehetskostnad."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herstel- of warming-up-inspanning. Zone 1 bouwt aerobe basis zonder vermoeidheidskosten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esforço de recuperação ou aquecimento. A Zona 1 constrói base aeróbia sem custo de fadiga."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Восстановительное или разминочное усилие. Зона 1 строит аэробную базу без цены усталости."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återhämtnings- eller uppvärmningsinsats. Zon 1 bygger aerob bas utan trötthetskostnad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复或热身强度。一区在不增加疲劳成本的情况下打造有氧基础。"
          }
        }
      }
    },
