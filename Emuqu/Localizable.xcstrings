    "Climb ahead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صعود قادم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stigning forude."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anstieg voraus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subida a la vista."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nousu edessä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montée en vue."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brekka fram undan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salita in arrivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この先、登りです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오르막이 다가옵니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stigning foran."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klim in aantocht."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subida à frente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Впереди подъём."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backe framför."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前方有爬坡。"
          }
        }
      }
    },
    "Climb in %@ — %@ at about %@. First of %lld. Save some power." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صعود بعد %@ — %@ بنحو %@. الأول من %lld. وفّر بعض القوة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stigning om %@ — %@ på omkring %@. Den første af %lld. Spar på kræfterne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anstieg in %@ — %@ mit etwa %@. Der erste von %lld. Spar dir etwas Kraft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subida en %@ — %@ a aproximadamente %@. La primera de %lld. Guarda fuerzas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nousu %@ päästä — %@, noin %@. Ensimmäinen %lld:stä. Säästä voimia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montée dans %@ — %@ à environ %@. La première sur %lld. Gardez des forces."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brekka eftir %@ — %@ með um %@. Sú fyrsta af %lld. Sparaðu orku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salita tra %@ — %@ a circa %@. La prima di %lld. Risparmia energie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 先で登り — %@、約 %@。%lld 本中の最初です。力を温存して。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 후 오르막 — %@, 약 %@. %lld개 중 첫 번째. 힘을 아껴 두세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stigning om %@ — %@ på omtrent %@. Den første av %lld. Spar litt krefter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klim over %@ — %@ van ongeveer %@. De eerste van %lld. Spaar wat kracht."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subida em %@ — %@ com cerca de %@. A primeira de %lld. Poupe um pouco de força."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подъём через %@ — %@, около %@. Первый из %lld. Поберегите силы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backe om %@ — %@ på ungefär %@. Den första av %lld. Spara lite kraft."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 后爬坡 — %@，约 %@。共 %lld 段中的第一段。留点力气。"
          }
        }
      }
    },
