    "Slightly slow — consider sleep hygiene adjustments" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بطيء قليلًا — فكّر في تعديل عادات النوم"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lidt langsomt — overvej at justere dine søvnvaner"
