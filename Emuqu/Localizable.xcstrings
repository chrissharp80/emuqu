        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokaisesta viimeaikaisesta yöstä on jo tallennus, joten esimerkkiöitä ei lisätty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque nuit récente a déjà un enregistrement : aucune nuit d’exemple n’a donc été ajoutée."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allar nýlegar nætur eru þegar með upptöku, svo engum sýninóttum var bætt við."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni notte recente ha già una registrazione, quindi non è stata aggiunta nessuna notte di esempio."
