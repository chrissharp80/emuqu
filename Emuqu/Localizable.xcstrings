        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "— nuku lisää parantaaksesi sitä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "— retournez dormir pour l'améliorer"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "— farðu aftur að sofa til að bæta það"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "— tornare a dormire per migliorarlo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "— もう一度眠って改善しましょう"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "— 개선하려면 다시 잠드세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "— legg deg igjen for å forbedre det"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "— ga terug slapen om het te verbeteren"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "— volte a dormir para melhorar"
          }
        },
        "ru" : {
          "stringUnit" : {
