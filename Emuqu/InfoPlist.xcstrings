        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 시트에서 이미지 저장을 선택하면 Emuqu가 회복 요약 또는 운동 요약 이미지를 사진 보관함에 저장합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu lagrer et restitusjons- eller øktsammendrag som bilde i bildebiblioteket ditt når du velger Lagre bilde i delingsarket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu bewaart een herstel- of trainingsoverzicht als afbeelding in je fotobibliotheek wanneer je in het deelmenu Bewaar afbeelding kiest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Emuqu salva um resumo de recuperação ou de treino como imagem na sua fototeca quando você escolhe Salvar Imagem na planilha de compartilhamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu сохраняет сводку восстановления или тренировки в виде изображения в вашей медиатеке, когда вы выбираете «Сохранить изображение» в меню «Поделиться»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu sparar en återhämtnings- eller passammanfattning som bild i ditt bildbibliotek när du väljer Spara bild i delningsbladet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你在共享表单中选择“存储图像”时，Emuqu 会将恢复概览或运动总结图片保存到你的照片图库。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Emuqu التعرّف على الكلام لتحويل أسئلتك الصوتية إلى مساعد الذكاء الاصطناعي إلى نص. نستخدم التعرّف على الجهاز كلما دعمه جهازك ولغتك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu bruger talegenkendelse til at omsætte dine stemmespørgsmål til AI-assistenten til tekst. Vi bruger genkendelse på enheden, når din enhed og dit sprog understøtter det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu verwendet Spracherkennung, um deine gesprochenen Fragen an den KI-Assistenten zu transkribieren. Wir nutzen die Erkennung auf dem Gerät, wann immer dein Gerät und deine Sprache sie unterstützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Emuqu uses speech recognition to transcribe your voice questions to the AI Assistant. We use on-device recognition whenever your device and language support it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu usa el reconocimiento de voz para transcribir tus preguntas habladas al asistente de IA. Usamos el reconocimiento en el dispositivo siempre que tu dispositivo y tu idioma lo admiten."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu käyttää puheentunnistusta tekoälyavustajalle esittämiesi puhuttujen kysymysten litterointiin. Käytämme laitteella tapahtuvaa tunnistusta aina, kun laitteesi ja kielesi tukevat sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu utilise la reconnaissance vocale pour transcrire vos questions orales à l’assistant IA. Nous utilisons la reconnaissance sur l’appareil chaque fois que votre appareil et votre langue la prennent en charge."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu notar talgreiningu til að umrita raddspurningar þínar til gervigreindaraðstoðarinnar. Við notum greiningu í tækinu hvenær sem tækið þitt og tungumálið styðja hana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu usa il riconoscimento vocale per trascrivere le tue domande vocali all’assistente IA. Usiamo il riconoscimento sul dispositivo ogni volta che il tuo dispositivo e la tua lingua lo supportano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu は、AI アシスタントへの音声での質問を文字に起こすために音声認識を使用します。デバイスと言語が対応している場合は、常にデバイス上での認識を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu는 AI 어시스턴트에게 음성으로 한 질문을 텍스트로 변환하기 위해 음성 인식을 사용합니다. 기기와 언어가 지원하는 경우 항상 기기 내 인식을 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu bruker talegjenkjenning til å transkribere talespørsmålene dine til AI-assistenten. Vi bruker gjenkjenning på enheten når enheten og språket ditt støtter det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu gebruikt spraakherkenning om je gesproken vragen aan de AI-assistent uit te schrijven. We gebruiken herkenning op het apparaat wanneer je apparaat en taal dat ondersteunen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Emuqu usa o reconhecimento de fala para transcrever suas perguntas faladas ao assistente de IA. Usamos o reconhecimento no dispositivo sempre que seu dispositivo e idioma são compatíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu использует распознавание речи, чтобы расшифровывать ваши голосовые вопросы ИИ-ассистенту. Мы используем распознавание на устройстве всякий раз, когда его поддерживают ваше устройство и язык."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu använder taligenkänning för att transkribera dina röstfrågor till AI-assistenten. Vi använder igenkänning på enheten när din enhet och ditt språk stöder det."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
