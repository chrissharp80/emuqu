   "key": "def _spline_resample",
   "hash": "61b35886b5e35ab0",
   "does": "Natural cubic spline resampling of (t, v) onto count samples at fs from t_start (Thomas algorithm for second derivatives); linear interpolation for 2 points, constant for <2.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "fewer than 2 points",
     "effect": "constant v[0] (0 if empty)"
    },
    {
     "at": "+4",
     "cond": "exactly 2 points",
     "effect": "linear interpolation"
    },
    {
     "at": "+6",
     "cond": "for each output sample (2-point path)",
     "effect": "interpolate"
    },
    {
     "at": "+8",
     "cond": "t1 > t0",
     "effect": "fraction else 0"
    },
    {
     "at": "+13",
     "cond": "for each interval",
     "effect": "slopes"
    },
    {
     "at": "+15",
     "cond": "h > 0",
     "effect": "slope else 0"
    },
    {
     "at": "+22",
     "cond": "forward sweep",
     "effect": "tridiagonal elimination"
    },
    {
     "at": "+27",
     "cond": "back substitution",
     "effect": "second derivatives"
    },
    {
     "at": "+31",
     "cond": "for each output sample",
     "effect": "evaluate"
    },
    {
     "at": "+33",
     "cond": "next knot before output time",
     "effect": "advance segment"
    },
    {
     "at": "+36",
     "cond": "segment width > 0",
     "effect": "cubic evaluation; else v[s]"
    }
   ],
