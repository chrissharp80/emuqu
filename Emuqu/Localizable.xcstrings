    "Re-pull the latest sleep snapshot. Your current edits will be discarded." : {
      "comment" : "A description of the refresh action, emphasizing data loss.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعادة سحب أحدث لقطة للنوم. سيتم تجاهل تعديلاتك الحالية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hent det seneste søvn-øjebliksbillede igen. Dine nuværende ændringer kasseres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuellsten Schlaf-Snapshot erneut abrufen. Deine aktuellen Änderungen werden verworfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a obtener la última instantánea de sueño. Tus ediciones actuales se descartarán."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hae uusin uni-tilannekuva uudelleen. Nykyiset muokkauksesi hylätään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
