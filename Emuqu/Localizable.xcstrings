    "Well above average for your age" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعلى بكثير من المتوسط لعمرك"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langt over gennemsnittet for din alder"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deutlich über dem Durchschnitt für dein Alter"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muy por encima de la media para tu edad"
          }
        },
