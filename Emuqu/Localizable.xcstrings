          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler os dados da gravação na cinta: %@. Tente novamente; os dados continuam na cinta até você iniciar uma nova gravação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать данные записи с датчика: %@. Повторите попытку; данные остаются на датчике, пока вы не начнёте новую запись."
          }
        },
        "sv" : {
          "stringUnit" : {
