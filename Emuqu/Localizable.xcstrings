    "Your workout is archived on the iPhone. Tap Save & Done to dismiss the summary on both devices." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمرينك محفوظ في الأرشيف على الـ iPhone. اضغط حفظ وإنهاء لإغلاق الملخّص على الجهازين."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din træning er arkiveret på iPhone. Tryk Gem og færdig for at lukke opsummeringen på begge enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Training ist auf dem iPhone archiviert. Tippe auf „Sichern & Fertig“, um die Zusammenfassung auf beiden Geräten zu schließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu entrenamiento está archivado en el iPhone. Toca Guardar y listo para cerrar el resumen en ambos dispositivos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harjoituksesi on arkistoitu iPhoneen. Sulje yhteenveto molemmista laitteista napauttamalla Tallenna ja valmis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre séance est archivée sur l’iPhone. Touchez Enregistrer et terminer pour fermer le résumé sur les deux appareils."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Æfingin þín er vistuð í iPhone. Ýttu á Vista og ljúka til að loka yfirlitinu á báðum tækjum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo allenamento è archiviato sull’iPhone. Tocca Salva e fine per chiudere il riepilogo su entrambi i dispositivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークアウトは iPhone に保存されました。「保存して完了」をタップすると、両方のデバイスでサマリーを閉じます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동이 iPhone에 보관되었습니다. ‘저장 후 완료’를 탭하면 두 기기 모두에서 요약이 닫힙니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Økten er arkivert på iPhone. Trykk Lagre og ferdig for å lukke sammendraget på begge enheter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je work-out is gearchiveerd op de iPhone. Tik op Bewaar en gereed om het overzicht op beide apparaten te sluiten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu treino está arquivado no iPhone. Toque em Salvar e concluir para fechar o resumo nos dois aparelhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренировка сохранена в архиве на iPhone. Нажмите «Сохранить и готово», чтобы закрыть сводку на обоих устройствах."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt pass är arkiverat på iPhone. Tryck på Spara och klar för att stänga sammanfattningen på båda enheterna."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的训练已存档到 iPhone。轻点「保存并完成」即可在两台设备上关闭摘要。"
          }
        }
      }
    },
