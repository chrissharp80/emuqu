    "Nothing remembered yet. Long-press any chat message and tap “Remember this” to add it here, or type a new fact below." : {
      "comment" : "A message displayed when the user hasn't added any facts to be remembered by the AI.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يتم تذكّر أي شيء بعد. اضغط مطولاً على أي رسالة دردشة وانقر على ‏“تذكّر هذا”‏ لإضافتها هنا، أو اكتب معلومة جديدة أدناه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet husket endnu. Tryk længe på en chatbesked, og tryk på “Husk dette” for at tilføje det her, eller indtast en ny oplysning nedenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts gemerkt. Drücke lange auf eine Chatnachricht und tippe auf „Das merken“, um sie hier hinzuzufügen, oder gib unten eine neue Information ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no se ha recordado nada. Mantén pulsado cualquier mensaje del chat y toca “Recordar esto” para añadirlo aquí, o escribe un nuevo dato abajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitään ei ole vielä muistettu. Paina mitä tahansa chatviestiä pitkään ja napauta “Muista tämä” lisätäksesi sen tähän, tai kirjoita uusi tieto alle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien de mémorisé pour le moment. Appuyez longuement sur un message du chat et touchez « S'en souvenir » pour l'ajouter ici, ou saisissez un nouveau fait ci-dessous."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekkert munað enn. Haltu inni á einhverjum spjallskilaboðum og ýttu á „Muna þetta“ til að bæta því við hér, eða sláðu inn nýja staðreynd hér að neðan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nulla in memoria. Tieni premuto un messaggio della chat e tocca “Ricorda questo” per aggiungerlo qui, oppure digita un nuovo dato qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ何も記憶されていません。チャットメッセージを長押しして「これを記憶」をタップするとここに追加できます。または、下に新しい情報を入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 기억된 내용이 없습니다. 채팅 메시지를 길게 누르고 “이것 기억하기”를 탭하여 여기에 추가하거나, 아래에 새 정보를 입력하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting husket ennå. Trykk lenge på en chatmelding og trykk på “Husk dette” for å legge den til her, eller skriv inn et nytt faktum nedenfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog niets onthouden. Houd een chatbericht ingedrukt en tik op “Dit onthouden” om het hier toe te voegen, of typ hieronder een nieuw feit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada memorizado ainda. Mantenha pressionada qualquer mensagem do chat e toque em “Lembrar disto” para adicioná-la aqui, ou digite um novo fato abaixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока ничего не запомнено. Нажмите и удерживайте любое сообщение в чате и коснитесь «Запомнить это», чтобы добавить его сюда, или введите новый факт ниже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget ihågkommet ännu. Tryck länge på ett chattmeddelande och tryck på “Kom ihåg detta” för att lägga till det här, eller skriv in ett nytt faktum nedan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有记住任何内容。长按任意聊天消息并点按“记住这条”即可添加到这里，或在下方输入一条新信息。"
          }
        }
      }
    },
    "Nothing saved yet. Run a workout, then tap \"Add to my route library\" on the post-workout summary — or pick a discovered trail (it gets auto-saved)." : {
      "comment" : "A message displayed when a user hasn't added any routes to their library yet. Encourages them to do so.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُحفظ شيء بعد. قم بتمرين، ثم اضغط على \"إضافة إلى مكتبة مساراتي\" في ملخص ما بعد التمرين — أو اختر مسارًا تم اكتشافه (يُحفظ تلقائيًا)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet gemt endnu. Gennemfør en træning, og tryk derefter på \"Føj til mit rutebibliotek\" på opsummeringen efter træningen — eller vælg et fundet spor (det gemmes automatisk)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts gespeichert. Absolviere ein Training und tippe dann in der Zusammenfassung nach dem Training auf \"Zu meiner Streckenbibliothek hinzufügen\" — oder wähle einen entdeckten Trail (er wird automatisch gespeichert)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay nada guardado. Realiza un entrenamiento y luego toca \"Añadir a mi biblioteca de rutas\" en el resumen posterior al entrenamiento, o elige un sendero descubierto (se guarda automáticamente)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitään ei ole vielä tallennettu. Suorita harjoitus ja napauta sitten harjoituksen jälkeisessä yhteenvedossa \"Lisää reittikirjastooni\" — tai valitse löydetty polku (se tallennetaan automaattisesti)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien d'enregistré pour l'instant. Effectuez une séance, puis touchez \"Ajouter à ma bibliothèque d'itinéraires\" sur le récapitulatif d'après-séance — ou choisissez un sentier découvert (il est enregistré automatiquement)."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekkert vistað enn. Ljúktu æfingu og pikkaðu svo á \"Bæta við leiðasafnið mitt\" í samantektinni eftir æfingu — eða veldu uppgötvaða slóð (hún vistast sjálfkrafa)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nulla di salvato. Esegui un allenamento, poi tocca \"Aggiungi alla mia libreria di percorsi\" nel riepilogo post-allenamento — oppure scegli un sentiero scoperto (viene salvato automaticamente)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ何も保存されていません。ワークアウトを行い、ワークアウト後のサマリーで「マイルートライブラリに追加」をタップしてください——または見つかったトレイルを選択してください（自動的に保存されます）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 저장된 항목이 없습니다. 운동을 진행한 후 운동 후 요약에서 \"내 경로 라이브러리에 추가\"를 탭하거나, 발견된 트레일을 선택하세요(자동으로 저장됩니다)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting lagret ennå. Gjennomfør en økt, og trykk deretter på \"Legg til i rutebiblioteket mitt\" i sammendraget etter økten — eller velg en oppdaget sti (den lagres automatisk)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog niets opgeslagen. Voer een training uit en tik daarna op \"Toevoegen aan mijn routebibliotheek\" in de samenvatting na de training — of kies een ontdekt pad (dat wordt automatisch opgeslagen)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada salvo ainda. Faça um treino e toque em \"Adicionar à minha biblioteca de trajetos\" no resumo pós-treino — ou escolha uma trilha descoberta (ela é salva automaticamente)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока ничего не сохранено. Завершите тренировку, затем нажмите \"Добавить в мою библиотеку маршрутов\" в сводке после тренировки — или выберите найденную тропу (она сохранится автоматически)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget sparat ännu. Genomför ett träningspass och tryck sedan på \"Lägg till i mitt ruttbibliotek\" i sammanfattningen efter passet — eller välj en upptäckt led (den sparas automatiskt)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未保存任何内容。完成一次训练，然后在训练后的摘要中点按\"添加到我的路线库\"——或选择一条发现的路径（会自动保存）。"
          }
        }
      }
    },
