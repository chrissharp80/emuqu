    "Load is easing down — fitness will drift lower if this holds." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحمل في تراجع — ستنخفض اللياقة تدريجيًا إذا استمر ذلك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belastningen aftager — formen vil glide nedad, hvis det fortsætter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Belastung geht zurück – hält das an, sinkt die Fitness allmählich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carga está bajando: la condición física irá a menos si esto se mantiene."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuormitus laskee – kunto heikkenee vähitellen, jos tämä jatkuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La charge diminue — la condition baissera si cela continue."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Álagið fer minnkandi — formið dalar ef þetta heldur áfram."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il carico sta calando: la forma scenderà se continua così."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "負荷が減っています — このままだと体力は徐々に低下します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부하가 줄고 있습니다. 이대로라면 체력이 서서히 떨어집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belastningen avtar – formen vil gli nedover hvis dette fortsetter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De belasting neemt af — je fitheid zakt langzaam als dit zo blijft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A carga está diminuindo — o condicionamento vai cair se isso continuar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нагрузка снижается — если так пойдёт и дальше, форма будет постепенно падать."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belastningen avtar – formen glider nedåt om det fortsätter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "负荷正在下降——如果持续下去，体能会逐渐降低。"
          }
        }
      }
    },
    "Load is jumping fast — easy days help you absorb it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحمل يقفز بسرعة — الأيام الخفيفة تساعدك على استيعابه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belastningen stiger hurtigt — rolige dage hjælper dig med at optage den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Belastung steigt schnell — lockere Tage helfen dir, sie zu verarbeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carga está subiendo rápido — los días suaves te ayudan a asimilarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuorma kasvaa nopeasti — kevyet päivät auttavat sulattamaan sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La charge grimpe vite — les journées faciles vous aident à l'absorber."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Álagið eykst hratt — léttir dagar hjálpa þér að vinna úr því."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il carico sta salendo in fretta — i giorni leggeri ti aiutano ad assorbirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "負荷が急増しています — 軽めの日を入れると吸収しやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "부하가 빠르게 늘고 있습니다 — 가벼운 날이 흡수에 도움이 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belastningen øker raskt — rolige dager hjelper deg å ta den opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De belasting stijgt snel — rustige dagen helpen je die op te vangen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A carga está subindo rápido — dias leves ajudam você a absorvê-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нагрузка быстро растёт — лёгкие дни помогут её усвоить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Belastningen ökar snabbt — lugna dagar hjälper dig att ta upp den."
          }
