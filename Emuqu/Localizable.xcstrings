    "Percentage of beats the cleaner had to interpolate or drop." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسبة النبضات التي اضطر المنقّي إلى استيفائها أو إسقاطها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procentdel af slag, som rensningen måtte interpolere eller kassere."
          }
        },
        "de" : {
