    "Trend appears once you've logged enough overnight sessions with vitals." : {
      "comment" : "Message displayed in a ChartCard when there is no trend data available for the vitals.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يظهر الاتجاه بمجرد تسجيلك عددًا كافيًا من الجلسات الليلية مع القياسات الحيوية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendensen vises, når du har logget nok natlige sessioner med vitaldata."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Trend erscheint, sobald du genug Nachtsitzungen mit Vitaldaten aufgezeichnet hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tendencia aparecerá cuando hayas registrado suficientes sesiones nocturnas con datos de constantes vitales."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trendi ilmestyy, kun olet tallentanut riittävästi yön istuntoja elintoimintotietoineen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tendance apparaîtra une fois que vous aurez enregistré assez de nuits avec données vitales."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þróunin birtist þegar þú hefur skráð nægar næturlotur með lífsmörkum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tendenza comparirà quando avrai registrato abbastanza sessioni notturne con dati vitali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バイタルを含む夜間セッションが十分にたまると、トレンドが表示されます。"
