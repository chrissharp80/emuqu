    "Length of the cloud. Captures slower rhythms and overall variability — the combined output of both ANS branches." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طول السحابة. يلتقط الإيقاعات الأبطأ والتقلب الإجمالي — الناتج المشترك لفرعي الجهاز العصبي الذاتي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skyens længde. Fanger langsommere rytmer og den samlede variabilitet — det samlede output fra begge ANS-grene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Länge der Punktwolke. Erfasst langsamere Rhythmen und die Gesamtvariabilität — das gemeinsame Ergebnis beider ANS-Zweige."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longitud de la nube. Recoge los ritmos más lentos y la variabilidad global: el resultado combinado de ambas ramas del SNA."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilven pituus. Kuvaa hitaampia rytmejä ja kokonaisvaihtelua — autonomisen hermoston molempien haarojen yhteistulos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longueur du nuage. Capte les rythmes plus lents et la variabilité globale — le résultat combiné des deux branches du SNA."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lengd skýsins. Fangar hægari takta og heildarbreytileika — sameiginlega útkomu beggja greina ósjálfráða taugakerfisins."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lunghezza della nuvola. Coglie i ritmi più lenti e la variabilità complessiva — il risultato combinato di entrambi i rami del SNA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点の集まりの長さ。遅いリズムと全体的な変動性を捉えます — ANS の両方の系統を合わせた出力です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "점 구름의 길이. 느린 리듬과 전반적인 변이도를 포착합니다 — 자율신경계 두 갈래가 함께 만들어 낸 결과입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lengden på skyen. Fanger opp langsommere rytmer og total variabilitet — det samlede resultatet av begge ANS-grenene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lengte van de wolk. Vangt tragere ritmes en de totale variabiliteit — het gecombineerde resultaat van beide takken van het AZS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprimento da nuvem. Capta ritmos mais lentos e a variabilidade geral — o resultado combinado dos dois ramos do SNA."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Длина облака. Отражает более медленные ритмы и общую вариабельность — совместную работу обеих ветвей ВНС."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molnets längd. Fångar långsammare rytmer och den totala variabiliteten — det sammanlagda resultatet av båda ANS-grenarna."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
