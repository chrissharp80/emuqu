        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'IA perdra toutes les notes inter-sessions que vous avez ajoutées. Votre historique de chat et vos données de récupération ne sont pas affectés."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gervigreindin mun tapa öllum þvert-á-lotur athugasemdum sem þú hefur bætt við. Spjallsaga þín og endurheimtargögn verða óbreytt."
