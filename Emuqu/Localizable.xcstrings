            "state" : "translated",
            "value" : "Tryk på **Del**, og send sporet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf **Teilen** und sende den Trace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca **Compartir** y envía la traza."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta **Jaa** ja lähetä jälki."
          }
        },
        "fr" : {
          "stringUnit" : {
