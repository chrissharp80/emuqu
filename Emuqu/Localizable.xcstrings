    "This moves the reading to Trash. You can restore it from Settings." : {
      "comment" : "A message displayed in a confirmation dialog.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سينقل هذا القراءة إلى سلة المحذوفات. يمكنك استعادتها من الإعدادات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette flytter målingen til Papirkurv. Du kan gendanne den fra Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit wird die Messung in den Papierkorb verschoben. Du kannst sie in den Einstellungen wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto mueve la lectura a la Papelera. Puedes restaurarla desde Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä siirtää lukeman roskakoriin. Voit palauttaa sen asetuksista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela déplace la mesure vers la Corbeille. Vous pouvez la restaurer depuis les Réglages."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þetta færir mælinguna í Ruslið. Þú getur endurheimt hana í Stillingum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’operazione sposta la lettura nel Cestino. Puoi ripristinarla dalle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作で測定値はゴミ箱に移動します。設定から復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작업은 측정값을 휴지통으로 옮깁니다. 설정에서 복원할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette flytter målingen til Papirkurv. Du kan gjenopprette den fra Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee gaat de meting naar de Prullenmand. Je kunt hem herstellen via Instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso move a leitura para a Lixeira. Você pode restaurá-la em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Измерение будет перемещено в Корзину. Вы можете восстановить его в Настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta flyttar mätningen till Papperskorgen. Du kan återställa den i Inställningar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作会将该读数移到回收站。你可以在设置中恢复。"
          }
        }
      }
    },
    "This name is what the coach will say when it recognises the route — \"Following Daily 1\"." : {
      "comment" : "A message shown in an alert when creating a new route.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الاسم هو ما سيقوله المدرّب عند التعرّف على المسار — \"اتّباع Daily 1\"."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette navn er, hvad coachen siger, når den genkender ruten — \"Følger Daily 1\"."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diesen Namen sagt der Coach, wenn er die Route erkennt — „Folge Daily 1\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este es el nombre que dirá el entrenador cuando reconozca la ruta — \"Siguiendo Daily 1\"."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
