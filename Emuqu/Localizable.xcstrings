          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "步道地图服务繁忙。请稍候再试。"
          }
        }
      }
    },
    "The trail map service sent a reply the app couldn't read. Try again." : {
