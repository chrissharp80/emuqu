        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "케이던스 높음, 리듬을 안정시키세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høy kadens, finn rytmen"
