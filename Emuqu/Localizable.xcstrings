    "Below the 12 bpm convention — sleep, hydration and fatigue can all slow it" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أقل من عتبة 12 نبضة/دقيقة — قد يبطئها النوم والترطيب والإرهاق"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under 12 bpm-konventionen — søvn, væske og træthed kan alle gøre den langsommere"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter der 12-bpm-Konvention — Schlaf, Flüssigkeit und Ermüdung können sie verlangsamen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por debajo de la convención de 12 lpm — el sueño, la hidratación y la fatiga pueden ralentizarla"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle 12 bpm:n käytännön rajan — uni, nesteytys ja väsymys voivat kaikki hidastaa sitä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En dessous de la convention de 12 bpm — le sommeil, l’hydratation et la fatigue peuvent la ralentir"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undir 12 slaga viðmiðinu — svefn, vökvun og þreyta geta öll hægt á henni"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto la convenzione dei 12 bpm — sonno, idratazione e stanchezza possono rallentarla"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12 bpm の慣例的基準未満 — 睡眠、水分、疲労はいずれも回復を遅らせることがあります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "12bpm 관례 기준 미만 — 수면, 수분, 피로 모두 회복을 늦출 수 있습니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under 12 bpm-konvensjonen — søvn, væske og tretthet kan alle gjøre den tregere"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onder de 12 bpm-conventie — slaap, vochtinname en vermoeidheid kunnen het allemaal vertragen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaixo da convenção de 12 bpm — sono, hidratação e cansaço podem deixá-la mais lenta"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ниже условного порога 12 уд/мин — сон, гидратация и усталость могут её замедлять"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
