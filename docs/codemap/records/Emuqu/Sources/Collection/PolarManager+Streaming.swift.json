     "effect": "continue (skip)"
    },
    {
     "at": "+11",
     "cond": "appendStreamedBeat returned false (cap)",
     "effect": "break"
    },
    {
     "at": "+12",
     "cond": "reading.hr > 0",
     "effect": "hr stored; else nil"
    }
   ],
