    "Emuqu is a wellness tool, not a medical device, and holds no regulatory clearance." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu أداة للعافية وليس جهازًا طبيًا، ولا يحمل أي ترخيص تنظيمي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu er et wellnessværktøj, ikke medicinsk udstyr, og har ingen myndighedsgodkendelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu ist ein Wellness-Tool, kein Medizinprodukt, und hat keine behördliche Zulassung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu es una herramienta de bienestar, no un dispositivo médico, y no cuenta con ninguna autorización regulatoria."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu on hyvinvointityökalu, ei lääkinnällinen laite, eikä sillä ole viranomaishyväksyntää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu est un outil de bien-être, pas un dispositif médical, et ne dispose d'aucune autorisation réglementaire."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu er vellíðunartól, ekki lækningatæki, og hefur ekkert eftirlitsleyfi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu è uno strumento per il benessere, non un dispositivo medico, e non ha alcuna autorizzazione regolatoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu はウェルネスツールであり、医療機器ではなく、規制当局の承認も受けていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu는 웰니스 도구이며 의료기기가 아니고, 규제 당국의 허가도 받지 않았습니다."
