        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "암밴드에 끼우고 전완이나 상완에 꼭 맞게 착용하세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fest den i armbåndet og bær den tettsittende på underarmen eller overarmen"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik hem in de armband en draag hem strak om je onderarm of bovenarm"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
