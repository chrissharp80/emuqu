          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korkeammat arvot (5-25%) kertovat suuremmasta parasympaattisesta aktiivisuudesta ja palautumisesta. Hyvin matalat arvot (<2%) viittaavat autonomiseen vaimenemiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des valeurs plus élevées (5-25%) indiquent une plus forte activité parasympathique et une meilleure récupération. Des valeurs très basses (<2%) suggèrent une suppression autonome."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hærri gildi (5-25%) benda til meiri sefkerfisvirkni og endurheimtar. Mjög lág gildi (<2%) benda til bælingar ósjálfráða kerfisins."
