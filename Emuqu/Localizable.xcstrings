    "Normal rest: 12-20 breaths/min. Slower breathing promotes HRV. Very slow (<6) or fast (>20) may affect HRV accuracy." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الراحة الطبيعية: 12-20 نفسًا/دقيقة. التنفس الأبطأ يعزّز HRV. البطيء جدًا (<6) أو السريع (>20) قد يؤثر على دقة القياس."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal hvile: 12-20 vejrtrækninger/min. Langsommere vejrtrækning fremmer HRV. Meget langsom (<6) eller hurtig (>20) kan påvirke HRV-nøjagtigheden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normale Ruhe: 12-20 Atemzüge/Min. Langsamere Atmung fördert die HRV. Sehr langsam (<6) oder schnell (>20) kann die HRV-Genauigkeit beeinträchtigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reposo normal: 12-20 respiraciones/min. Respirar más lento favorece la HRV. Muy lento (<6) o rápido (>20) puede afectar la precisión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normaali lepo: 12-20 hengitystä/min. Hitaampi hengitys tukee HRV:tä. Hyvin hidas (<6) tai nopea (>20) voi heikentää HRV:n tarkkuutta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repos normal : 12-20 respirations/min. Une respiration plus lente favorise la HRV. Très lente (<6) ou rapide (>20) peut affecter la précision de la HRV."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eðlileg hvíld: 12-20 andardrættir/mín. Hægari öndun eflir HRV. Mjög hæg (<6) eða hröð (>20) getur haft áhrif á nákvæmni HRV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riposo normale: 12-20 respiri/min. Respirare più lentamente favorisce l’HRV. Molto lento (<6) o veloce (>20) può alterarne l’accuratezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常の安静時: 12-20 回/分。ゆっくりした呼吸は HRV を高めます。極端に遅い（<6）または速い（>20）呼吸は HRV の精度に影響することがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정상 안정 시: 분당 12-20회. 느린 호흡은 HRV를 높입니다. 지나치게 느리거나(<6) 빠르면(>20) HRV 정확도에 영향을 줄 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal hvile: 12-20 åndedrag/min. Langsommere pust fremmer HRV. Svært langsom (<6) eller rask (>20) kan påvirke HRV-nøyaktigheten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normale rust: 12-20 ademhalingen/min. Langzamer ademen bevordert HRV. Zeer langzaam (<6) of snel (>20) kan de HRV-nauwkeurigheid beïnvloeden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repouso normal: 12-20 respirações/min. Respirar mais devagar favorece a VFC. Muito lento (<6) ou rápido (>20) pode afetar a precisão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Норма в покое: 12-20 вдохов/мин. Более медленное дыхание повышает ВСР. Очень медленное (<6) или частое (>20) может снизить точность ВСР."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normal vila: 12-20 andetag/min. Långsammare andning gynnar HRV. Mycket långsam (<6) eller snabb (>20) kan påverka HRV-noggrannheten."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正常静息：12-20 次/分。呼吸放慢有助于提升 HRV。过慢（<6）或过快（>20）可能影响 HRV 准确性。"
          }
        }
      }
    },
