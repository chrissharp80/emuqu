    "An RMSSD of 25ms at %lld reflects the same autonomic health as 42ms at 25 — the app accounts for this." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قيمة RMSSD البالغة 25م.ث في عمر %lld تعكس صحة الجهاز العصبي الذاتي نفسها التي تعكسها 42م.ث في عمر 25 — والتطبيق يأخذ ذلك في الحسبان."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En RMSSD på 25 ms som %lld-årig afspejler samme autonome sundhed som 42 ms som 25-årig — det tager appen højde for."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein RMSSD von 25 ms mit %lld spiegelt dieselbe autonome Gesundheit wider wie 42 ms mit 25 — die App berücksichtigt das."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un RMSSD de 25 ms a los %lld años refleja la misma salud autonómica que 42 ms a los 25 — la app lo tiene en cuenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25 ms:n RMSSD %lld-vuotiaana kertoo samasta autonomisesta terveydestä kuin 42 ms 25-vuotiaana — sovellus ottaa tämän huomioon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un RMSSD de 25 ms à %lld ans reflète la même santé autonome que 42 ms à 25 ans — l'app en tient compte."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RMSSD upp á 25 ms við %lld ára aldur endurspeglar sömu ósjálfráðu heilsu og 42 ms við 25 ára — appið tekur tillit til þess."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un RMSSD di 25 ms a %lld anni riflette la stessa salute autonomica di 42 ms a 25 anni — l'app ne tiene conto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 歳での RMSSD 25ms は、25 歳での 42ms と同じ自律神経の健康度を示します — アプリはこれを考慮しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld세의 RMSSD 25ms는 25세의 42ms와 같은 자율신경 건강 상태를 반영합니다 — 앱은 이를 고려합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En RMSSD på 25 ms ved %lld år gjenspeiler samme autonome helse som 42 ms ved 25 — appen tar hensyn til dette."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een RMSSD van 25 ms op %lld weerspiegelt dezelfde autonome gezondheid als 42 ms op 25 — de app houdt hier rekening mee."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um RMSSD de 25 ms aos %lld anos reflete a mesma saúde autonômica que 42 ms aos 25 — o app leva isso em conta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RMSSD 25 мс в %lld лет отражает такое же вегетативное здоровье, как 42 мс в 25 — приложение это учитывает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En RMSSD på 25 ms vid %lld års ålder speglar samma autonoma hälsa som 42 ms vid 25 — appen tar hänsyn till det."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 岁时 25ms 的 RMSSD 与 25 岁时 42ms 反映的自主神经健康程度相同 — 应用已考虑这一点。"
          }
        }
      }
    },
