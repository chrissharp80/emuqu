    "Get to bed earlier — sleep is the lever you can move tonight." : {
      "comment" : "One of the actions to take based on a \"fair\" recovery score.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نم مبكرًا — النوم هو الرافعة التي يمكنك تحريكها الليلة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå tidligere i seng — søvn er den håndtag, du kan flytte i nat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh früher ins Bett — Schlaf ist der Hebel, den du heute Nacht bewegen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acuéstate antes — el sueño es la palanca que puedes mover esta noche."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mene aiemmin nukkumaan — uni on vipu, jota voit siirtää tänä yönä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couchez-vous plus tôt — le sommeil est le levier que vous pouvez actionner ce soir."
