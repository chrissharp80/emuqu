    "Recent training is below your usual range. Room to add quality this week." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التدريب الأخير أقل من نطاقك المعتاد. هناك مجال لإضافة جودة هذا الأسبوع."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den seneste træning ligger under dit normale niveau. Plads til at lægge kvalitet ind i denne uge."
