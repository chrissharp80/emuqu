        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þetta mun endurreikna stig allra skráðra lota. Þetta gæti tekið nokkurn tíma ef þú átt mikið af gögnum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione ricalcolerà i punteggi per tutte le sessioni registrate. Potrebbe richiedere del tempo se ha molti dati."
