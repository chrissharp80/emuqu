    "Recovered %lld of %lld sessions. %lld could not be recovered (may have insufficient data)." : {
      "comment" : "A message displayed after attempting to recover multiple lost sessions, indicating how many were successfully recovered and how many failed. The first argument is the number of successfully recovered sessions. The second argument is the total number of sessions.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم استرداد %lld من أصل %lld جلسة. تعذّر استرداد %lld (قد تكون بياناتها غير كافية)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gendannede %lld af %lld sessioner. %lld kunne ikke gendannes (har muligvis utilstrækkelige data)."
          }
        },
        "de" : {
          "stringUnit" : {
