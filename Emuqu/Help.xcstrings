    "Moderate stress — your sympathetic system is pushing. Incomplete recovery or significant stressor." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إجهاد متوسط — جهازك الودي نشط. تعافٍ غير مكتمل أو عامل ضغط ملحوظ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderat stress — dit sympatiske system presser på. Ufuldstændig restitution eller en betydelig stressfaktor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mäßiger Stress — dein sympathisches System treibt an. Unvollständige Erholung oder ein deutlicher Stressfaktor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estrés moderado: tu sistema simpático está presionando. Recuperación incompleta o un factor de estrés importante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohtalainen stressi — sympaattinen järjestelmäsi painaa päälle. Vajaa palautuminen tai merkittävä stressitekijä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress modéré — votre système sympathique est sollicité. Récupération incomplète ou facteur de stress important."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miðlungs streita — sympatíska kerfið þrýstir á. Ófullkominn bati eða verulegur streituvaldur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress moderato — il sistema simpatico sta spingendo. Recupero incompleto o fattore di stress rilevante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中程度のストレス — 交感神経系が働いています。回復が不十分か、大きなストレス要因があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중간 스트레스 — 교감신경계가 밀어붙이고 있습니다. 불완전한 회복이나 상당한 스트레스 요인."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderat stress — det sympatiske systemet presser på. Ufullstendig restitusjon eller en betydelig stressfaktor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matige stress — je sympathische systeem duwt. Onvolledig herstel of een flinke stressfactor."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estresse moderado — seu sistema simpático está acelerando. Recuperação incompleta ou estressor significativo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Умеренный стресс — симпатическая система активна. Неполное восстановление или значительный стрессор."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Måttlig stress — ditt sympatiska system driver på. Ofullständig återhämtning eller en betydande stressfaktor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中度压力 — 你的交感神经系统在发力。恢复不完全或存在明显的压力源。"
          }
        }
      }
    },
