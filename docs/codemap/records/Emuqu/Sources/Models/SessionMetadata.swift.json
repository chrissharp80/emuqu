  {
   "key": "init HRVSession(from:)",
   "hash": "b816cc234d1db03c",
   "does": "Decodes an HRVSession: required id/startDate/state, sessionType defaulting to .overnight, tags to [], sourceSchemaVersion from payloadSchemaVersion (stated version, or newer than this build when an enum case is unknown) and raised to newer than this build too when a decoded artifact flag holds an unknown type (ArtifactFlags.holdsUnknownType), skips rrSeries when decoder.userInfo[.skipRRSeries]==true, reads SessionState/SessionType/HRVDataQuality leniently (unknown case → .complete / .quick / .insufficient), marks a legacy Elite HRV import's analysis (analysisResult.withLegacyImportProvenance(source: importedMetrics?.source): estimated metrics named, fabricated ANS metrics dropped) and drops such a session's recoveryScore, frozenReadiness and scoreBreakdown (an RMSSD-made readiness, never a score the app computed), migrates trainingSnapshot from analysisResult.trainingContext, validates perceivedReadiness, decodes morningFeelingTags via MorningFeelingTagArray; any other field's decode error throws.",
   "entry": "Decodable synthesis use by JSONDecoder in SessionArchive/CloudKit paths",
   "calls": [
    "Emuqu/Sources/Models/SessionMetadata.swift::func HRVSession.payloadSchemaVersion(in:)",
    "Emuqu/Sources/Models/SessionMetadata.swift::func KeyedDecodingContainer.decodeKnown(_:forKey:unknown:)",
    "Emuqu/Sources/Models/SessionMetadata.swift::func KeyedDecodingContainer.decodeKnownIfPresent(_:forKey:unknown:)",
    "Emuqu/Sources/Models/SessionMetadata.swift::func HRVSession.validPerceivedReadiness(_:)",
    "Emuqu/Sources/Models/MorningFeelingTag.swift::init MorningFeelingTagArray(from:)",
    "Emuqu/Sources/Models/RRModels.swift::func HRVAnalysisResult.isLegacyEliteImport(source:)",
    "Emuqu/Sources/Models/RRModels.swift::func HRVAnalysisResult.withLegacyImportProvenance(source:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+7",
     "cond": "payloadSchemaVersion",
     "effect": "stated version (0 when absent), or currentSchemaVersion+1 when an enum case is unknown — the archive then refuses to re-write the lossy decode"
    },
    {
     "at": "+11",
     "cond": "state raw value unknown to this build",
     "effect": ".complete (missing state still throws)"
    },
    {
     "at": "+12",
     "cond": "sessionType absent / unknown",
     "effect": "absent → .overnight; unknown → .quick (kept out of the overnight baseline)"
    },
    {
     "at": "+14",
     "cond": "userInfo[.skipRRSeries] == true ?:",
     "effect": "true: rrSeries nil (lightweight decode via SessionArchive.lightweightSessionDecoder); false: decodes rrSeries"
    },
    {
     "at": "+18",
     "cond": "an artifact flag holds an unknown type",
     "effect": "sourceSchemaVersion raised to at least currentSchemaVersion+1"
    },
    {
     "at": "+23",
     "cond": "tags absent ?? []",
     "effect": "empty tags"
    },
    {
     "at": "+28",
     "cond": "analysisResult nil (?.) / isLegacyEliteImport",
     "effect": "nothing to mark; a legacy Elite result is remembered, gains estimatedMetrics and loses ansMetrics"
    },
    {
     "at": "+45",
     "cond": "trainingSnapshot absent ?? analysisResult?.trainingContext",
     "effect": "legacy sessions take training context from the analysis result"
    },
    {
     "at": "+51",
     "cond": "hrvDataQuality unknown",
     "effect": ".insufficient (excluded from HRV aggregates)"
    },
    {
     "at": "+54",
     "cond": "isLegacyEliteImport",
     "effect": "recoveryScore, frozenReadiness and scoreBreakdown set to nil"
    }
   ],
   "deps": {
    "Emuqu/Sources/Models/MorningFeelingTag.swift::init MorningFeelingTagArray(from:)": "32a1e51ebf91cf04",
    "Emuqu/Sources/Models/RRModels.swift::func HRVAnalysisResult.isLegacyEliteImport(source:)": "008b564bbafc2b40",
