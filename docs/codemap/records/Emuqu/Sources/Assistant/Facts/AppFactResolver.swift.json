{
 "file": "Emuqu/Sources/Assistant/Facts/AppFactResolver.swift",
 "hash": "1297369abb02e523",
 "role": "Composition root for the assistant's fact system: the shared PeriodParser vocabulary, AppFactResolverFactory.build (registers every fact namespace on a FactResolverRegistry), the user.* profile/settings namespace (incl. score.* meta facts), and the small app.capabilities/app.version namespace.",
 "types": [
  "PeriodParser: enum — parses period tokens (7d, last_week, this_week, all_time...) into a cutoff Date or DateInterval",
  "AppFactResolverFactory: enum — builds the FactResolverRegistry with all namespaces",
  "UserProfileNamespace: struct (FactNamespaceResolver) — user.profile.*, user.settings.*, score.algorithm.version, score.history.recomputed_under_v2",
  "AppCapabilitiesNamespace: struct (FactNamespaceResolver) — app.capabilities.has_barometer, app.version.schema.workout_metadata",
  "RecentBiometricProfile: private @MainActor enum — one Apple Health biometric-profile fetch shared by the profile facts for 10 s"
 ],
 "state": [
  "mem:PeriodParser.namedDayWindows (static let token→days table)",
  "mem:UserProfileNamespace.namespace = \"user\"",
  "mem:UserProfileNamespace.settings (closure returning UserSettings)",
  "mem:AppCapabilitiesNamespace.namespace = \"app\"",
  "mem:RecentBiometricProfile.recent (MainActor static: start time + in-flight/finished fetch Task)"
 ],
 "toplevel": "Imports CoreMotion under #if canImport(CoreMotion). Header comment states the concurrency contract (fact resolution runs on MainActor; assumeIsolated relies on it). No global code.",
 "units": [
  {
   "key": "func PeriodParser.cutoff(for:now:)",
   "hash": "f57a000f6d11c678",
   "does": "Lowercases/trims a period token and returns its start Date: numeric N-day windows (Nd, last_Nd, N_days) via numericDayWindow, today = start of day, yesterday = start of yesterday, this_week = start of the locale week, all_time/all = distantPast, else the namedDayWindows rolling window (bare 'week' included); unknown → nil.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Assistant/Facts/AppFactResolver.swift::func PeriodParser.numericDayWindow(_:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+3",
     "cond": "numericDayWindow parses 1-365 days",
     "effect": "returns now - N days"
    },
    {
     "at": "+7",
     "cond": "case today",
     "effect": "start of today"
    },
    {
     "at": "+8",
     "cond": "case yesterday",
     "effect": "start of yesterday"
    },
    {
     "at": "+9",
     "cond": "case this_week",
     "effect": "start of current weekOfYear interval (nil if Calendar fails)"
    },
    {
     "at": "+10",
     "cond": "case all_time / all",
     "effect": "Date.distantPast"
    },
    {
     "at": "+11",
     "cond": "default",
     "effect": "looked up in namedDayWindows"
    },
    {
     "at": "+12",
     "cond": "token not in namedDayWindows",
     "effect": "returns nil (caller treats as unknown period); else now - days"
    }
   ],
   "deps": {
    "Emuqu/Sources/Assistant/Facts/AppFactResolver.swift::func PeriodParser.numericDayWindow(_:)": "2b47a160638e5297"
   }
  },
  {
   "key": "func PeriodParser.interval(for:now:)",
   "hash": "fbdd48eafde68e96",
   "does": "Returns the DateInterval for a period: yesterday = [start of yesterday, start of today), last_week = previous calendar week, everything else = [cutoff(for:), now]. Callers answer a nil with PeriodParser.invalidPeriod (invalidParameter), never an empty period.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Assistant/Facts/AppFactResolver.swift::func PeriodParser.cutoff(for:now:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+4",
     "cond": "case yesterday",
     "effect": "interval yesterday-start..today-start"
    },
    {
     "at": "+6",
     "cond": "Calendar could not compute yesterday",
     "effect": "nil"
    },
    {
     "at": "+8",
     "cond": "case last_week",
     "effect": "previous calendar week interval"
    },
    {
     "at": "+9",
     "cond": "current week interval or minus-one-week date unavailable",
     "effect": "nil"
    },
    {
     "at": "+13",
     "cond": "default",
     "effect": "uses cutoff(for:)"
    },
    {
     "at": "+14",
     "cond": "cutoff nil or after now",
     "effect": "nil; else [start, now]"
    }
   ],
   "deps": {
    "Emuqu/Sources/Assistant/Facts/AppFactResolver.swift::func PeriodParser.cutoff(for:now:)": "77f1f69a5a0abdaa"
   }
  },
