            "value" : "Polar H10로 밤새 전체 기록을 하려면 배터리가 최소 30%% 필요합니다. 현재 %lld%%입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar H10 trenger minst 30%% batteri for et fullt nattopptak. Ditt er på %lld%%."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De Polar H10 heeft minstens 30%% batterij nodig voor een volledige nachtopname. De jouwe staat op %lld%%."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Polar H10 precisa de pelo menos 30%% de bateria para uma gravação noturna completa. A sua está em %lld%%."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar H10 нужно не менее 30%% заряда для полной ночной записи. У вас %lld%%."
