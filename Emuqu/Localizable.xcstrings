    "Come back and tap **Stop**. There's no rush; capture runs as long as you want (up to 10 min)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عُد واضغط على **إيقاف**. لا داعي للعجلة؛ يستمر الالتقاط طالما تريد (حتى 10 دقائق)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kom tilbage, og tryk på **Stop**. Der er ingen hast; optagelsen kører, så længe du vil (op til 10 min)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komm zurück und tippe auf **Stopp**. Keine Eile – die Aufzeichnung läuft, so lange du willst (bis zu 10 Min.)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve y toca **Detener**. Sin prisa: la captura dura lo que quieras (hasta 10 min)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palaa ja napauta **Pysäytä**. Ei kiirettä – tallennus jatkuu niin kauan kuin haluat (enintään 10 min)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revenez et touchez **Arrêter**. Rien ne presse : la capture dure aussi longtemps que vous le souhaitez (jusqu'à 10 min)."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komdu aftur og ýttu á **Stöðva**. Engin þörf á að flýta sér; upptakan heldur áfram eins lengi og þú vilt (allt að 10 mín.)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Torna qui e tocca **Ferma**. Nessuna fretta: l'acquisizione dura quanto vuoi (fino a 10 min)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戻って**停止**をタップします。急ぐ必要はありません。キャプチャは好きなだけ続けられます（最大 10 分）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "돌아와서 **정지**를 탭하세요. 서두를 필요 없습니다. 캡처는 원하는 만큼 계속됩니다(최대 10분)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kom tilbake og trykk på **Stopp**. Det haster ikke; opptaket går så lenge du vil (opptil 10 min)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kom terug en tik op **Stoppen**. Geen haast: het vastleggen loopt zo lang je wilt (tot 10 min)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volte e toque em **Parar**. Sem pressa: a captura dura o quanto você quiser (até 10 min)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вернитесь и нажмите **Остановить**. Спешить некуда: запись идёт сколько угодно (до 10 мин)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kom tillbaka och tryck på **Stoppa**. Ingen brådska; inspelningen pågår så länge du vill (upp till 10 min)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回来后点按**停止**。不用着急，采集可按需持续（最长 10 分钟）。"
          }
        }
      }
    },
    "Come back to Emuqu and pull-to-refresh the dashboard." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عد إلى Emuqu واسحب لأسفل لتحديث لوحة المعلومات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå tilbage til Emuqu, og træk ned for at opdatere oversigten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehre zu Emuqu zurück und zieh das Dashboard nach unten, um es zu aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
