  "WorkoutThreshold.CueText: private struct — raw text + language, concept matching and condition inference",
  "WorkoutThreshold.Readings: struct — one tick's sensor values",
  "CueLexicon: enum — per-concept word lists (english + 16 languages) and regex builder"
 ],
 "state": [
  "mem:WorkoutThreshold.number (static regex for a decimal with . or ,)",
  "mem:CueLexicon.english (static word table)",
