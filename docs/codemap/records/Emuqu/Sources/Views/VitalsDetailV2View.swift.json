   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+4",
     "cond": "flagged == 0",
     "effect": "judged == 0 ? .notCompared : .normal"
    },
    {
     "at": "+5",
     "cond": "flagged == 1",
