  {
   "key": "func RecordView.acknowledgeError()",
   "hash": "9833dad0880992f3",
   "does": "Error alert OK. With fetchFailed set, does nothing: the Retry card keeps its reason (lastError) and session and has its own Dismiss. Otherwise resets a stale .failed session (resetSession also clears lastError) and clears lastError, so the same error raised again re-presents.",
   "entry": "Error alert OK button.",
   "calls": [
    "Emuqu/Sources/Collection/RRCollector+Session.swift::func RRCollector.resetSession()"
   ],
   "reads": [
    "mem:RecordView.fetchFailed",
    "mem:SessionState.currentSession"
   ],
   "writes": [
    "mem:RRCollector session state (via resetSession)",
    "mem:SessionState.lastError"
   ],
   "branches": [
    {
     "at": "+1",
     "cond": "fetchFailed",
     "effect": "true: return, nothing changes"
    },
    {
     "at": "+2",
     "cond": "currentSession?.state == .failed",
     "effect": "true: collector.resetSession()"
    }
   ],
   "deps": {
    "Emuqu/Sources/Collection/RRCollector+Forwarders.swift::var RRCollector.lastError": "6dca98a7661720c1",
    "Emuqu/Sources/Collection/RRCollector+Session.swift::func RRCollector.resetSession()": "2d1dbd705fabf7be"
   }
