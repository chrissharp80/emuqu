    "Your device has unrecovered recording data. Recover it first or explicitly discard it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي جهازك على بيانات تسجيل غير مستردة. استردها أولًا أو تجاهلها صراحةً."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din enhed har ugendannede optagelsesdata. Gendan dem først, eller kassér dem udtrykkeligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf deinem Gerät befinden sich nicht wiederhergestellte Aufnahmedaten. Stelle sie zuerst wieder her oder verwirf sie ausdrücklich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu dispositivo tiene datos de grabación sin recuperar. Recupéralos primero o descártalos de forma explícita."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitteessasi on palauttamattomia tallennustietoja. Palauta ne ensin tai hylkää ne erikseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre appareil contient des données d’enregistrement non récupérées. Récupérez-les d’abord ou supprimez-les explicitement."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tækið þitt geymir óendurheimt upptökugögn. Endurheimtu þau fyrst eða hentu þeim sérstaklega."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo contiene dati di registrazione non recuperati. Recuperali prima o scartali esplicitamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
