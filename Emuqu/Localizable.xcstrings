    "Your training has been unusually similar day-to-day this week" : {
      "comment" : "A description of the Foster monotony banner.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كان تدريبك متشابهًا بشكل غير معتاد من يوم لآخر هذا الأسبوع"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din træning har været usædvanligt ensartet fra dag til dag i denne uge"
