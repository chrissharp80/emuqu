          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 동기화는 본인의 비공개 CloudKit 컨테이너로 갑니다 — 제3자 서버 없음"
          }
        },
        "nb" : {
