   "key": "func VitalsScoring.calculateVitalsScore(vitals:baselineStats:)",
   "hash": "b44fe97954fc2533",
   "does": "Averages the available vitals sub-scores (sleep/resting HR vs personal baseline, respiratory rate vs 7-day baseline or population window, wrist-temperature deviation step score) into a 0-100 score; returns nil when vitals is nil or no sub-score is computable (SpO2 alone yields nil).",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Analysis/VitalsScoring.swift::func VitalsScoring.restingHRSubScore(vitals:baselineStats:)",
    "Emuqu/Sources/Analysis/VitalsScoring.swift::func VitalsScoring.respiratorySubScore(vitals:)",
    "Emuqu/Sources/Analysis/VitalsScoring.swift::func VitalsScoring.temperatureSubScore(_:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+4",
     "cond": "vitals is nil",
     "effect": "return nil (caller falls back to Tier 2); else continue"
    },
    {
     "at": "+6",
     "cond": "restingHRSubScore returned a value (RHR + baseline mean>0 + SD>0)",
     "effect": "append RHR sub-score; else RHR dropped from the average"
    },
    {
     "at": "+7",
     "cond": "respiratorySubScore returned a value",
     "effect": "append RR sub-score; else dropped"
    },
    {
     "at": "+13",
     "cond": "vitals.wristTemperature non-nil",
     "effect": "append temperatureSubScore(value) treating it as the personal deviation the caller must already have applied; else dropped"
    },
    {
     "at": "+14",
     "cond": "subScores is empty",
     "effect": "return nil; else return arithmetic mean of the sub-scores"
    }
   ],
   "deps": {
    "Emuqu/Sources/Analysis/VitalsScoring.swift::func VitalsScoring.respiratorySubScore(vitals:)": "8d2a3159e58b68a4",
