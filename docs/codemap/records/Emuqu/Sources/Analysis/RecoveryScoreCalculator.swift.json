  {
   "key": "func RecoveryScoreCalculator.zToRecoveryScore(_:parameters:)",
   "hash": "44beb1dbb210cc4a",
   "does": "Maps a z-score to a 0-100 recovery score by piecewise-linear interpolation over parameters.zScoreBands (default V2: -3→5, -1.5→25, -0.75→64, [-0.5,0.5]→72, 1.5→90); NaN or empty table → 50; below/above endpoints → endpoint score.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Analysis/RecoveryScoreCalculator.swift::func RecoveryScoreCalculator.interpolate(_:in:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+3",
     "cond": "bands has first and last",
     "effect": "false (empty table) returns neutralScore 50"
    },
    {
     "at": "+13",
     "cond": "z is NaN",
     "effect": "returns 50 (finite/infinite z continue)"
    },
    {
     "at": "+14",
     "cond": "z <= lowest.z",
     "effect": "returns lowest.score (5)"
    },
    {
     "at": "+15",
     "cond": "z >= highest.z",
     "effect": "returns highest.score (90)"
    },
    {
     "at": "+16",
     "cond": "interpolate(...) ?? highest.score",
     "effect": "nil (no bracketing band, excluded by guards) falls back to highest score"
    }
   ],
   "deps": {
    "Emuqu/Sources/Analysis/RecoveryScoreCalculator.swift::func RecoveryScoreCalculator.interpolate(_:in:)": "43ecf86d32ca55d9"
   }
  },
  {
   "key": "func RecoveryScoreCalculator.interpolate(_:in:)",
   "hash": "1e1a48f8e8ac2eb9",
   "does": "Linear interpolation between the first band pair whose upper z >= z; nil when no pair matches.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+3",
     "cond": "for each i where z <= bands[i+1].z",
     "effect": "first match returns lo.score + t*(hi.score-lo.score); no match returns nil"
    }
   ],
   "deps": {}
  },
