    "Resting heart rate is elevated at %@ bpm (avg: %@ bpm), which may indicate stress, dehydration, or incomplete recovery." : {
      "comment" : "The localized string for a trend insight indicating that the user's resting heart rate is higher than the average. The first argument is the string “%.0f”. The second argument is the string “%.0f”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معدل نبض الراحة مرتفع عند %@ نبضة/دقيقة (المتوسط: %@ نبضة/دقيقة)، ما قد يشير إلى إجهاد أو جفاف أو تعافٍ غير مكتمل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvilepulsen er forhøjet ved %@ bpm (gns.: %@ bpm), hvilket kan tyde på stress, dehydrering eller ufuldstændig restitution."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ruhepuls ist mit %@ bpm erhöht (Ø: %@ bpm) — das kann auf Stress, Dehydrierung oder unvollständige Erholung hindeuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Resting heart rate is elevated at %1$@ bpm (avg: %2$@ bpm), which may indicate stress, dehydration, or incomplete recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La FC en reposo está elevada, en %@ lpm (media: %@ lpm), lo que puede indicar estrés, deshidratación o recuperación incompleta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leposyke on koholla, %@ bpm (ka: %@ bpm), mikä voi viitata stressiin, kuivumiseen tai vajaaseen palautumiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La FC de repos est élevée, à %@ bpm (moy. : %@ bpm), ce qui peut indiquer du stress, une déshydratation ou une récupération incomplète."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvíldarpúls er hækkaður, %@ slög/mín (meðaltal: %@ slög/mín), sem gæti bent til streitu, vökvaskorts eða ófullnægjandi endurheimtar."
