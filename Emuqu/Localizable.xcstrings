    "Highest sustained HRV during sleep — your physiological ceiling, separate from readiness." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعلى HRV مستدام أثناء النوم — سقفك الفسيولوجي، منفصل عن الجاهزية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højeste vedvarende HRV under søvn — dit fysiologiske loft, adskilt fra parathed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höchster anhaltender HRV-Wert während des Schlafs — deine physiologische Obergrenze, unabhängig von der Bereitschaft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV sostenida más alta durante el sueño — tu techo fisiológico, distinto del estado de preparación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korkein ylläpidetty HRV unen aikana — fysiologinen kattosi, erillinen valmiudesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV soutenu le plus élevé pendant le sommeil — votre plafond physiologique, distinct de l'état de préparation."
