      }
    },
    "Cognitive recovery and emotional processing. Your brain consolidates memories, processes emotions, and restores mental function. Target: ~25% of total sleep." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التعافي الذهني والمعالجة العاطفية. يُرسّخ دماغك الذكريات ويعالج المشاعر ويستعيد الوظائف الذهنية. الهدف: نحو 25% من إجمالي النوم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kognitiv restitution og følelsesmæssig bearbejdning. Din hjerne konsoliderer minder, bearbejder følelser og genopretter mental funktion. Mål: ~25 % af den samlede søvn."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kognitive Erholung und emotionale Verarbeitung. Dein Gehirn festigt Erinnerungen, verarbeitet Emotionen und stellt die geistige Leistungsfähigkeit wieder her. Ziel: ~25 % des Gesamtschlafs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperación cognitiva y procesamiento emocional. Tu cerebro consolida recuerdos, procesa emociones y restaura la función mental. Objetivo: ~25 % del sueño total."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kognitiivinen palautuminen ja tunteiden käsittely. Aivosi vahvistavat muistoja, käsittelevät tunteita ja palauttavat henkistä toimintakykyä. Tavoite: noin 25 % kokonaisunesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupération cognitive et traitement émotionnel. Votre cerveau consolide les souvenirs, traite les émotions et restaure les fonctions mentales. Objectif : ~25 % du sommeil total."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hugrænn bati og tilfinningaúrvinnsla. Heilinn festir minningar í sessi, vinnur úr tilfinningum og endurheimtir andlega getu. Markmið: ~25% af heildarsvefni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recupero cognitivo ed elaborazione emotiva. Il cervello consolida i ricordi, elabora le emozioni e ripristina le funzioni mentali. Obiettivo: ~25% del sonno totale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認知の回復と感情の処理。脳が記憶を定着させ、感情を処理し、精神機能を回復させます。目安：総睡眠の約 25%。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인지 회복과 감정 처리. 뇌가 기억을 정리하고, 감정을 처리하며, 정신 기능을 회복합니다. 목표: 전체 수면의 약 25%."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kognitiv restitusjon og emosjonell bearbeiding. Hjernen konsoliderer minner, bearbeider følelser og gjenoppretter mental funksjon. Mål: ~25 % av total søvn."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cognitief herstel en emotionele verwerking. Je hersenen slaan herinneringen op, verwerken emoties en herstellen mentale functies. Doel: ~25% van de totale slaap."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recuperação cognitiva e processamento emocional. Seu cérebro consolida memórias, processa emoções e restaura a função mental. Meta: ~25% do sono total."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когнитивное восстановление и эмоциональная переработка. Мозг закрепляет воспоминания, перерабатывает эмоции и восстанавливает умственные функции. Цель: ~25% от общего сна."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kognitiv återhämtning och emotionell bearbetning. Hjärnan befäster minnen, bearbetar känslor och återställer mental funktion. Mål: ~25 % av total sömn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "认知恢复和情绪处理。你的大脑会巩固记忆、处理情绪并恢复心理功能。目标：约占总睡眠的 25%。"
          }
        }
      }
    },
