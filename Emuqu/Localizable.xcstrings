    "Notifications are disabled in iOS Settings. Open Settings → Notifications → Emuqu to allow." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإشعارات معطّلة في إعدادات iOS. افتح الإعدادات ← الإشعارات ← Emuqu للسماح بها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifikationer er slået fra i iOS-indstillinger. Åbn Indstillinger → Notifikationer → Emuqu for at tillade."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen sind in den iOS-Einstellungen deaktiviert. Öffne Einstellungen → Mitteilungen → Emuqu, um sie zu erlauben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones están desactivadas en los Ajustes de iOS. Abre Ajustes → Notificaciones → Emuqu para permitirlas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilmoitukset on poistettu käytöstä iOS-asetuksissa. Avaa Asetukset → Ilmoitukset → Emuqu salliaksesi ne."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications sont désactivées dans les Réglages iOS. Ouvrez Réglages → Notifications → Emuqu pour les autoriser."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilkynningar eru óvirkar í iOS-stillingum. Opnaðu Stillingar → Tilkynningar → Emuqu til að leyfa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche sono disattivate nelle Impostazioni di iOS. Apri Impostazioni → Notifiche → Emuqu per consentirle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知が iOS の設定でオフになっています。設定 → 通知 → Emuqu を開いて許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 설정에서 알림이 꺼져 있습니다. 설정 → 알림 → Emuqu에서 허용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsler er slått av i iOS-innstillingene. Åpne Innstillinger → Varsler → Emuqu for å tillate."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meldingen zijn uitgeschakeld in de iOS-instellingen. Open Instellingen → Berichtgeving → Emuqu om ze toe te staan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As notificações estão desativadas nos Ajustes do iOS. Abra Ajustes → Notificações → Emuqu para permitir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления отключены в настройках iOS. Откройте Настройки → Уведомления → Emuqu, чтобы разрешить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notiser är avstängda i iOS-inställningarna. Öppna Inställningar → Notiser → Emuqu för att tillåta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知已在 iOS 设置中关闭。请打开“设置 → 通知 → Emuqu”以允许。"
          }
        }
      }
