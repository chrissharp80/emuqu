        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar H10 behöver minst 30%% batteri för en hel nattinspelning. Ditt är på %lld%%."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
