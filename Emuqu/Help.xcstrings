    "H10 Internal Recording — Data stored on the device itself. Survives everything except device battery death." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التسجيل الداخلي في H10 — بيانات مخزّنة على الجهاز نفسه. تصمد أمام كل شيء باستثناء نفاد بطارية الجهاز."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H10 intern optagelse — Data gemt på selve enheden. Overlever alt undtagen at enhedens batteri løber tørt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interne H10-Aufnahme — Daten werden auf dem Gerät selbst gespeichert. Übersteht alles außer einem leeren Geräteakku."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grabación interna del H10: datos guardados en el propio dispositivo. Sobrevive a todo salvo a que se agote la batería del dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H10:n sisäinen tallennus — Tiedot tallennetaan itse laitteeseen. Kestää kaiken paitsi laitteen akun tyhjenemisen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrement interne du H10 — Données stockées sur l’appareil lui-même. Résiste à tout, sauf à une batterie à plat."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innri upptaka H10 — Gögn geymd á tækinu sjálfu. Þolir allt nema að rafhlaða tækisins tæmist."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrazione interna H10 — Dati memorizzati sul dispositivo stesso. Resiste a tutto tranne all'esaurimento della batteria del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H10 内部記録 — デバイス本体に保存されるデータ。デバイスのバッテリー切れ以外のあらゆる状況に耐えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "H10 내부 기록 — 데이터가 기기 자체에 저장됩니다. 기기 배터리가 다 닳는 경우를 제외하면 어떤 상황에서도 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Internt opptak på H10 — data lagres på selve enheten. Overlever alt unntatt at batteriet i enheten går tomt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interne opname van de H10 — Gegevens opgeslagen op het apparaat zelf. Overleeft alles behalve een lege batterij."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gravação interna do H10 — Dados armazenados no próprio dispositivo. Sobrevivem a tudo, exceto à bateria do dispositivo acabar."
          }
        },
        "ru" : {
