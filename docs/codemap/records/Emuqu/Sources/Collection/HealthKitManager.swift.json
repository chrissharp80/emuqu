  {
   "key": "func HealthKitManager.backfillWorkoutsToHealthKit(archive:bodyWeightKg:)",
   "hash": "5a9daf9ac8c54bdd",
   "does": "Back-publishes archived workout sessions to Apple Health: requires HealthKit + workout write auth; skips entirely when the workout set watermark (count-newestDate) matches the stored one; otherwise logs denied optional types and serially handles each entry (backfillOne: claim, read, needsBackfill, stamp-only for a session already exported, else export+stamp with 1 s pacing), storing the watermark only when no session failed. An unreadable session counts as skipped, so it no longer holds the watermark. Returns (exported, skipped, failed). Called from EmuquApp.swift on foreground.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Collection/HealthKitManager.swift::var HealthKitManager.workoutWriteAuthorized",
    "Emuqu/Sources/Collection/HealthKitManager.swift::func HealthKitManager.backfillWatermark(_:)",
    "Emuqu/Sources/Collection/HealthKitManager.swift::func HealthKitManager.reportDeniedWorkoutSampleTypes()",
    "Emuqu/Sources/Collection/HealthKitManager.swift::func HealthKitManager.backfillOne(entry:archive:bodyWeightKg:tally:)",
    "Emuqu/Sources/Utilities/DebugLog.swift::func debugLog(_:level:file:line:)",
    "Emuqu/Sources/Collection/HealthKitManager.swift::var HealthKitManager.isHealthKitAvailable"
   ],
   "reads": [
    "archive:SessionArchive.entries",
    "ud:hkBackfillExportedWatermark"
   ],
   "writes": [
    "ud:hkBackfillExportedWatermark"
   ],
   "branches": [
    {
     "at": "+5",
     "cond": "HealthKit unavailable OR workout write not authorized",
     "effect": "returns (0,0,0)"
    },
    {
     "at": "+9",
     "cond": "stored watermark equals current",
     "effect": "returns (0, candidates.count, 0) without scanning"
    },
    {
     "at": "+14",
     "cond": "for each workout entry",
     "effect": "yields then backfills one"
    },
    {
     "at": "+20",
     "cond": "no failures",
     "effect": "stores the new watermark; else keeps the old one so the scan repeats next foreground"
    }
   ],
   "flags": [],
