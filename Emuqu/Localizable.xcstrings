    "For wellness and fitness use only. Not a medical device; not medical advice, diagnosis, or treatment." : {
      "comment" : "Disclaimer text for the app, visible on every page of the Holistic Daily Report.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للاستخدام في العافية واللياقة فقط. ليس جهازًا طبيًا؛ وليس نصيحة طبية أو تشخيصًا أو علاجًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun til wellness- og fitnessbrug. Ikke et medicinsk udstyr; ikke lægelig rådgivning, diagnose eller behandling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur für Wellness- und Fitnesszwecke. Kein Medizinprodukt; keine medizinische Beratung, Diagnose oder Behandlung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo para uso de bienestar y fitness. No es un dispositivo médico; no constituye consejo médico, diagnóstico ni tratamiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain hyvinvointi- ja kuntoilukäyttöön. Ei lääkinnällinen laite; ei lääketieteellistä neuvontaa, diagnoosia tai hoitoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À usage bien-être et fitness uniquement. Pas un dispositif médical ; ni conseil médical, ni diagnostic, ni traitement."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aðeins til vellíðunar- og líkamsræktarnota. Ekki lækningatæki; hvorki læknisráð, greining né meðferð."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo per uso benessere e fitness. Non è un dispositivo medico; non è consulenza medica, diagnosi o terapia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウェルネスおよびフィットネス用途に限ります。医療機器ではなく、医学的助言・診断・治療でもありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웰니스 및 피트니스 용도로만 사용하세요. 의료기기가 아니며 의학적 조언, 진단, 치료가 아닙니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun til velvære- og treningsbruk. Ikke medisinsk utstyr; ikke medisinsk råd, diagnose eller behandling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen voor wellness- en fitnessgebruik. Geen medisch hulpmiddel; geen medisch advies, diagnose of behandeling."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas para uso de bem-estar e condicionamento físico. Não é um dispositivo médico; não é aconselhamento médico, diagnóstico ou tratamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только для велнеса и фитнеса. Не является медицинским изделием; не является медицинской консультацией, диагнозом или лечением."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast för wellness- och träningsbruk. Inte en medicinteknisk produkt; inte medicinsk rådgivning, diagnos eller behandling."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅供健康与健身用途。非医疗器械；不构成医疗建议、诊断或治疗。"
          }
        }
      }
    },
    "For workouts without a GPS route it uses your current location, so iOS may ask for location access." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للتمارين التي لا تحتوي على مسار GPS يستخدم موقعك الحالي، لذا قد يطلب iOS الوصول إلى الموقع."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til træning uden GPS-rute bruger den din aktuelle placering, så iOS kan bede om adgang til placering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Trainings ohne GPS-Route wird dein aktueller Standort verwendet, daher fragt iOS möglicherweise nach Standortzugriff."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para los entrenamientos sin ruta GPS usa tu ubicación actual, por lo que iOS puede pedir acceso a la ubicación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harjoituksissa, joissa ei ole GPS-reittiä, se käyttää nykyistä sijaintiasi, joten iOS saattaa pyytää sijaintilupaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les entraînements sans itinéraire GPS, il utilise votre position actuelle, iOS peut donc demander l’accès à la localisation."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyrir æfingar án GPS-leiðar notar það núverandi staðsetningu þína, svo iOS gæti beðið um aðgang að staðsetningu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per gli allenamenti senza percorso GPS usa la tua posizione attuale, quindi iOS potrebbe chiedere l’accesso alla posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS ルートのないワークアウトでは現在地を使用するため、iOS が位置情報へのアクセスを求めることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS 경로가 없는 운동에는 현재 위치를 사용하므로 iOS가 위치 접근 권한을 요청할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For økter uten GPS-rute brukes din nåværende posisjon, så iOS kan be om tilgang til posisjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor trainingen zonder gps-route gebruikt het je huidige locatie, dus iOS kan om toegang tot je locatie vragen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para treinos sem rota de GPS, ele usa sua localização atual, então o iOS pode pedir acesso à localização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для тренировок без GPS-маршрута используется ваша текущая геопозиция, поэтому iOS может запросить доступ к геопозиции."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För träningspass utan GPS-rutt används din aktuella plats, så iOS kan be om platsåtkomst."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于没有 GPS 路线的训练，它会使用你的当前位置，因此 iOS 可能会请求位置访问权限。"
          }
        }
      }
    },
