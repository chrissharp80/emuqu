        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trekker den NED: dårlig søvn, tung og vedvarende treningsbelastning, alkohol (også moderate mengder), sykdom, akutt stress, dehydrering"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drukt hem OMLAAG: slecht slapen, zware aanhoudende trainingsbelasting, alcohol (ook matige hoeveelheden), ziekte, acute stress, uitdroging"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fazem CAIR: sono ruim, carga de treino pesada e prolongada, álcool (mesmo em quantidade moderada), doença, estresse agudo, desidratação"
