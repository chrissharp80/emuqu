    "Don't stress about \"bad\" readings — your baseline needs to capture your full range" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تقلق من القراءات «السيئة» — يحتاج خط الأساس إلى التقاط نطاقك الكامل"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stress ikke over »dårlige« målinger — din baseline skal fange hele dit spænd"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach dir keine Gedanken über „schlechte“ Messungen — deine Baseline muss deine gesamte Bandbreite erfassen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
