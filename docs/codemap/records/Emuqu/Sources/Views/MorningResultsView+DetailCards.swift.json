  {
   "key": "func MorningDetailCards.artifactQuality(_:)",
   "hash": "6d7bcf220a18cfbc",
   "does": "Maps artifact % to (word, icon, colour): <5 Excellent, <10 Good, <20 Fair, else Poor — same 5/10/20 bands as the Artifacts glossary.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Services/LanguageManager.swift::var LanguageManager.appBundle"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "percent < 5",
     "effect": "Excellent, sage seal"
    },
    {
     "at": "+3",
     "cond": "5 ≤ percent < 10",
     "effect": "Good, sage seal outline"
    },
    {
     "at": "+4",
     "cond": "10 ≤ percent < 20",
     "effect": "Fair, gold triangle"
    },
    {
     "at": "+5",
     "cond": "default (≥20, or NaN)",
     "effect": "Poor, terracotta triangle"
    }
   ],
   "deps": {
    "Emuqu/Sources/Services/LanguageManager.swift::var LanguageManager.appBundle": "61ce9bcce9965ced"
   }
