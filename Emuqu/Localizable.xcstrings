    "RR Intervals exports the raw data needed to recalculate all HRV metrics. Use this for backup and recovery." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصدّر فواصل RR البيانات الأولية اللازمة لإعادة حساب جميع مقاييس HRV. استخدم هذا للنسخ الاحتياطي والاسترداد."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RR-intervaller eksporterer de rå data, der er nødvendige for at genberegne alle HRV-målinger. Brug dette til sikkerhedskopiering og gendannelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RR-Intervalle exportieren die Rohdaten, die zur Neuberechnung aller HRV-Metriken benötigt werden. Nutze dies für Backup und Wiederherstellung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La exportación de intervalos RR contiene los datos sin procesar necesarios para recalcular todas las métricas de HRV. Úsala para respaldo y recuperación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RR-intervallien vienti sisältää raakatiedot, joita tarvitaan kaikkien HRV-mittareiden uudelleenlaskentaan. Käytä tätä varmuuskopiointiin ja palautukseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'export des intervalles RR fournit les données brutes nécessaires pour recalculer toutes les métriques HRV. Utilisez-le pour la sauvegarde et la récupération."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RR bila útflutningur inniheldur hrágögnin sem þarf til að endurreikna allar HRV mælingar. Notaðu þetta til öryggisafritunar og endurheimtar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'esportazione degli intervalli RR contiene i dati grezzi necessari per ricalcolare tutte le metriche HRV. Utilizzare per backup e recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RR間隔はすべてのHRVメトリクスを再計算するために必要な生データをエクスポートします。バックアップと復元に使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RR 간격은 모든 HRV 지표를 재계산하는 데 필요한 원시 데이터를 내보냅니다. 백업 및 복구에 사용하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RR-intervaller eksporterer rådataene som trengs for å beregne alle HRV-målinger på nytt. Bruk dette for sikkerhetskopiering og gjenoppretting."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RR-intervallen exporteert de ruwe gegevens die nodig zijn om alle HRV-metrieken opnieuw te berekenen. Gebruik dit voor back-up en herstel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A exportação de Intervalos RR fornece os dados brutos necessários para recalcular todas as métricas de HRV. Use para backup e recuperação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспорт RR-интервалов содержит исходные данные для пересчёта всех показателей ВСР. Используйте для резервного копирования и восстановления."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RR-intervall exporterar rådata som behövs för att beräkna om alla HRV-mått. Använd detta för säkerhetskopiering och återställning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RR间期导出重新计算所有HRV指标所需的原始数据。用于备份和恢复。"
          }
        }
      }
    },
