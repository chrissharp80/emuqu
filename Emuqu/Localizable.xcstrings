    "HR at which your α1 crossed 0.75. In lab comparisons this lands within about ±10 bpm of the gas-exchange aerobic threshold (Rogers & Gronwald 2021; Schaffarczyk 2022; Van Hooren 2023)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معدل ضربات القلب الذي عبر عنده α1 قيمة 0.75. في المقارنات المخبرية يقع هذا ضمن حوالي ±10 نبضة/دقيقة من العتبة الهوائية بتبادل الغازات (Rogers & Gronwald 2021؛ Schaffarczyk 2022؛ Van Hooren 2023)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puls, hvor din α1 krydsede 0,75. I laboratoriesammenligninger lander dette inden for cirka ±10 bpm af den aerobe tærskel målt ved gasudveksling (Rogers & Gronwald 2021; Schaffarczyk 2022; Van Hooren 2023)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herzfrequenz, bei der dein α1 0,75 unterschritten hat. In Laborvergleichen liegt dies etwa ±10 bpm um die per Gasaustausch bestimmte aerobe Schwelle (Rogers & Gronwald 2021; Schaffarczyk 2022; Van Hooren 2023)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FC a la que tu α1 cruzó 0,75. En comparaciones de laboratorio esto cae dentro de unos ±10 lpm del umbral aeróbico por intercambio de gases (Rogers & Gronwald 2021; Schaffarczyk 2022; Van Hooren 2023)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syke, jossa α1 ylitti arvon 0,75. Laboratoriovertailuissa tämä osuu noin ±10 bpm:n sisään kaasunvaihdolla mitatusta aerobisesta kynnyksestä (Rogers & Gronwald 2021; Schaffarczyk 2022; Van Hooren 2023)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FC à laquelle votre α1 a franchi 0,75. Dans les comparaisons en laboratoire, cela tombe à environ ±10 bpm du seuil aérobie mesuré par échanges gazeux (Rogers & Gronwald 2021 ; Schaffarczyk 2022 ; Van Hooren 2023)."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Púls þar sem α1 fór yfir 0,75. Í samanburði á rannsóknarstofu lendir þetta innan um ±10 slög/mín frá loftháða þröskuldinum mældum með gasskiptum (Rogers & Gronwald 2021; Schaffarczyk 2022; Van Hooren 2023)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FC alla quale il tuo α1 ha attraversato 0,75. Nei confronti di laboratorio questo cade entro circa ±10 bpm dalla soglia aerobica da scambio gassoso (Rogers & Gronwald 2021; Schaffarczyk 2022; Van Hooren 2023)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "α1 が 0.75 を横切ったときの心拍数。実験室での比較では、ガス交換で測った有酸素性閾値の約 ±10 bpm 以内に収まります（Rogers & Gronwald 2021、Schaffarczyk 2022、Van Hooren 2023）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "α1이 0.75를 넘은 심박수입니다. 실험실 비교에서는 가스 교환으로 측정한 유산소 역치의 약 ±10 bpm 이내에 들어옵니다(Rogers & Gronwald 2021, Schaffarczyk 2022, Van Hooren 2023)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puls der α1 krysset 0,75. I laboratoriesammenligninger lander dette innenfor omtrent ±10 bpm fra den aerobe terskelen målt ved gassutveksling (Rogers & Gronwald 2021; Schaffarczyk 2022; Van Hooren 2023)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hartslag waarbij je α1 0,75 passeerde. In laboratoriumvergelijkingen valt dit binnen ongeveer ±10 bpm van de aerobe drempel via gaswisseling (Rogers & Gronwald 2021; Schaffarczyk 2022; Van Hooren 2023)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FC em que seu α1 cruzou 0,75. Em comparações de laboratório isso fica dentro de cerca de ±10 bpm do limiar aeróbico por troca gasosa (Rogers & Gronwald 2021; Schaffarczyk 2022; Van Hooren 2023)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пульс, при котором ваш α1 пересёк 0,75. В лабораторных сравнениях это попадает примерно в ±10 уд/мин от аэробного порога по газообмену (Rogers & Gronwald 2021; Schaffarczyk 2022; Van Hooren 2023)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puls där din α1 korsade 0,75. I laboratoriejämförelser hamnar detta inom ungefär ±10 bpm från den aeroba tröskeln mätt med gasutbyte (Rogers & Gronwald 2021; Schaffarczyk 2022; Van Hooren 2023)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "α1 越过 0.75 时的心率。在实验室对比中，它落在气体交换法有氧阈值约 ±10 bpm 范围内（Rogers & Gronwald 2021；Schaffarczyk 2022；Van Hooren 2023）。"
          }
        }
      }
    },
    "HR data isn't available for this workout — TRIMP and zone analysis fall back to estimates." : {
      "comment" : "Message displayed when there is no HR data available for a workout, causing the TRIMP and zone analysis to fall back to estimates.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بيانات النبض غير متاحة لهذا التمرين — يعتمد تحليل TRIMP والمناطق على تقديرات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsdata er ikke tilgængelige for denne træning — TRIMP og zoneanalyse falder tilbage på estimater."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für dieses Training liegen keine Herzfrequenzdaten vor — TRIMP und Zonenanalyse greifen auf Schätzwerte zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay datos de FC para este entrenamiento — el TRIMP y el análisis de zonas se basan en estimaciones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tälle harjoitukselle ei ole sykedataa — TRIMP ja alueanalyysi perustuvat arvioihin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
