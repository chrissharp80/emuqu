    "Worth checking with a healthcare professional if you're concerned." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كان الأمر يقلقك، فمن المفيد مراجعة أخصائي رعاية صحية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du er bekymret, kan det være værd at tjekke med en sundhedsfaglig person."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du dir Sorgen machst, lohnt sich ein Gespräch mit einer Fachperson aus dem Gesundheitswesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si te preocupa, vale la pena consultarlo con un profesional sanitario."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos asia huolestuttaa sinua, se kannattaa tarkistaa terveydenhuollon ammattilaiselta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cela vous inquiète, il peut être utile d'en parler à un professionnel de santé."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ef þú hefur áhyggjur er gott að ræða það við heilbrigðisstarfsmann."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ti preoccupa, vale la pena sentire un professionista sanitario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "気になる場合は、医療の専門家に確認してみる価値があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "걱정된다면 보건 의료 전문가에게 확인해 보는 것이 좋습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du er bekymret, kan det være lurt å sjekke med helsepersonell."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je je zorgen maakt, is het de moeite waard om het na te gaan bij een zorgprofessional."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se isso te preocupa, vale a pena verificar com um profissional de saúde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если это вас беспокоит, стоит уточнить у специалиста в области здравоохранения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du är orolig kan det vara värt att stämma av med vårdpersonal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你感到担心，值得向医疗保健专业人员确认一下。"
          }
        }
      }
    },
