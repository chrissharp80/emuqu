    "Another easy day or active recovery — let HRV climb back to baseline before the next quality session." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوم سهل آخر أو تعافٍ نشط — دع HRV يعود إلى خط الأساس قبل الجلسة النوعية التالية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endnu en let dag eller aktiv restitution — lad HRV komme tilbage til baseline før næste kvalitetssession."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch ein lockerer Tag oder aktive Erholung – lass die HRV zum Ausgangswert zurückkehren, bevor die nächste Qualitätseinheit kommt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otro día suave o recuperación activa: deja que la HRV vuelva a tu referencia antes de la próxima sesión de calidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toinen kevyt päivä tai aktiivinen palautuminen – anna HRV:n nousta perustasolle ennen seuraavaa laatuharjoitusta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encore une journée facile ou de la récupération active — laissez la HRV revenir à votre référence avant la prochaine séance de qualité."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annar léttur dagur eða virk endurheimt — leyfðu HRV að ná grunnlínu á ný fyrir næstu gæðaæfingu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un altro giorno facile o recupero attivo: lascia che l'HRV torni alla base prima della prossima sessione di qualità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう1日軽めか、アクティブ回復を — 次の質の高いセッションの前にHRVをベースラインまで戻しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루 더 가볍게 하거나 적극적 회복을 하세요. 다음 고강도 세션 전에 HRV가 기준선으로 돌아오게 하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enda en lett dag eller aktiv restitusjon – la HRV komme tilbake til baseline før neste kvalitetsøkt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog een lichte dag of actief herstel — laat je HRV terugkomen op je basislijn voor de volgende kwaliteitstraining."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais um dia leve ou recuperação ativa — deixe a HRV voltar à linha de base antes da próxima sessão de qualidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ещё один лёгкий день или активное восстановление — дайте ВСР вернуться к базовой линии перед следующей качественной тренировкой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ännu en lätt dag eller aktiv återhämtning – låt HRV komma tillbaka till baslinjen före nästa kvalitetspass."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再安排一天轻松训练或主动恢复——在下一次高质量训练前，让 HRV 回到基线。"
          }
        }
      }
    },
