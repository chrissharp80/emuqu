{
 "file": "Emuqu/Sources/Views/SettingsSearchIndex.swift",
 "hash": "26c47f19beab1581",
 "role": "Hand-curated flat catalogue of Settings search entries (title, subtitle, English aliases, SF Symbol, destination-view factory) that SettingsView builds once into cachedSearchEntries and filters per keystroke for its .searchable field.",
 "types": [
  "SettingsSearchEntry: struct (Identifiable) — one searchable row with a precomputed lowercased haystack and an AnyView destination closure",
  "SettingsSearchIndex: enum (@MainActor) — namespace of static factories that build the catalogue by Settings section"
 ],
 "state": [],
 "toplevel": "SettingsSearchEntry stores title/subtitle/aliases/systemImage/destination/haystack as lets; Identifiable conformance uses the computed id. No globals. Titles and subtitles are localized via LanguageManager.appBundle at build time; aliases are hard-coded English. SettingsView rebuilds the catalogue when LanguageManager.revision changes (SettingsView.swift:68-71).",
 "units": [
  {
   "key": "var SettingsSearchEntry.id",
   "hash": "c2a67f4ec792c8fc",
   "does": "Returns \"<systemImage>|<title>\" as the Identifiable id: stable across catalogue rebuilds, and unique in every language because every entry has its own SF Symbol.",
   "entry": "Identifiable.id witness read by SwiftUI ForEach over search results in SettingsView",
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [],
   "deps": {}
  },
