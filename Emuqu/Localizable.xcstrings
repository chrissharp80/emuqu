        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone-síminn þinn auglýsir sig sem „Emuqu“ svo forritið sem tekur á móti geti borið kennsl á hann."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo iPhone si annuncia come \"Emuqu\" così che l’app ricevente possa identificarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
