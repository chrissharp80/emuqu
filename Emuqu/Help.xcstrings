          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen korrigerer milde artefakter automatisk med interpolering og medianerstatning, og vindusvelgeren bruker ikke et vindu med over 15 % artefakter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De app corrigeert lichte artefacten automatisch met interpolatie en vervanging door de mediaan, en de vensterkiezer gebruikt geen venster met meer dan 15% artefacten."
          }
        },
