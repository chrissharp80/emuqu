    "Every turn goes to whatever you picked in the model picker. Full control." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل دور يذهب إلى ما اخترته في منتقي النموذج. تحكم كامل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver tur går til det, du har valgt i modelvælgeren. Fuld kontrol."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Runde geht an das, was du in der Modellauswahl gewählt hast. Volle Kontrolle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada turno va a lo que elegiste en el selector de modelo. Control total."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen vuoro menee mallivalitsimessa valitsemallesi. Täysi hallinta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque tour va à ce que vous avez choisi dans le sélecteur de modèle. Contrôle total."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver umferð fer í það sem þú valdir í líkanavalinu. Full stjórn."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni turno va a ciò che hai scelto nel selettore del modello. Controllo totale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎回のやり取りが、モデルピッカーで選んだものに送られます。完全に自分で管理できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매번 모델 선택기에서 고른 모델로 보냅니다. 완전한 제어."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver tur går til det du valgte i modellvelgeren. Full kontroll."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke beurt gaat naar wat je in de modelkiezer hebt gekozen. Volledige controle."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada turno vai para o que você escolheu no seletor de modelo. Controle total."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый шаг идёт в то, что выбрано в списке моделей. Полный контроль."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje tur går till det du valt i modellväljaren. Full kontroll."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每轮都发送到你在模型选择器中选的模型。完全由你掌控。"
          }
        }
      }
    },
    "Every vital measured last night is within your usual range. No systemic stress flagged." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل العلامات الحيوية المقاسة الليلة الماضية ضمن نطاقك المعتاد. لم يُرصد إجهاد جهازي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle vitalværdier målt i nat ligger inden for dit sædvanlige område. Ingen systemisk stress registreret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle letzte Nacht gemessenen Vitalwerte liegen in deinem üblichen Bereich. Keine systemische Belastung erkannt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las constantes vitales medidas anoche están dentro de tu rango habitual. No se ha detectado estrés sistémico."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki viime yönä mitatut elintoiminnot ovat tavanomaisella vaihteluvälilläsi. Systeemistä stressiä ei havaittu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les signes vitaux mesurés la nuit dernière sont dans votre plage habituelle. Aucun stress systémique signalé."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öll lífsmörk sem mæld voru í nótt eru innan venjulegs bils þíns. Ekkert almennt álag greint."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutti i parametri vitali misurati la scorsa notte rientrano nel tuo intervallo abituale. Nessuno stress sistemico rilevato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昨夜測定したバイタルはすべていつもの範囲内です。全身性のストレスは検出されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어젯밤 측정한 모든 바이탈이 평소 범위 안에 있습니다. 전신 스트레스는 감지되지 않았습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle vitale verdier som ble målt i natt, ligger innenfor det vanlige området ditt. Ingen systemisk stress flagget."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle vitale waarden van afgelopen nacht vallen binnen je gebruikelijke bereik. Geen systemische stress gesignaleerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os sinais vitais medidos na noite passada estão na sua faixa habitual. Nenhum estresse sistêmico sinalizado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все жизненные показатели прошлой ночи в вашем обычном диапазоне. Системного стресса не отмечено."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alla vitalvärden som mättes i natt ligger inom ditt vanliga intervall. Ingen systemisk stress flaggad."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昨晚测得的所有生命体征都在你的常规范围内。未发现全身性压力。"
          }
        }
      }
    },
