    "Turn the wheel to your birthday and choose your biological sex to continue, or tap Skip." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدر العجلة إلى تاريخ ميلادك واختر جنسك البيولوجي للمتابعة، أو اضغط على تخطي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drej hjulet til din fødselsdag, og vælg dit biologiske køn for at fortsætte, eller tryk på Spring over."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dreh das Rad auf deinen Geburtstag und wähle dein biologisches Geschlecht, um fortzufahren, oder tippe auf „Überspringen\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira la rueda hasta tu fecha de nacimiento y elige tu sexo biológico para continuar, o toca Omitir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyöritä rulla syntymäpäivääsi ja valitse biologinen sukupuolesi jatkaaksesi, tai napauta Ohita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tournez la molette jusqu'à votre date de naissance et choisissez votre sexe biologique pour continuer, ou touchez Passer."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snúðu hjólinu á afmælisdaginn þinn og veldu líffræðilegt kyn til að halda áfram, eða ýttu á Sleppa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gira la ruota fino alla tua data di nascita e scegli il tuo sesso biologico per continuare, oppure tocca Salta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続けるにはホイールを回して誕生日を合わせ、生物学的性別を選んでください。または「スキップ」をタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속하려면 휠을 돌려 생일을 맞추고 생물학적 성별을 선택하거나, 건너뛰기를 탭하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei hjulet til fødselsdagen din og velg biologisk kjønn for å fortsette, eller trykk på Hopp over."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draai aan het wiel naar je verjaardag en kies je biologische geslacht om verder te gaan, of tik op Sla over."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gire a roda até a data do seu aniversário e escolha seu sexo biológico para continuar, ou toque em Pular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прокрутите колесо до даты рождения и выберите биологический пол, чтобы продолжить, или нажмите «Пропустить»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vrid hjulet till din födelsedag och välj ditt biologiska kön för att fortsätta, eller tryck på Hoppa över."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "转动滚轮选择你的生日并选择生理性别以继续，或点按“跳过”。"
          }
        }
      }
    },
