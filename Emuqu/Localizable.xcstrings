    "Mixed-intensity %lld-minute %@: %lld min easy (below LT1), %lld min threshold (LT1–LT2), %lld min above LT2. Characteristic of a structured tempo or interval session." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ بشدة مختلطة لمدة %1$lld دقيقة: %3$lld دقيقة خفيفة (دون LT1)، و%4$lld دقيقة عند العتبة (LT1–LT2)، و%5$lld دقيقة فوق LT2. سمة جلسة تيمبو أو فترات منظّمة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld-minutters %@ med blandet intensitet: %lld min let (under LT1), %lld min tærskel (LT1–LT2), %lld min over LT2. Karakteristisk for en struktureret tempo- eller intervalsession."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld-minütiges %@ mit gemischter Intensität: %lld Min locker (unter LT1), %lld Min Schwelle (LT1–LT2), %lld Min über LT2. Typisch für eine strukturierte Tempo- oder Intervalleinheit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Mixed-intensity %1$lld-minute %2$@: %3$lld min easy (below LT1), %4$lld min threshold (LT1–LT2), %5$lld min above LT2. Characteristic of a structured tempo or interval session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ de %1$lld minutos con intensidad mixta: %3$lld min suaves (bajo LT1), %4$lld min en umbral (LT1–LT2), %5$lld min por encima de LT2. Propio de una sesión estructurada de tempo o series."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld minuutin %@ sekaintensiteetillä: %lld min kevyttä (alle LT1), %lld min kynnystä (LT1–LT2), %lld min yli LT2:n. Tyypillistä jäsennellylle tempo- tai intervalliharjoitukselle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ de %1$lld minutes à intensité mixte : %3$lld min en aisance (sous LT1), %4$lld min au seuil (LT1–LT2), %5$lld min au-dessus de LT2. Caractéristique d’une séance structurée de tempo ou d’intervalles."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld mínútna %@ með blandaðri ákefð: %lld mín rólegt (undir LT1), %lld mín þröskuldur (LT1–LT2), %lld mín yfir LT2. Einkennandi fyrir skipulagða tempó- eða lotuæfingu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ di %1$lld minuti a intensità mista: %3$lld min facili (sotto LT1), %4$lld min in soglia (LT1–LT2), %5$lld min sopra LT2. Tipico di una seduta strutturata di tempo o intervalli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "混合強度の %lld 分間の%@: イージー %lld 分（LT1 未満）、閾値 %lld 分（LT1–LT2）、LT2 超 %lld 分。構造化されたテンポ走またはインターバルの特徴です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "혼합 강도의 %lld분 %@: 이지 %lld분(LT1 미만), 역치 %lld분(LT1–LT2), LT2 초과 %lld분. 구조화된 템포 또는 인터벌 훈련의 특징입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld-minutters %@ med blandet intensitet: %lld min rolig (under LT1), %lld min terskel (LT1–LT2), %lld min over LT2. Karakteristisk for en strukturert tempo- eller intervalløkt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ van %1$lld minuten met gemengde intensiteit: %3$lld min rustig (onder LT1), %4$lld min drempel (LT1–LT2), %5$lld min boven LT2. Kenmerkend voor een gestructureerde tempo- of intervalsessie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ de %1$lld minutos com intensidade mista: %3$lld min leves (abaixo do LT1), %4$lld min em limiar (LT1–LT2), %5$lld min acima do LT2. Característico de uma sessão estruturada de tempo ou tiros."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ длительностью %1$lld минут со смешанной интенсивностью: %3$lld мин легко (ниже LT1), %4$lld мин на пороге (LT1–LT2), %5$lld мин выше LT2. Характерно для структурированной темповой или интервальной тренировки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld-minuters %@ med blandad intensitet: %lld min lugnt (under LT1), %lld min tröskel (LT1–LT2), %lld min över LT2. Kännetecknande för ett strukturerat tempo- eller intervallpass."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "混合强度的 %lld 分钟%@：轻松 %lld 分钟（LT1 以下），阈值 %lld 分钟（LT1–LT2），LT2 以上 %lld 分钟。这是结构化节奏跑或间歇训练的典型特征。"
          }
        }
      }
    },
    "Mixed-intensity: %lld min easy, %lld min threshold, %lld min above anaerobic threshold." : {
