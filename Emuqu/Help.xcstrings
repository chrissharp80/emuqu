    "API keys live in the iOS Keychain (encrypted, device-local) and are never synced to iCloud or sent to any other vendor" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ مفاتيح API في سلسلة مفاتيح iOS (مشفّرة، على الجهاز فقط) ولا تُزامَن أبدًا مع iCloud ولا تُرسل إلى أي جهة أخرى"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API-nøgler opbevares i iOS-nøgleringen (krypteret, kun på enheden) og synkroniseres aldrig til iCloud eller sendes til nogen anden udbyder"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API-Schlüssel liegen im iOS-Schlüsselbund (verschlüsselt, nur auf dem Gerät) und werden nie mit iCloud synchronisiert oder an andere Anbieter gesendet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves de API se guardan en el Llavero de iOS (cifradas, solo en el dispositivo) y nunca se sincronizan con iCloud ni se envían a ningún otro proveedor"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API-avaimet säilytetään iOS:n avainnipussa (salattuna, vain laitteella), eikä niitä koskaan synkronoida iCloudiin tai lähetetä muille palveluntarjoajille"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés d’API sont stockées dans le trousseau iOS (chiffré, local à l’appareil) et ne sont jamais synchronisées avec iCloud ni envoyées à un autre fournisseur"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API-lyklar eru geymdir í iOS Keychain (dulkóðaðir, aðeins á tækinu) og eru aldrei samstilltir við iCloud né sendir til annarra þjónustuaðila"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiavi API sono conservate nel Portachiavi iOS (crittografate, solo sul dispositivo) e non vengono mai sincronizzate su iCloud né inviate ad altri fornitori"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API キーは iOS キーチェーン（暗号化、端末内のみ）に保存され、iCloud に同期されたり他の事業者に送信されたりすることはありません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 키는 iOS 키체인(암호화, 기기 내 저장)에 보관되며 iCloud에 동기화되거나 다른 업체로 전송되지 않습니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API-nøkler lagres i iOS-nøkkelringen (kryptert, lokalt på enheten) og blir aldri synkronisert til iCloud eller sendt til noen annen leverandør"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
