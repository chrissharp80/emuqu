{
 "file": "Emuqu/Sources/Views/TrendsV2View.swift",
 "hash": "62ea01ceb8a562bb",
 "role": "Trends screen (reached from More menu): loads every archived session once (lightweight), filters to reliable overnight readings within the selected range/tag, memoizes derived chart/stats/insight/direction state, and renders tag chips, range chips, the RMSSD overall-trend card, the metric chart, stats grid, insights and the History calendar (which can soft-delete a session).",
 "types": [
  "TrendsV2View: struct (View) — Trends screen",
  "TrendsV2View.TimeRange: enum Int — 7/14/30/90/all(0) range chips",
  "TrendsV2View.Metric: enum String — chart metric (rawValue English data key)",
  "TrendsV2View.BaselineStats: struct — 60-day mean/population SD/sampleCount plus the band edges low/high (log space for log-normal metrics); hasData needs >=4",
  "TrendsV2View.Derived: struct — memoized snapshot (sessions, points, rollingBaseline, chartBand, direction, stats, insights)",
  "TrendsV2View.DirectionInfo: struct — label/glyph/color for a trend verdict"
 ],
 "state": [
  "mem:TrendsV2View.selectedRange (@State, default .thirty)",
  "mem:TrendsV2View.selectedMetric (@State, default .recoveryScore)",
  "mem:TrendsV2View.selectedTagId (@State UUID?, nil = All)",
  "mem:TrendsV2View.allSessions (@State [HRVSession], all archive sessions lightweight)",
  "mem:TrendsV2View.isLoadingSessions (@State Bool re-entrancy guard)",
  "mem:TrendsV2View.reloadRequested (@State Bool, a refresh asked for during a load)",
  "mem:TrendsV2View.derived (@State Derived, starts .empty)",
  "mem:TrendsV2View.scrubbedDate (@State Date?, chartXSelection binding)",
  "mem:TrendsV2View.BaselineStats.empty (static let)",
  "mem:TrendsV2View.Derived.empty (@MainActor static let, direction 'Building trend')",
  "@ScaledMetric dt11/dt12/dt13/dt14/dt17/dt22/dt24 font sizes",
  "@Environment dependencies, accessibilityReduceTransparency, RRCollector, ArchiveSignal"
 ],
 "toplevel": "Stored-property initializers: selectedRange .thirty, selectedMetric .recoveryScore, derived .empty, allSessions []; ScaledMetric defaults 11..24 bound to text styles. Environment reads RRCollector and ArchiveSignal (crash if not injected). No #if blocks. @State reloadRequested false.",
