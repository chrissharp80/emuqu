    "Sustained loud noise alone (wind, traffic, HVAC) doesn't interrupt. Only decoded speech does." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الضوضاء العالية المستمرة وحدها (الرياح، حركة المرور، التكييف) لا تقاطع. الكلام المفهوم وحده يفعل ذلك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedvarende høj støj alene (vind, trafik, ventilation) afbryder ikke. Kun genkendt tale gør."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anhaltender lauter Lärm allein (Wind, Verkehr, Lüftung) unterbricht nicht. Nur erkannte Sprache tut das."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ruido fuerte sostenido por sí solo (viento, tráfico, climatización) no interrumpe. Solo lo hace el habla reconocida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelkkä jatkuva kova melu (tuuli, liikenne, ilmanvaihto) ei keskeytä. Vain tunnistettu puhe keskeyttää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un bruit fort et continu seul (vent, circulation, climatisation) n’interrompt pas. Seule la parole décodée le fait."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viðvarandi hávaði einn og sér (vindur, umferð, loftræsting) grípur ekki fram í. Aðeins greint tal gerir það."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rumore forte e continuo da solo (vento, traffico, climatizzazione) non interrompe. Lo fa solo il parlato riconosciuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持続的な大きな騒音（風、交通、空調）だけでは割り込みません。割り込むのは、認識された発話だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지속적인 큰 소음만으로는(바람, 교통, 냉난방) 끼어들지 않습니다. 해석된 말소리만 끼어들기를 일으킵니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedvarende høy støy alene (vind, trafikk, ventilasjon) avbryter ikke. Bare gjenkjent tale gjør det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanhoudend hard geluid alleen (wind, verkeer, ventilatie) onderbreekt niet. Alleen herkende spraak doet dat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruído alto contínuo sozinho (vento, trânsito, ar-condicionado) não interrompe. Só a fala reconhecida interrompe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один лишь постоянный громкий шум (ветер, транспорт, вентиляция) не прерывает. Прерывает только распознанная речь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihållande högt ljud i sig (vind, trafik, ventilation) avbryter inte. Bara avkodat tal gör det."
