        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I appen går du till Spela in och trycker på Sök efter enheter — den bör dyka upp inom några sekunder"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
