    "ud:cloudkit.pendingSnapshotBackfillAttempts"
   ],
   "branches": [
    {
     "at": "+3",
     "cond": "none of the ids is still queued",
     "effect": "returns with no writes"
    },
    {
     "at": "+6",
     "cond": "for each deferred id still queued",
     "effect": "computes count = previous+1"
    },
    {
     "at": "+7",
