        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous ajoutez une clé Tavily pour la recherche web, les requêtes de recherche rédigées par l’assistant sont envoyées à Tavily."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ef þú bætir við Tavily-lykli fyrir vefleit fara leitarfyrirspurnirnar sem aðstoðarmaðurinn skrifar til Tavily."
