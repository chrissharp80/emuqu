  {
   "key": "func TrajectoryVerdict.compute(_:)",
   "hash": "0d59eabed43dae82",
   "does": "Verdict: comeback, overreach, peaking toggles win in that order; <8 samples or no week-ago CTL → buildingBaseline; delta = rampRate (or CTL−weekAgo when rampRate==0); TSB < −15 → highStrain; delta > 1.5 → rapidIncrease if rampRate > 8 else building; else decliningVerdict.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Analysis/TrajectoryVerdict.swift::func TrajectoryVerdict.decliningVerdict(delta:currentTSB:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "comebackActive",
     "effect": "→ .comeback"
    },
    {
     "at": "+2",
     "cond": "overreachActive",
     "effect": "→ .overreach"
    },
    {
     "at": "+3",
     "cond": "peakingDetected",
     "effect": "→ .peaking"
    },
    {
     "at": "+4",
     "cond": "sampleCount > 7 and ctlOneWeekAgo present",
     "effect": "false → .buildingBaseline"
    },
    {
     "at": "+7",
     "cond": "rampRate != 0",
     "effect": "true → delta = rampRate; false → currentCTL − weekAgoCTL"
    },
    {
     "at": "+8",
     "cond": "TSB present and < −15",
     "effect": "→ .highStrain"
    },
    {
     "at": "+9",
     "cond": "delta > 1.5 / rampRate > 8",
     "effect": "delta>1.5: rampRate>8 → .rapidIncrease else .building (a rampRate==0 fallback delta can never yield rapidIncrease); otherwise fall to decliningVerdict"
    }
   ],
   "flags": [],
   "deps": {
    "Emuqu/Sources/Analysis/TrajectoryVerdict.swift::func TrajectoryVerdict.decliningVerdict(delta:currentTSB:)": "d4884cbaba89725a",
    "Emuqu/Sources/Collection/HealthKitManager.swift::func HealthKitManager.sampleCount(for:from:to:)": "4f00a2cb9ab6b0f5",
    "Emuqu/Sources/Views/DashboardV2View+Chips.swift::func DashboardV2View.peakingDetected(_:)": "51e53bc83e143c3c"
   }
  },
