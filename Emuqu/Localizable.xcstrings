    "Your purchase is waiting for approval. Emuqu unlocks as soon as it's approved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عملية الشراء بانتظار الموافقة. سيُفتح Emuqu فور الموافقة عليها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit køb afventer godkendelse. Emuqu låses op, så snart det er godkendt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Kauf wartet auf Zustimmung. Emuqu wird freigeschaltet, sobald er genehmigt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu compra está pendiente de aprobación. Emuqu se desbloquea en cuanto se apruebe."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ostoksesi odottaa hyväksyntää. Emuqu avautuu heti, kun se on hyväksytty."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre achat attend une approbation. Emuqu se déverrouille dès qu’il est approuvé."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaupin bíða samþykkis. Emuqu opnast um leið og þau eru samþykkt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo acquisto è in attesa di approvazione. Emuqu si sblocca non appena viene approvato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入は承認待ちです。承認され次第、Emuqu のロックが解除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구매가 승인을 기다리고 있습니다. 승인되는 즉시 Emuqu가 잠금 해제됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjøpet ditt venter på godkjenning. Emuqu låses opp så snart det er godkjent."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je aankoop wacht op goedkeuring. Emuqu wordt ontgrendeld zodra die is goedgekeurd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua compra está aguardando aprovação. O Emuqu é desbloqueado assim que ela for aprovada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покупка ожидает одобрения. Emuqu разблокируется сразу после одобрения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt köp väntar på godkännande. Emuqu låses upp så snart det har godkänts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的购买正在等待批准。批准后 Emuqu 会立即解锁。"
          }
        }
      }
    },
    "Your Readiness Score is improving. Training adaptations are progressing well." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "درجة الجاهزية لديك تتحسن. التكيفات التدريبية تتقدم جيدًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
