    "Typical: 10-45 ms (median ~20 ms)" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المعتاد: 10-45 ms (الوسيط نحو 20 ms)"
          }
        },
