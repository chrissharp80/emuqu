          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat heeft de sleutel voor deze back-up nog niet. Controleer of iCloud-sleutelhanger aan staat en probeer het later opnieuw."
