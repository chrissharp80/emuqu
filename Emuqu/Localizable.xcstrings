        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La charge d'entraînement est désactivée, ou vous êtes en pause d'entraînement. Modifiez-le dans Réglages → Entraînement."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slökkt er á æfingaálagi eða þú ert í æfingahléi. Breyttu því í Stillingar → Þjálfun."
