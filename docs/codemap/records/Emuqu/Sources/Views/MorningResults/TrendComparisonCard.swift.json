  {
   "key": "func TrendComparisonCard.trendAverages(_:)",
   "hash": "ac603969fdc0294b",
   "does": "Averages: RMSSD = exp(baseline lnRmssdMean) else arithmetic mean; HR = baseline meanHRBaseline else arithmetic mean; stress/readiness arithmetic means or nil; baselines from baselineStats; stress baseline nil; 7-day trend from TrendVerdict.weeklyRMSSDChange.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Models/SessionMetadata.swift::var HRVSession.rmssd",
    "Emuqu/Sources/Models/SessionMetadata.swift::var HRVSession.meanHR",
    "Emuqu/Sources/Models/SessionMetadata.swift::var HRVSession.stressIndex",
    "Emuqu/Sources/Models/SessionMetadata.swift::var HRVSession.readinessScore",
    "Emuqu/Sources/Analysis/TrendAnalysis+Verdict.swift::func TrendVerdict.weeklyRMSSDChange(_:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+7",
     "cond": "geomBaseline ?? arithmetic RMSSD mean",
     "effect": "canonical geometric baseline when baselineStats set; arithmetic mean before baseline forms"
    },
    {
     "at": "+7",
     "cond": "rmssdValues.isEmpty",
     "effect": "0 when no RMSSD values; else mean"
    },
    {
     "at": "+8",
     "cond": "baselineStats?.meanHRBaseline ?? arithmetic HR mean",
     "effect": "baseline HR when set; else mean"
    },
    {
     "at": "+8",
     "cond": "hrValues.isEmpty",
     "effect": "0 when no HR values; else mean"
    },
    {
     "at": "+9",
     "cond": "stressValues.isEmpty",
     "effect": "nil; else mean"
    },
    {
     "at": "+10",
     "cond": "readinessValues.isEmpty",
     "effect": "nil; else mean"
    }
   ],
   "flags": [],
   "deps": {
    "Emuqu/Sources/Analysis/TrendAnalysis+Verdict.swift::func TrendVerdict.weeklyRMSSDChange(_:)": "26eac7e02c76e2ca",
