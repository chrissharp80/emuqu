    "Keep nightly sleep on schedule; don't waste a good day with a bad night." : {
      "comment" : "Bullet point in the \"What to do today\" section of the Recovery Score detail view, advising against doing too much training on a given day.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حافظ على مواعيد نومك الليلية؛ لا تُهدر يومًا جيدًا بليلة سيئة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold din natlige søvn på skemaet; spild ikke en god dag med en dårlig nat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte deinen Schlafrhythmus ein — verschwende keinen guten Tag mit einer schlechten Nacht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el horario de sueño; no eches a perder un buen día con una mala noche."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä yöunet aikataulussa; älä pilaa hyvää päivää huonolla yöllä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez un horaire de sommeil régulier ; ne gâchez pas une bonne journée avec une mauvaise nuit."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haltu svefninum á áætlun; ekki sóa góðum degi með slæmri nótt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni gli orari del sonno; non sprecare una buona giornata con una brutta notte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就寝時刻を一定に保ちましょう。良い一日を悪い夜で台無しにしないように。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "밤 수면 일정을 지키세요. 좋은 하루를 나쁜 밤으로 낭비하지 마세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold nattesøvnen på skjema; ikke kast bort en god dag med en dårlig natt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je nachtritme aan; verspil geen goede dag met een slechte nacht."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o horário de sono; não desperdice um bom dia com uma noite ruim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соблюдайте режим ночного сна; не тратьте хороший день на плохую ночь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll nattsömnen enligt schema; slösa inte bort en bra dag med en dålig natt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持规律的夜间作息；别让糟糕的一夜浪费了好的一天。"
          }
        }
      }
    },
    "Keep screen on during recording" : {
