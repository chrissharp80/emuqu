            "value" : "연령 평균보다 훨씬 높음"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godt over snittet for alderen din"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruim boven het gemiddelde voor jouw leeftijd"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bem acima da média para sua idade"
          }
        },
        "ru" : {
