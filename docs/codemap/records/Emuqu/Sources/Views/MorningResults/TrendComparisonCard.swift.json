   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+7",
     "cond": "geomBaseline ?? arithmetic RMSSD mean",
     "effect": "canonical geometric baseline when baselineStats set; arithmetic mean before baseline forms"
    },
    {
     "at": "+7",
     "cond": "rmssdValues.isEmpty",
     "effect": "0 when no RMSSD values; else mean"
    },
    {
     "at": "+8",
     "cond": "baselineStats?.meanHRBaseline ?? arithmetic HR mean",
     "effect": "baseline HR when set; else mean"
    },
    {
     "at": "+8",
     "cond": "hrValues.isEmpty",
     "effect": "0 when no HR values; else mean"
    },
    {
     "at": "+9",
     "cond": "stressValues.isEmpty",
     "effect": "nil; else mean"
    },
    {
     "at": "+10",
     "cond": "readinessValues.isEmpty",
     "effect": "nil; else mean"
    }
   ],
