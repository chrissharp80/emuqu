  {
   "key": "func ArchiveDiagnosticsView.indexReport(entries:)",
   "hash": "016e07088ae0b07b",
   "does": "Builds the index report: count, then for up to 50 entries the POSIX date, RMSSD (1 dp, app locale, '?' if nil), 8-char id prefix and last 40 chars of filePath, plus '… and N more'.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Services/LanguageManager.swift::var LanguageManager.appBundle",
    "Emuqu/Sources/Services/LanguageManager.swift::var LanguageManager.appLocale"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+3",
     "cond": "entries empty",
     "effect": "true: return count + 'No sessions in index.'; false: list entries"
    },
    {
     "at": "+9",
     "cond": "loop over first 50 entries",
     "effect": "one block per entry"
    },
    {
     "at": "+10",
     "cond": "entry.meanRMSSD nil",
     "effect": "nil: '?'; else formatted"
    },
    {
     "at": "+15",
     "cond": "entries.count > 50",
     "effect": "true: appends '… and N more'; false: nothing"
    }
   ],
   "deps": {
    "Emuqu/Sources/Services/LanguageManager.swift::var LanguageManager.appBundle": "45e03a07330b7279",
    "Emuqu/Sources/Services/LanguageManager.swift::var LanguageManager.appLocale": "bc43c12becc33618"
   }
  },
