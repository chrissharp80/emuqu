          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vermogen in de zeer laagfrequente band. Geassocieerd met thermoregulatie, hormonale schommelingen en langetermijnregulatiemechanismen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
