  {
   "key": "func BreadcrumbRecorder.shouldCommit(_:)",
   "hash": "d939b5a943889825",
   "does": "Accepts a fix with 0 < accuracy <= 100 m when there is no previous commit, 30 s have elapsed, or the user moved >= 25 m from the last commit.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Services/BreadcrumbStore.swift::var BreadcrumbFix.asCLLocation"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+4",
     "cond": "accuracy > 0",
     "effect": "continue; otherwise reject"
    },
    {
     "at": "+8",
     "cond": "accuracy <= 100 m",
     "effect": "continue; otherwise reject"
    },
    {
     "at": "+10",
     "cond": "a previous commit exists",
     "effect": "apply throttle; otherwise accept"
    },
    {
     "at": "+12",
     "cond": "elapsed >= 30 s",
     "effect": "accept"
    },
    {
     "at": "+14",
     "cond": "moved >= 25 m",
     "effect": "accept; otherwise reject"
    }
   ],
   "flags": [],
   "deps": {
    "Emuqu/Sources/Services/BreadcrumbStore.swift::var BreadcrumbFix.asCLLocation": "60e5c26d5f60676c"
   }
  },
