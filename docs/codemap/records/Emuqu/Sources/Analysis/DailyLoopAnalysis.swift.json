 "units": [
  {
   "key": "var DailyLoopAnalysis.loopState",
   "hash": "051590ecd04662ed",
   "does": "Classifies the day: undetermined without a workout, without an intensity signal (no α1 and no usable HR sample) or without a recovery band (no z-score); otherwise switches exhaustively on (recoveryBand, workoutIntensity): above+easy → underloading unless cumulatively loaded (then absorbing); above+moderate/hard → absorbing; within → sustainable; below+easy → backedOff; below+moderate/hard → highStrain.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Analysis/DailyLoopAnalysis.swift::var DailyLoopAnalysis.hasIntensitySignal",
    "Emuqu/Sources/Analysis/DailyLoopAnalysis.swift::var DailyLoopAnalysis.recoveryBand",
    "Emuqu/Sources/Analysis/DailyLoopAnalysis.swift::var DailyLoopAnalysis.workoutIntensity",
    "Emuqu/Sources/Analysis/DailyLoopAnalysis.swift::var DailyLoopAnalysis.isCumulativelyLoaded"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+4",
     "cond": "workoutSession != nil && hasIntensitySignal && recoveryBand != nil",
     "effect": "false: .undetermined; true: switch"
    },
    {
     "at": "+6",
     "cond": "case (.above,.easy)",
     "effect": "returns isCumulativelyLoaded ? .absorbing : .underloading"
    },
    {
     "at": "+8",
     "cond": "isCumulativelyLoaded ?:",
     "effect": "true: .absorbing; false: .underloading"
    },
    {
     "at": "+9",
     "cond": "case (.above,.moderate|.hard)",
     "effect": ".absorbing"
    },
    {
     "at": "+11",
     "cond": "case (.within,_)",
     "effect": ".sustainable"
    },
    {
     "at": "+13",
     "cond": "case (.below,.easy)",
     "effect": ".backedOff"
    },
    {
     "at": "+15",
     "cond": "case (.below,.moderate|.hard)",
     "effect": ".highStrain"
    }
   ],
   "deps": {
    "Emuqu/Sources/Analysis/DailyLoopAnalysis.swift::var DailyLoopAnalysis.hasIntensitySignal": "bd34ac9adce05e89",
