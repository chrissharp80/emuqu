  "DailyLoopAnalysis.LoopState: enum — absorbing/underloading/sustainable/backedOff/highStrain/undetermined",
  "DailyLoopAnalysis.IntensityClass: enum — easy/moderate/hard",
  "DailyLoopAnalysis.VerdictTone: enum — positive/neutral/caution",
  "DailyLoopAnalysis.RecoveryBand: private enum — above/within/below the ±0.5 SD SWC band"
 ],
 "state": [
  "mem:DailyLoopAnalysis.swcSDMultiple = 0.5"
 ],
