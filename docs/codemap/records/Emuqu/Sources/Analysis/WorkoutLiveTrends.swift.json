{
 "file": "Emuqu/Sources/Analysis/WorkoutLiveTrends.swift",
 "hash": "4776aaa3f30baff3",
 "role": "Stateless math for live/historical workout analytics: mid-workout trend metrics (reverse split, HR drift, decoupling, HR slope, cadence drift, grade-adjusted pace, time-to-fade), live time-in-zone, Riegel race predictions, Daniels-style pace zones, Banister load projection/recovery time, and cross-workout history baselines; plus the live tally (WorkoutLiveTrends.Tally) that keeps the trend, split, chunk and zone figures of the recorder's growing sample buffer as running sums and folds, so a tick reads them without scanning the buffer.",
 "types": [
  "WorkoutLiveTrends: enum — namespace of trend functions over [WorkoutSample]",
  "WorkoutZoneBreakdown: struct — seconds per HR zone (50/60/70/80/90 % of max) + dominant zone",
  "RaceTimePrediction: enum — Riegel T2=T1*(D2/D1)^1.06 predictions per standard distance",
  "RaceTimePrediction.Basis / Prediction: struct — effort used and predicted time",
  "TrainingPaceZones: struct — easy/marathon/threshold/interval/repetition paces from 5K pace",
  "RecoveryTimeEstimate: enum — hours until TSB>=0 at rest",
  "TrainingLoadProjection: enum — forward ATL/CTL/TSB projection using TrainingLoadSeries.Point.stepped",
  "TrainingLoadProjection.Day: struct — projected day",
  "WorkoutHistoryBaselines: struct — sport-matched averages of pace/HR/alpha1 across recent archived workouts",
  "WorkoutLiveTrends.SplitFold: struct (fileprivate) — kilometreSplits one sample at a time",
  "WorkoutLiveTrends.RunningSum: struct (fileprivate) — prefix sums and counts of one optional value; mean over a run of positions",
  "WorkoutLiveTrends.Tally: struct — the live trends of a growing sample buffer, synced by appending its new tail or starting over",
  "WorkoutZoneBreakdown.Fold: struct — compute one sample at a time for one max HR"
 ],
