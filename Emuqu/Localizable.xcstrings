    "The number of normal (non-artifact) heartbeats used in the analysis after artifact removal." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد النبضات الطبيعية (غير المشوّهة) المستخدمة في التحليل بعد إزالة التشوّهات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antallet af normale (ikke-artefakt) hjerteslag, der indgår i analysen efter fjernelse af artefakter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anzahl normaler (artefaktfreier) Herzschläge, die nach der Artefaktentfernung in die Analyse eingehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El número de latidos normales (sin artefactos) usados en el análisis tras eliminar los artefactos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyysissä käytettyjen normaalien (artefaktittomien) sydämenlyöntien määrä artefaktien poiston jälkeen."
          }
        },
        "fr" : {
          "stringUnit" : {
