    "Read it before you agree: its protections can differ from this policy's." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرأها قبل أن توافق: قد تختلف الحماية التي توفرها عن حماية هذه السياسة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læs den, før du accepterer: dens beskyttelse kan være anderledes end denne politiks."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lies sie, bevor du zustimmst: Das Schutzniveau dort kann von dem dieser Richtlinie abweichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Léela antes de aceptar: sus protecciones pueden diferir de las de esta política."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lue se ennen kuin hyväksyt: sen suojat voivat poiketa tämän käytännön suojista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisez-la avant d’accepter : ses protections peuvent différer de celles de cette politique."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lestu hana áður en þú samþykkir: vernd hennar getur verið önnur en í þessari stefnu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggila prima di accettare: le sue tutele possono essere diverse da quelle di questa informativa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同意する前にお読みください。その保護内容は本ポリシーと異なる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동의하기 전에 읽어 보세요. 그 보호 내용은 이 방침과 다를 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
