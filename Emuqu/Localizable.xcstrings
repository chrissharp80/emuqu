    "Open the Flo tab to accept the data-sharing notice for %@. Your question is sent when you accept, and the answer appears in the chat." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح علامة تبويب Flo لقبول إشعار مشاركة البيانات الخاص بـ %@. يُرسَل سؤالك عند القبول، وتظهر الإجابة في المحادثة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbn fanen Flo for at acceptere meddelelsen om datadeling for %@. Dit spørgsmål sendes, når du accepterer, og svaret vises i chatten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne den Flo-Tab, um den Hinweis zur Datenweitergabe für %@ zu akzeptieren. Deine Frage wird beim Akzeptieren gesendet, und die Antwort erscheint im Chat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la pestaña Flo para aceptar el aviso de uso compartido de datos de %@. Tu pregunta se envía al aceptar y la respuesta aparece en el chat."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa Flo-välilehti hyväksyäksesi palvelun %@ tietojenjakoilmoituksen. Kysymyksesi lähetetään, kun hyväksyt, ja vastaus näkyy keskustelussa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez l’onglet Flo pour accepter l’avis de partage des données de %@. Votre question est envoyée dès que vous acceptez, et la réponse s’affiche dans la conversation."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opnaðu Flo-flipann til að samþykkja tilkynningu um gagnadeilingu fyrir %@. Spurningin þín er send þegar þú samþykkir og svarið birtist í spjallinu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri la scheda Flo per accettare l’avviso di condivisione dei dati di %@. La tua domanda viene inviata quando accetti e la risposta compare nella chat."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flo タブを開いて %@ のデータ共有の通知に同意してください。同意すると質問が送信され、回答はチャットに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flo 탭을 열어 %@의 데이터 공유 안내에 동의하세요. 동의하면 질문이 전송되고 답변은 채팅에 표시됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpne Flo-fanen for å godta varselet om datadeling for %@. Spørsmålet ditt sendes når du godtar, og svaret vises i chatten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open het tabblad Flo om de melding over het delen van gegevens voor %@ te accepteren. Je vraag wordt verzonden zodra je accepteert en het antwoord verschijnt in de chat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra a aba Flo para aceitar o aviso de compartilhamento de dados do %@. Sua pergunta é enviada quando você aceitar, e a resposta aparece na conversa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Откройте вкладку Flo, чтобы принять уведомление о передаче данных для %@. Ваш вопрос будет отправлен после согласия, а ответ появится в чате."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppna fliken Flo för att godkänna meddelandet om datadelning för %@. Din fråga skickas när du godkänner, och svaret visas i chatten."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请打开 Flo 标签页，接受 %@ 的数据共享说明。接受后会发送你的问题，回答将显示在聊天中。"
          }
        }
      }
    },
