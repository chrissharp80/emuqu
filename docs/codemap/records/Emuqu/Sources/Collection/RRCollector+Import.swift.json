  {
   "key": "func SessionImport.save(_:)",
   "hash": "a93bc84b4feafe0a",
   "does": "Saves one imported session: requires complete+analysed, refuses a duplicate the archive already holds, archives it with a re-upload request (same-sleep merge allowed). A reading saved under its own id is uploaded to iCloud; one the archive merged into an existing reading reaches iCloud through the archive's re-upload request for the merged id, and the merged reading (re-read) is what the baseline and deviation use; the deviation is measured against the nights before the imported one (deviation(for:sleepSchedule:)), not a baseline it has just joined. Bumps the archive signal (its own post reaches an ArchiveSignal listening on an injected centre).",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Storage/Archive+StoreForwarding.swift::func SessionArchive.holdsCopy(of:)",
    "Emuqu/Sources/Storage/Archive.swift::func SessionArchive.archive(_:skipSameNightMerge:requestingReupload:)",
    "Emuqu/Sources/Storage/CloudKitSyncManager.swift::func CloudKitSyncManager.uploadSession(_:)",
    "Emuqu/Sources/Analysis/BaselineTracker.swift::func BaselineTracker.update(with:sleepSchedule:)",
    "Emuqu/Sources/Analysis/BaselineTracker.swift::func BaselineTracker.deviation(for:sleepSchedule:)",
    "Emuqu/Sources/Collection/ArchiveSignal.swift::func ArchiveSignal.notifyChanged()",
    "Emuqu/Sources/Storage/Archive.swift::func SessionArchive.retrieveOrLog(_:caller:)"
   ],
   "reads": [
    "archive:index"
   ],
   "writes": [
    "archive:session file+index",
    "archive:modifiedAt stamp",
    "notif:flowRecoveryArchiveSessionsNeedReupload (merged)",
    "ck:session record",
    "file:HRVBaseline",
    "mem:SessionState.baselineDeviation",
    "mem:ArchiveSignal.version",
    "notif:flowRecoveryArchiveChanged"
   ],
   "branches": [
    {
     "at": "+1",
     "cond": "not complete or no analysisResult",
     "effect": "throws importNotAnalyzed"
    },
    {
     "at": "+4",
     "cond": "archive already holds a copy (same type, overlapping time)",
     "effect": "throws duplicateImport"
    },
    {
     "at": "+7",
     "cond": "merged into another id",
     "effect": "baseline/deviation use the re-read merged reading (the import when the read fails); no direct upload"
    },
    {
     "at": "+8",
     "cond": "saved under its own id",
     "effect": "uploadSession"
    },
    {
     "at": "+16",
     "cond": "deviation computed",
     "effect": "publishes it; nil leaves the previous deviation"
    }
   ],
   "flags": [],
   "deps": {
