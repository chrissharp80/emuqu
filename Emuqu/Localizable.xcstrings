    "“%@”" : {
      "comment" : "A text label that appears in the voice bar when voice input is in progress, showing a partial transcription of what the user is saying.",
      "isCommentAutoGenerated" : true,
      "shouldTranslate" : false
    },
    "\"End and save\" stops the arrow but keeps the trail in your history so you can route back to it later. \"Discard\" deletes it forever." : {
      "comment" : "An alert message in the \"Get Me Back\" view that explains the two options for ending a trail.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"إنهاء وحفظ\" يوقف السهم لكنه يحتفظ بالمسار في سجلك حتى تتمكن من العودة إليه لاحقًا. \"التخلّص\" يحذفه نهائيًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Afslut og gem\" stopper pilen, men beholder sporet i din historik, så du kan finde tilbage til det senere. \"Kassér\" sletter det for altid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Beenden und speichern\" stoppt den Pfeil, behält aber die Strecke in deinem Verlauf, damit du sie später erneut abrufen kannst. \"Verwerfen\" löscht sie endgültig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Finalizar y guardar\" detiene la flecha pero mantiene la ruta en tu historial para que puedas volver a ella más tarde. \"Descartar\" la elimina para siempre."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Lopeta ja tallenna\" pysäyttää nuolen mutta säilyttää reitin historiassasi, jotta voit palata siihen myöhemmin. \"Hylkää\" poistaa sen lopullisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Terminer et enregistrer » arrête la flèche mais conserve le tracé dans votre historique pour que vous puissiez y revenir plus tard. « Supprimer » l'efface définitivement."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Ljúka og vista\" stöðvar örina en heldur slóðinni í ferilskránni þinni svo þú getir farið aftur að henni síðar. \"Henda\" eyðir henni að eilífu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Termina e salva\" interrompe la freccia ma mantiene il percorso nella cronologia, così puoi ritrovarlo in seguito. \"Elimina\" lo cancella per sempre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「終了して保存」は矢印を停止しますが、軌跡は履歴に残るので、後で戻ることができます。「破棄」は永久に削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"종료 후 저장\"은 화살표를 멈추지만 경로를 기록에 남겨 나중에 다시 찾아갈 수 있습니다. \"삭제\"는 영구적으로 지웁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Avslutt og lagre\" stopper pilen, men beholder sporet i historikken din så du kan finne tilbake til det senere. \"Forkast\" sletter det for alltid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Beëindigen en opslaan\" stopt de pijl maar bewaart het spoor in je geschiedenis, zodat je er later naar terug kunt. \"Verwijderen\" wist het voorgoed."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Encerrar e salvar\" interrompe a seta, mas mantém o trajeto no seu histórico para que você possa retornar a ele mais tarde. \"Descartar\" o exclui para sempre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Завершить и сохранить» останавливает стрелку, но оставляет маршрут в истории, чтобы вы могли вернуться к нему позже. «Отменить» удаляет его навсегда."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Avsluta och spara\" stoppar pilen men behåller spåret i din historik så att du kan återvända till det senare. \"Kasta\" tar bort det för alltid."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"结束并保存\"会停止箭头，但会将轨迹保留在你的历史记录中，以便日后重新返回。\"放弃\"则会永久删除它。"
          }
        }
      }
    },
