    "Tap a suggestion below or type a question. Your data stays between you and %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على اقتراح أدناه أو اكتب سؤالًا. تبقى بياناتك بينك وبين %@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på et forslag nedenfor, eller skriv et spørgsmål. Dine data forbliver mellem dig og %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe unten auf einen Vorschlag oder gib eine Frage ein. Deine Daten bleiben zwischen dir und %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una sugerencia abajo o escribe una pregunta. Tus datos quedan entre tú y %@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta ehdotusta alla tai kirjoita kysymys. Tietosi pysyvät sinun ja palvelun %@ välillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une suggestion ci-dessous ou posez une question. Vos données restent entre vous et %@."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ýttu á tillögu hér fyrir neðan eða skrifaðu spurningu. Gögnin þín haldast á milli þín og %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un suggerimento qui sotto o scrivi una domanda. I tuoi dati restano tra te e %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下の候補をタップするか、質問を入力してください。データはあなたと %@ の間だけでやり取りされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래 제안을 탭하거나 질문을 입력하세요. 데이터는 사용자와 %@ 사이에서만 오갑니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på et forslag nedenfor eller skriv et spørsmål. Dataene dine blir mellom deg og %@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik hieronder op een suggestie of typ een vraag. Je gegevens blijven tussen jou en %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em uma sugestão abaixo ou digite uma pergunta. Seus dados ficam entre você e a %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите подсказку ниже или введите вопрос. Ваши данные остаются между вами и %@."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
