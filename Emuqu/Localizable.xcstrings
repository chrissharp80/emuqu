            "state" : "translated",
            "value" : "أي تطبيق أو جهاز يدعم BLE ضمن نطاق Bluetooth أثناء التمرين (عادةً ~10 م / 30 قدمًا)."
          }
        },
        "da" : {
          "stringUnit" : {
