   ],
   "branches": [
    {
     "at": "+2",
     "cond": "some sample has hr > 0",
     "effect": "currentHeartRate = last such hr; else unchanged"
    },
    {
     "at": "+5",
     "cond": "isStreaming false",
     "effect": "return after updating live HR only (no buffering)"
    },
    {
     "at": "+7",
     "cond": "for each sample where rrAvailable",
     "effect": "append its RRs; samples without RR are skipped"
    },
    {
     "at": "+8",
     "cond": "appendStreamedBeats returned false (cap hit)",
     "effect": "break out of the batch"
    }
   ],
