   "key": "func RouteTRIMPEstimator.scaledEstimate(priorAvgRatio:recordedRatio:priorCount:targetDistance:)",
   "hash": "0ecbeec46ff47c15",
   "does": "Chooses the case: prior+today → 0.6/0.4 blend × distance with confidence min(0.85, 0.4+0.15·n); prior only → prior × distance, priorDominant; today only → today × distance at 0.4; neither → nil.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+9",
     "cond": "(prior, today) both present",
     "effect": "blend, priorConfidence, priorDominant false"
    },
    {
     "at": "+13",
     "cond": "prior present, today nil",
     "effect": "prior × distance, priorConfidence, priorDominant true"
    },
    {
     "at": "+17",
     "cond": "prior nil, today present",
     "effect": "today × distance, confidence 0.4 (floor)"
    },
    {
     "at": "+21",
     "cond": "both nil",
     "effect": "nil"
    }
   ],
