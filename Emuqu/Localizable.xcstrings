    "Moisten the strap's electrodes and make sure it sits snugly against your skin." : {
      "comment" : "Advice in a banner shown during a workout when the chest strap is connected but has stopped sending heart rate.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رطِّب أقطاب الحزام وتأكد من أنه ملاصق لبشرتك بإحكام."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fugt bæltets elektroder, og sørg for, at det sidder tæt mod huden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Befeuchte die Elektroden des Gurts und achte darauf, dass er eng auf der Haut sitzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Humedece los electrodos de la banda y asegúrate de que quede bien ajustada a la piel."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostuta pannan elektrodit ja varmista, että panta on tiiviisti ihoa vasten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Humidifiez les électrodes de la ceinture et assurez-vous qu'elle est bien ajustée contre la peau."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vættu rafskaut beltisins og gættu þess að það liggi þétt að húðinni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inumidisci gli elettrodi della fascia e assicurati che aderisca bene alla pelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストラップの電極を湿らせ、肌にしっかり密着させてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스트랩 전극을 적시고 피부에 밀착되어 있는지 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fukt elektrodene på beltet og sørg for at det sitter tett mot huden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maak de elektroden van de band vochtig en zorg dat hij strak tegen je huid zit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umedeça os eletrodos da cinta e verifique se ela está bem ajustada à pele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смочите электроды ремня и убедитесь, что он плотно прилегает к коже."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fukta bandets elektroder och se till att det sitter tätt mot huden."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请润湿心率带的电极，并确保它紧贴皮肤。"
          }
        }
      }
    },
