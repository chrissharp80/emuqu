            "value" : "Seus dados foram salvos. O treinador analisará quando você reconectar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши данные сохранены. Тренер проанализирует при переподключении."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
