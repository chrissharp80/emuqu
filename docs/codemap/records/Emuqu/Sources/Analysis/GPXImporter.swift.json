   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+5",
     "cond": "times nil",
     "effect": "every point stamped Date() (now)"
    },
    {
     "at": "+8",
     "cond": "pointTimes empty",
     "effect": "start = now"
    },
    {
     "at": "+11",
     "cond": "pointTimes empty",
     "effect": "end = start"
    },
    {
     "at": "+14",
     "cond": "point has own time and hr",
     "effect": "included; else skipped (points with inherited time lose their HR)"
    },
    {
     "at": "+18",
     "cond": "point has own time and cad",
     "effect": "included; else skipped"
    },
    {
     "at": "+23",
