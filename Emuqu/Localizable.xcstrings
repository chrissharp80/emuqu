    "Am I ramping too fast?" : {
      "comment" : "Suggestion prompt for the \"Training\" category in the CoachHomeV2View.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أزيد الحمل بسرعة كبيرة؟"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Øger jeg for hurtigt?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steigere ich zu schnell?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estoy aumentando demasiado rápido?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nostanko kuormaa liian nopeasti?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Est-ce que j’augmente ma charge trop vite ?"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er ég að auka of hratt?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sto aumentando troppo in fretta?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "負荷を上げるのが速すぎますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "너무 빠르게 늘리고 있나요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Øker jeg for raskt?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bouw ik te snel op?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
