        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sækja nýjustu svefnskyndimynd aftur. Núverandi breytingum þínum verður hent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recupera di nuovo l'ultima istantanea del sonno. Le tue modifiche attuali verranno annullate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
