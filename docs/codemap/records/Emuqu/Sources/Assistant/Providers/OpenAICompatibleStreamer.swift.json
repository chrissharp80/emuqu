    {
     "at": "+10",
     "cond": "for each conversation turn",
     "effect": "appends one message."
    },
    {
     "at": "+12",
     "cond": "turn.role == .user",
     "effect": ".plainUser; otherwise .plainAssistant (non-user roles all become assistant)."
    },
