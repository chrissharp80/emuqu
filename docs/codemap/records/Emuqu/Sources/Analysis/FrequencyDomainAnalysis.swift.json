  "mem:FrequencyDomainAnalyzer.resampleFrequency = 4.0",
  "mem:FrequencyDomainAnalyzer.vlfRange/lfRange/hfRange (0.003..<0.04, 0.04..<0.15, 0.15...0.4 Hz)",
  "mem:FrequencyDomainAnalyzer.vlfMinDuration = 10 min (its own constant)",
  "mem:FrequencyDomainAnalyzer.defaultWelchSegmentLength = 256",
  "mem:FrequencyDomainAnalyzer.vlfWelchSegmentLength = 1024",
  "mem:FrequencyDomainAnalyzer.welchOverlap = 0.5"
 ],
