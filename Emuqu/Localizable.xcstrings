    "Apple Health has no activity recorded after that recording started, so there is nothing to rebuild it from." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد في Apple Health أي نشاط مسجَّل بعد بدء ذلك التسجيل، لذا لا يوجد ما يُعاد البناء منه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health har ingen registreret aktivitet efter at optagelsen begyndte, så der er intet at genopbygge den ud fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health hat nach dem Start dieser Aufzeichnung keine Aktivität erfasst — es gibt also nichts, woraus sie wiederhergestellt werden könnte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health no tiene ninguna actividad registrada después de que empezó esa grabación, así que no hay nada con lo que reconstruirla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Healthissa ei ole tallennettua aktiivisuutta tallennuksen alkamisen jälkeen, joten siitä ei ole mitään mistä rakentaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Santé n’a enregistré aucune activité après le début de cet enregistrement : il n’y a donc rien pour le reconstruire."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health hefur enga skráða hreyfingu eftir að upptakan hófst, svo það er ekkert til að endurbyggja hana úr."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Salute non ha alcuna attività registrata dopo l’inizio di quella registrazione, quindi non c’è nulla da cui ricostruirla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その記録の開始後に Apple ヘルスケアに残っているアクティビティがないため、再構築する材料がありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 기록이 시작된 이후의 활동이 Apple 건강에 없어서 다시 만들 근거가 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
