          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup bruto incremental — A cada 5 minutos durante a gravação, e também imediatamente ao reconectar o Bluetooth."
          }
        },
        "ru" : {
          "stringUnit" : {
