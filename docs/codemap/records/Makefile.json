  {
   "key": "target clean-build",
   "hash": "becc86aa3b99e96e",
   "does": "Finds top-level directories under build/ with mtime older than 14 days; if none prints a \"nothing older than 14 days\" message, else prints their sizes with du -sh, deletes them with rm -rf, and prints a removal message.",
   "entry": "`make clean-build` from a developer shell",
   "calls": [],
   "reads": [],
   "writes": [
    "file:build/*"
   ],
   "branches": [
    {
     "at": "+2",
     "cond": "no build/ subdirectory older than 14 days (or build/ absent; find errors to /dev/null)",
     "effect": "prints nothing-to-do message; else du -sh and rm -rf the unquoted list (word-split, so a directory name with spaces would be split) and print removed"
    }
   ],
   "deps": {}
  },
