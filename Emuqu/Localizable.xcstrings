    "Far below your usual range. Worth a rest day." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أقل بكثير من نطاقك المعتاد. يستحق يوم راحة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langt under dit sædvanlige område. En hviledag er værd at tage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weit unter deinem üblichen Bereich. Ein Ruhetag wäre sinnvoll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muy por debajo de tu rango habitual. Merece la pena un día de descanso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selvästi tavanomaisen vaihteluvälisi alapuolella. Lepopäivä kannattaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien en dessous de votre plage habituelle. Un jour de repos serait utile."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langt undir venjulegu bili þínu. Vert að taka hvíldardag."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Molto al di sotto del tuo intervallo abituale. Vale la pena un giorno di riposo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつもの範囲を大きく下回っています。休養日にする価値があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평소 범위보다 훨씬 낮습니다. 휴식일을 가질 만합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Langt under det vanlige området ditt. Verdt en hviledag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ver onder je gebruikelijke bereik. Een rustdag is de moeite waard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muito abaixo da sua faixa habitual. Vale um dia de descanso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Намного ниже вашего обычного диапазона. Стоит взять день отдыха."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Långt under ditt vanliga intervall. Värt en vilodag."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远低于你的常规范围。值得休息一天。"
          }
        }
      }
    },
