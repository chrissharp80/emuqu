    "This moves the reading to the Trash. You can restore it from Settings → iCloud & Data → Trash." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُنقل هذا القياس إلى سلة المحذوفات. يمكنك استعادته من الإعدادات ← iCloud والبيانات ← سلة المحذوفات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Målingen flyttes til papirkurven. Du kan gendanne den fra Indstillinger → iCloud og data → Papirkurv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Messung wird in den Papierkorb verschoben. Du kannst sie unter Einstellungen → iCloud & Daten → Papierkorb wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La medición se moverá a la papelera. Puedes restaurarla desde Ajustes → iCloud y datos → Papelera."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mittaus siirretään roskakoriin. Voit palauttaa sen kohdasta Asetukset → iCloud ja tiedot → Roskakori."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mesure sera placée dans la corbeille. Vous pouvez la restaurer depuis Réglages → iCloud et données → Corbeille."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mælingin færist í ruslið. Þú getur endurheimt hana í Stillingar → iCloud og gögn → Rusl."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La misurazione verrà spostata nel Cestino. Puoi ripristinarla da Impostazioni → iCloud e dati → Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この測定はゴミ箱に移動されます。設定 → iCloudとデータ → ゴミ箱 から復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 측정은 휴지통으로 이동됩니다. 설정 → iCloud 및 데이터 → 휴지통에서 복원할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Målingen flyttes til papirkurven. Du kan gjenopprette den fra Innstillinger → iCloud og data → Papirkurv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De meting wordt naar de prullenbak verplaatst. Je kunt hem terugzetten via Instellingen → iCloud en gegevens → Prullenbak."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A medição será movida para a Lixeira. Você pode restaurá-la em Configurações → iCloud e dados → Lixeira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Измерение будет перемещено в корзину. Его можно восстановить в разделе Настройки → iCloud и данные → Корзина."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mätningen flyttas till papperskorgen. Du kan återställa den från Inställningar → iCloud och data → Papperskorg."
