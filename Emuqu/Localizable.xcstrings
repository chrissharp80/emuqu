    "This wipes the chat thread. Your API keys and recovery data are not affected." : {
      "comment" : "An alert message that appears when the user chooses to clear the chat.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا يمسح سلسلة المحادثة. لن تتأثر مفاتيح API الخاصة بك وبيانات التعافي."
