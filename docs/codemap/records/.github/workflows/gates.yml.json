  {
   "key": "step script-gates/Debt budgets ratchet down only",
   "hash": "0e2ce7a25cb5ff6b",
   "does": "Budget ratchet, always with BUDGET_REQUIRE_BASELINE=1 so a baseline that does not resolve fails the step. On a pull_request compares against origin/$GITHUB_BASE_REF. On a push compares against the tip before the push (github.event.before, passed as PUSH_BEFORE) when it is set, not the null SHA, and resolves to a commit in the checkout, so every commit of a multi-commit push is inside the compared range and the budget-raise-ok trailer scan. Otherwise (dispatch, or a created/forced push whose before-commit is absent) compares against HEAD~1, printing a note when a push's before-commit was unusable; on a root commit prints a message and passes.",
   "entry": "GitHub Actions step in gates.yml job script-gates (on push to main, every pull_request, and manual dispatch); a failing step fails the job and skips later steps",
   "calls": [
    "ext:script scripts/check_budget_monotonicity.sh",
    "scripts/check_budget_monotonicity.sh::fn no_baseline",
    "scripts/check_budget_monotonicity.sh::fn is_allowed",
    "scripts/check_budget_monotonicity.sh::fn is_floor",
    "scripts/check_budget_monotonicity.sh::fn read_number",
    "scripts/check_budget_monotonicity.sh::fn loosens",
    "scripts/check_budget_monotonicity.sh::fn report_loosened",
    "scripts/check_budget_monotonicity.sh::fn budget_files"
   ],
   "reads": [
    "file:.ci/*.txt",
    "env:github.event.before"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+5",
     "cond": "GITHUB_BASE_REF non-empty (pull_request event)",
     "effect": "compare against origin/<base> with a baseline required; an unresolvable base fails"
    },
    {
     "at": "+7",
     "cond": "PUSH_BEFORE set, not 40 zeros, and resolves to a commit",
     "effect": "compare against the tip before the push with a baseline required"
    },
    {
     "at": "+10",
     "cond": "HEAD~1 resolves (dispatch, or a push whose before-commit is null or absent)",
     "effect": "compare against the parent commit with a baseline required; prints a note first when PUSH_BEFORE was set (+11)"
    },
    {
     "at": "+15",
     "cond": "none of the above (root commit)",
     "effect": "echo and pass without comparing"
    }
   ],
   "deps": {
    "scripts/check_budget_monotonicity.sh::": "e7994e90b3de4f7e",
    "scripts/check_budget_monotonicity.sh::fn budget_files": "0ce529da21619702",
