    "Fatigue far exceeds fitness — recent load is heavily outpacing your base" : {
      "comment" : "Description of a situation where a person's fatigue is significantly higher than their fitness level, indicating that recent physical activity is disproportionately taxing.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
