    "%lld-min Z2 work, α1 averaged above 0.75. Body absorbed the load cleanly." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld دقيقة عمل في المنطقة 2، وكان متوسط α1 فوق 0.75. استوعب الجسم الحمل بنظافة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld min Z2-arbejde, α1 lå i gennemsnit over 0,75. Kroppen optog belastningen rent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Min Z2-Arbeit, α1 lag im Mittel über 0,75. Der Körper hat die Belastung sauber verarbeitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld min de trabajo en Z2, α1 promedió por encima de 0,75. El cuerpo absorbió la carga limpiamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld min Z2-työtä, α1:n keskiarvo oli yli 0,75. Keho otti kuorman vastaan puhtaasti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld min de travail en Z2, α1 en moyenne au-dessus de 0,75. Le corps a absorbé la charge proprement."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld mín Z2-vinna, α1 var að meðaltali yfir 0,75. Líkaminn tók álagið vel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld min di lavoro in Z2, α1 in media sopra 0,75. Il corpo ha assorbito bene il carico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z2 で %lld 分、α1 の平均は 0.75 超。身体は負荷をきれいに吸収しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z2에서 %lld분, α1 평균이 0.75 위. 몸이 부하를 깔끔하게 흡수했습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld min Z2-arbeid, α1 lå i snitt over 0,75. Kroppen tok opp belastningen rent."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld min Z2-werk, α1 lag gemiddeld boven 0,75. Het lichaam verwerkte de belasting soepel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld min de trabalho em Z2, α1 ficou em média acima de 0,75. O corpo absorveu a carga com folga."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld мин работы в Z2, α1 в среднем был выше 0,75. Организм чисто усвоил нагрузку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld min Z2-arbete, α1 låg i snitt över 0,75. Kroppen tog upp belastningen rent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z2 训练 %lld 分钟，α1 平均高于 0.75。身体干净地吸收了负荷。"
          }
        }
      }
    },
