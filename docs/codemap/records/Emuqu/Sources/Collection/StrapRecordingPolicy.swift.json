   "hash": "ac173926cd87aa9b",
   "does": "Start preconditions: notConnected unless API, device id and .connected; alreadyRecording if app state is not .idle or the strap reports recording; else startVeritySense or startH10 by device type.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+8",
     "cond": "missing API/device id or not connected",
     "effect": "returns .notConnected"
    },
    {
     "at": "+9",
     "cond": "recordingState != .idle or isRecordingOnDevice",
     "effect": "returns .alreadyRecording"
    },
    {
     "at": "+10",
     "cond": "deviceType == .veritySense",
     "effect": ".startVeritySense; else (H10 or nil type) .startH10"
    }
   ],
   "flags": [],
