          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typisch bereik: 0,2-0,5. Lage verhoudingen wijzen op verminderde parasympathische modulatie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faixa típica: 0,2-0,5. Razões baixas sugerem menor modulação parassimpática."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Типичный диапазон: 0,2-0,5. Низкие значения указывают на сниженную парасимпатическую модуляцию."
          }
        },
        "sv" : {
          "stringUnit" : {
