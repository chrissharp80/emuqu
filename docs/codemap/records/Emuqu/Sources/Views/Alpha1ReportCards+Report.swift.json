{
 "file": "Emuqu/Sources/Views/Alpha1ReportCards+Report.swift",
 "hash": "9b242776e6fe3a55",
 "role": "Post-workout DFA-α1 report: α1 chart with AT1/AT2 rules and 'beat artifact' markers, plain-English threshold summary, avg/max/min and band totals, plus a route map coloured by α1 band. Also hosts the pure, nonisolated ectopic-shadow detector, band-totals/AT1-crossing rule and sample timing shared with the workout snapshot builder and PDF.",
 "types": [
  "Alpha1ReportCards: extension — α1 report and route cards",
  "Alpha1ReportCards.EctopicShadow: struct — a short sub-0.75 α1 dip with padded start/end, deepest offset and value",
  "Alpha1ReportCards.Alpha1Dip: struct — open sub-threshold run tracked until recovery",
  "Alpha1ReportCards.Alpha1Stats: struct — avg/max/min α1, band seconds, first AT1 crossing",
  "Alpha1ReportCards.Alpha1Bands: struct — accumulator for band seconds + first crossing",
  "Alpha1ReportCards.AT1CrossDetector: struct — warmup(120 s)+armed+sustain(180 s) crossing state machine",
  "Alpha1ReportCards.Alpha1Segment: struct — coordinates + colour of one route run",
  "Alpha1ReportCards.Alpha1SegmentBuilder: struct — groups consecutive fixes into same-colour runs"
 ],
 "state": [
  "mem:Alpha1ReportCards.maxSampleGapSec = 5 (static let)",
  "mem:Alpha1Dip.windowSec=120 / approachPad=60 / recoveryPad=120 (private static lets)",
  "mem:AT1CrossDetector.warmupSec=120 / sustainSec=180",
  "mem:UtilityServices.alpha1StatsCache (single-entry Alpha1StatsCache, read/written here)",
  "mem:Alpha1ReportCards.effortHeartRateRise = 10 bpm (static let)"
 ],
