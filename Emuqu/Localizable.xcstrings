    "Flo is off, or its notice hasn't been accepted yet. Open the Flo tab to turn it on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flo متوقف، أو لم يُقبَل إشعاره بعد. افتح علامة تبويب Flo لتشغيله."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flo er slået fra, eller meddelelsen er ikke accepteret endnu. Åbn fanen Flo for at slå den til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flo ist aus, oder der Hinweis wurde noch nicht akzeptiert. Öffne den Tab Flo, um es einzuschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flo está desactivado o aún no has aceptado su aviso. Abre la pestaña Flo para activarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flo on pois päältä, tai sen ilmoitusta ei ole vielä hyväksytty. Avaa Flo-välilehti ottaaksesi sen käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flo est désactivé, ou son avertissement n’a pas encore été accepté. Ouvrez l’onglet Flo pour l’activer."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slökkt er á Flo, eða tilkynning þess hefur ekki enn verið samþykkt. Opnaðu Flo-flipann til að kveikja á því."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flo è disattivato o la sua informativa non è ancora stata accettata. Apri la scheda Flo per attivarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flo がオフになっているか、案内にまだ同意していません。Flo タブを開いてオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flo가 꺼져 있거나 안내에 아직 동의하지 않았습니다. Flo 탭을 열어 켜세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flo er slått av, eller merknaden er ikke godtatt ennå. Åpne Flo-fanen for å slå den på."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flo staat uit, of de melding is nog niet geaccepteerd. Open het tabblad Flo om het aan te zetten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Flo está desativado ou o aviso dele ainda não foi aceito. Abra a aba Flo para ativá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flo выключен, или его уведомление ещё не принято. Откройте вкладку Flo, чтобы включить его."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flo är avstängt, eller så har meddelandet inte godkänts än. Öppna fliken Flo för att slå på det."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flo 已关闭，或尚未接受其说明。打开 Flo 标签页即可开启。"
          }
        }
      }
    },
