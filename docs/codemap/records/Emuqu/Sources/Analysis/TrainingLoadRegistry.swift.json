    "mem:TrainingMetricsCache.lastUpdated"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "sampleOn(today) exists",
     "effect": "uses it"
    },
    {
     "at": "+2",
     "cond": "?? samplesSince(today-7d).first",
     "effect": "newest sample within 7 days (samplesSince sorts newest first) when today is missing"
    },
    {
     "at": "+4",
     "cond": "day.ctl > 0",
     "effect": "acwr = atl/ctl; else nil"
