   "key": "func MedicalQueryGuard.classify(_:)",
   "hash": "1aaac3c2f48f8ee5",
   "does": "Trims the text, folds typographic apostrophes (U+2018, U+2019, U+02BC) to ASCII ' so iOS Smart Punctuation input matches patterns written with ', then tests the compiled groups in order selfHarm, emergency (symptom), injury, rhythm, general concern (symptom), returning the first matching Trigger or nil; matching is case-insensitive regex.",
   "entry": null,
   "calls": [],
   "reads": [
    "mem:MedicalQueryGuard.selfHarmPatterns",
    "mem:MedicalQueryGuard.emergencyPatterns",
    "mem:MedicalQueryGuard.injuryPatterns",
    "mem:MedicalQueryGuard.rhythmPatterns",
    "mem:MedicalQueryGuard.generalConcernPatterns"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+3",
     "cond": "trimmed text empty",
     "effect": "true: nil (proceed); false: run patterns"
    },
    {
     "at": "+15",
     "cond": "any self-harm pattern matches",
     "effect": "return .selfHarm"
    },
    {
     "at": "+16",
     "cond": "any emergency pattern matches",
     "effect": "return .symptom"
    },
    {
     "at": "+17",
     "cond": "any injury pattern matches",
     "effect": "return .injury"
    },
    {
     "at": "+18",
     "cond": "any rhythm pattern matches",
     "effect": "return .rhythm"
    },
    {
     "at": "+19",
     "cond": "any general-concern (danger judgement) pattern matches",
     "effect": "return .symptom; else nil"
    }
   ],
