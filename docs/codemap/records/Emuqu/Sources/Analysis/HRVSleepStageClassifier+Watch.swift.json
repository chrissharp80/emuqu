   "key": "func HRVSleepStageClassifier.decideAugmentedStage(watch:score:)",
   "hash": "8527655ee2de375d",
   "does": "Per-Watch-stage override rules: core/unspecified → augmentedFromCore; awake → REM if LF/HF available, REM > 0.68 and awake < 0.80; deep → REM if LF/HF available, REM > 0.72 and deep < 0.40; REM → deep if deep > 0.72 and the unforced REM evidence (remEvidence, else remScore) < 0.40 (no LF/HF gate), so the first-hour REM suppression is not read as opposing evidence.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Analysis/HRVSleepStageClassifier+Watch.swift::func HRVSleepStageClassifier.augmentedFromCore(watch:score:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+5",
     "cond": "watch .core/.unspecified",
     "effect": "delegate to augmentedFromCore"
    },
    {
     "at": "+7",
     "cond": "watch .awake",
     "effect": "check awake→REM rule"
    },
    {
     "at": "+8",
     "cond": "hasFreq && rem > 0.68 && awake < 0.80",
     "effect": "true: .rem; false: keep awake"
    },
    {
     "at": "+12",
     "cond": "watch .deep",
     "effect": "check deep→REM rule"
    },
    {
     "at": "+13",
     "cond": "hasFreq && rem > 0.72 && deep < 0.40",
     "effect": "true: .rem; false: keep deep"
    },
    {
     "at": "+17",
     "cond": "watch .rem",
     "effect": "check REM→deep rule"
    },
    {
     "at": "+18",
     "cond": "deep > 0.72 && (remEvidence ?? remScore) < 0.40",
     "effect": "true: .deep; false: keep REM"
    }
   ],
   "deps": {
