    "Ensure the optical sensor sits flat against your skin with no gaps" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكد من أن المستشعر البصري مستوٍ على بشرتك دون فراغات"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sørg for, at den optiske sensor ligger fladt mod huden uden mellemrum"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achte darauf, dass der optische Sensor ohne Lücken flach auf der Haut aufliegt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que el sensor óptico quede plano sobre la piel, sin huecos"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varmista, että optinen anturi on tasaisesti ihoa vasten ilman rakoja"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que le capteur optique est bien à plat contre la peau, sans espace"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gakktu úr skugga um að ljósneminn liggi flatur að húðinni án bila"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assicurati che il sensore ottico aderisca bene alla pelle, senza spazi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "光学センサーが隙間なく肌に平らに密着していることを確認してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "광학 센서가 틈 없이 피부에 평평하게 닿도록 하세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sørg for at den optiske sensoren ligger flatt mot huden uten mellomrom"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorg dat de optische sensor plat tegen je huid ligt, zonder openingen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique se o sensor óptico fica rente à pele, sem folgas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что оптический датчик прилегает к коже ровно, без зазоров"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se till att den optiska sensorn ligger plant mot huden utan glipor"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确保光学传感器平贴皮肤，没有空隙"
          }
        }
      }
    },
