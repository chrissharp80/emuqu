    },
    "It reaches a third party only when you use a cloud AI provider you have agreed to, as described below." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تصل إلى طرف ثالث إلا عندما تستخدم مزوّد ذكاء اصطناعي سحابيًا وافقت عليه، كما هو موضّح أدناه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De når kun en tredjepart, når du bruger en cloud-AI-udbyder, du har givet samtykke til, som beskrevet nedenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An Dritte gelangen sie nur, wenn du einen Cloud-KI-Anbieter nutzt, dem du zugestimmt hast, wie unten beschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo llegan a un tercero cuando usas un proveedor de IA en la nube que has aceptado, como se describe a continuación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se päätyy kolmannelle osapuolelle vain, kun käytät pilvipohjaista tekoälypalveluntarjoajaa, jonka olet hyväksynyt, kuten alla kuvataan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles ne parviennent à un tiers que lorsque vous utilisez un fournisseur d’IA cloud que vous avez accepté, comme décrit ci-dessous."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þau berast aðeins til þriðja aðila þegar þú notar gervigreindarþjónustu í skýinu sem þú hefur samþykkt, eins og lýst er hér að neðan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
