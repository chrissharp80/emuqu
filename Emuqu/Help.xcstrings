    "Wake up mid-night? Pause your recording and resume later" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استيقظت في منتصف الليل؟ أوقف التسجيل مؤقتًا واستأنفه لاحقًا"
          }
        },
        "da" : {
          "stringUnit" : {
