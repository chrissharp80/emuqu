    "Less studied than α1. Values around 1.0 are typical at rest." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أقل دراسة من α1. القيم القريبة من 1.0 معتادة أثناء الراحة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindre undersøgt end α1. Værdier omkring 1,0 er typiske i hvile."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger erforscht als α1. Werte um 1,0 sind in Ruhe typisch."
          }
        },
        "es" : {
          "stringUnit" : {
