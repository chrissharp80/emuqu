    "Window for a quality session if your plan calls for one. Otherwise easy aerobic to bank volume." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فرصة لجلسة نوعية إذا كانت خطتك تتضمنها. وإلا فتمرين هوائي سهل لزيادة الحجم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plads til en kvalitetssession, hvis din plan lægger op til det. Ellers let aerobt for at samle volumen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raum für eine Qualitätseinheit, wenn dein Plan eine vorsieht. Sonst locker im Ausdauerbereich, um Umfang zu sammeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay margen para una sesión de calidad si tu plan la incluye. Si no, aeróbico suave para sumar volumen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilaa laatuharjoitukselle, jos suunnitelmasi sitä vaatii. Muuten kevyttä aerobista volyymin kartuttamiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fenêtre pour une séance de qualité si votre plan en prévoit une. Sinon, aérobie facile pour accumuler du volume."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svigrúm fyrir gæðaæfingu ef áætlunin gerir ráð fyrir henni. Annars létt þolæfing til að safna magni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazio per una sessione di qualità, se il tuo piano la prevede. Altrimenti aerobico facile per accumulare volume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計画にあれば質の高いセッションの好機です。なければ軽い有酸素で量を積みましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획에 있다면 고강도 세션을 할 기회입니다. 아니라면 가벼운 유산소로 운동량을 쌓으세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rom for en kvalitetsøkt hvis planen din legger opp til det. Ellers lett aerobt for å samle volum."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruimte voor een kwaliteitstraining als je schema daarom vraagt. Anders rustig duurwerk om volume op te bouwen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espaço para uma sessão de qualidade, se o seu plano pedir. Caso contrário, aeróbico leve para acumular volume."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Есть возможность для качественной тренировки, если она в плане. Иначе — лёгкая аэробная работа для объёма."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrymme för ett kvalitetspass om din plan har ett. Annars lätt aerobt för att samla volym."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果计划中有高质量训练，现在是好时机。否则就做轻松有氧来积累训练量。"
          }
        }
      }
    },
