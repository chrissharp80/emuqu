        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши потоковые данные в безопасности. Резервное копирование на устройство необязательно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
