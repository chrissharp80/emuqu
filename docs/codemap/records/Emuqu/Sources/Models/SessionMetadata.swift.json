   "key": "init HRVSession(from:)",
   "hash": "10d38045201da06c",
   "does": "Decodes an HRVSession: required id/startDate/state, sessionType defaulting to .overnight, tags to [], sourceSchemaVersion from payloadSchemaVersion (stated version, or newer than this build when an enum case is unknown), skips rrSeries when decoder.userInfo[.skipRRSeries]==true, reads SessionState/SessionType/HRVDataQuality leniently (unknown case → .complete / .quick / .insufficient), migrates trainingSnapshot from analysisResult.trainingContext, validates perceivedReadiness, decodes morningFeelingTags via MorningFeelingTagArray; any other field's decode error throws.",
   "entry": "Decodable synthesis use by JSONDecoder in SessionArchive/CloudKit paths",
   "calls": [
    "Emuqu/Sources/Models/SessionMetadata.swift::func HRVSession.payloadSchemaVersion(in:)",
    "Emuqu/Sources/Models/SessionMetadata.swift::func KeyedDecodingContainer.decodeKnown(_:forKey:unknown:)",
    "Emuqu/Sources/Models/SessionMetadata.swift::func KeyedDecodingContainer.decodeKnownIfPresent(_:forKey:unknown:)",
    "Emuqu/Sources/Models/SessionMetadata.swift::func HRVSession.validPerceivedReadiness(_:)",
    "Emuqu/Sources/Models/MorningFeelingTag.swift::init MorningFeelingTagArray(from:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+7",
     "cond": "payloadSchemaVersion",
     "effect": "stated version (0 when absent), or currentSchemaVersion+1 when an enum case is unknown — the archive then refuses to re-write the lossy decode"
    },
    {
     "at": "+11",
     "cond": "state raw value unknown to this build",
     "effect": ".complete (missing state still throws)"
    },
    {
     "at": "+12",
     "cond": "sessionType absent / unknown",
     "effect": "absent → .overnight; unknown → .quick (kept out of the overnight baseline)"
    },
    {
     "at": "+14",
     "cond": "userInfo[.skipRRSeries] == true ?:",
     "effect": "true: rrSeries nil (lightweight decode via SessionArchive.lightweightSessionDecoder); false: decodes rrSeries"
    },
    {
     "at": "+20",
     "cond": "tags absent ?? []",
     "effect": "empty tags"
    },
    {
     "at": "+39",
     "cond": "trainingSnapshot absent ?? analysisResult?.trainingContext",
     "effect": "legacy sessions take training context from the analysis result"
    },
    {
     "at": "+46",
     "cond": "hrvDataQuality unknown",
     "effect": ".insufficient (excluded from HRV aggregates)"
    }
   ],
   "flags": [],
   "deps": {
    "Emuqu/Sources/Models/MorningFeelingTag.swift::init MorningFeelingTagArray(from:)": "95e5ec417e853349",
