  {
   "key": "func HealthWorkoutSummary.summary(from:archive:)",
   "hash": "58e3246aa07de537",
   "does": "Lightweight-decodes the session (retrieveLightweightOrLog — a read failure is logged with the session id and counted by the archive), requires workoutMetadata, clamps duration, drops <60 s, and builds a summary with avg HR = session.meanHR ?? mean of sample HRs, max HR from samples, precomputed load from TrainingLoadPrecedence.stored, wasRecovered = partialDataReason != nil.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Storage/Archive.swift::func SessionArchive.retrieveLightweightOrLog(_:caller:)",
    "Emuqu/Sources/Collection/HealthDataTypes.swift::func HealthWorkoutSummary.clampedDuration(samples:entry:)",
    "Emuqu/Sources/Collection/TrainingLoadPrecedence.swift::func TrainingLoadPrecedence.stored(_:ftp:)",
    "Emuqu/Sources/Collection/HealthDataTypes.swift::func HealthWorkoutSummary.activityTypeFromSport(_:)",
    "Emuqu/Sources/Collection/HealthDataTypes.swift::func HealthWorkoutSummary.mean(_:)",
    "Emuqu/Sources/Collection/HealthDataTypes.swift::init HealthWorkoutSummary(date:type:durationMinutes:caloriesBurned:averageHR:maxHR:precomputedLoad:precomputedLoadSource:wasRecovered:)"
   ],
   "reads": [
    "archive:SessionArchive.retrieveLightweight"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+4",
     "cond": "session readable and workoutMetadata non-nil",
     "effect": "false: nil — a read failure is logged by the archive; the workout is left out of training load"
    },
    {
     "at": "+7",
     "cond": "meta.samples ?? []",
     "effect": "no samples: empty"
    },
    {
     "at": "+9",
     "cond": "duration >= 60 s",
     "effect": "false: nil"
    },
    {
     "at": "+17",
     "cond": "session.meanHR ?? mean(sampleHRs)",
     "effect": "no meanHR: sample mean (nil when no sample HR)"
    }
   ],
   "flags": [],
   "deps": {
    "Emuqu/Sources/Collection/HealthDataTypes.swift::func HealthWorkoutSummary.activityTypeFromSport(_:)": "c4f5f96d0e2a9d71",
    "Emuqu/Sources/Collection/HealthDataTypes.swift::func HealthWorkoutSummary.clampedDuration(samples:entry:)": "dea5ef8c86a1bc7a",
