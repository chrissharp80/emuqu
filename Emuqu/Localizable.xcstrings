          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch volgt de regio van je apparaat; anders metrisch of imperiaal"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático segue a região do seu dispositivo; caso contrário, métrico ou imperial"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоматически — по региону устройства; иначе метрическая или имперская система"
          }
        },
        "sv" : {
