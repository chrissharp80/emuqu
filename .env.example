# Environment variables scripts/run_tests_with_coverage.sh reads.
# Nothing loads a .env file for you: copy this to .env and export it into your
# shell first (`set -a; . ./.env; set +a`), or set the variables inline on the
# command line. A value only written to .env is ignored.
SCHEME=Emuqu
PROJECT=Emuqu.xcodeproj
# The coverage floors live in .ci/min_coverage.txt, .ci/min_coverage_logic.txt
# and .ci/min_coverage_views.txt. MIN_COVERAGE overrides the committed overall
# floor, and any value below it loosens the gate, so there is no example value:
# leave it unset unless you are deliberately testing a different threshold.

# Optional explicit simulator destination
# DESTINATION=id=<simulator-id>
