    "Latency needs Sleep Schedule wind-down or starting the strap before bed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب زمن الاستغراق تفعيل فترة الاسترخاء في جدول النوم أو بدء الحزام قبل النوم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indsovningstid kræver nedtrapning i Sleep Schedule eller at pulsbæltet startes før sengetid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einschlafdauer erfordert die Wind-down-Phase im Schlafplan oder das Starten des Gurts vor dem Zubettgehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La latencia requiere la fase de relajación del Horario de sueño o iniciar la banda antes de acostarte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nukahtamisviive vaatii unirytmin rauhoittumisvaiheen tai pannan käynnistämisen ennen nukkumaanmenoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La latence nécessite la phase d’endormissement de l’Horaire de sommeil ou de démarrer la ceinture avant le coucher."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svefnbið krefst niðurróunar í Svefnáætlun eða að ólin sé ræst fyrir háttinn."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La latenza richiede la fase di rilassamento della Pianificazione sonno o l’avvio della fascia prima di coricarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入眠潜時には、睡眠スケジュールのワインドダウン、または就寝前にストラップを開始する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입면 잠복기를 보려면 수면 일정의 취침 준비 시간을 쓰거나, 잠들기 전에 스트랩을 시작해야 합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innsovningstid krever nedtrapping i Søvnplan eller at pulsbeltet startes før leggetid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inslaaptijd vereist de afbouwfase van het Slaapschema of de band starten vóór het slapengaan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A latência exige a fase de desaceleração da Agenda de Sono ou iniciar a cinta antes de dormir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для латентности нужен период подготовки ко сну в расписании сна или запуск датчика перед сном."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insomningstid kräver nedvarvning i Sömnschema eller att pulsbandet startas före läggdags."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入睡潜伏期需要使用睡眠计划的放松时段，或在就寝前启动心率带。"
          }
        }
      }
    },
