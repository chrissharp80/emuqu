   "hash": "a5767ecbc16f0b7a",
   "does": "Picks a baseline and runs scripts/check_budget_monotonicity.sh with it: BUDGET_BASE_REF when set and non-empty; else the merge base of HEAD and origin/main (printing which commit); else, when there is no origin/main, HEAD (printing that commits already made are not compared). The script compares every numeric .ci/*.txt in the working tree against the baseline commit; a raised ceiling or lowered min_* floor fails unless a `budget-raise-ok: <path>` trailer appears in the commits BASE..HEAD. With the merge base it sees raises committed on the branch as well as uncommitted ones; with HEAD only uncommitted ones.",
   "entry": "`make budget-monotonicity` from a developer shell; prerequisite of `make ci` (Makefile)",
   "calls": [
    "ext:script scripts/check_budget_monotonicity.sh",
    "scripts/check_budget_monotonicity.sh::fn no_baseline",
    "scripts/check_budget_monotonicity.sh::fn is_allowed",
    "scripts/check_budget_monotonicity.sh::fn is_floor",
    "scripts/check_budget_monotonicity.sh::fn read_number",
    "ext:git merge-base/rev-parse/show/log"
   ],
   "reads": [
    "file:.ci/*.txt"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "BUDGET_BASE_REF unset or empty",
     "effect": "computes a default baseline (below); otherwise BUDGET_BASE_REF is the baseline"
    },
    {
     "at": "+3",
     "cond": "`git merge-base HEAD origin/main` succeeds",
     "effect": "that commit is the baseline and is printed"
    },
    {
     "at": "+5",
     "cond": "no origin/main (merge-base fails)",
     "effect": "baseline HEAD (working tree vs last commit), with a message that committed raises are not compared"
    }
   ],
   "deps": {
    "scripts/check_budget_monotonicity.sh::": "e7994e90b3de4f7e",
    "scripts/check_budget_monotonicity.sh::fn is_allowed": "e9c905a963e0a00b",
    "scripts/check_budget_monotonicity.sh::fn is_floor": "7ba97920277bae1e",
    "scripts/check_budget_monotonicity.sh::fn no_baseline": "e1ca9cb6a5d991db",
    "scripts/check_budget_monotonicity.sh::fn read_number": "4caff814b9ebd6bf"
   }
  },
