   "hash": "d9bc183158871eaa",
   "does": "Piecewise-linear map of capacity ratio onto readiness: 0→100, 0.8→85, 1.0→70, 1.3→50, 1.5→30, 2.0→10, beyond 2.0 → 10.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+10",
