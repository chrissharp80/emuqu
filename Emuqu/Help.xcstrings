    "Outside the range these bands were characterised over — worth a second reading before reading anything into it." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خارج النطاق الذي حُدّدت فيه هذه النطاقات — يستحق قراءة ثانية قبل استنتاج أي شيء منه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uden for det interval, disse bånd er beskrevet for — værd at måle igen, før du lægger noget i det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Außerhalb des Bereichs, für den diese Bänder beschrieben wurden — eine zweite Messung lohnt sich, bevor du etwas hineininterpretierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuera del rango en el que se caracterizaron estas bandas: conviene una segunda lectura antes de sacar conclusiones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näiden kaistojen kuvausalueen ulkopuolella — kannattaa mitata uudelleen ennen kuin siitä päättelee mitään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En dehors de la plage sur laquelle ces bandes ont été établies — mieux vaut refaire une lecture avant d’en tirer quoi que ce soit."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utan bilsins sem þessi svið voru skilgreind á — vert að mæla aftur áður en lesið er í það."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuori dall'intervallo in cui queste fasce sono state caratterizzate: meglio una seconda lettura prima di trarne conclusioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの帯域が特徴づけられた範囲の外です — 何かを読み取る前に、もう一度測定する価値があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 구간 기준이 정해진 범위를 벗어났습니다 — 의미를 두기 전에 한 번 더 측정해 볼 만합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utenfor området disse båndene ble beskrevet for — verdt en ny måling før du tolker noe ut av det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buiten het bereik waarvoor deze banden zijn bepaald — doe een tweede meting voordat je er iets uit afleidt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fora da faixa em que essas bandas foram caracterizadas — vale uma segunda leitura antes de tirar qualquer conclusão."
          }
        },
        "ru" : {
