 "role": "Value type holding CloudKit sync bookkeeping (uploaded / pending / quarantined / local-only id sets and in-memory failure counts) and persisting each set as a JSON array of UUID strings next to sync_state.json.",
 "types": [
  "CloudKitSyncState: struct — durable sync bookkeeping with load/save/mutation helpers"
 ],
 "state": [
  "file:sync_state.json (uploadedSessionIds)",
  "file:pending_uploads.json (pendingUploadIds)",
  "file:quarantined_uploads.json (quarantinedSessionIds)",
  "file:local_only_sessions.json (localOnlySessionIds)",
  "mem:CloudKitSyncState.uploadFailureCounts (NOT persisted)",
  "mem:CloudKitSyncState.isLoaded",
  "ud:UserDefaultsKeys.cloudKitChangeToken (only removed, legacy cleanup)"
 ],
 "toplevel": "All sets default empty; isLoaded false until loadAll or resetAll. The three sibling file URLs are derived from syncStateURL's directory.",
 "flags": [
  {
   "kind": "spec-mismatch",
   "sev": "low",
   "text": "uploadFailureCounts is never persisted, so per-session backoff restarts from zero on every launch, while Push comments claim the stable bucket makes 'exponential backoff schedules actually hold' across launches.",
   "evidence": [
    "Emuqu/Sources/Storage/CloudKitSyncState.swift:34",
    "Emuqu/Sources/Storage/CloudKitSyncManager+Push.swift:365",
    "Emuqu/Sources/Storage/CloudKitSyncManager+Push.swift:188"
   ],
   "found": "first read, upheld on second"
  },
  {
   "kind": "fragile",
   "sev": "med",
   "text": "loadAll merges disk into memory with formUnion, which keeps pre-load inserts but cannot keep pre-load REMOVALS: a markRemoved/markDeleted/markLocalOnly made before boot() gets the id re-added to uploadedSessionIds from sync_state.json. pendingPushBatch subtracts uploadedSessionIds, so such a re-upload request (forceReuploadSession, .flowRecoveryArchiveSessionsNeedReupload posted during archive migrations) is silently dropped. The comment claims marks made before load are kept.",
   "evidence": [
    "Emuqu/Sources/Storage/CloudKitSyncState.swift:61",
    "Emuqu/Sources/Storage/CloudKitSyncState.swift:80",
    "Emuqu/Sources/Storage/CloudKitSyncState.swift:245",
    "Emuqu/Sources/Storage/CloudKitSyncManager+Push.swift:173",
    "Emuqu/Sources/Storage/CloudKitSyncManager.swift:608"
   ],
   "found": "first read, upheld on second"
  }
 ],
