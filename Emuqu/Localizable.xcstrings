    "Tap Resume to pick up from there, or Save as is to keep what you've got." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على استئناف للمتابعة من هناك، أو حفظ كما هو للاحتفاظ بما سجّلته."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på Genoptag for at fortsætte derfra, eller Gem som det er for at beholde det, du har."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf „Fortsetzen\", um dort weiterzumachen, oder auf „Unverändert speichern\", um zu behalten, was du hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca Reanudar para seguir desde ahí, o Guardar tal cual para conservar lo que tienes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta Jatka jatkaaksesi siitä, tai Tallenna sellaisenaan säilyttääksesi sen, mitä sinulla on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez Reprendre pour continuer là où vous en étiez, ou Enregistrer tel quel pour garder ce que vous avez."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ýttu á Halda áfram til að halda áfram þaðan, eða Vista óbreytt til að halda því sem þú ert með."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca Riprendi per continuare da lì, oppure Salva così com'è per tenere quello che hai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「再開」をタップしてそこから続けるか、「そのまま保存」で記録済みの内容を保存してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재개를 탭해 거기서부터 이어서 하거나, 그대로 저장을 탭해 지금까지의 기록을 보관하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på Gjenoppta for å fortsette derfra, eller Lagre som det er for å beholde det du har."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op Hervat om verder te gaan waar je was, of op Opslaan zoals het is om te bewaren wat je hebt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em Retomar para continuar de onde parou, ou em Salvar como está para manter o que você já tem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите «Возобновить», чтобы продолжить с этого места, или «Сохранить как есть», чтобы оставить то, что уже записано."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på Återuppta för att fortsätta därifrån, eller Spara som det är för att behålla det du har."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按“继续”从中断处继续，或点按“按原样保存”保留已记录的内容。"
          }
        }
      }
    },
