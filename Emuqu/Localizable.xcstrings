    "TSB is %@ and recovery is strong — open window for intervals or a long aerobic session." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قيمة TSB هي %@ والتعافي قوي — فرصة مفتوحة لتمارين الفترات أو جلسة هوائية طويلة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSB er %@ og restitutionen er stærk — oplagt vindue til intervaller eller en lang aerob session."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSB liegt bei %@ und die Erholung ist stark – gutes Fenster für Intervalle oder eine lange Ausdauereinheit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
