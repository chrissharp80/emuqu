    "Used for workout zones and the voice coach. Current effective max: %lld bpm (%@). Set your actual max if you know it — otherwise 208 − 0.7 × age is a rough estimate." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم لمناطق التمرين ومدرب الصوت. الحد الأقصى الفعّال الحالي: %lld نبضة/دقيقة (%@). اضبط الحد الأقصى الفعلي إذا كنت تعرفه — وإلا فإن 208 − 0.7 × العمر تقدير تقريبي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges til træningszoner og stemmecoachen. Nuværende effektive maks.: %lld bpm (%@). Angiv dit faktiske maks., hvis du kender det — ellers er 208 − 0,7 × alder et groft estimat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird für Trainingszonen und den Sprachcoach verwendet. Aktuelles effektives Maximum: %lld bpm (%@). Lege dein tatsächliches Maximum fest, falls du es kennst – andernfalls ist 208 − 0,7 × Alter eine grobe Schätzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Used for workout zones and the voice coach. Current effective max: %1$lld bpm (%2$@). Set your actual max if you know it — otherwise 208 − 0.7 × age is a rough estimate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para las zonas de entrenamiento y el entrenador de voz. Máx. efectivo actual: %lld lpm (%@). Indica tu máx. real si lo conoces; de lo contrario, 208 − 0,7 × edad es una estimación aproximada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään harjoitusalueisiin ja äänivalmentajaan. Nykyinen tehollinen maksimi: %lld bpm (%@). Aseta todellinen maksimisi, jos tiedät sen — muuten 208 − 0,7 × ikä on karkea arvio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé pour les zones d'entraînement et le coach vocal. Max. effectif actuel : %lld bpm (%@). Indiquez votre max. réel si vous le connaissez — sinon, 208 − 0,7 × âge est une estimation approximative."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notað fyrir æfingasvæði og raddþjálfarann. Núverandi virkt hámark: %lld bpm (%@). Stilltu raunverulegt hámark þitt ef þú þekkir það — annars er 208 − 0,7 × aldur grófleg áætlun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato per le zone di allenamento e il coach vocale. Massimo effettivo attuale: %lld bpm (%@). Imposta il tuo massimo reale se lo conosci — altrimenti 208 − 0,7 × età è una stima approssimativa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークアウトゾーンと音声コーチに使用されます。現在の実効最大値：%lld bpm（%@）。実際の最大値が分かる場合は設定してください。分からない場合は「208 − 0.7 × 年齢」が目安になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동 존과 음성 코치에 사용됩니다. 현재 유효 최대값: %lld bpm (%@). 실제 최대값을 알면 설정하세요 — 모르면 208 − 0.7 × 나이가 대략적인 추정값입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brukes til treningssoner og stemmetreneren. Gjeldende effektivt maks.: %lld bpm (%@). Angi ditt faktiske maks. hvis du vet det — ellers er 208 − 0,7 × alder et grovt anslag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt voor trainingszones en de stemcoach. Huidig effectief maximum: %lld bpm (%@). Stel je werkelijke maximum in als je het weet — anders is 208 − 0,7 × leeftijd een ruwe schatting."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para as zonas de treino e o treinador de voz. Máx. efetivo atual: %lld bpm (%@). Defina seu máx. real se souber — caso contrário, 208 − 0,7 × idade é uma estimativa aproximada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется для зон тренировки и голосового тренера. Текущий эффективный максимум: %lld уд/мин (%@). Укажите свой реальный максимум, если знаете его, — иначе 208 − 0,7 × возраст даёт грубую оценку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används för träningszoner och röstcoachen. Aktuellt effektivt max: %lld bpm (%@). Ange ditt faktiska max om du känner till det — annars är 208 − 0,7 × ålder en grov uppskattning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于训练区间和语音教练。当前有效最大值：%lld bpm（%@）。如果你知道自己的实际最大值,请设置它——否则 208 − 0.7 × 年龄是一个粗略估计。"
          }
        }
      }
    },
