{
 "file": "Emuqu/Sources/Services/EntitlementAnchor.swift",
 "hash": "16af2d644bc6fe0d",
 "role": "Durable store for the entitlement facts that must survive app deletion — UserDefaults cache plus one iCloud-synchronizable keychain item per install (all items read and merged, only the install's own written, undecodable copies never overwritten): beta-tester status, device/App Store trial starts, clock high-water mark and the one-time store history check; plus TrialPolicy, the pure 30-day trial arithmetic.",
 "types": [
  "EntitlementAnchor: enum — namespace for pure merge logic and persistence of the anchor record",
  "EntitlementAnchor.Record: struct (Codable, Equatable) — isBetaTester, deviceTrialStartDate (coded as 'trialStartDate'), storeTrialStartDate, highWaterMark, storeHistoryCheckedAt",
  "EntitlementAnchor.TierRead: private enum — absent | record | unreadable",
  "EntitlementAnchor.Tiers: private struct — defaults read, merged keychain record, own keychain item read",
  "TrialPolicy: enum — pure trial-length / days-remaining / active / expired arithmetic (30 days)"
 ],
 "state": [
  "ud:entitlement.anchor.v1 (EntitlementAnchor.defaultsKey, JSON-encoded Record)",
  "ud:entitlement.anchor.account (this install's keychain account name, 'install-<UUID>')",
  "kc:com.chrissharp.flowrecovery.entitlement/<every account> (synchronizable generic passwords) accessible AfterFirstUnlock; the legacy account 'primary' is read, never written",
  "mem:EntitlementAnchor.Record.empty (isBetaTester false, no starts, highWaterMark .distantPast)",
  "mem:TrialPolicy.durationDays = 30",
  "mem:TrialPolicy.secondsPerDay = 86400"
 ],
 "toplevel": "Record.CodingKeys maps deviceTrialStartDate to the legacy key 'trialStartDate' and does not decode the legacy 'historyCheckedAt' key (so a store build re-runs the history check). Codable synthesis encodes/decodes Record for both tiers. resetForUITesting is compiled only under #if DEBUG.",
