    "Requires longer recordings (>5 min) to be meaningful. Read it against your own recent nights rather than a population norm." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب تسجيلات أطول (>5 دقائق) ليكون ذا معنى. اقرأه مقارنةً بلياليك الأخيرة لا بمعيار سكاني."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kræver længere optagelser (>5 min) for at være meningsfuld. Læs den ud fra dine egne seneste nætter frem for en befolkningsnorm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfordert längere Aufzeichnungen (>5 Min), um aussagekräftig zu sein. Lies ihn im Vergleich zu deinen eigenen letzten Nächten, nicht zu einer Bevölkerungsnorm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requiere grabaciones más largas (>5 min) para ser significativa. Léela frente a tus propias noches recientes, no frente a una norma poblacional."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaatii pidempiä tallennuksia (>5 min) ollakseen merkityksellinen. Vertaa sitä omiin viime öihisi, älä väestön normiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessite des enregistrements plus longs (>5 min) pour être significative. Lisez-la par rapport à vos propres nuits récentes plutôt qu’à une norme de population."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krefst lengri upptaka (>5 mín) til að vera marktækt. Lestu það miðað við þínar eigin nýlegu nætur frekar en þýðisviðmið."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiede registrazioni più lunghe (>5 min) per essere significativo. Leggila rispetto alle tue notti recenti, non a una norma di popolazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "意味を持たせるにはより長い記録（5 分超）が必要です。集団の基準ではなく、あなた自身の最近の夜と比べて読んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "의미 있는 값을 얻으려면 더 긴 기록(5분 초과)이 필요합니다. 인구 기준이 아니라 최근 당신의 밤들과 비교해 읽으세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krever lengre opptak (>5 min) for å være meningsfullt. Les den opp mot dine egne siste netter, ikke en befolkningsnorm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vereist langere opnamen (>5 min) om betekenisvol te zijn. Lees hem af tegen je eigen recente nachten, niet tegen een bevolkingsnorm."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exige gravações mais longas (>5 min) para ter significado. Leia em relação às suas próprias noites recentes, não a uma norma populacional."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для осмысленности требуются более длинные записи (>5 мин). Оценивайте её по своим последним ночам, а не по популяционной норме."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kräver längre inspelningar (>5 min) för att vara meningsfull. Läs den mot dina egna senaste nätter snarare än en befolkningsnorm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要更长的记录（超过 5 分钟）才有意义。请与你自己最近几晚的数据比较，而不是与人群标准比较。"
          }
        }
      }
    },
