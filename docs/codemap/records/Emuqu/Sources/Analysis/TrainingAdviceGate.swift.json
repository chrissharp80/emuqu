   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "load non-nil",
     "effect": "false → Assessment.clear"
    },
    {
     "at": "+3",
     "cond": "reasons contain sharpIncrease or heavyFatigue",
     "effect": "true → .easier"
    },
    {
