            "value" : "إنهاك تدريبي مرتفع. إرهاق كبير. خطط للتعافي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høj belastning. Stor træthed. Planlæg restitution."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hohe Beanspruchung. Starke Ermüdung. Plane Erholung ein."
