    "Respiratory rate: scored against your 7-day baseline, or against the 12-18 br/min population range until that baseline exists" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معدل التنفس: يُقيَّم مقابل خط الأساس لـ 7 أيام، أو مقابل نطاق عامة السكان 12-18 نفَس/دقيقة حتى يتوفر خط الأساس"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vejrtrækningsfrekvens: vurderes mod din 7-dages baseline eller mod befolkningsintervallet 12-18 vejrtrækninger/min, indtil den baseline findes"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atemfrequenz: bewertet anhand deiner 7-Tage-Baseline oder, bis diese existiert, anhand des Bevölkerungsbereichs von 12–18 Atemzügen/Min."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frecuencia respiratoria: se puntúa frente a tu línea base de 7 días, o frente al rango poblacional de 12-18 resp/min hasta que exista esa línea base"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hengitystiheys: pisteytetään 7 päivän perustasoasi vasten tai väestön 12–18 hengenvedon/min vaihteluväliä vasten, kunnes perustaso on muodostunut"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fréquence respiratoire : évaluée par rapport à votre référence sur 7 jours, ou par rapport à la plage de population de 12-18 resp/min tant que cette référence n’existe pas"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öndunartíðni: metin miðað við 7 daga grunngildið þitt, eða miðað við almennt bil 12-18 andardrætti/mín. þar til grunngildið er til"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequenza respiratoria: valutata rispetto alla tua linea di base a 7 giorni, oppure rispetto all'intervallo della popolazione di 12-18 atti/min finché quella linea di base non esiste"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼吸数：7 日間のベースラインに対して評価します。ベースラインができるまでは、一般人口の範囲（12～18 回/分）に対して評価します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호흡수: 7일 기준선 대비로 점수를 매기며, 기준선이 생기기 전까지는 12-18회/분의 일반 인구 범위를 기준으로 합니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Respirasjonsfrekvens: vurdert mot 7-dagers grunnlinjen din, eller mot befolkningsområdet 12-18 pust/min til grunnlinjen finnes"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ademhalingsfrequentie: beoordeeld tegen je 7-daagse basislijn, of tegen het bevolkingsbereik van 12-18 ademhalingen/min zolang die basislijn er nog niet is"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequência respiratória: avaliada em relação à sua linha de base de 7 dias, ou à faixa populacional de 12-18 resp/min até essa linha de base existir"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Частота дыхания: оценивается относительно базового уровня за 7 дней, а пока его нет — относительно популяционного диапазона 12–18 вдохов/мин"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andningsfrekvens: bedöms mot din 7-dagars baslinje, eller mot befolkningsintervallet 12–18 andetag/min tills baslinjen finns"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "呼吸频率：与你的 7 天基线比较；在基线建立之前，与每分钟 12-18 次的人群范围比较"
          }
        }
      }
    },
