    "Rapid-increase and high-load warnings will be hidden until you turn this off." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم إخفاء تحذيرات الزيادة السريعة والحمل المرتفع حتى توقف هذا الخيار."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advarsler om hurtig stigning og høj belastning skjules, indtil du slår dette fra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warnungen zu schnellem Anstieg und hoher Belastung bleiben ausgeblendet, bis du dies ausschaltest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las alertas de aumento rápido y carga alta estarán ocultas hasta que lo desactives."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nopean nousun ja suuren kuormituksen varoitukset piilotetaan, kunnes poistat tämän käytöstä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les alertes d'augmentation rapide et de charge élevée seront masquées jusqu'à ce que vous désactiviez ceci."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viðvaranir um hraða aukningu og mikið álag verða faldar þar til þú slekkur á þessu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli avvisi di aumento rapido e carico elevato resteranno nascosti finché non lo disattivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "急増や高負荷の警告は、これをオフにするまで非表示になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "급격한 증가 및 높은 부하 경고는 이 기능을 끌 때까지 숨겨집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varsler om rask økning og høy belastning skjules til du slår dette av."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waarschuwingen voor snelle stijging en hoge belasting blijven verborgen tot je dit uitschakelt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os avisos de aumento rápido e carga alta ficarão ocultos até você desativar isto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предупреждения о резком росте и высокой нагрузке будут скрыты, пока вы не выключите этот режим."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varningar om snabb ökning och hög belastning döljs tills du stänger av detta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你关闭此项之前，快速增加和高负荷的警告将被隐藏。"
          }
        }
      }
    },
