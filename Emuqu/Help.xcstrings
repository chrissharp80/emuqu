    "The Dashboard is your daily starting point. It shows your recovery status at a glance and drills into every component." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لوحة المعلومات هي نقطة انطلاقك اليومية. تعرض حالة تعافيك بنظرة سريعة وتتعمق في كل مكوّن."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oversigten er dit daglige udgangspunkt. Den viser din restitutionsstatus med et blik og lader dig dykke ned i hver komponent."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Übersicht ist dein täglicher Ausgangspunkt. Sie zeigt deinen Erholungsstatus auf einen Blick und führt zu jedem einzelnen Bestandteil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El panel es tu punto de partida diario. Muestra tu estado de recuperación de un vistazo y te permite profundizar en cada componente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kojelauta on päivittäinen lähtöpisteesi. Se näyttää palautumistilasi yhdellä silmäyksellä ja antaa porautua jokaiseen osatekijään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tableau de bord est votre point de départ quotidien. Il affiche votre état de récupération en un coup d’œil et permet d’explorer chaque composante."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yfirsýnin er daglegur upphafspunktur þinn. Hún sýnir batastöðuna í fljótu bragði og gerir þér kleift að kafa ofan í hvern þátt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pannello è il tuo punto di partenza quotidiano. Mostra a colpo d'occhio lo stato del tuo recupero e permette di approfondire ogni componente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダッシュボードは毎日の出発点です。回復状態をひと目で確認でき、各構成要素を詳しく掘り下げられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
