    "Sleep efficiency %lld%% — fragmented sleep blunts recovery." : {
      "comment" : "\"sleep efficiency\" is a bit of a misnomer here, since it doesn't strictly measure sleep quality. It just looks at how much of the sleep cycle is spent in deep sleep (SWS),",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كفاءة النوم %lld%% — النوم المجزأ يضعف التعافي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søvneffektivitet %lld%% — fragmenteret søvn svækker restitutionen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schlafeffizienz %lld%% — fragmentierter Schlaf bremst die Erholung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eficiencia del sueño %lld%% — el sueño fragmentado reduce la recuperación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unen tehokkuus %lld%% — pirstoutunut uni heikentää palautumista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efficacité du sommeil %lld%% — un sommeil fragmenté freine la récupération."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svefnnýtni %lld%% — sundurslitinn svefn dregur úr endurheimt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efficienza del sonno %lld%% — il sonno frammentato riduce il recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠効率 %lld%% — 分断された睡眠は回復を鈍らせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면 효율 %lld%% — 분절된 수면은 회복을 둔화시킵니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søvneffektivitet %lld%% — fragmentert søvn svekker restitusjonen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slaapefficiëntie %lld%% — gefragmenteerde slaap remt herstel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eficiência do sono %lld%% — sono fragmentado reduz a recuperação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эффективность сна %lld%% — фрагментированный сон снижает восстановление."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sömneffektivitet %lld%% — fragmenterad sömn dämpar återhämtningen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
