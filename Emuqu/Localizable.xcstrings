    "Emuqu needs Bluetooth to connect to your Polar heart rate sensor. Turn it on for Emuqu in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Emuqu إلى البلوتوث للاتصال بمستشعر نبض Polar. فعّله لـ Emuqu من الإعدادات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu skal bruge Bluetooth for at forbinde til din Polar-pulssensor. Slå det til for Emuqu i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu benötigt Bluetooth, um sich mit deinem Polar-Herzfrequenzsensor zu verbinden. Aktiviere es für Emuqu in den Einstellungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
