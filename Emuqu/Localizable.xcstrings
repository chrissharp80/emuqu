    "Pa:Hr decoupling %@ — mild drift in the second half; worth watching for hydration / fueling." : {
      "comment" : "The \"Pa:Hr decoupling\" value is a percentage. The argument is the string “%+.1f %%”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انفكاك Pa:Hr %@ — انجراف طفيف في النصف الثاني؛ يستحق الانتباه للترطيب والتغذية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr-afkobling %@ — let drift i anden halvdel; hold øje med væske og energi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr-Entkopplung %@ — leichter Drift in der zweiten Hälfte; auf Flüssigkeit und Verpflegung achten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desacoplamiento Pa:Hr %@ — deriva leve en la segunda mitad; conviene vigilar hidratación y avituallamiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr-irtikytkentä %@ — lievää ryömintää toisella puoliskolla; seuraa nesteytystä ja tankkausta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découplage Pa:Hr %@ — légère dérive en seconde moitié ; surveillez hydratation et ravitaillement."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr-aftenging %@ — lítilsháttar rek í seinni hluta; fylgstu með vökva og næringu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disaccoppiamento Pa:Hr %@ — lieve deriva nella seconda metà; attenzione a idratazione e alimentazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr デカップリング %@ — 後半に軽度のドリフト。水分と補給に注意しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr 디커플링 %@ — 후반부에 가벼운 드리프트. 수분과 연료 보충을 살펴보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr-frakobling %@ — lett drift i andre halvdel; følg med på væske og energi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr-ontkoppeling %@ — lichte drift in de tweede helft; let op hydratatie en voeding."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desacoplamento Pa:Hr %@ — leve deriva na segunda metade; vale ficar de olho em hidratação e alimentação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рассогласование Pa:Hr %@ — лёгкий дрейф во второй половине; стоит следить за питьём и питанием."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr-frikoppling %@ — lätt drift under andra halvan; håll koll på vätska och energi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr 解耦 %@ — 后半程有轻微漂移；注意补水与补给。"
          }
        }
      }
    },
    "Pa:Hr decoupling %@ — significant efficiency loss over the session. Heat, fatigue, or nutrition likely factors." : {
      "comment" : "The HRV decoupling percentage is displayed in the summary sheet. A value of 80 or higher indicates that the aerobic efficiency of the workout has declined significantly. The argument is the string “%+.1f %%”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انفكاك Pa:Hr %@ — فقدان كبير في الكفاءة خلال الجلسة. الحرارة أو الإرهاق أو التغذية عوامل مرجّحة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr-afkobling %@ — betydeligt effektivitetstab i løbet af sessionen. Varme, træthed eller ernæring er sandsynlige faktorer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr-Entkopplung %@ — deutlicher Effizienzverlust im Verlauf der Einheit. Hitze, Ermüdung oder Ernährung sind wahrscheinliche Faktoren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desacoplamiento Pa:Hr %@ — pérdida de eficiencia notable a lo largo de la sesión. Calor, fatiga o nutrición son factores probables."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr-irtikytkentä %@ — merkittävä tehokkuuden lasku harjoituksen aikana. Todennäköisiä syitä ovat kuumuus, väsymys tai ravitsemus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découplage Pa:Hr %@ — perte d’efficacité importante sur la séance. Chaleur, fatigue ou nutrition sont des facteurs probables."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr-aftenging %@ — umtalsvert skilvirknitap yfir lotuna. Hiti, þreyta eða næring eru líklegir þættir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disaccoppiamento Pa:Hr %@ — perdita di efficienza rilevante nella sessione. Caldo, fatica o alimentazione sono fattori probabili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr デカップリング %@ — セッションを通じて効率が大きく低下しました。暑さ、疲労、栄養が要因として考えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr 디커플링 %@ — 세션 전반에 걸쳐 효율이 크게 떨어졌습니다. 더위, 피로, 영양이 유력한 요인입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr-frakobling %@ — betydelig effektivitetstap gjennom økten. Varme, tretthet eller ernæring er sannsynlige faktorer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr-ontkoppeling %@ — aanzienlijk efficiëntieverlies tijdens de sessie. Hitte, vermoeidheid of voeding zijn waarschijnlijke factoren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desacoplamento Pa:Hr %@ — perda de eficiência relevante ao longo da sessão. Calor, fadiga ou nutrição são fatores prováveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рассогласование Pa:Hr %@ — заметная потеря эффективности за сессию. Вероятные факторы: жара, усталость или питание."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr-frikoppling %@ — betydande effektivitetsförlust under passet. Värme, trötthet eller kost är sannolika faktorer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr 解耦 %@ — 整场训练效率明显下降。高温、疲劳或营养可能是主要原因。"
