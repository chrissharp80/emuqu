        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mæling frá sama tíma er þegar í ferlinum þínum, svo þessi var ekki vistuð."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
