        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Training Stress Balance — CTL minus ATL. Positiv = frisch, negativ = ermüdet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Balance de estrés de entrenamiento: CTL menos ATL. Positivo = fresco, negativo = fatigado."
          }
        },
        "fi" : {
          "stringUnit" : {
