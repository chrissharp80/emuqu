    "Couldn't download the recording from the strap. Keep it close to the phone, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر تنزيل التسجيل من الحزام. أبقِه قريبًا من الهاتف، ثم حاول مرة أخرى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optagelsen kunne ikke hentes fra pulsbæltet. Hold det tæt på telefonen, og prøv så igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufzeichnung konnte nicht vom Gurt geladen werden. Halte ihn nah am Telefon und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo descargar la grabación de la banda. Mantenla cerca del teléfono e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennetta ei voitu ladata vyöstä. Pidä se lähellä puhelinta ja yritä sitten uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de télécharger l’enregistrement depuis la ceinture. Gardez-la près du téléphone, puis réessayez."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekki tókst að sækja upptökuna af ólinni. Hafðu hana nálægt símanum og reyndu svo aftur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile scaricare la registrazione dalla fascia. Tienila vicina al telefono, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストラップから記録をダウンロードできませんでした。iPhone の近くに置いて、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스트랩에서 기록을 다운로드할 수 없습니다. 휴대폰 가까이에 둔 후 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke laste ned opptaket fra beltet. Hold det nær telefonen, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de opname niet van de band downloaden. Houd hem dicht bij de telefoon en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível baixar a gravação da cinta. Mantenha-a perto do telefone e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить запись с датчика. Держите его рядом с телефоном и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att hämta inspelningen från bandet. Håll det nära telefonen och försök sedan igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法从心率带下载记录。请将其靠近手机，然后再试一次。"
          }
        }
      }
    },
    "Couldn't hear you. Tap to try again — or check that AirPods aren't in another app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم أتمكن من سماعك. اضغط للمحاولة مرة أخرى — أو تأكد من أن AirPods ليست مستخدمة في تطبيق آخر."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg kunne ikke høre dig. Tryk for at prøve igen — eller tjek, at AirPods ikke bruges i en anden app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich konnte dich nicht hören. Tippe, um es erneut zu versuchen — oder prüfe, ob deine AirPods in einer anderen App verwendet werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No te he oído. Toca para intentarlo de nuevo, o comprueba que los AirPods no estén en otra app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En kuullut sinua. Yritä uudelleen napauttamalla — tai tarkista, etteivät AirPodit ole toisen apin käytössä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ne vous ai pas entendu. Touchez pour réessayer, ou vérifiez que vos AirPods ne sont pas utilisés par une autre app."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ég heyrði ekki í þér. Ýttu til að reyna aftur — eða athugaðu hvort AirPods séu í notkun í öðru forriti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ti ho sentito. Tocca per riprovare, oppure controlla che gli AirPods non siano usati da un’altra app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "聞き取れませんでした。タップしてもう一度お試しください。AirPods が別のアプリで使われていないかも確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말씀을 듣지 못했어요. 다시 시도하려면 탭하세요. AirPods가 다른 앱에서 사용 중인지도 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg hørte deg ikke. Trykk for å prøve igjen – eller sjekk at AirPods ikke brukes i en annen app."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik kon je niet horen. Tik om het opnieuw te proberen, of controleer of je AirPods niet in een andere app worden gebruikt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não consegui ouvir você. Toque para tentar de novo, ou verifique se os AirPods não estão em outro app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось вас расслышать. Нажмите, чтобы повторить, или проверьте, не используются ли AirPods другим приложением."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag kunde inte höra dig. Tryck för att försöka igen – eller kontrollera att dina AirPods inte används av en annan app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
