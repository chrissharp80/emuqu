    "Recovery drop only %lld bpm — could be fatigue, dehydration, or stale baseline." : {
      "comment" : "The HRR value here is arbitrary but chosen to be close to the average in the test data.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انخفاض النبض في التعافي %lld نبضة/دقيقة فقط — قد يكون إرهاقًا أو جفافًا أو خط أساس قديمًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restitutionsfaldet er kun %lld bpm — kan skyldes træthed, dehydrering eller en forældet baseline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erholungsabfall nur %lld bpm — mögliche Ursachen: Ermüdung, Dehydrierung oder veraltete Baseline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La caída de recuperación es de solo %lld lpm — podría ser fatiga, deshidratación o una línea base desactualizada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palautumispudotus vain %lld bpm — syynä voi olla väsymys, kuivuminen tai vanhentunut perustaso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Récupération de la FC de seulement %lld bpm — fatigue, déshydratation ou référence obsolète possibles."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurheimtarfall aðeins %lld slög/mín — gæti verið þreyta, vökvaskortur eða úrelt grunnlína."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calo di recupero di soli %lld bpm — potrebbe essere fatica, disidratazione o una baseline non aggiornata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復時の低下はわずか %lld bpm — 疲労、脱水、または古いベースラインが原因かもしれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복 시 감소가 %lld bpm에 불과합니다 — 피로, 탈수 또는 오래된 기준선 때문일 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restitusjonsfallet er bare %lld bpm — kan skyldes tretthet, dehydrering eller en utdatert baseline."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herstelafname slechts %lld bpm — kan vermoeidheid, uitdroging of een verouderde basislijn zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queda de recuperação de apenas %lld bpm — pode ser fadiga, desidratação ou linha de base desatualizada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Падение при восстановлении всего %lld уд/мин — возможны усталость, обезвоживание или устаревшая базовая линия."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Återhämtningsfallet är bara %lld bpm — kan bero på trötthet, uttorkning eller en föråldrad baslinje."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复期仅下降 %lld bpm — 可能是疲劳、脱水或基线过时。"
