   "key": "func HealthWorkoutImporter.applyTotals(from:to:)",
   "hash": "fd1fca3e4e83720c",
   "does": "Writes candidate.distanceMeters into session.workoutMetadata.distanceMeters only when the track-derived distance is nil/<=0, and copies candidate.weather onto the metadata when present.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "session has workoutMetadata",
     "effect": "continue; otherwise return without changes"
    },
    {
     "at": "+2",
     "cond": "candidate distance exists and > 0",
     "effect": "check derived distance; otherwise distance unchanged"
    },
    {
     "at": "+3",
     "cond": "derived (track) distance is nil or <= 0",
     "effect": "replace with HealthKit total; otherwise the track-derived distance is kept even if it disagrees with HealthKit"
    },
    {
     "at": "+6",
     "cond": "candidate.weather is non-nil",
     "effect": "set metadata.weatherSnapshot; otherwise leave as built (nil)"
    }
   ],
   "flags": [
    {
     "kind": "spec-mismatch",
     "sev": "low",
     "text": "Doc comment says 'HealthKit's own totals win over anything derived from the track', but the code only uses the HealthKit total when the track-derived distance is zero; for a GPS workout the polyline-summed distance is kept even when it differs from the source app's recorded total.",
