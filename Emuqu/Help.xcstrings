    "Intervals close to uncorrelated. Uncommon in a resting adult recording — worth a repeat before reading anything into it." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفواصل شبه غير مترابطة. غير شائع في تسجيل شخص بالغ أثناء الراحة — يستحق التكرار قبل استنتاج أي شيء منه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervaller tæt på ukorrelerede. Usædvanligt i en hvileoptagelse hos en voksen — værd at gentage, før du lægger noget i det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervalle nahezu unkorreliert. Ungewöhnlich bei einer Ruheaufnahme eines Erwachsenen — wiederhole die Messung, bevor du etwas hineininterpretierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervalos casi sin correlación. Poco habitual en una grabación en reposo de un adulto: conviene repetirla antes de sacar conclusiones."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välit lähes korreloimattomia. Harvinaista aikuisen lepotallennuksessa — kannattaa toistaa ennen kuin siitä päättelee mitään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervalles presque non corrélés. Inhabituel dans un enregistrement d’adulte au repos — mieux vaut refaire une lecture avant d’en tirer quoi que ce soit."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bil nærri því að vera ófylgnin. Óalgengt í hvíldarupptöku fullorðins — vert að endurtaka áður en lesið er í það."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervalli quasi non correlati. Poco comune in una registrazione a riposo di un adulto: meglio ripeterla prima di trarne conclusioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "間隔がほぼ無相関です。安静時の成人の記録ではあまり見られません — 何かを読み取る前にもう一度測定する価値があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "간격이 거의 상관되어 있지 않습니다. 안정 시 성인 기록에서는 드문 경우이니, 의미를 두기 전에 다시 측정해 볼 만합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervallene er nesten ukorrelerte. Uvanlig i et hvileopptak hos en voksen — verdt å gjenta før du tolker noe ut av det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervallen bijna ongecorreleerd. Ongebruikelijk bij een opname van een volwassene in rust — herhaal de meting voordat je er iets uit afleidt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervalos quase não correlacionados. Incomum em uma gravação de um adulto em repouso — vale repetir antes de tirar qualquer conclusão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Интервалы почти не коррелированы. Нетипично для записи взрослого в покое — стоит повторить, прежде чем делать выводы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervallen är nästan okorrelerade. Ovanligt i en vilomätning hos en vuxen — värt att upprepa innan du tolkar något."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "间期接近不相关。在成人静息记录中不常见 — 在据此下任何结论之前，值得重测一次。"
          }
        }
      }
    },
