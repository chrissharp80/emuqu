     "cond": "remote windowUserAdjusted and no autoWindowResult",
     "effect": "copies local autoWindowResult/Score"
    },
    {
     "at": "+12",
     "cond": "remote healthKitExportedAt nil",
     "effect": "copies local export time and failure count"
