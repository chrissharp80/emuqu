   "key": "func OvernightHRChartCanvas.HRChartGeometry.windowBounds(stats:size:points:firstMs:totalDurationMs:)",
   "hash": "d7436690ad3175dd",
   "does": "The analysis window's x range on the time viewport: from stats.windowStartMs/EndMs when they differ, else from the t_ms of the window's first and last beats (indices clamped to the points) — beat indices are not proportional to x on a viewport widened by HealthKit or gappy. Start fraction clamped ≥ 0, end ≤ 1; isFull when it spans more than OvernightChartDrawing.fullRecordingWindowFraction (0.8). (0, 0, full) with no viewport or no beats, so the highlight is skipped.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+7",
     "cond": "totalDurationMs <= 0 or no points",
     "effect": "(0, 0, true)"
    },
    {
     "at": "+9",
     "cond": "windowStartMs != windowEndMs",
     "effect": "ms bounds; else beat t_ms"
    },
    {
     "at": "+17",
     "cond": "span > 0.8",
     "effect": "isFull"
    }
   ],
   "flags": [],
