    "Gaps of %@ or more in your sleep data are treated as separate sessions." : {
      "comment" : "Text that explains how sleep data is grouped into \"sessions\" based on the user's selected criteria.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُعامَل الفجوات التي تبلغ %@ أو أكثر في بيانات نومك كجلسات منفصلة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mellemrum på %@ eller mere i dine søvndata behandles som separate sessioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lücken von %@ oder mehr in deinen Schlafdaten werden als separate Sitzungen behandelt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los intervalos de %@ o más en tus datos de sueño se tratan como sesiones separadas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vähintään %@ kestävät aukot unidatassasi käsitellään erillisinä istuntoina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les écarts de %@ ou plus dans vos données de sommeil sont traités comme des sessions distinctes."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eyður upp á %@ eða meira í svefngögnunum þínum eru meðhöndlaðar sem aðskildar lotur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le interruzioni di %@ o più nei tuoi dati del sonno vengono trattate come sessioni separate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠データ内の%@以上の間隔は、別々のセッションとして扱われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면 데이터에서 %@ 이상의 공백은 별도의 세션으로 처리됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hull på %@ eller mer i søvndataene dine behandles som separate økter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderbrekingen van %@ of meer in je slaapgegevens worden behandeld als afzonderlijke sessies."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervalos de %@ ou mais nos seus dados de sono são tratados como sessões separadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перерывы в данных о сне продолжительностью %@ или более считаются отдельными сессиями."
