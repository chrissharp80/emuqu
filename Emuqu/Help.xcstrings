    "Late Meal — Ate late the night before" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وجبة متأخرة — تناولت الطعام متأخرًا في الليلة السابقة"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sent måltid — Spiste sent aftenen før"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spätes Essen — Am Vorabend spät gegessen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cena tardía: cenaste tarde la noche anterior"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Myöhäinen ateria — Söi myöhään edellisenä iltana"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repas tardif — Avoir mangé tard la veille au soir"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seint að borða — Borðaðir seint kvöldið áður"
