    "Wear the strap (sensor pad must be wet) and stay within 2 m of your wrist." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارتدِ الحزام (يجب أن تكون وسادة المستشعر مبللة) وابقَ ضمن مترين من معصمك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag remmen på (sensorpuden skal være våd), og hold dig inden for 2 m fra håndleddet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege den Gurt an (Sensorfläche muss feucht sein) und bleibe im Umkreis von 2 m zum Handgelenk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte la banda (la almohadilla del sensor debe estar húmeda) y mantente a menos de 2 m de tu muñeca."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pue vyö (anturityyny on kostutettava) ja pysy 2 metrin sisällä ranteestasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Portez la ceinture (la zone du capteur doit être humide) et restez à moins de 2 m de votre poignet."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settu ólina á (skynjarapúðinn þarf að vera blautur) og haltu þig innan 2 m frá úlnliðnum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indossa la fascia (il sensore deve essere umido) e resta entro 2 m dal polso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストラップを装着し（センサーパッドを湿らせてください）、手首から 2 m 以内にいてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스트랩을 착용하고(센서 패드를 적셔야 합니다) 손목에서 2 m 이내에 있으세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta på deg beltet (sensorputen må være våt) og hold deg innenfor 2 m fra håndleddet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draag de band (het sensorvlak moet nat zijn) en blijf binnen 2 m van je pols."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vista a cinta (a área do sensor precisa estar úmida) e fique a menos de 2 m do seu pulso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наденьте ремень (контактную площадку нужно смочить) и оставайтесь в пределах 2 м от запястья."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta på dig bandet (sensorytan måste vara fuktig) och håll dig inom 2 m från handleden."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请佩戴心率带（传感器区域需保持湿润），并保持在手腕 2 米范围内。"
          }
        }
      }
    },
