    "mem:AssistantViewModel.speakableTextCursor",
    "file:conversation.json (ConversationStore, App Group)"
   ],
   "branches": [
    {
     "at": "+1",
     "cond": "pendingChunks empty",
     "effect": "return"
    },
    {
     "at": "+3",
     "cond": "not forced and <33 ms since last publish",
     "effect": "return (chunks stay buffered)"
    },
    {
     "at": "+4",
     "cond": "turn no longer exists",
     "effect": "discard pendingChunks and return"
    },
    {
     "at": "+8",
     "cond": "nothing publishable (incomplete first sentence or empty after scrub)",
     "effect": "return without updating lastPublishAt"
    },
    {
     "at": "+10",
     "cond": "no tool_use seen yet this round AND batch contains a sentence terminator",
