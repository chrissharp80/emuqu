  {
   "key": "func WorkoutPDFReport.effortParagraph(sport:durationMin:bundle:)",
   "hash": "f5e3f0231007e93a",
   "does": "Returns the effort paragraph: if α1 band time > 60 s, classifies as all-easy, all-hard, mixed (any hard minute) or threshold-exposure with band minutes; otherwise an 'insufficient clean RR data' sentence.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Export/WorkoutPDFReport.swift::var WorkoutPDFReport.drawing",
    "Emuqu/Sources/Export/WorkoutPDFReport+Pages.swift::func WorkoutPDFRenderer.alpha1Stats()",
    "Emuqu/Sources/Export/WorkoutPDFReport+Pages.swift::var WorkoutPDFRenderer.Alpha1Stats.totalSec"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+3",
     "cond": "stats.totalSec > 60",
     "effect": "true: band-based sentence; false: 'Insufficient clean RR data ... DFA α1' sentence"
    },
    {
     "at": "+7",
     "cond": "no between-band and no above-AT2 seconds",
     "effect": "true: 'entirely below aerobic threshold' sentence; false: next check"
    },
    {
     "at": "+9",
     "cond": "no below-AT1 and no between seconds",
     "effect": "true: 'predominantly above anaerobic threshold' sentence; false: next check"
    },
    {
     "at": "+11",
     "cond": "hardMin > 0 (whole minutes above AT2)",
     "effect": "true: mixed-intensity sentence with easy/threshold/hard minutes; false: threshold-exposure sentence (easy + threshold minutes; <60 s above AT2 is dropped from text)"
    }
   ],
   "deps": {
    "Emuqu/Sources/Export/WorkoutPDFReport+Pages.swift::func WorkoutPDFRenderer.alpha1Stats()": "c7cbd4932f4109f3",
    "Emuqu/Sources/Export/WorkoutPDFReport+Pages.swift::var WorkoutPDFRenderer.Alpha1Stats.totalSec": "d4128801065703ea",
    "Emuqu/Sources/Export/WorkoutPDFReport.swift::var WorkoutPDFReport.drawing": "f7d3779a5caa920a"
   }
