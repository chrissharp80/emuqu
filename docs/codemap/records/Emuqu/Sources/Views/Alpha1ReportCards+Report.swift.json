  {
   "key": "func Alpha1ReportCards.ectopicShadows(in:)",
   "hash": "801ce94957a284d1",
   "does": "Scans samples in order; each α1 < 0.75 opens/deepens a dip, the first α1 >= 0.75 closes it and records a candidate EctopicShadow if the dip lasted 1–120 s. Samples without α1 are skipped; a dip still open at session end is dropped. Candidates during which heart rate rose by >= effortHeartRateRise (10 bpm) from the approach window to the deepest point are dropped as real efforts (heartRateRose). Pure, used by this card, the α1 route colouring, WorkoutAnalysisSnapshotBuilder, FitnessPostSummaryView+Feeling and WorkoutPDFReport.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Views/Alpha1ReportCards+Report.swift::func Alpha1ReportCards.closeDip(_:recoveredAt:into:)",
    "Emuqu/Sources/Views/Alpha1ReportCards+Report.swift::func Alpha1ReportCards.extendDip(_:offsetSec:alpha1:)",
    "Emuqu/Sources/Views/Alpha1ReportCards+Report.swift::func Alpha1ReportCards.heartRateRose(into:in:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+3",
     "cond": "for each sample",
     "effect": "iterates all samples"
    },
    {
     "at": "+4",
     "cond": "sample.alpha1 nil",
     "effect": "skipped (does not close a dip)"
    },
    {
     "at": "+5",
     "cond": "alpha1 >= AT1 (0.75)",
     "effect": "closes any open dip via closeDip and continues; else extends/opens dip"
    },
    {
     "at": "+11",
     "cond": "heartRateRose for a candidate shadow",
     "effect": "candidate dropped (kept as physiology); otherwise returned"
    }
   ],
   "deps": {
    "Emuqu/Sources/Views/Alpha1ReportCards+Report.swift::func Alpha1ReportCards.closeDip(_:recoveredAt:into:)": "0d093420af41d5c1",
