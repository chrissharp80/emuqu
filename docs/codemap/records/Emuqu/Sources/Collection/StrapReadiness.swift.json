   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "isLinked",
     "effect": "false: nil (keep waiting); true: switch"
    },
    {
     "at": "+3",
     "cond": "state .ready",
     "effect": "→ .ready"
    },
    {
     "at": "+4",
     "cond": "state .unavailable",
     "effect": "→ .unavailable"
    },
    {
     "at": "+5",
     "cond": "state .pending",
     "effect": "isSettled → .unconfirmed; else nil"
    }
   ],
