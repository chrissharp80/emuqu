    "Elevated — context-sensitive; check for arousal, recent activity, or illness" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرتفع — يعتمد على السياق؛ تحقّق من الاستثارة أو نشاط حديث أو مرض"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forhøjet — kontekstafhængigt; tjek for ophidselse, nylig aktivitet eller sygdom"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhöht — kontextabhängig; prüfe Weckreaktionen, kürzliche Aktivität oder Krankheit"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elevado — depende del contexto; comprueba activación, actividad reciente o enfermedad"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koholla — riippuu tilanteesta; tarkista vireystila, äskeinen aktiivisuus tai sairaus"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Élevé — dépend du contexte ; vérifiez l’éveil, une activité récente ou une maladie"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hækkað — háð samhengi; athugaðu örvun, nýlega hreyfingu eða veikindi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elevato — dipende dal contesto; verifica attivazione, attività recente o malattia"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上昇 — 文脈に依存します。覚醒、直近の活動、体調不良を確認してください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상승 — 맥락에 좌우됨. 각성, 최근 활동, 질병 여부를 확인하세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forhøyet — kontekstavhengig; sjekk for opphisselse, nylig aktivitet eller sykdom"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhoogd — contextafhankelijk; check op arousal, recente activiteit of ziekte"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elevado — depende do contexto; verifique excitação, atividade recente ou doença"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повышено — зависит от контекста; проверьте микропробуждения, недавнюю активность или болезнь"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förhöjt — kontextberoende; kolla efter arousal, nyligen aktivitet eller sjukdom"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "升高 — 需结合情境；留意唤醒状态、近期活动或身体不适"
          }
        }
      }
    },
