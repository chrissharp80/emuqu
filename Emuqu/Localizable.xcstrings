    "This session was saved without raw RR data — older recordings only kept summary stats." : {
      "comment" : "Message shown in the Poincaré plot when a session is saved without raw RR data.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
