        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dati della sessione sono stati ripristinati. Vai alla scheda Registra per riprendere o terminare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションデータが復元されました。記録タブに移動して再開または終了してください。"
