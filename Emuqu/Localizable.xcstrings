    "Threshold workout — you pushed into the LT1-LT2 band for %lld min, easy the remaining %lld min." : {
      "comment" : "The text that describes a workout that is mostly aerobic with some anaerobic effort. The argument is the number of minutes spent doing aerobic work, the second argument is the number of minutes spent doing anaerobic work.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمرين عند العتبة — دفعت إلى نطاق LT1-LT2 لمدة %lld دقيقة، وكانت الـ%lld دقيقة المتبقية خفيفة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tærskeltræning — du pressede ind i LT1-LT2-båndet i %lld min, og de resterende %lld min var lette."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwellentraining — du warst %lld Min im LT1-LT2-Band, die restlichen %lld Min locker."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Threshold workout — you pushed into the LT1-LT2 band for %1$lld min, easy the remaining %2$lld min."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenamiento de umbral — entraste en la banda LT1-LT2 durante %lld min y los %lld min restantes fueron suaves."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kynnysharjoitus — työnnyit LT1-LT2-alueelle %lld min ajaksi, loput %lld min kevyesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Séance au seuil — vous êtes monté dans la bande LT1-LT2 pendant %lld min, les %lld min restantes en aisance."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þröskuldsæfing — þú fórst inn á LT1-LT2 bilið í %lld mín, hinar %lld mín rólegar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allenamento in soglia — sei entrato nella banda LT1-LT2 per %lld min, i restanti %lld min facili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "閾値ワークアウト — LT1-LT2 帯に %lld 分入り、残りの %lld 分はイージーでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "역치 훈련 — LT1-LT2 구간에서 %lld분을 밀어붙였고, 나머지 %lld분은 이지였습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terskeløkt — du presset inn i LT1-LT2-båndet i %lld min, de resterende %lld min var rolige."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drempeltraining — je zat %lld min in de LT1-LT2-band, de resterende %lld min rustig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treino de limiar — você entrou na faixa LT1-LT2 por %lld min e os %lld min restantes foram leves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пороговая тренировка — вы держались в диапазоне LT1-LT2 %lld мин, остальные %lld мин легко."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tröskelpass — du gick upp i LT1-LT2-bandet i %lld min, de återstående %lld min var lugna."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阈值训练 — 你在 LT1-LT2 区间推进了 %lld 分钟，其余 %lld 分钟为轻松强度。"
          }
        }
      }
