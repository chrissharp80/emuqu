    "More beats = more reliable analysis. Minimum ~120 for basic metrics, 300+ ideal for frequency analysis." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نبضات أكثر = تحليل أكثر موثوقية. الحد الأدنى نحو 120 للمقاييس الأساسية، و300+ مثالي لتحليل التردد."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flere slag = mere pålidelig analyse. Minimum ~120 til basale mål, 300+ er ideelt til frekvensanalyse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr Schläge = zuverlässigere Analyse. Mindestens ~120 für Basiswerte, 300+ ideal für die Frequenzanalyse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más latidos = análisis más fiable. Mínimo ~120 para métricas básicas, 300+ ideal para el análisis de frecuencia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enemmän lyöntejä = luotettavampi analyysi. Vähintään ~120 perusmittareihin, 300+ ihanteellinen taajuusanalyysiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus de battements = analyse plus fiable. Minimum ~120 pour les mesures de base, 300+ idéal pour l’analyse fréquentielle."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fleiri slög = áreiðanlegri greining. Lágmark ~120 fyrir grunnmælingar, 300+ kjörið fyrir tíðnigreiningu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più battiti = analisi più affidabile. Minimo ~120 per le metriche di base, 300+ ideale per l’analisi in frequenza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍数が多いほど解析の信頼性が高まります。基本指標には最低 120 拍程度、周波数解析には 300 拍以上が理想です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "박동 수가 많을수록 분석이 더 신뢰할 만합니다. 기본 지표는 최소 120개, 주파수 분석에는 300개 이상이 이상적입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flere slag = mer pålitelig analyse. Minimum ~120 for basismål, 300+ er ideelt for frekvensanalyse."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meer slagen = betrouwbaardere analyse. Minimaal ~120 voor basismetrieken, 300+ ideaal voor frequentieanalyse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais batimentos = análise mais confiável. Mínimo ~120 para métricas básicas, 300+ ideal para análise de frequência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше ударов = надёжнее анализ. Минимум ~120 для базовых метрик, 300+ идеально для частотного анализа."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fler slag = mer tillförlitlig analys. Minst ~120 för basmått, 300+ är idealiskt för frekvensanalys."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心搏越多，分析越可靠。基础指标至少约 120 个，频域分析以 300 个以上为佳。"
          }
        }
      }
    },
