   "key": "var ProbableCauseRow.confidenceColor",
   "hash": "cb970ff2be60da51",
   "does": "Badge colour from CauseConfidence(rawValue: confidenceLevel ?? confidence): critical/veryHigh dustyRose, high terracotta, moderateHigh softGold, moderate mist, positive kinds sage, low kinds or unparsable textTertiary.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "confidenceLevel ?? confidence",
     "effect": "untranslated raw level when given; else the display text (fails to parse when translated → none)"
    },
    {
     "at": "+2",
     "cond": "case .critical, .veryHigh",
     "effect": "dustyRose"
    },
    {
     "at": "+3",
     "cond": "case .high",
     "effect": "terracotta"
    },
    {
     "at": "+4",
     "cond": "case .moderateHigh",
     "effect": "softGold"
    },
    {
     "at": "+5",
     "cond": "case .moderate",
     "effect": "mist"
    },
    {
     "at": "+6",
     "cond": "case .pattern/.contributingFactor/.goodSign/.excellent",
     "effect": "sage"
    },
    {
     "at": "+7",
     "cond": "case .lowModerate/.low/nil",
     "effect": "textTertiary"
    }
   ],
   "deps": {
