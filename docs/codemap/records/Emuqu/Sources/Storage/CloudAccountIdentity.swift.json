   "key": "func CloudAccountIdentity.verdict(recorded:current:syncEnabled:stoppedByApp:accountChangedThisLaunch:hasBookkeeping:)",
   "hash": "e95aecb054f5e988",
   "does": "Pure decision for the signed-in account: with a recorded account, sameAccount when it equals current else differentAccount. With none: awaitingOptIn while sync is off and either the app stopped sync or there is no bookkeeping; attributeBookkeeping when the account changed this launch while bookkeeping remains; else adopt.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+4",
     "cond": "recorded account present",
     "effect": "sameAccount if equal to current, else differentAccount"
    },
    {
     "at": "+5",
     "cond": "sync off and (stopped by the app or no bookkeeping)",
     "effect": "awaitingOptIn"
    },
    {
     "at": "+6",
     "cond": "account changed this launch and bookkeeping held",
     "effect": "attributeBookkeeping"
    },
    {
     "at": "+7",
     "cond": "otherwise",
     "effect": "adopt"
    }
   ],
