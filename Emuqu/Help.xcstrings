    "\"Lead me back to where I started\" — uses the breadcrumb origin (engaged Get Me Back) OR the start of any recent workout (auto-archived)" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«أعدني إلى نقطة البداية» — يستخدم نقطة بداية المسار (عند تفعيل Get Me Back) أو بداية أي تمرين حديث (مؤرشف تلقائيًا)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»Før mig tilbage til, hvor jeg startede« — bruger brødkrummesporets startpunkt (aktiveret Get Me Back) ELLER starten af en nylig træning (automatisk arkiveret)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bring mich zurück zu meinem Startpunkt“ — nutzt den Ausgangspunkt der Brotkrumenspur (Get Me Back aktiviert) ODER den Start eines kürzlichen Trainings (automatisch archiviert)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Llévame de vuelta a donde empecé»: usa el origen del rastro (Get Me Back activado) O el inicio de cualquier entrenamiento reciente (archivado automáticamente)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Vie minut takaisin lähtöpisteeseen\" — käyttää reittijäljen alkupistettä (Get Me Back käytössä) TAI minkä tahansa viimeaikaisen harjoituksen alkua (arkistoitu automaattisesti)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Ramène-moi à mon point de départ » — utilise l’origine du fil d’Ariane (Get Me Back activé) OU le début de toute séance récente (archivée automatiquement)"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Leiddu mig aftur þangað sem ég byrjaði“ — notar upphafspunkt slóðarinnar (þegar Get Me Back er virkt) EÐA upphaf nýlegrar æfingar (sjálfvirkt vistað)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Riportami al punto di partenza\" — usa l'origine della traccia (Get Me Back attivato) OPPURE l'inizio di un qualsiasi allenamento recente (archiviato automaticamente)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「出発地点まで戻して」— パンくずの起点（Get Me Back 使用時）または最近のワークアウトの開始地点（自動アーカイブ）を使用します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"출발한 곳으로 안내해줘\" — 브레드크럼 출발점(Get Me Back 사용 시) 또는 최근 운동의 시작 지점(자동 보관)을 사용"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Led meg tilbake dit jeg startet» — bruker startpunktet for sporet (aktivert Get Me Back) ELLER starten på en nylig økt (automatisk arkivert)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Breng me terug naar waar ik begonnen ben” — gebruikt het startpunt van het spoor (Get Me Back actief) OF het begin van een recente training (automatisch gearchiveerd)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Me leve de volta até onde comecei\" — usa a origem do rastro (Get Me Back ativado) OU o início de qualquer treino recente (arquivado automaticamente)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Отведи меня туда, откуда я начал» — использует исходную точку следа (включён Get Me Back) ИЛИ начало любой недавней тренировки (архивируется автоматически)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Led mig tillbaka till där jag startade\" — använder brödsmulespårets startpunkt (aktiverad Get Me Back) ELLER starten på ett nyligen genomfört pass (automatiskt arkiverat)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“带我回到出发的地方”— 使用轨迹起点（已启用 Get Me Back）或任何近期训练的起点（自动存档）"
          }
        }
      }
    },
