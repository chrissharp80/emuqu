  {
   "key": "var DailyLoopAnalysis.workoutIntensity",
   "hash": "d46fbc618765e42d",
   "does": "Classifies today's workout from its samples: mean alpha1 and peak HR as fraction of userMaxHR; easy when alpha1 >= 0.75 and peak < 75%, hard when alpha1 < 0.5 or peak >= 85%, moderate when peak >= 70%, else easy; easy when there is no workout metadata.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "workoutSession.workoutMetadata exists",
     "effect": "false: .easy; true: classifies"
    },
    {
     "at": "+2",
     "cond": "samples ?? []",
     "effect": "no samples: no alpha1 values"
    },
    {
     "at": "+3",
     "cond": "alphas empty ?:",
     "effect": "true: avgAlpha nil; false: mean"
    },
    {
     "at": "+5",
     "cond": "peakHR ?? 0",
     "effect": "no HR samples: pctMax 0"
    },
    {
     "at": "+6",
     "cond": "avgAlpha >= 0.75 && pctMax < 0.75",
     "effect": ".easy"
    },
    {
     "at": "+7",
     "cond": "avgAlpha < 0.50",
     "effect": ".hard"
    },
    {
     "at": "+8",
     "cond": "pctMax >= 0.85",
     "effect": ".hard"
    },
    {
     "at": "+9",
     "cond": "pctMax >= 0.70",
     "effect": ".moderate; otherwise falls to .easy"
    }
   ],
   "deps": {}
  },
