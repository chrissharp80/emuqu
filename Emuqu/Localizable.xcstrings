          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence funciona en el dispositivo: gratis, privado y sin conexión. Otros proveedores requieren una clave de API en Ajustes → Flo."
          }
        },
