    "No saved routes match the current filters. Widen the length / ascent range above." : {
      "comment" : "A message shown when there are no saved routes that match the current filter criteria in the \"Saved routes\" section of the Discover Trails view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
