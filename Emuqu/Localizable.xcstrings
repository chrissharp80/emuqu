    "Couldn't read recording data from the strap: %@. Try again; the data is still on the strap until you start a new recording." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت قراءة بيانات التسجيل من الحزام: %@. حاول مرة أخرى؛ تبقى البيانات على الحزام حتى تبدأ تسجيلًا جديدًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke læse optagelsesdata fra pulsbæltet: %@. Prøv igen; dataene ligger stadig på pulsbæltet, indtil du starter en ny optagelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahmedaten konnten nicht vom Gurt gelesen werden: %@. Versuche es erneut; die Daten bleiben auf dem Gurt, bis du eine neue Aufnahme startest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
