        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slóðakortaþjónustan er upptekin. Bíddu aðeins og reyndu aftur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il servizio di mappe dei sentieri è occupato. Attendi un momento e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレイル地図サービスが混み合っています。しばらく待ってからもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
