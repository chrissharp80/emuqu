    "PM5 monitor for the Concept2 rower. Streams stroke rate, distance, drag factor, instantaneous power." : {
      "comment" : "A footer describing the PM5 monitor for the Concept2 rower.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاشة PM5 لجهاز التجديف Concept2. تبثّ معدل الشدّ والمسافة وعامل المقاومة والقدرة اللحظية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PM5-monitor til Concept2-romaskinen. Streamer taghastighed, distance, modstandsfaktor og momentan effekt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PM5-Monitor für das Concept2-Ruderergometer. Überträgt Schlagfrequenz, Distanz, Widerstandsfaktor und Momentanleistung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitor PM5 para el remo Concept2. Transmite ritmo de palada, distancia, factor de arrastre y potencia instantánea."
          }
        },
