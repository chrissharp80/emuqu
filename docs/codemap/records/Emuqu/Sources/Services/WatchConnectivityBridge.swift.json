  "mem:WatchConnectivityBridge.latestWatchHR / latestWatchHRAt",
  "mem:WatchConnectivityBridge.latestWatchStrapHR / latestWatchStrapAt",
  "mem:WatchConnectivityBridge.pendingWatchStrapRR (+ pendingWatchStrapRRLock NSLock)",
  "mem:WatchConnectivityBridge.lastProcessedContextTimestamp",
  "mem:WatchConnectivityBridge.liveWorkoutStartedAt",
  "mem:WatchConnectivityBridge.wcQueue (serial DispatchQueue com.chrissharp.flowrecovery.watchbridge.transport, .utility)",
  "mem:WatchConnectivityBridge.didActivate (OSAllocatedUnfairLock<Bool>)",
  "mem:WatchConnectivityBridge.timeoutCounter (static lock Int), circuitBreakerThreshold=3",
  "mem:WatchConnectivityBridge.lastContextErrorMessage (static lock String?)",
