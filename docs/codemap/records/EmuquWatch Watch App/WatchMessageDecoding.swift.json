 "types": [
  "WatchMessageDecoding: enum (namespace, nonisolated)",
  "WatchMessageDecoding.StateUpdate: struct — optional fields, nil = absent; isLiveSnapshot marks a liveState tick",
  "WatchMessageDecoding.Bounds: enum — plausible ranges for each numeric field",
  "WatchMessageDecoding.RecordingTransition: enum — none/started/stopped",
  "WatchMessageDecoding.Command: enum — startWorkout/stopWorkout/strapState/liveState/voiceChatState/unknown",
  "WatchMessageDecoding.StrapMeasurement: struct — heartRate (nil when no real beat), rrMillis in whole ms"
 ],
 "state": [
