    "Extended overnight recordings give the richest data, but quick readings work too" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التسجيلات الليلية الممتدة تعطي أغنى البيانات، لكن القراءات السريعة تعمل أيضًا"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Udvidede optagelser natten over giver de rigeste data, men hurtigmålinger virker også"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erweiterte Nachtaufnahmen liefern die umfangreichsten Daten, aber auch Schnellmessungen funktionieren"
          }
        },
        "es" : {
