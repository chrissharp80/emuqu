    "ud:FlowRecovery.cloudkit.hkSanitizeReupload.v4.remaining"
   ],
   "writes": [
    "ud:FlowRecovery.cloudkit.hkSanitizeReupload.v4.remaining",
    "file:<archiveDir>/sync_state.json",
    "file:<archiveDir>/record_versions.json"
   ],
   "branches": [
    {
     "at": "+3",
     "cond": "handled < 10 and list has a first id",
     "effect": "take it off the head and scrub it"
    },
    {
     "at": "+5",
     "cond": "scrub returned retryLater",
     "effect": "append the id at the end, break"
    },
    {
     "at": "+14",
     "cond": "handled > 0",
     "effect": "saves sync state and logs; else silent"
    }
   ],
