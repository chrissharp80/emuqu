    "Average during sleep. Typical range: 95-100%. Sustained readings below 95% are worth raising with a clinician." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المتوسط أثناء النوم. النطاق المعتاد: 95-100%. القراءات المستمرة دون 95% تستحق مناقشتها مع مختص."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemsnit under søvn. Typisk interval: 95-100 %. Vedvarende målinger under 95 % er værd at tage op med en læge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchschnitt während des Schlafs. Typischer Bereich: 95–100 %. Anhaltende Werte unter 95 % solltest du mit einer medizinischen Fachperson besprechen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media durante el sueño. Rango típico: 95-100 %. Las lecturas sostenidas por debajo del 95 % merecen comentarse con un profesional sanitario."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keskiarvo unen aikana. Tyypillinen vaihteluväli: 95–100 %. Pitkään alle 95 %:n lukemat kannattaa ottaa puheeksi terveydenhuollon ammattilaisen kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moyenne pendant le sommeil. Plage typique : 95-100 %. Des valeurs durablement inférieures à 95 % méritent d’être évoquées avec un professionnel de santé."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meðaltal í svefni. Dæmigert bil: 95-100%. Viðvarandi mælingar undir 95% er vert að ræða við heilbrigðisstarfsmann."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media durante il sonno. Intervallo tipico: 95-100%. Valori costantemente sotto il 95% sono da segnalare a un medico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠中の平均値です。一般的な範囲：95～100%。95% を下回る状態が続く場合は、医療専門家に相談する価値があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면 중 평균. 일반적인 범위: 95-100%. 95% 미만이 지속되면 의료진과 상의해 볼 만합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gjennomsnitt under søvn. Typisk område: 95-100 %. Vedvarende målinger under 95 % er verdt å ta opp med helsepersonell."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemiddelde tijdens de slaap. Gebruikelijk bereik: 95-100%. Aanhoudende waarden onder 95% zijn het bespreken waard met een zorgverlener."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Média durante o sono. Faixa típica: 95-100%. Leituras persistentemente abaixo de 95% merecem ser comentadas com um profissional de saúde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Среднее во время сна. Типичный диапазон: 95–100%. Если значения стабильно ниже 95%, это стоит обсудить с врачом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genomsnitt under sömn. Typiskt intervall: 95-100 %. Ihållande värden under 95 % är värda att ta upp med vårdpersonal."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠期间的平均值。典型范围：95-100%。持续低于 95% 的读数值得与临床医生沟通。"
          }
        }
      }
    },
    "Awake Time" : {
      "extractionState" : "extracted_with_value",
