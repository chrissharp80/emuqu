   "key": "func GPXExporter.decode(polyline:startDate:duration:)",
   "hash": "ab1a362484bb0c9f",
   "does": "Decodes the stored polyline Data (UTF-8 '<coords>\\n<altitudes>') to CLLocations with horizontal accuracy 10 m, the stored altitude with vertical accuracy 10 m (or altitude 0 with vertical accuracy -1, CoreLocation's 'altitude invalid', when the fix has no stored altitude), and timestamps startDate + idx×interval, where interval spreads fixes over duration (or 5 s when duration missing).",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Analysis/GPXExporter.swift::func GPXExporter.fixInterval(coordCount:duration:)",
    "Emuqu/Sources/Analysis/GPXExporter.swift::func GPXExporter.decodeCoordinates(_:)",
    "Emuqu/Sources/Analysis/GPXExporter.swift::func GPXExporter.decodeAltitudes(_:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "polyline Data is not valid UTF-8",
     "effect": "returns []"
    },
    {
     "at": "+3",
     "cond": "parts.first nil",
     "effect": "never nil: split(maxSplits:1, omittingEmptySubsequences:false) always yields at least one element, so the ?? \"\" fallback is unreachable; an empty first part decodes to no coordinates"
    },
    {
     "at": "+4",
     "cond": "no second (altitude) part",
     "effect": "altitudes = [] so every fix gets altitude 0 with verticalAccuracy -1"
    },
    {
     "at": "+12",
     "cond": "idx < altitudes.count",
     "effect": "altitude from polyline; else 0"
    },
    {
     "at": "+14",
     "cond": "idx < altitudes.count",
     "effect": "verticalAccuracy 10; else -1 (altitude invalid)"
    }
   ],
   "deps": {
    "Emuqu/Sources/Analysis/GPXExporter.swift::func GPXExporter.decodeAltitudes(_:)": "038ddc9999fbe5a5",
    "Emuqu/Sources/Analysis/GPXExporter.swift::func GPXExporter.decodeCoordinates(_:)": "07d439f5f1d54190",
