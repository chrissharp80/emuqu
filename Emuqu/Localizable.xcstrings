    "Defaults to your system brightness. Drag down to save battery; reverts when you leave this screen." : {
      "comment" : "A footer note under the brightness slider, explaining its purpose.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم سطوع النظام افتراضيًا. اسحب لأسفل لتوفير البطارية؛ يعود إلى وضعه السابق عند مغادرة هذه الشاشة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruger som standard din systemlysstyrke. Træk ned for at spare batteri; nulstilles, når du forlader denne skærm."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet standardmäßig deine Systemhelligkeit. Nach unten ziehen, um Akku zu sparen; wird zurückgesetzt, wenn du diesen Bildschirm verlässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el brillo del sistema de forma predeterminada. Arrastra hacia abajo para ahorrar batería; se revierte al salir de esta pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käyttää oletuksena järjestelmän kirkkautta. Vedä alas säästääksesi akkua; palautuu, kun poistut tästä näkymästä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise par défaut la luminosité du système. Faites glisser vers le bas pour économiser la batterie ; rétablie lorsque vous quittez cet écran."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notar sjálfgefið birtustig kerfisins. Dragðu niður til að spara rafhlöðu; færist til baka þegar þú yfirgefur þennan skjá."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa per impostazione predefinita la luminosità del sistema. Trascina verso il basso per risparmiare batteria; viene ripristinata quando esci da questa schermata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトでシステムの明るさを使用します。下にドラッグするとバッテリーを節約できます。この画面を離れると元に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본적으로 시스템 밝기를 사용합니다. 배터리를 절약하려면 아래로 드래그하세요. 이 화면을 벗어나면 원래대로 돌아갑니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruker systemlysstyrken som standard. Dra ned for å spare batteri; tilbakestilles når du forlater denne skjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt standaard de helderheid van je systeem. Sleep omlaag om de batterij te sparen; wordt hersteld wanneer je dit scherm verlaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o brilho do sistema por padrão. Arraste para baixo para economizar bateria; reverte ao sair desta tela."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По умолчанию используется системная яркость. Перетащите вниз, чтобы сэкономить заряд; сбрасывается при выходе с этого экрана."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använder systemets ljusstyrka som standard. Dra nedåt för att spara batteri; återställs när du lämnar den här skärmen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认使用系统亮度。向下拖动以节省电量；离开此屏幕后会恢复。"
          }
        }
      }
    },
