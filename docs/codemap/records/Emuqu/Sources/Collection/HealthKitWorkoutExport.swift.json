  {
   "key": "func HealthKitWorkoutExport.distanceSamples(from:sport:clock:)",
   "hash": "79a16b97ae38b85a",
   "does": "Builds delta-distance samples for sports with a Health distance type: ticks sorted by offset, each increase over the last cumulative distance becomes a sample spanning from where the previous written delta ended (the workout start for the first) to this tick, so a delta that built up over non-advancing ticks covers all of them. The span is placed on the wall clock by clock.interval(fromActiveOffset:to:), so it never crosses a pause: one a pause interrupted starts at that pause's resume.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Collection/HealthKitWorkoutExport.swift::func HealthKitWorkoutExport.distanceType(for:)",
    "Emuqu/Sources/Collection/HealthKitWorkoutExport.swift::func HealthKitWorkoutExport.inTimeOrder(_:)",
    "Emuqu/Sources/Collection/HealthKitWorkoutExport.swift::func WorkoutWallClock.interval(fromActiveOffset:to:)",
    "Emuqu/Sources/Collection/HealthSampleFactory.swift::func HealthSampleFactory.quantitySample(type:value:unit:start:end:metadata:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+5",
     "cond": "sport has no distance type or HK type unavailable",
     "effect": "returns []"
    },
    {
     "at": "+10",
     "cond": "loop over time-ordered ticks",
     "effect": "per-tick processing"
    },
    {
     "at": "+11",
     "cond": "tick has no distanceMeters or distance not greater than the last emitted cumulative distance",
     "effect": "tick skipped (no sample; span start unchanged)"
    },
    {
     "at": "+13",
     "cond": "delta not finite or <= 0",
     "effect": "tick skipped; otherwise lastDistance updated and the span start moves to this tick"
    },
    {
     "at": "+20",
     "cond": "factory returned a sample",
     "effect": "appended; nil (invalid interval/value) dropped"
    }
   ],
   "flags": [],
   "deps": {
    "Emuqu/Sources/Collection/HealthKitWorkoutExport.swift::func HealthKitWorkoutExport.distanceType(for:)": "c6d0d1c31de553b0",
