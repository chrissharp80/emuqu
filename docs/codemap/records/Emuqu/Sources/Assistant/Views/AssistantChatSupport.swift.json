  {
   "key": "func ChatInputBar.consumeInboxIfPresent()",
   "hash": "e78bffee4c5719e5",
   "does": "Moves AssistantInbox.pendingDraft into the chat. 'Can send now' = composerState.canSend AND Flo is on with its notice accepted (floNoticeAccepted). With Apple active and unable to send it leaves the question queued in the inbox (re-run when canSend or the notice changes). Otherwise clears the inbox and either auto-sends the trimmed text (can send now AND (Apple active OR ends with ?, ？ or ؟)) — a cloud send the view model still rejects with .rejectedNoProvider goes into the field — or adds it to the field after anything already typed.",
   "entry": "ChatInputBar onAppear / onChange(inbox.pendingDraft) / onChange(composerState.canSend)",
   "calls": [
    "Emuqu/Sources/Assistant/Views/AssistantChatSupport.swift::var ChatInputBar.inbox",
    "Emuqu/Sources/Assistant/Views/AssistantChatSupport.swift::var ChatInputBar.floNoticeAccepted",
    "Emuqu/Sources/Assistant/Views/AssistantChatSupport.swift::func ChatInputBar.endsWithQuestionMark(_:)",
    "Emuqu/Sources/Assistant/Views/AssistantChatSupport.swift::func ChatInputBar.joined(_:_:)",
    "closure:onSend — viewModel.send(text:)",
    "Emuqu/Sources/Assistant/ViewModel/AssistantViewModel.swift::func AssistantViewModel.send(text:fromVoice:)"
   ],
   "reads": [
    "mem:AssistantInbox.pendingDraft",
    "mem:ComposerState.canSend",
    "mem:AssistantViewModel.hasAcceptedDisclaimer"
   ],
   "writes": [
    "mem:AssistantInbox.pendingDraft"
   ],
   "branches": [
    {
     "at": "+1",
     "cond": "inbox has a pendingDraft",
     "effect": "continues; nil → return"
    },
    {
     "at": "+3",
     "cond": "Apple active and cannot send now",
     "effect": "return, leaving the draft queued in the inbox"
    },
    {
     "at": "+6",
     "cond": "can send now AND (Apple active OR ends with a question mark)",
     "effect": "auto-send; on .rejectedNoProvider with a cloud model the text goes into the field. Else prefill (appended to typed text)"
    }
