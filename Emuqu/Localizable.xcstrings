    "Copy, Email and Share are off while the screen is being recorded or mirrored." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النسخ والبريد والمشاركة متوقفة أثناء تسجيل الشاشة أو عكسها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiér, E-mail og Del er slået fra, mens skærmen optages eller spejles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieren, E-Mail und Teilen sind aus, solange der Bildschirm aufgenommen oder gespiegelt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiar, Correo y Compartir están desactivados mientras se graba o se duplica la pantalla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopioi, Sähköposti ja Jaa ovat pois käytöstä, kun näyttöä tallennetaan tai peilataan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copier, E-mail et Partager sont désactivés pendant l’enregistrement ou la recopie de l’écran."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afrita, Tölvupóstur og Deila eru óvirk á meðan skjárinn er tekinn upp eða speglaður."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia, E-mail e Condividi sono disattivati mentre lo schermo viene registrato o duplicato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面の収録中またはミラーリング中は、コピー、メール、共有を使用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면을 녹화하거나 미러링하는 동안에는 복사, 이메일, 공유를 사용할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopier, E-post og Del er slått av mens skjermen tas opp eller speiles."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiëren, E-mail en Delen zijn uitgeschakeld zolang het scherm wordt opgenomen of gedupliceerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiar, E-mail e Compartilhar ficam desativados enquanto a tela é gravada ou espelhada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копирование, почта и «Поделиться» отключены, пока экран записывается или транслируется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopiera, Mejl och Dela är avstängda medan skärmen spelas in eller speglas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屏幕录制或镜像期间，“拷贝”“邮件”和“共享”不可用。"
          }
        }
      }
    },
