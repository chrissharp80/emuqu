    "Elevation for a recorded route is looked up at OpenTopoData, or at Open-Meteo when OpenTopoData doesn't answer, with the route's coordinates." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستعلم عن ارتفاع المسار المسجَّل لدى OpenTopoData، أو لدى Open-Meteo عندما لا يستجيب OpenTopoData، باستخدام إحداثيات المسار."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højden for en optaget rute slås op hos OpenTopoData, eller hos Open-Meteo når OpenTopoData ikke svarer, med rutens koordinater."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Höhe einer aufgezeichneten Route wird mit ihren Koordinaten bei OpenTopoData abgefragt, oder bei Open-Meteo, wenn OpenTopoData nicht antwortet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La altitud de una ruta grabada se consulta en OpenTopoData, o en Open-Meteo cuando OpenTopoData no responde, con las coordenadas de la ruta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennetun reitin korkeus haetaan reitin koordinaateilla OpenTopoDatasta tai Open-Meteosta, kun OpenTopoData ei vastaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’altitude d’un parcours enregistré est obtenue auprès d’OpenTopoData, ou d’Open-Meteo quand OpenTopoData ne répond pas, avec les coordonnées du parcours."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hæð skráðrar leiðar er sótt til OpenTopoData, eða til Open-Meteo þegar OpenTopoData svarar ekki, með hnitum leiðarinnar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’altitudine di un percorso registrato viene richiesta a OpenTopoData, o a Open-Meteo quando OpenTopoData non risponde, con le coordinate del percorso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録したルートの標高は、ルートの座標を使って OpenTopoData に、または OpenTopoData が応答しないときは Open-Meteo に問い合わせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록된 경로의 고도는 경로 좌표로 OpenTopoData에서, OpenTopoData가 응답하지 않으면 Open-Meteo에서 조회합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyden for en registrert rute slås opp hos OpenTopoData, eller hos Open-Meteo når OpenTopoData ikke svarer, med rutens koordinater."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De hoogte van een opgenomen route wordt met de coördinaten van de route opgevraagd bij OpenTopoData, of bij Open-Meteo als OpenTopoData niet antwoordt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A altitude de uma rota gravada é consultada no OpenTopoData, ou no Open-Meteo quando o OpenTopoData não responde, com as coordenadas da rota."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Высота записанного маршрута запрашивается у OpenTopoData или у Open-Meteo, если OpenTopoData не отвечает, по координатам маршрута."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höjden för en inspelad rutt hämtas från OpenTopoData, eller från Open-Meteo när OpenTopoData inte svarar, med ruttens koordinater."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录路线的海拔会使用路线坐标向 OpenTopoData 查询；若 OpenTopoData 无响应，则向 Open-Meteo 查询。"
          }
        }
      }
    },
