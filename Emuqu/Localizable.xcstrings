    "Workout recording is removed from the tab bar. Settings is promoted in." : {
      "comment" : "A description of the effect of hiding the \"Fitness\" tab.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم إزالة تسجيل التمرين من شريط التبويبات. وتُضاف الإعدادات بدلاً منه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træningsoptagelse fjernes fra fanelinjen. Indstillinger flyttes ind i stedet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Workout-Aufzeichnung wird aus der Tableiste entfernt. Einstellungen wird stattdessen aufgenommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación de entrenamientos se elimina de la barra de pestañas. Ajustes pasa a ocupar su lugar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harjoituksen tallennus poistetaan välilehtipalkista. Asetukset nostetaan tilalle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'enregistrement de séance est retiré de la barre d'onglets. Réglages y est ajouté à la place."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Æfingaupptaka er fjarlægð úr flipastikunni. Stillingar koma í staðinn."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione degli allenamenti viene rimossa dalla barra delle schede. Al suo posto viene inserito Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークアウト記録がタブバーから削除されます。代わりに設定が追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동 기록이 탭 바에서 제거됩니다. 대신 설정이 추가됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Øktopptak fjernes fra fanelinjen. Innstillinger settes inn i stedet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Workout-opname wordt uit de tabbalk verwijderd. Instellingen komt ervoor in de plaats."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação de treino é removida da barra de abas. Ajustes entra no lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись тренировки удаляется из панели вкладок. Вместо неё добавляются настройки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passinspelning tas bort från flikfältet. Inställningar läggs in i stället."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "训练记录从标签栏中移除。设置将取而代之。"
          }
        }
      }
    },
