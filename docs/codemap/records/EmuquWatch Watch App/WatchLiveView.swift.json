{
 "file": "EmuquWatch Watch App/WatchLiveView.swift",
 "hash": "1c15aa7583e7baac",
 "role": "The whole Watch UI: a vertical-paged TabView (Start / Live metrics / Pause-Stop) that becomes a CompletionScreen after a workout ends, plus sport and zone pickers.",
 "types": [
  "WatchLiveView: struct (View) — root, page selection",
  "SportOption: struct — sport raw/label",
  "ZoneOption: struct — target zone value/label",
  "StartScreen: struct (private View) — sport/target/start/strap/voice",
  "SportPickerView, ZonePickerView: struct (private View) — full-screen list pickers",
  "PickerRow: struct (private View) — row with checkmark",
  "LiveMetricsScreen: struct (private View) — HR/pace/time/α1/distance/elevation grid",
  "PauseStopScreen: struct (private View) — Pause/Resume and End",
  "CompletionScreen: struct (private View) — Save & Done"
 ],
 "state": [
  "mem:sportOptions (global let: run, walk, bike, treadmill, indoor_bike)",
  "mem:zoneOptions (global let: 0=No target, 1-5)",
  "mem:WatchLiveView.page (@State TabPage)",
  "mem:StartScreen.selectedSport (@State, default run)",
  "mem:StartScreen.selectedZone (@State, default No target)"
 ],
 "toplevel": "Global lets sportOptions and zoneOptions (94-122) are built with String(localized:) at first use. The Start screen offers only 5 of the 10 iPhone sports. zoneOptions is now 'No target' plus plain 'Zone 1'…'Zone 5' (as iOS HRZone names them), built with (1...5).map.",
 "units": [
