          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lees het voordat je akkoord gaat: de bescherming ervan kan verschillen van die van dit beleid."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leia antes de concordar: as proteções dela podem ser diferentes das desta política."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прочитайте её, прежде чем соглашаться: её гарантии могут отличаться от гарантий этой политики."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läs den innan du godkänner: dess skydd kan skilja sig från den här policyns."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同意前请先阅读：其保护措施可能与本政策不同。"
