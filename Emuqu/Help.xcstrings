    "From a chat: long-press any message → Remember this. The message text becomes a fact" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من المحادثة: اضغط مطولًا على أي رسالة → تذكّر هذا. يصبح نص الرسالة حقيقة"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra en chat: tryk længe på en besked → Husk dette. Beskedens tekst bliver en fakta"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus einem Chat: Drücke lange auf eine Nachricht → Das merken. Der Nachrichtentext wird zu einem Fakt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde un chat: mantén pulsado cualquier mensaje → Recordar esto. El texto del mensaje se convierte en un dato"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
