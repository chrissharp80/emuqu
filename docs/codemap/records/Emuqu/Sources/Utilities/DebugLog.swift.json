{
 "file": "Emuqu/Sources/Utilities/DebugLog.swift",
 "hash": "22fe7b0f90a31f01",
 "role": "App-wide logger: debugLog() buffers every line into an observable in-memory ring buffer and 'Recent Problems' error catalog, and (always in DEBUG, opt-in in Release) flushes PHI-scrubbed lines to debug_log.txt in the App Group container (via AppConfig.sharedContainerURL); exports the file, or the scrubbed in-memory buffer when Persistent Logging is off; also owns the PHI scrubber/regex cache, log export and the debugLogExternal/correlation helpers.",
 "types": [
  "DebugLogger: class (@Observable, @MainActor) — logger singleton, ring buffer, disk flush, export",
  "DebugLogger.LogLevel: enum — debug/info/warning/error, Comparable",
  "DebugLogger.LogEntry: struct — one log line",
  "ExternalCause: enum — strap/iOS/bluetooth/iCloud/network tag for debugLogExternal"
 ],
 "state": [
  "mem:DebugLogger.shared",
  "mem:DebugLogger.entries (observable, ≤5000, ≤7 days)",
  "mem:DebugLogger.exportBuffer (lock-backed copy of entries for off-main export)",
  "mem:DebugLogger.errorCatalog (observable, ≤1000, in-memory only)",
  "mem:DebugLogger.persistentLoggingEnabled",
  "ud:UserDefaultsKeys.persistentLoggingEnabled ('PersistentLoggingEnabled')",
  "file:<AppGroup or Documents or tmp>/debug_log.txt",
  "file:tmp/log-export/hrv_debug_log_<epoch>.txt",
  "notif:DebugLogger.significantLogPosted ('DebugLogger.SignificantLog')",
  "static maxFileSize=2MB, maxMemoryEntries=5000, flushInterval=5s",
  "static lineDateStyle (yyyy-MM-dd HH:mm:ss.SSS local)",
  "static metricPattern/unitPattern/separatorPattern (PHI regex sources)",
  "mem:DebugLogger.compiledPatterns (regex cache)",
  "DispatchQueue 'com.hrv.debuglogger'",
  "Timer flushTimer (5 s repeating)"
 ],
 "toplevel": "Static regex source strings and lineDateStyle are initialised lazily; persistentLoggingEnabled is hard-wired true under #if DEBUG in init. Free functions debugLog/correlationTagged/debugLogExternal and enum ExternalCause are top-level.",
 "units": [
