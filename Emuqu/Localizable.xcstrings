    "Your recovery is in." : {
      "comment" : "Teaser notification body text.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصلت نتيجة تعافيك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din restitution er klar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Erholung liegt vor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu recuperación está lista."
          }
        },
        "fi" : {
          "stringUnit" : {
