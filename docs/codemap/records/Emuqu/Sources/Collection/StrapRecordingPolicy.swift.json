{
 "file": "Emuqu/Sources/Collection/StrapRecordingPolicy.swift",
 "hash": "e33b7cf31b184b7a",
 "role": "Pure decision functions and constants guarding the strap's on-device recording: start preconditions, status interpretation, unattended-fetch decision, end-of-session stop, transfer budgets, retry schedule, recording-to-session matching, saved/unrecovered checks, start-refusal classification and low-battery warnings.",
 "types": [
  "StrapRecordingPolicy: enum (namespace) — recording policy decisions",
  "StrapRecordingPolicy.StartDecision: enum — notConnected/alreadyRecording/startVeritySense/startH10",
  "StrapRecordingPolicy.StatusOutcome: struct — isRecordingOnDevice + optional new RecordingState",
  "StrapRecordingPolicy.QuickFetchDecision: enum — notConnected/fetchH10/fetchVeritySense/skipVeritySenseNotRecording",
  "StrapRecordingPolicy.TransferBudget: struct — per-phase deadlines (stopSeconds, downloadSeconds) + showsProgress; statics unattended (45/120 s) and attended (45/300 s)",
  "StrapRecordingPolicy.DownloadFailure: enum — deterministic/nothingListed/transient",
  "StrapRecordingPolicy.RetryStep: enum — giveUp/pause(ms)/resetLink",
  "StrapRecordingPolicy.StartRefusal: enum — batteryTooLow/undownloadedRecordingOnStrap/retryable"
 ],
 "state": [
  "mem:StrapRecordingPolicy.morningReconnectWindowSeconds = 60",
  "mem:StrapRecordingPolicy.featureReadyWindowSeconds = 60",
  "mem:StrapRecordingPolicy.linkDropWaitSeconds = 5",
  "mem:StrapRecordingPolicy.TransferBudget.unattended (45 s stop, 120 s download, no progress)",
  "mem:StrapRecordingPolicy.TransferBudget.attended (45 s stop, 300 s download, progress)",
  "mem:StrapRecordingPolicy.reconnectWindowSeconds = morningReconnectWindowSeconds (60)",
  "mem:StrapRecordingPolicy.maxDownloadAttempts = 9",
  "mem:StrapRecordingPolicy.sessionSpanLimitSeconds = 86400",
  "mem:StrapRecordingPolicy.armingRetryIntervalSeconds = 180",
  "mem:StrapRecordingPolicy.lowBatteryWarningPercent = 20"
 ],
 "toplevel": "Static constants listed in state; no other top-level behaviour.",
