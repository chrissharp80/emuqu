   "key": "step dependency-review/Refuse an empty comparison",
   "hash": "2e0d25c78be70470",
   "does": "Resolves BASE_REF (inputs.base-ref or the default branch) and HEAD_REF (inputs.head-ref or github.sha) to commits, trying the ref as given and then origin/<ref>. Fails if either does not resolve, or if both are the same commit (the review would compare nothing and report success), telling the user to dispatch with base-ref set to an earlier tag or SHA; otherwise prints the two commits.",
   "entry": "Step of security.yml dependency-review job (workflow_dispatch only); a failing step fails the job and skips the review.",
   "calls": [
    "ext:git rev-parse"
   ],
   "reads": [
    "git:refs (local branches, tags, origin/*)"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "inputs.base-ref empty",
     "effect": "BASE_REF = repository default branch"
    },
    {
     "at": "+3",
     "cond": "inputs.head-ref empty",
     "effect": "HEAD_REF = dispatched commit sha"
    },
    {
     "at": "+8",
     "cond": "ref does not resolve as given",
     "effect": "resolve() tries origin/<ref>; fails if that does not resolve either"
    },
    {
     "at": "+10",
     "cond": "BASE_REF does not resolve",
     "effect": "error to stderr, exit 1"
    },
    {
     "at": "+14",
     "cond": "HEAD_REF does not resolve",
     "effect": "error to stderr, exit 1"
    },
    {
     "at": "+18",
     "cond": "base and head are the same commit",
     "effect": "explains the empty comparison, exit 1"
    }
   ],
   "flags": [],
   "deps": {}
