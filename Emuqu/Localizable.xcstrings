    "Watch caffeine, alcohol, and stress today; they all compound." : {
      "comment" : "One of the actions to take based on a \"pay attention\" verdict.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتبه للكافيين والكحول والإجهاد اليوم؛ فكلها تتراكم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vær opmærksom på koffein, alkohol og stress i dag; det hele hober sig op."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achte heute auf Koffein, Alkohol und Stress — alles summiert sich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuida hoy la cafeína, el alcohol y el estrés; todo se acumula."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varo tänään kofeiinia, alkoholia ja stressiä; ne kumuloituvat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surveillez caféine, alcool et stress aujourd’hui ; tout s’additionne."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gættu að koffíni, áfengi og streitu í dag; allt safnast upp."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attenzione oggi a caffeina, alcol e stress; si sommano tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日はカフェイン・アルコール・ストレスに注意 — すべて積み重なります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 카페인, 알코올, 스트레스에 주의하세요. 모두 누적됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pass på koffein, alkohol og stress i dag; alt hoper seg opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let vandaag op cafeïne, alcohol en stress; alles stapelt op."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuidado com cafeína, álcool e estresse hoje; tudo se soma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Следите сегодня за кофеином, алкоголем и стрессом — всё накапливается."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se upp med koffein, alkohol och stress idag; allt adderas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天注意咖啡因、酒精和压力 — 它们会叠加。"
          }
        }
      }
    },
