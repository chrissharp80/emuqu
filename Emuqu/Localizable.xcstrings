        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DFA α1 var i snitt %@ – de harde dragene trakk den under 0,50, så dette teller som en hard dag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DFA α1 lag gemiddeld op %@ — de zware inspanningen trokken hem onder 0,50, dus dit telt als een zware dag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O DFA α1 teve média de %@ — os esforços intensos o levaram abaixo de 0,50, então conta como um dia forte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Средний DFA α1 составил %@ — интенсивные отрезки опустили его ниже 0,50, так что это тяжёлый день."
          }
        },
        "sv" : {
