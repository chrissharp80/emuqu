    "Compare today to yesterday. What changed in HRV, sleep, training load, and vitals?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قارن اليوم بالأمس. ما الذي تغيّر في HRV والنوم وحمل التدريب والعلامات الحيوية؟"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenlign i dag med i går. Hvad har ændret sig i HRV, søvn, træningsbelastning og vitale værdier?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleiche heute mit gestern. Was hat sich bei HRV, Schlaf, Trainingsbelastung und Vitalwerten verändert?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara hoy con ayer. ¿Qué ha cambiado en la HRV, el sueño, la carga de entrenamiento y las constantes vitales?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertaa tätä päivää eiliseen. Mikä muuttui HRV:ssä, unessa, harjoituskuormassa ja elintoiminnoissa?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare aujourd'hui à hier. Qu'est-ce qui a changé pour la HRV, le sommeil, la charge d'entraînement et les signes vitaux ?"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berðu daginn í dag saman við gærdaginn. Hvað breyttist í HRV, svefni, æfingaálagi og lífsmörkum?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confronta oggi con ieri. Cosa è cambiato in HRV, sonno, carico di allenamento e parametri vitali?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日と昨日を比べてください。HRV、睡眠、トレーニング負荷、バイタルで何が変わりましたか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘과 어제를 비교해 주세요. HRV, 수면, 훈련 부하, 바이탈에서 무엇이 달라졌나요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenlign i dag med i går. Hva har endret seg i HRV, søvn, treningsbelastning og vitale verdier?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergelijk vandaag met gisteren. Wat is er veranderd in HRV, slaap, trainingsbelasting en vitale waarden?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare hoje com ontem. O que mudou na VFC, no sono, na carga de treino e nos sinais vitais?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сравни сегодня со вчера. Что изменилось в ВСР, сне, тренировочной нагрузке и показателях?"
          }
        },
        "sv" : {
          "stringUnit" : {
