   "key": "func SessionReanalysisCoordinator.reanalyzeSession(_:method:)",
   "hash": "3f559abdb48d7544",
   "does": "Reanalyses one saved session. If one is already in flight for the id it records a pending request and returns the archived copy; otherwise marks it in flight, runs one pass (reanalyzeOnce), then one more pass for each request that arrived meanwhile (it may carry newer inputs, e.g. sleep that landed after the pass read HealthKit), and returns the latest result.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Collection/SessionReanalysisCoordinator.swift::func SessionReanalysisCoordinator.coalescedInFlightSession(_:)",
    "Emuqu/Sources/Collection/SessionReanalysisCoordinator.swift::func SessionReanalysisCoordinator.reanalyzeOnce(_:method:)"
   ],
   "reads": [
    "mem:SessionReanalysisCoordinator.inFlightReanalyses",
    "mem:SessionReanalysisCoordinator.pendingReanalyses"
   ],
   "writes": [
    "mem:SessionReanalysisCoordinator.inFlightReanalyses",
    "mem:SessionReanalysisCoordinator.pendingReanalyses"
   ],
   "branches": [
    {
     "at": "+1",
     "cond": "session id already in flight",
     "effect": "records it pending, returns the coalesced archived copy"
    },
    {
     "at": "+8",
     "cond": "a request arrived while in flight",
     "effect": "trailing pass; its nil result keeps the previous one"
    }
   ],
