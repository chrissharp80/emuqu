    },
    "Emuqu uses a one-time lifetime purchase — pay once, own it forever. No subscriptions, no recurring charges." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعتمد Emuqu على شراء لمرة واحدة مدى الحياة — ادفع مرة وامتلكه للأبد. لا اشتراكات ولا رسوم متكررة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu bruger et engangskøb — betal én gang, og ej den for altid. Ingen abonnementer, ingen tilbagevendende betalinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu ist ein einmaliger, lebenslanger Kauf — einmal bezahlen, für immer besitzen. Keine Abos, keine wiederkehrenden Kosten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu usa una compra única de por vida: pagas una vez y es tuyo para siempre. Sin suscripciones ni cargos recurrentes."
