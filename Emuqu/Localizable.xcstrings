    "Any sleep overlapping this range is replaced with awake time." : {
      "comment" : "A description below the awake window date pickers, explaining how the carve awake feature works.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستبدل أي نوم يتداخل مع هذا النطاق بوقت اليقظة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al søvn, der overlapper dette interval, erstattes med vågen tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Schlaf, der sich mit diesem Bereich überschneidet, wird durch Wachzeit ersetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier sueño que se superponga con este intervalo se reemplaza por tiempo despierto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikki tähän väliin osuva uni korvataan hereilläoloajalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout sommeil chevauchant cette plage est remplacé par du temps d'éveil."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öllum svefni sem skarast við þetta bil er skipt út fyrir vökutíma."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualsiasi sonno che si sovrappone a questo intervallo viene sostituito con tempo da sveglio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この範囲と重なる睡眠はすべて覚醒時間に置き換えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 범위와 겹치는 수면은 모두 깨어 있는 시간으로 대체됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All søvn som overlapper dette området, erstattes med våken tid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle slaap die overlapt met dit bereik wordt vervangen door wakkere tijd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer sono que se sobreponha a este intervalo é substituído por tempo acordado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любой сон, пересекающийся с этим диапазоном, заменяется временем бодрствования."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
