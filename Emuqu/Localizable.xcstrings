    "Set defaults in Profile to skip typing addresses" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبط الافتراضيات في الملف الشخصي لتجنّب كتابة العناوين"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angiv standarder i Profil for at slippe for at taste adresser"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standards im Profil setzen, um Adressen nicht zu tippen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura valores por defecto en Perfil para no escribir direcciones"
          }
        },
        "fi" : {
          "stringUnit" : {
