   "key": "func WatchMessageDecoding.pace(secPerKm:imperial:)",
   "hash": "ed721b0973f0830a",
   "does": "Formats seconds-per-km as \"m:ss /km\" or (×1.609344) \"m:ss /mi\" in the current locale, capped at 86,400 s; nil for non-finite or non-positive input.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "secPerKm finite and > 0",
     "effect": "false: return nil (no pace shown); true: format"
    },
    {
     "at": "+2",
     "cond": "imperial",
     "effect": "true: multiply by 1.609344 for per-mile; false: per-km as is"
    },
    {
     "at": "+4",
     "cond": "imperial",
     "effect": "true: \"<time> /mi\"; false: \"<time> /km\""
    }
