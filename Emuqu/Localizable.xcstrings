    "No matching workout + morning recovery pair to combine. Daily reports need both on the same day." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد زوج مطابق من تمرين + تعافي صباحي للدمج. تحتاج التقارير اليومية إلى كليهما في اليوم نفسه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der findes intet matchende par af træning + morgenrestitution. Daglige rapporter kræver begge på samme dag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein passendes Paar aus Training + Morgen-Erholung zum Kombinieren. Tagesberichte brauchen beides am selben Tag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay un par de entrenamiento + recuperación matinal para combinar. Los informes diarios necesitan ambos el mismo día."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhdistettävää harjoitus + aamupalautuminen -paria ei löytynyt. Päiväraportit vaativat molemmat samalle päivälle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune paire séance + récupération matinale à combiner. Les rapports quotidiens nécessitent les deux le même jour."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekkert samsvarandi par af æfingu + morgunendurheimt til að sameina. Dagsskýrslur þurfa hvort tveggja sama dag."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuna coppia allenamento + recupero mattutino da combinare. I report giornalieri richiedono entrambi nello stesso giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "組み合わせられるワークアウトと朝の回復のペアがありません。日次レポートには同じ日の両方が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "결합할 운동 + 아침 회복 쌍이 없습니다. 일일 리포트에는 같은 날의 두 가지가 모두 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen matchende par av økt + morgenrestitusjon å kombinere. Daglige rapporter krever begge samme dag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen bijpassend paar training + ochtendherstel om te combineren. Dagrapporten hebben beide op dezelfde dag nodig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há par de treino + recuperação matinal para combinar. Os relatórios diários exigem ambos no mesmo dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет подходящей пары «тренировка + утреннее восстановление» для объединения. Дневным отчётам нужны оба в один день."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inget matchande par av pass + morgonåterhämtning att kombinera. Dagsrapporter kräver båda samma dag."
          }
        },
