  {
   "key": "func AgeAdjustedHRV.medianRMSSD(forAge:sex:)",
   "hash": "afaa1b3c44c988a2",
   "does": "Maps age to a population-median RMSSD (ms) by decade band (55/45/38/32/27/22/18) and multiplies by the sex factor when sex is given.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Analysis/HRVThresholds.swift::var AgeAdjustedHRV.Sex.rmssdMultiplier"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "age < 20",
     "effect": "base 55"
    },
    {
     "at": "+3",
     "cond": "20..<30",
     "effect": "base 45"
    },
    {
     "at": "+4",
     "cond": "30..<40",
     "effect": "base 38"
    },
    {
     "at": "+5",
     "cond": "40..<50",
     "effect": "base 32"
    },
    {
     "at": "+6",
     "cond": "50..<60",
     "effect": "base 27"
    },
    {
     "at": "+7",
     "cond": "60..<70",
     "effect": "base 22"
    },
    {
     "at": "+8",
     "cond": "default (>=70)",
     "effect": "base 18"
    },
    {
     "at": "+12",
     "cond": "sex is nil (?? fallback)",
     "effect": "multiplier 1.0 when sex unknown, else sex.rmssdMultiplier"
    }
   ],
   "deps": {
    "Emuqu/Sources/Analysis/HRVThresholds.swift::var AgeAdjustedHRV.Sex.rmssdMultiplier": "3328fb4cadb16efe"
   }
  },
