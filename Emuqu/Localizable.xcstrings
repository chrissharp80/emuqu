    "Emuqu never sells your data, and contains no analytics SDKs, advertising frameworks, or tracking services." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يبيع Emuqu بياناتك أبدًا، ولا يحتوي على حزم تحليلات أو أطر إعلانية أو خدمات تتبّع."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu sælger aldrig dine data og indeholder ingen analytics-SDK'er, annonceframeworks eller sporingstjenester."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
