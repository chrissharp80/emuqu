    "Erasing all your data sits behind a confirmation step so a stray tap can't wipe your history." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب مسح كل بياناتك خطوة تأكيد حتى لا تمحو نقرة عابرة سجلك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletning af alle dine data kræver en bekræftelse, så et fejltryk ikke kan slette din historik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Löschen aller Daten erfordert eine Bestätigung, damit ein versehentlicher Tipp deinen Verlauf nicht löscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borrar todos tus datos requiere un paso de confirmación para que un toque accidental no elimine tu historial."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaikkien tietojen poistaminen vaatii vahvistuksen, jottei vahinkonapautus pyyhi historiaasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'effacement de toutes vos données passe par une étape de confirmation, pour qu'un geste malencontreux n'efface pas votre historique."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til að eyða öllum gögnunum þínum þarf staðfestingu svo óvart ýting þurrki ekki út söguna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancellare tutti i dati richiede una conferma, così un tocco accidentale non può eliminare lo storico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのデータの消去には確認の手順があるため、誤ってタップしても履歴が消えることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 데이터 삭제에는 확인 단계가 있어 실수로 탭해도 기록이 지워지지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletting av alle dataene dine krever en bekreftelse, så et feiltrykk ikke kan slette historikken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al je gegevens wissen vraagt om een bevestiging, zodat een verkeerde tik je geschiedenis niet kan wissen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagar todos os seus dados exige uma confirmação, para que um toque acidental não apague seu histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление всех данных требует подтверждения, чтобы случайное касание не стёрло историю."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att radera all din data kräver en bekräftelse, så att ett feltryck inte kan radera din historik."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清除所有数据前需要确认，避免误触删除你的历史记录。"
          }
        }
