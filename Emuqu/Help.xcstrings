        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis den registreres, lægges den ekstra søvn automatisk til din samlede søvn"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
