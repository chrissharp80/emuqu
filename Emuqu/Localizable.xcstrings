    "Aerobic capacity has room to grow — your CTL reflects training load, VO₂max your aerobic ceiling" : {
      "comment" : "Explanation of how VO₂max and CTL are related.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السعة الهوائية لديها مجال للنمو — يعكس CTL حمل التدريب، بينما يعكس VO₂max سقفك الهوائي"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den aerobe kapacitet har plads til at vokse — CTL afspejler træningsbelastning, VO₂max dit aerobe loft"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aerobe Kapazität hat Luft nach oben — CTL zeigt die Trainingsbelastung, VO₂max deine aerobe Obergrenze"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capacidad aeróbica tiene margen de mejora — tu CTL refleja la carga de entrenamiento y el VO₂máx tu techo aeróbico"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aerobisessa kapasiteetissa on kasvunvaraa — CTL kuvaa harjoituskuormaa, VO₂max aerobista kattoasi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capacité aérobie peut encore progresser — votre CTL reflète la charge, la VO₂max votre plafond aérobie"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loftháð geta hefur svigrúm til vaxtar — CTL endurspeglar æfingaálag, VO₂max loftháða þakið þitt"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capacità aerobica ha margini di crescita — il CTL riflette il carico, il VO₂max il tuo tetto aerobico"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有酸素能力にはまだ伸びしろがあります — CTL はトレーニング負荷を、VO₂max は有酸素の上限を表します"
