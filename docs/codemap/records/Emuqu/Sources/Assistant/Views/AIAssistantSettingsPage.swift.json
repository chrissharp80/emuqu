    "Emuqu/Sources/Utilities/DebugLog.swift::func debugLog(_:level:file:line:)"
   ],
   "reads": [
    "kc:service.tavily_web_search"
   ],
   "writes": [
    "kc:com.chrissharp.flowrecovery.assistant.apikey/<provider>",
    "ud:assistant.consent.v8.<provider>",
    "ud:assistant.consent.v8.<provider>.grantedAt",
    "mem:ProviderConsentTracker.acknowledgedProviders",
    "file:user_settings.json (SettingsManager.settings.enableWebSearch)"
   ],
   "branches": [
    {
     "at": "+3",
     "cond": "keychain delete failed",
     "effect": "log warning"
    },
    {
     "at": "+8",
     "cond": "removed AND provider is Anthropic AND no Tavily key is stored",
