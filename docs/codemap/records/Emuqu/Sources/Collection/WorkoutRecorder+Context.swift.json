   "key": "func WorkoutAIContextBuilder.attemptAutoRouteDetection(sport:)",
   "hash": "ebb6861c22acaf60",
   "does": "Saved-route auto-binding: once the live track reaches the later of 500 m (RouteLibrary.detectionTriggerMeters) and nextRouteDetectionAtMeters, schedules the next attempt another 500 m on, asks RouteLibrary.findMatch against the saved-route store and, on a match, binds plannedRoute, marks auto-detected, stores direction and logs. Retried every further 500 m while nothing matches, so a loop joined after a warm-up leg is still recognised; the ticker stops calling once a route is bound.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Collection/WorkoutRecorder.swift::var WorkoutRecorder.location",
    "Emuqu/Sources/Collection/WorkoutRecorder+GeometryForwarding.swift::func WorkoutRecorder.trackLengthMeters(_:)",
    "Emuqu/Sources/Analysis/RouteLibrary.swift::func RouteLibrary.findMatch(currentTrack:sport:store:)",
    "Emuqu/Sources/Utilities/DebugLog.swift::func debugLog(_:level:file:line:)"
   ],
   "reads": [
    "mem:WorkoutLocationManager.track",
    "mem:SavedRouteStore",
    "mem:WorkoutRecorder.nextRouteDetectionAtMeters"
   ],
   "writes": [
    "mem:WorkoutRecorder.nextRouteDetectionAtMeters",
    "mem:WorkoutRecorder.plannedRoute",
    "mem:WorkoutRecorder.plannedRouteWasAutoDetected",
    "mem:WorkoutRecorder.plannedRouteDirection"
   ],
   "branches": [
    {
     "at": "+3",
     "cond": "traveled < max(500 m, nextRouteDetectionAtMeters)",
     "effect": "returns without trying"
    },
    {
     "at": "+6",
     "cond": "no matching saved route",
     "effect": "returns; next attempt after 500 m more track"
    },
    {
     "at": "+16",
     "cond": "direction == .reverse",
     "effect": "log suffix \"(reverse)\"; else empty"
    }
   ],
