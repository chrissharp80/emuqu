        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La BAJAN: dormir mal, una carga de entrenamiento elevada y sostenida, el alcohol (incluso en cantidades moderadas), la enfermedad, el estrés agudo y la deshidratación"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LASKEE sitä: huono uni, raskas pitkäkestoinen harjoituskuormitus, alkoholi (kohtuullisinakin määrinä), sairaus, akuutti stressi, nestehukka"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La font BAISSER : mauvais sommeil, charge d’entraînement lourde et prolongée, alcool (même en quantité modérée), maladie, stress aigu, déshydratation"
