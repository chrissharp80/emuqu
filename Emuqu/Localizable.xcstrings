    "Your data is saved. Coach will analyze when you reconnect." : {
      "comment" : "Text displayed in an empty state when the user's Coach is offline, explaining that the user's data is saved and will be analyzed once the user reconnects.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حفظ بياناتك. سيحللها المدرب عند إعادة الاتصال."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine data er gemt. Coachen analyserer, når du er online igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten sind gespeichert. Der Coach analysiert, sobald du wieder online bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos están guardados. El entrenador los analizará al reconectarte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietosi on tallennettu. Valmentaja analysoi, kun yhteys palaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données sont enregistrées. Le coach analysera à la reconnexion."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gögnin þín eru vistuð. Þjálfarinn greinir þegar þú tengist aftur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati sono salvati. Il coach analizzerà alla riconnessione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データは保存されました。再接続時にコーチが解析します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터가 저장되었습니다. 다시 연결되면 코치가 분석합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
