    "Microphone access is denied. Open Settings → Emuqu → enable Microphone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم رفض الوصول إلى الميكروفون. افتح الإعدادات ← Emuqu ← وفعّل الميكروفون."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til mikrofonen er afvist. Åbn Indstillinger → Emuqu → slå Mikrofon til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonzugriff ist abgelehnt. Öffne Einstellungen → Emuqu → aktiviere Mikrofon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso al micrófono está denegado. Abre Ajustes → Emuqu → activa Micrófono."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonin käyttö on estetty. Avaa Asetukset → Emuqu → ota Mikrofoni käyttöön."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au micro est refusé. Ouvrez Réglages → Emuqu → activez Micro."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aðgangi að hljóðnema er hafnað. Opnaðu Stillingar → Emuqu → kveiktu á Hljóðnema."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso al microfono è negato. Apri Impostazioni → Emuqu → attiva Microfono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクへのアクセスが拒否されています。設定 → Emuqu → マイクをオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크 접근이 거부되었습니다. 설정 → Emuqu → 마이크를 켜세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilgang til mikrofonen er avslått. Åpne Innstillinger → Emuqu → slå på Mikrofon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegang tot de microfoon is geweigerd. Open Instellingen → Emuqu → schakel Microfoon in."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso ao microfone foi negado. Abra Ajustes → Emuqu → ative Microfone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к микрофону запрещён. Откройте Настройки → Emuqu → включите Микрофон."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtkomst till mikrofonen nekas. Öppna Inställningar → Emuqu → slå på Mikrofon."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风访问被拒绝。请打开“设置”→ Emuqu → 开启“麦克风”。"
          }
        }
      }
    },
    "Microphone access is off. Turn it on in Settings → Apps → Emuqu." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوصول إلى الميكروفون متوقف. فعّله في الإعدادات ← التطبيقات ← Emuqu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adgang til mikrofonen er slået fra. Slå den til under Indstillinger → Apps → Emuqu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Mikrofonzugriff ist aus. Aktiviere ihn unter Einstellungen → Apps → Emuqu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso al micrófono está desactivado. Actívalo en Ajustes → Apps → Emuqu."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonin käyttö on pois päältä. Salli se kohdassa Asetukset → Apit → Emuqu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accès au micro est désactivé. Activez-le dans Réglages → Apps → Emuqu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slökkt er á aðgangi að hljóðnema. Kveiktu á honum í Stillingar → Forrit → Emuqu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'accesso al microfono è disattivato. Attivalo in Impostazioni → App → Emuqu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクへのアクセスがオフになっています。設定 → アプリ → Emuqu でオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크 접근이 꺼져 있습니다. 설정 → 앱 → Emuqu에서 켜세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilgang til mikrofonen er slått av. Slå den på i Innstillinger → Apper → Emuqu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toegang tot de microfoon staat uit. Zet het aan in Instellingen → Apps → Emuqu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso ao microfone está desativado. Ative em Ajustes → Apps → Emuqu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к микрофону выключен. Включите его в Настройки → Приложения → Emuqu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åtkomst till mikrofonen är avstängd. Slå på den i Inställningar → Appar → Emuqu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风访问已关闭。请在“设置 → App → Emuqu”中开启。"
          }
        }
      }
    },
    "Microphone is currently held by another app. Try again in a moment, or restart the app if it persists." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الميكروفون مستخدم حاليًا من تطبيق آخر. حاول مرة أخرى بعد قليل، أو أعد تشغيل التطبيق إن استمرت المشكلة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonen bruges i øjeblikket af en anden app. Prøv igen om lidt, eller genstart appen, hvis det fortsætter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon wird gerade von einer anderen App genutzt. Versuch es gleich noch einmal oder starte die App neu, falls es bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app está usando el micrófono. Inténtalo de nuevo en un momento o reinicia la app si persiste."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toinen sovellus käyttää mikrofonia. Yritä hetken päästä uudelleen tai käynnistä sovellus uudelleen, jos ongelma jatkuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le micro est actuellement utilisé par une autre app. Réessayez dans un instant ou redémarrez l'app si le problème persiste."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annað forrit er með hljóðnemann. Reyndu aftur eftir smástund eða endurræstu appið ef þetta heldur áfram."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il microfono è in uso da un'altra app. Riprova tra poco o riavvia l'app se il problema persiste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクは現在別のアプリが使用中です。しばらくしてからもう一度試すか、解決しない場合はアプリを再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 앱이 현재 마이크를 사용 중입니다. 잠시 후 다시 시도하거나, 계속되면 앱을 다시 시작하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonen brukes nå av en annen app. Prøv igjen om litt, eller start appen på nytt hvis det vedvarer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De microfoon wordt nu door een andere app gebruikt. Probeer het zo opnieuw, of herstart de app als het blijft gebeuren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O microfone está sendo usado por outro app. Tente de novo em instantes ou reinicie o app se persistir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Микрофон сейчас занят другим приложением. Повторите попытку чуть позже или перезапустите приложение, если проблема не исчезнет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofonen används just nu av en annan app. Försök igen om en stund, eller starta om appen om det kvarstår."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风当前被其他应用占用。请稍后再试，如果问题持续请重启应用。"
          }
        }
      }
    },
