    "NSMotionUsageDescription" : {
      "comment" : "Privacy - Motion Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Emuqu بيانات الحركة — عدد الخطوات والإيقاع من CMPedometer، والارتفاع البارومتري من CMAltimeter — لتتبع مسافة المشي والجري بدقة (بما في ذلك في الأماكن المغلقة حيث لا يكون GPS موثوقًا)، وحساب الصعود في المشي لمسافات طويلة والجري، وعرض خطواتك اليومية للأسبوع الماضي في علامة التبويب «اللياقة»."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu bruger bevægelsesdata – skridttal og kadence fra CMPedometer samt barometrisk højde fra CMAltimeter – til at måle gå- og løbedistance præcist (også indendørs, hvor GPS er upålidelig), til at beregne stigning på vandreture og løbeture og til at vise dine daglige skridt fra den seneste uge på fanen Fitness."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu verwendet Bewegungsdaten – Schrittzahl und Kadenz von CMPedometer sowie barometrische Höhe von CMAltimeter –, um Geh- und Laufstrecken genau zu erfassen (auch drinnen, wo GPS unzuverlässig ist), Höhenmeter bei Wanderungen und Läufen zu berechnen und deine täglichen Schritte der letzten Woche im Tab „Fitness“ anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Emuqu uses motion data — step count and cadence from CMPedometer, plus barometric altitude from CMAltimeter — to track walking and running distance accurately (including indoors where GPS is unreliable), to compute elevation gain on hikes and runs, and to show your daily steps from the past week in the Fitness tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu usa datos de movimiento —número de pasos y cadencia de CMPedometer, y altitud barométrica de CMAltimeter— para medir con precisión la distancia caminando y corriendo (también en interiores, donde el GPS no es fiable), calcular el desnivel en caminatas y carreras, y mostrar tus pasos diarios de la última semana en la pestaña Condición física."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu käyttää liiketietoja – askelmäärää ja askeltiheyttä CMPedometerista sekä barometrista korkeutta CMAltimeterista – mitatakseen kävely- ja juoksumatkan tarkasti (myös sisätiloissa, joissa GPS on epäluotettava), laskeakseen nousumetrit vaelluksilla ja juoksuissa sekä näyttääkseen viime viikon päivittäiset askeleesi Kunto-välilehdellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu utilise les données de mouvement — nombre de pas et cadence de CMPedometer, et altitude barométrique de CMAltimeter — pour mesurer précisément la distance à pied et en courant (y compris en intérieur, où le GPS est peu fiable), calculer le dénivelé positif en randonnée et en course, et afficher vos pas quotidiens de la semaine passée dans l’onglet Forme."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu notar hreyfigögn – skrefafjölda og taktíðni úr CMPedometer og loftþrýstingshæð úr CMAltimeter – til að mæla göngu- og hlaupavegalengd nákvæmlega (líka innandyra þar sem GPS er óáreiðanlegt), reikna hækkun í göngum og hlaupum og sýna dagleg skref þín síðustu viku í Hreysti-flipanum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu usa i dati di movimento — numero di passi e cadenza da CMPedometer e altitudine barometrica da CMAltimeter — per misurare con precisione la distanza a piedi e di corsa (anche al chiuso, dove il GPS non è affidabile), calcolare il dislivello in escursioni e corse e mostrare i passi giornalieri dell’ultima settimana nella scheda Fitness."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu はモーションデータ（CMPedometer の歩数とケイデンス、CMAltimeter の気圧高度）を使用して、ウォーキングやランニングの距離を正確に計測し（GPS が不安定な屋内でも）、ハイキングやランニングの獲得標高を計算し、「フィットネス」タブに過去 1 週間の毎日の歩数を表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu는 모션 데이터(CMPedometer의 걸음 수와 케이던스, CMAltimeter의 기압 고도)를 사용해 걷기 및 달리기 거리를 정확하게 측정하고(GPS가 불안정한 실내 포함), 하이킹과 달리기의 상승 고도를 계산하며, 피트니스 탭에 지난 한 주의 일일 걸음 수를 표시합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu bruker bevegelsesdata – skrittall og kadens fra CMPedometer og barometrisk høyde fra CMAltimeter – til å måle gå- og løpedistanse nøyaktig (også innendørs, der GPS er upålitelig), beregne stigning på turer og løpeturer og vise de daglige skrittene dine fra siste uke i Trening-fanen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu gebruikt bewegingsgegevens – stappen en cadans van CMPedometer en barometrische hoogte van CMAltimeter – om wandel- en hardloopafstand nauwkeurig te meten (ook binnen, waar gps onbetrouwbaar is), het hoogteverschil bij wandelingen en hardlooptochten te berekenen en je dagelijkse stappen van de afgelopen week te tonen in het tabblad Fitness."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Emuqu usa dados de movimento — contagem de passos e cadência do CMPedometer, e altitude barométrica do CMAltimeter — para medir com precisão a distância de caminhada e corrida (inclusive em ambientes internos, onde o GPS não é confiável), calcular o ganho de elevação em trilhas e corridas e mostrar seus passos diários da última semana na aba Fitness."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu использует данные о движении — количество шагов и каденс из CMPedometer, а также барометрическую высоту из CMAltimeter, — чтобы точно измерять расстояние ходьбы и бега (в том числе в помещении, где GPS ненадёжен), рассчитывать набор высоты в походах и на пробежках и показывать ваши ежедневные шаги за последнюю неделю на вкладке «Форма»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu använder rörelsedata – stegantal och kadens från CMPedometer samt barometrisk höjd från CMAltimeter – för att mäta gång- och löpdistans exakt (även inomhus där GPS är opålitlig), beräkna höjdökning på vandringar och löprundor och visa dina dagliga steg från den senaste veckan på fliken Fitness."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu 使用运动数据（来自 CMPedometer 的步数和步频，以及来自 CMAltimeter 的气压高度）来准确记录步行和跑步距离（包括 GPS 不可靠的室内），计算徒步和跑步的爬升高度，并在“体能”标签页显示过去一周的每日步数。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ Emuqu صورة ملخص التعافي أو ملخص التمرين في مكتبة الصور عندما تختار «حفظ الصورة» من ورقة المشاركة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu gemmer et restitutionsresumé eller et træningsresumé som billede i dit fotobibliotek, når du vælger Gem billede i delingsarket."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu sichert eine Erholungs- oder Trainingszusammenfassung als Bild in deiner Fotomediathek, wenn du im Teilen-Menü „Bild sichern“ wählst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Emuqu saves a recovery recap or workout summary image to your photo library when you choose Save Image from the share sheet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu guarda un resumen de recuperación o de entrenamiento como imagen en tu fototeca cuando eliges Guardar imagen en la hoja para compartir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu tallentaa palautumis- tai harjoitusyhteenvedon kuvana kuvakirjastoosi, kun valitset jakotaulukosta Tallenna kuva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu enregistre un récapitulatif de récupération ou de séance sous forme d’image dans votre photothèque lorsque vous choisissez Enregistrer l’image dans la feuille de partage."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu vistar samantekt á endurheimt eða æfingu sem mynd í myndasafninu þínu þegar þú velur Vista mynd í deilingarspjaldinu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu salva un riepilogo del recupero o dell’allenamento come immagine nella tua libreria foto quando scegli Salva immagine nel foglio di condivisione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有シートで「画像を保存」を選ぶと、Emuqu は回復のまとめやワークアウトのまとめを画像として写真ライブラリに保存します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 시트에서 이미지 저장을 선택하면 Emuqu가 회복 요약 또는 운동 요약 이미지를 사진 보관함에 저장합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu lagrer et restitusjons- eller øktsammendrag som bilde i bildebiblioteket ditt når du velger Lagre bilde i delingsarket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu bewaart een herstel- of trainingsoverzicht als afbeelding in je fotobibliotheek wanneer je in het deelmenu Bewaar afbeelding kiest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Emuqu salva um resumo de recuperação ou de treino como imagem na sua fototeca quando você escolhe Salvar Imagem na planilha de compartilhamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu сохраняет сводку восстановления или тренировки в виде изображения в вашей медиатеке, когда вы выбираете «Сохранить изображение» в меню «Поделиться»."
          }
        },
        "sv" : {
          "stringUnit" : {
