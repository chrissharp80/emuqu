   ],
   "reads": [
    "mem:WorkoutMetadata.pauseSpans"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "rrSeries nil",
     "effect": "[] points → no beats"
    },
    {
     "at": "+5",
