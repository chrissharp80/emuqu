    "The names, email addresses and notes of your saved email contacts, and your default email recipients, when the assistant looks up a contact or writes an email" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسماء جهات اتصال البريد الإلكتروني المحفوظة وعناوين بريدها وملاحظاتها، ومستلمو البريد الافتراضيون لديك، عندما يبحث المساعد عن جهة اتصال أو يكتب رسالة بريد إلكتروني"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navne, e-mailadresser og noter for dine gemte e-mailkontakter samt dine standardmodtagere, når assistenten slår en kontakt op eller skriver en e-mail"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Namen, E-Mail-Adressen und Notizen deiner gespeicherten E-Mail-Kontakte sowie deine Standardempfänger, wenn der Assistent einen Kontakt nachschlägt oder eine E-Mail schreibt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres, direcciones de correo y notas de tus contactos de correo guardados, y tus destinatarios predeterminados, cuando el asistente busca un contacto o redacta un correo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallentamiesi sähköpostiyhteystietojen nimet, sähköpostiosoitteet ja muistiinpanot sekä oletusvastaanottajasi, kun avustaja hakee yhteystiedon tai kirjoittaa sähköpostin"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms, adresses e-mail et notes de vos contacts e-mail enregistrés, ainsi que vos destinataires par défaut, lorsque l’assistant recherche un contact ou rédige un e-mail"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nöfn, netföng og athugasemdir vistaðra netfangatengiliða þinna og sjálfgefnir viðtakendur þínir, þegar aðstoðarmaðurinn flettir upp tengilið eða skrifar tölvupóst"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomi, indirizzi email e note dei contatti email che hai salvato, e i tuoi destinatari predefiniti, quando l’assistente cerca un contatto o scrive un’email"
          }
