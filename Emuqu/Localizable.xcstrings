    "Below 6 hours — sleep debt is accumulating, recovery will be impaired" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أقل من 6 ساعات — يتراكم دين النوم، وسيتأثر التعافي"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under 6 timer — søvngælden vokser, og restitutionen vil blive svækket"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter 6 Stunden — Schlafschuld baut sich auf, die Erholung wird beeinträchtigt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos de 6 horas — se acumula deuda de sueño, la recuperación se verá afectada"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle 6 tuntia — univelka kertyy, palautuminen heikkenee"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moins de 6 heures — la dette de sommeil s’accumule, la récupération sera altérée"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undir 6 klukkustundum — svefnskuld safnast upp og endurheimt skerðist"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meno di 6 ore — il debito di sonno si accumula, il recupero sarà compromesso"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6 時間未満 — 睡眠負債が蓄積し、回復が損なわれます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6시간 미만 — 수면 부채가 쌓이며 회복이 저하됩니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under 6 timer — søvngjelden bygger seg opp, restitusjonen vil svekkes"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minder dan 6 uur — slaapschuld stapelt zich op, herstel wordt aangetast"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos de 6 horas — a dívida de sono está aumentando e a recuperação será prejudicada"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
