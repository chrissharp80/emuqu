    "Know when to push hard and when to rest" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعرف متى تضغط ومتى ترتاح"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vid, hvornår du skal presse på og hvornår du skal hvile"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wissen, wann man Gas geben und wann man sich erholen sollte"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabe cuándo esforzarte y cuándo descansar"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedä milloin painaa kovaa ja milloin levätä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sachez quand forcer et quand vous reposer"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vittu hvenær á að herða og hvenær á að hvílast"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sapere quando spingersi e quando riposare"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつ追い込み、いつ休むべきか知る"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언제 열심히 하고 언제 쉬어야 하는지"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vit når du skal presse på og når du skal hvile"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet wanneer u hard moet gaan en wanneer u moet rusten"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saiba quando se esforçar e quando descansar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Знайте, когда выкладываться и когда отдыхать"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vet när du ska pressa på och när du ska vila"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "知道何时全力以赴、何时休息"
          }
        }
      }
    },
