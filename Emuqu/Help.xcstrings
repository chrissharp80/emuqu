    "Drop a pin where you start, follow the compass arrow back. Offline." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع دبوسًا عند نقطة البداية، واتبع سهم البوصلة للعودة. دون اتصال."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt en nål, hvor du starter, og følg kompaspilen tilbage. Offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze eine Markierung am Startpunkt und folge dem Kompasspfeil zurück. Offline."
          }
        },
        "es" : {
