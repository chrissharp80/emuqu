    "Incremental Raw Backup — Every 5 minutes during recording, plus immediately on Bluetooth reconnection." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسخ احتياطي خام تدريجي — كل 5 دقائق أثناء التسجيل، وفورًا عند إعادة اتصال البلوتوث."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Løbende rå backup — Hvert 5. minut under optagelse, plus straks ved genforbindelse via Bluetooth."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inkrementelles Rohdaten-Backup — Alle 5 Minuten während der Aufnahme sowie sofort bei erneuter Bluetooth-Verbindung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia incremental sin procesar: cada 5 minutos durante la grabación, y al instante al reconectarse el Bluetooth."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisäävä raakavarmuuskopio — 5 minuutin välein tallennuksen aikana sekä heti Bluetooth-yhteyden palautuessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sauvegarde brute incrémentale — Toutes les 5 minutes pendant l’enregistrement, plus immédiatement à la reconnexion Bluetooth."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stigvaxandi hrátt afrit — Á 5 mínútna fresti meðan á upptöku stendur og strax þegar Bluetooth tengist aftur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backup grezzo incrementale — Ogni 5 minuti durante la registrazione, più subito dopo la riconnessione Bluetooth."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "増分の生データバックアップ — 記録中 5 分ごと、および Bluetooth 再接続時にすぐ実行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "증분 원시 백업 — 기록 중 5분마다, 그리고 Bluetooth 재연결 시 즉시."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinnvis rå sikkerhetskopi — hvert 5. minutt under opptak, pluss umiddelbart når Bluetooth kobles til igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
