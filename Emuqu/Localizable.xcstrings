            "state" : "translated",
            "value" : "Heilleikaprófun lotugagna mistókst — skráin gæti verið skemmd."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controllo di integrità dei dati della sessione non riuscito: il file potrebbe essere danneggiato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションデータの整合性チェックに失敗しました。ファイルが破損している可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
