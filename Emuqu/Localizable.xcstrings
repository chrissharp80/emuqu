    "Below 50: very low. 50-100: low. 100-150: normal. 150-200: elevated. Above 200: high, and above 300 a clear signal to recover." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أقل من 50: منخفض جدًا. 50-100: منخفض. 100-150: طبيعي. 150-200: مرتفع. فوق 200: عالٍ، وفوق 300 إشارة واضحة إلى ضرورة التعافي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under 50: meget lav. 50-100: lav. 100-150: normal. 150-200: forhøjet. Over 200: høj, og over 300 et tydeligt signal om at restituere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unter 50: sehr niedrig. 50-100: niedrig. 100-150: normal. 150-200: erhöht. Über 200: hoch, und über 300 ein klares Signal zur Erholung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por debajo de 50: muy bajo. 50-100: bajo. 100-150: normal. 150-200: elevado. Por encima de 200: alto, y por encima de 300, una señal clara para recuperarte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle 50: hyvin matala. 50-100: matala. 100-150: normaali. 150-200: koholla. Yli 200: korkea, ja yli 300 selvä merkki palautua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sous 50 : très bas. 50-100 : bas. 100-150 : normal. 150-200 : élevé. Au-dessus de 200 : haut, et au-dessus de 300, un signal clair de récupérer."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undir 50: mjög lágt. 50-100: lágt. 100-150: eðlilegt. 150-200: hækkað. Yfir 200: hátt, og yfir 300 skýrt merki um að jafna sig."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sotto 50: molto basso. 50-100: basso. 100-150: normale. 150-200: elevato. Sopra 200: alto, e sopra 300 un chiaro segnale per recuperare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 未満：非常に低い。50-100：低い。100-150：正常。150-200：高め。200 超：高い。300 を超えたら回復を優先すべき明確なサインです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "50 미만: 매우 낮음. 50-100: 낮음. 100-150: 정상. 150-200: 다소 높음. 200 초과: 높음, 300을 넘으면 회복하라는 분명한 신호입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under 50: svært lav. 50-100: lav. 100-150: normal. 150-200: forhøyet. Over 200: høy, og over 300 et tydelig signal om å restituere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onder 50: zeer laag. 50-100: laag. 100-150: normaal. 150-200: verhoogd. Boven 200: hoog, en boven 300 een duidelijk signaal om te herstellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaixo de 50: muito baixo. 50-100: baixo. 100-150: normal. 150-200: elevado. Acima de 200: alto, e acima de 300 um sinal claro para se recuperar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ниже 50: очень низкий. 50-100: низкий. 100-150: нормальный. 150-200: повышенный. Выше 200: высокий, а выше 300 — явный сигнал к восстановлению."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Under 50: mycket låg. 50-100: låg. 100-150: normal. 150-200: förhöjd. Över 200: hög, och över 300 en tydlig signal att återhämta dig."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低于 50：很低。50-100：低。100-150：正常。150-200：偏高。高于 200：高，高于 300 则是需要恢复的明确信号。"
          }
        }
      }
    },
