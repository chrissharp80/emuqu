            "value" : "Þetta er %@%% yfir grunnlínu þinni—þú ert í frábæru formi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo è %@%% sopra la tua baseline: sei in gran forma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはベースラインより %@%% 高い — 絶好調です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이는 기준선보다 %@%% 높습니다 — 컨디션이 아주 좋습니다."
          }
