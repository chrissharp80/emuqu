{
 "file": "Emuqu/Sources/Models/SessionMetadata.swift",
 "hash": "0a976524a089163c",
 "role": "Core session data model: DeviceProvenance, SessionType, HRVDataQuality, HRVSession (40+ fields with hand-written Codable), OfflineSession, and the lightweight SessionArchiveEntry index record.",
 "types": [
  "DeviceProvenance: struct — source device/firmware/mode/app+OS version",
  "DeviceProvenance.RecordingMode: enum — device_internal|streaming|imported",
  "SessionType: enum — overnight|nap|quick|breathe|workout",
  "HRVDataQuality: enum — good|preSleep|insufficient, with allowsHRVAggregates(_:), the shared reliability rule",
  "HRVSession: struct — full session payload persisted by SessionArchive and synced via CloudKit",
  "HRVSession.DataSourceSummary: struct — chosen RR source + beat counts",
  "HRVSession.SleepSegmentMs: struct",
  "HRVSession.SessionState: enum — collecting|analyzing|complete|paused|failed",
  "HRVSession.ImportedMetrics: struct",
  "HRVSession.CodingKeys: enum",
  "OfflineSession: struct — pending-sync wrapper used by Reconciliation",
  "SessionArchiveEntry: struct — index row with mirrored metrics/sleep fields and the transient sourceSchemaVersion it was decoded with",
  "SessionArchiveEntry.CodingKeys: enum",
  "KeyedDecodingContainer: extension — decodeKnown / decodeKnownIfPresent / holdsUnknownCase, lenient String-backed enum decoding"
 ],
 "state": [
  "mem:HRVSession.currentSchemaVersion = 1",
  "mem:HRVSession.healthKitExportRetryCeiling = 5",
  "mem:SessionArchiveEntry.currentSchemaVersion = 1"
 ],
 "toplevel": "Static lets above; HRVSession and SessionArchiveEntry have custom init(from:)/encode(to:); DeviceProvenance, DataSourceSummary, SleepSegmentMs, ImportedMetrics, OfflineSession use synthesized Codable. HRVSession.sourceSchemaVersion and SessionArchiveEntry.sourceSchemaVersion are transient (decoded, never encoded). The KeyedDecodingContainer extension at the end gives both decoders (and SleepStageInterval's) lenient enum reads.",
 "flags": [],
 "units": [
