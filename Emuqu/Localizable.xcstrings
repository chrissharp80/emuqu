    "Override the device language for AI conversations and voice. Useful if your phone is set to another language but you prefer the AI in English." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجاوز لغة الجهاز لمحادثات الذكاء الاصطناعي والصوت. مفيد إذا كان هاتفك مضبوطًا على لغة أخرى لكنك تفضّل الذكاء الاصطناعي بالإنجليزية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilsidesæt enhedssproget for AI-samtaler og stemme. Nyttigt, hvis din telefon er indstillet til et andet sprog, men du foretrækker AI'en på engelsk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überschreibe die Gerätesprache für KI-Unterhaltungen und Sprachausgabe. Nützlich, wenn dein Telefon auf eine andere Sprache eingestellt ist, du die KI aber auf Englisch bevorzugst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sustituye el idioma del dispositivo para las conversaciones de IA y la voz. Útil si tu teléfono está configurado en otro idioma pero prefieres la IA en inglés."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohita laitteen kieli tekoälykeskusteluissa ja äänessä. Hyödyllistä, jos puhelimesi on asetettu toiselle kielelle, mutta haluat tekoälyn englanniksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplacez la langue de l'appareil pour les conversations IA et la voix. Utile si votre téléphone est réglé sur une autre langue mais que vous préférez l'IA en anglais."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hnekktu tungumáli tækisins fyrir gervigreindarsamtöl og rödd. Gagnlegt ef síminn þinn er stilltur á annað tungumál en þú vilt frekar hafa gervigreindina á ensku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisci la lingua del dispositivo per le conversazioni IA e la voce. Utile se il tuo telefono è impostato su un'altra lingua ma preferisci l'IA in inglese."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI の会話と音声でデバイスの言語を上書きします。スマートフォンが別の言語に設定されているが、AI は英語で使いたい場合に便利です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 대화 및 음성에 대해 기기 언어를 재정의합니다. 휴대폰이 다른 언어로 설정되어 있지만 AI는 영어로 사용하고 싶을 때 유용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overstyr enhetsspråket for KI-samtaler og stemme. Nyttig hvis telefonen er satt til et annet språk, men du foretrekker KI på engelsk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vervang de apparaattaal voor AI-gesprekken en spraak. Handig als je telefoon op een andere taal is ingesteld, maar je de AI liever in het Engels hebt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitua o idioma do dispositivo para conversas com IA e voz. Útil se o seu telefone estiver definido em outro idioma, mas você prefere a IA em inglês."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переопределите язык устройства для разговоров с ИИ и голоса. Полезно, если на телефоне установлен другой язык, но вы предпочитаете ИИ на английском."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åsidosätt enhetens språk för AI-konversationer och röst. Användbart om din telefon är inställd på ett annat språk men du föredrar AI:n på engelska."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为 AI 对话和语音覆盖设备语言。如果你的手机设置为其他语言，但你希望 AI 使用英语，此功能很有用。"
          }
        }
      }
    },
