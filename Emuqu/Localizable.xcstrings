    "Couldn't reach the strap — bring it close, make sure it's on, then try again." : {
      "comment" : "Message shown in the \"Merge full night from strap\" card when the strap is not reachable.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الوصول إلى الحزام — قرّبه، وتأكد من تشغيله، ثم أعد المحاولة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke nå pulsbæltet — hold det tæt på, sørg for at det er tændt, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Gurt war nicht erreichbar — bring ihn näher, stelle sicher, dass er an ist, und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con la banda — acércala, comprueba que esté encendida e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pantaan ei saatu yhteyttä — tuo se lähelle, varmista että se on päällä ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’atteindre la ceinture — rapprochez-la, vérifiez qu’elle est allumée, puis réessayez."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Náði ekki í ólina — hafðu hana nálægt, gakktu úr skugga um að hún sé kveikt og reyndu aftur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile raggiungere la fascia — avvicinala, assicurati che sia accesa e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストラップに接続できませんでした — 近づけて、電源が入っているか確認してから再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스트랩에 연결할 수 없습니다 — 가까이 두고 전원이 켜져 있는지 확인한 뒤 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke nå pulsbeltet — hold det nært, sjekk at det er på, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kon de band niet bereiken — houd hem dichtbij, controleer of hij aanstaat en probeer opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível alcançar a cinta — aproxime-a, confirme que está ligada e tente de novo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось связаться с датчиком — поднесите его ближе, убедитесь, что он включён, и повторите."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunde inte nå pulsbandet — håll det nära, se till att det är på och försök igen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接心率带 — 请靠近、确认已开机，然后重试。"
          }
        }
      }
    },
    "Couldn't recover — make sure the strap is connected, then try again." : {
      "comment" : "Message shown in the \"Recover workout from strap\" button when recovery fails.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر الاسترداد — تأكد من توصيل الحزام ثم حاول مرة أخرى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke gendanne — sørg for, at remmen er forbundet, og prøv igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiederherstellung fehlgeschlagen — stelle sicher, dass der Gurt verbunden ist, und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo recuperar: asegúrate de que la banda esté conectada e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palautus ei onnistunut — varmista, että panta on yhdistetty, ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de la récupération — vérifiez que la ceinture est connectée, puis réessayez."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tókst ekki að endurheimta — gakktu úr skugga um að ólin sé tengd og reyndu aftur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recupero non riuscito — assicurati che la fascia sia connessa, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
