          "stringUnit" : {
            "state" : "translated",
            "value" : "Форма снижается. Пора снова набирать форму?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konditionen sjunker sakta. Dags att bygga upp igen?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体能在逐渐下降。是时候重建了吗？"
          }
        }
      }
    },
