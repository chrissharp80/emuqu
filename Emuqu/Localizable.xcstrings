    "Verity Sense streams optical intervals live. Internal recording cannot run at the same time." : {
      "comment" : "Help text for the extended capture mode, explaining that Verity Sense cannot stream and record internally at the same time.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبثّ Verity Sense فترات بصرية مباشرة. لا يمكن تشغيل التسجيل الداخلي في الوقت نفسه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verity Sense streamer optiske intervaller live. Intern optagelse kan ikke køre samtidig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verity Sense streamt optische Intervalle live. Eine interne Aufzeichnung kann nicht gleichzeitig laufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
