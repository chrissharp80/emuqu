  {
   "key": "func JourneyIntelligenceService.inferShape(crowFly:pathLength:maxFromOrigin:direction:)",
   "hash": "0971097c0421482e",
   "does": "Classifies shape: unknown if path ≤50 m; outAndBackReturning if crow-fly < 75% of max distance and heading toward origin; loop if path/crow-fly > 2.5 (or crow-fly ≤1 m); pointToPoint if ratio <1.3 and crow-fly >200 m; else outAndBackOutbound.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+6",
     "cond": "pathLength > 50",
     "effect": "false: .unknown"
    },
    {
     "at": "+8",
     "cond": "maxFromOrigin > 0 AND crowFly < 0.75·max AND direction == .towardOrigin",
     "effect": "true: .outAndBackReturning"
    },
    {
     "at": "+14",
     "cond": "crowFly > 1",
     "effect": "true: ratio = path/crowFly; false: infinity (forces .loop)"
    },
    {
     "at": "+15",
     "cond": "ratio > 2.5",
     "effect": "true: .loop"
    },
    {
     "at": "+18",
     "cond": "ratio < 1.3 AND crowFly > 200",
     "effect": "true: .pointToPoint; false: .outAndBackOutbound"
    }
   ],
   "deps": {}
  }
