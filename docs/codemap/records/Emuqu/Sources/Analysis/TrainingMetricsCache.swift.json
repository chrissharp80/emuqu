    "ext:JSONEncoder.encode",
    "ext:Data.write(to:options:.atomic)"
   ],
   "reads": [
    "mem:TrainingMetricsCache.current",
    "mem:TrainingMetricsCache.dailySeries",
    "mem:TrainingMetricsCache.computedAt",
    "mem:TrainingMetricsCache.persistTask"
   ],
   "writes": [
    "file:TrainingMetricsCache.json",
    "mem:TrainingMetricsCache.persistTask"
   ],
   "branches": [
    {
     "at": "+1",
     "cond": "persistenceURL nil or computedAt nil",
     "effect": "true: return without writing; false: continue"
    },
    {
     "at": "+5",
     "cond": "lastWorkoutFingerprint nil",
     "effect": "fingerprint stored as '' (never equals a real digest, so next launch sees an observed change)"
    },
    {
     "at": "+12",
     "cond": "a previous write exists",
     "effect": "awaited before this one starts"
    },
    {
     "at": "+16",
     "cond": "encode or write throws",
     "effect": "error logged at .warning; nothing else (next cold launch rebuilds)"
    }
   ],
