   "key": "func JourneyIntelligenceService.inferDirection(trail:originFix:)",
   "hash": "6c28a579f32d6d5d",
   "does": "Compares the net displacement over the last 60 s with the vector to origin (longitude scaled by cos lat): dot>0 → towardOrigin, else awayFromOrigin; stationary when moved <5 m; unknown when <2 recent fixes.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Services/BreadcrumbStore.swift::var BreadcrumbFix.asCLLocation"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+5",
     "cond": "trail.fixes.last exists",
     "effect": "false: .unknown"
    },
    {
     "at": "+8",
     "cond": "recent window has a first fix and >=2 fixes",
     "effect": "false: .unknown"
    },
    {
     "at": "+11",
     "cond": "distance first→last recent >= 5 m",
     "effect": "false: .stationary"
    },
    {
     "at": "+21",
     "cond": "dot product > 0",
     "effect": "true: .towardOrigin; false (incl. exactly 0): .awayFromOrigin"
    }
   ],
   "deps": {
    "Emuqu/Sources/Services/BreadcrumbStore.swift::var BreadcrumbFix.asCLLocation": "96a4392555411a9b",
    "EmuquTests/WorkoutRecoveryResolversTests.swift::func WorkoutRecoveryResolversTests.fixes(count:everySec:)": "4e7344dc27d7bd85"
   }
