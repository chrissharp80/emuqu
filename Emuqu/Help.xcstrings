    "Keep your phone within Bluetooth range (~3-5 meters) during recording" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبقِ هاتفك ضمن نطاق البلوتوث (نحو 3-5 أمتار) أثناء التسجيل"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold telefonen inden for Bluetooth-rækkevidde (~3-5 meter) under optagelsen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte dein Telefon während der Aufnahme in Bluetooth-Reichweite (~3–5 Meter)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén el teléfono dentro del alcance del Bluetooth (~3-5 metros) durante la grabación"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä puhelimesi Bluetooth-kantaman sisällä (noin 3–5 metriä) tallennuksen aikana"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez votre téléphone à portée Bluetooth (~3-5 mètres) pendant l’enregistrement"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hafðu símann innan Bluetooth-drægni (~3-5 metrar) meðan á upptöku stendur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni il telefono nel raggio del Bluetooth (~3-5 metri) durante la registrazione"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録中は iPhone を Bluetooth の範囲内（約 3～5 m）に置いてください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록 중에는 휴대폰을 Bluetooth 범위(약 3-5미터) 안에 두세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold telefonen innenfor Bluetooth-rekkevidde (~3-5 meter) under opptaket"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd je telefoon tijdens de opname binnen Bluetooth-bereik (~3-5 meter)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o telefone dentro do alcance do Bluetooth (~3-5 metros) durante a gravação"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время записи держите телефон в радиусе действия Bluetooth (~3–5 метров)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll telefonen inom Bluetooth-räckvidd (~3–5 meter) under inspelningen"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录期间请将手机保持在蓝牙范围内（约 3-5 米）"
          }
        }
      }
    },
