        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa operazione rieseguirà gli algoritmi di analisi sui Suoi dati RR esistenti. I Suoi dati grezzi sono al sicuro e non verranno modificati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既存のRRデータに対して分析アルゴリズムを再実行します。生データは安全で変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기존 RR 데이터에 대해 분석 알고리즘을 다시 실행합니다. 원시 데이터는 안전하며 수정되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette kjører analysealgoritmene på nytt på eksisterende RR-data. Rådataene dine er trygge og vil ikke bli endret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee worden de analyse-algoritmen opnieuw uitgevoerd op uw bestaande RR-gegevens. Uw ruwe gegevens zijn veilig en worden niet gewijzigd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso executará novamente os algoritmos de análise nos seus dados RR existentes. Seus dados brutos estão seguros e não serão modificados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Алгоритмы анализа будут повторно применены к вашим данным RR. Исходные данные в безопасности и не будут изменены."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta kör om analysalgoritmerna på din befintliga RR-data. Din rådata är säker och kommer inte att ändras."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将对你现有的RR数据重新运行分析算法。你的原始数据安全且不会被修改。"
