   "key": "func OpenAICompatibleStreamer.consumeSSE(_:continuation:)",
   "hash": "750a1c509d376363",
   "does": "Reads SSE lines; on [DONE] flushes pending tool calls, yields .done and returns; other data chunks go to handleChunk (which throws on a mid-stream error chunk). A stream that ends without [DONE] while tool-call fragments are still open was cut mid call: the fragments may be incomplete, so they are not run, and URLError(.networkConnectionLost) is thrown (ProviderStream maps it to a fallbackable .network). A stream that ends without [DONE] and no open calls finishes normally.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Assistant/Providers/OpenAICompatibleStreamer.swift::func OpenAICompatibleStreamer.flushToolCalls(_:continuation:)",
    "Emuqu/Sources/Assistant/Providers/OpenAICompatibleStreamer.swift::func OpenAICompatibleStreamer.handleChunk(_:openToolCalls:continuation:)",
    "ext:URLSession.AsyncBytes.lines"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+5",
     "cond": "for each line",
     "effect": "loop; network errors propagate."
    },
    {
     "at": "+7",
     "cond": "line starts with data:",
     "effect": "processed; otherwise skipped."
    },
    {
     "at": "+9",
     "cond": "payload empty",
     "effect": "skipped."
    },
    {
     "at": "+10",
     "cond": "payload == \"[DONE]\"",
     "effect": "flush tool calls, yield .done, return."
    },
    {
     "at": "+17",
     "cond": "stream ended with tool-call fragments open",
     "effect": "throws URLError(.networkConnectionLost)"
    }
   ],
   "flags": [],
