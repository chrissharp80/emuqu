    "Your age, sex, weight and heart-rate settings, typed in or filled from Apple Health, personalise your scores and zones." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُخصّص عمرك وجنسك ووزنك وإعدادات معدل ضربات القلب، سواء أدخلتها بنفسك أو عُبّئت من Apple Health، درجاتك ونطاقاتك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din alder, dit køn, din vægt og dine pulsindstillinger, indtastet eller hentet fra Apple Health, tilpasser dine scorer og zoner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Alter, Geschlecht, Gewicht und deine Herzfrequenzeinstellungen, eingegeben oder aus Apple Health übernommen, personalisieren deine Werte und Zonen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu edad, sexo, peso y ajustes de frecuencia cardíaca, introducidos a mano o tomados de Apple Health, personalizan tus puntuaciones y zonas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikäsi, sukupuolesi, painosi ja sykeasetuksesi, jotka syötät itse tai jotka haetaan Apple Healthista, mukauttavat pisteesi ja alueesi sinulle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre âge, votre sexe, votre poids et vos réglages de fréquence cardiaque, saisis ou remplis depuis Apple Santé, personnalisent vos scores et vos zones."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aldur, kyn, þyngd og hjartsláttarstillingar, slegnar inn eða fylltar út úr Apple Health, sérsníða stigin þín og svæðin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Età, sesso, peso e impostazioni della frequenza cardiaca, inseriti da te o compilati da Apple Salute, personalizzano i tuoi punteggi e le tue zone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力した、または Apple ヘルスケアから取り込んだ年齢、性別、体重、心拍数の設定によって、スコアとゾーンがあなたに合わせて調整されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 입력하거나 Apple 건강에서 가져온 나이, 성별, 체중, 심박수 설정으로 점수와 구간이 사용자에게 맞춰집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alder, kjønn, vekt og pulsinnstillinger, skrevet inn eller hentet fra Apple Health, tilpasser scorene og sonene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je leeftijd, geslacht, gewicht en hartslaginstellingen, ingetypt of overgenomen uit Apple Health, stemmen je scores en zones op jou af."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua idade, sexo, peso e configurações de frequência cardíaca, digitados ou preenchidos a partir do Apple Saúde, personalizam suas pontuações e zonas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши возраст, пол, вес и настройки пульса, введённые вручную или взятые из Apple Здоровье, персонализируют ваши оценки и зоны."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din ålder, ditt kön, din vikt och dina pulsinställningar, inskrivna eller hämtade från Apple Hälsa, anpassar dina poäng och zoner."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的年龄、性别、体重和心率设置（手动输入或从 Apple 健康填入）会用于个性化你的评分和区间。"
          }
        }
      }
    },
    "Your API key (stored on-device in Keychain) authenticates the request." : {
