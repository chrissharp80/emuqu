  {
   "key": "func WorkoutLoadBackfill.runIfNeeded(archive:savedRouteStore:lookbackDays:)",
   "hash": "fcb4d7fb0c69e056",
   "does": "Launch gate: fingerprints the saved routes (routeFingerprint) and returns without scanning when ranRecently says the last scan was < 7 days ago against the same route IDs; otherwise awaits run() and, only when the scan completed (no workout or prior unreadable, and no estimate unwritten, for a reason that may clear), stamps the lastRun date and the route-ID fingerprint in UserDefaults; an incomplete scan is logged and left unstamped so the next launch scans again.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Analysis/WorkoutLoadBackfill.swift::func WorkoutLoadBackfill.routeFingerprint(_:)",
    "Emuqu/Sources/Analysis/WorkoutLoadBackfill.swift::func WorkoutLoadBackfill.ranRecently(defaults:routeIds:)",
    "Emuqu/Sources/Analysis/WorkoutLoadBackfill.swift::func WorkoutLoadBackfill.run(archive:savedRouteStore:lookbackDays:)",
    "Emuqu/Sources/Utilities/DebugLog.swift::func debugLog(_:level:file:line:)"
   ],
   "reads": [
    "mem:SavedRouteStore.routes"
   ],
   "writes": [
    "ud:FlowRecovery.workoutLoadBackfill.lastRun",
    "ud:FlowRecovery.workoutLoadBackfill.routeIdsAtLastRun"
   ],
   "branches": [
    {
     "at": "+7",
     "cond": "ranRecently (scanned < 7 days ago with the same route IDs)",
     "effect": "return without scanning; else run"
    },
    {
     "at": "+10",
     "cond": "the scan was incomplete",
     "effect": "logged as a warning, not stamped; else defaults stamped"
    }
   ],
