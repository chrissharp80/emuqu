{
 "file": "Emuqu/Sources/Models/SessionMetadata.swift",
 "hash": "8636ba25519a9642",
 "role": "Core session data model: DeviceProvenance, SessionType, HRVDataQuality and HRVSession (40+ fields with hand-written Codable), the session's moving time (activeWorkoutSeconds), and the lenient enum-decoding helpers; the index record SessionArchiveEntry is in SessionMetadata+ArchiveEntry.swift.",
 "types": [
  "DeviceProvenance: struct — source device/firmware/mode/app+OS version",
  "DeviceProvenance.RecordingMode: enum — device_internal|streaming|imported; an unknown case decodes as .streaming",
  "SessionType: enum — overnight|nap|quick|breathe|workout",
  "HRVDataQuality: enum (CaseIterable) — good|preSleep|insufficient, with allowsHRVAggregates(_:), the shared reliability rule",
  "HRVSession: struct — full session payload persisted by SessionArchive and synced via CloudKit",
  "HRVSession.DataSourceSummary: struct — chosen RR source + beat counts",
  "HRVSession.SleepSegmentMs: struct",
  "HRVSession.SessionState: enum — collecting|analyzing|complete|paused|failed",
  "HRVSession.ImportedMetrics: struct",
  "HRVSession.CodingKeys: enum; HRVSession.NestedCaseKey: private enum — recordingMode/boundarySource/factors/impact keys the schema check reads inside nested values",
  "HRVSession: extension — activeWorkoutSeconds (moving time)",
  "KeyedDecodingContainer: extension — decodeKnown / decodeKnownIfPresent / holdsUnknownCase, lenient String-backed enum decoding"
 ],
 "state": [
  "mem:HRVSession.currentSchemaVersion = 1",
  "mem:HRVSession.healthKitExportRetryCeiling = 5",
  "mem:HRVSession.ImportedMetrics.eliteHRVSource = \"Elite HRV\""
 ],
 "toplevel": "Static lets above; HRVSession has a custom init(from:)/encode(to:); DeviceProvenance, DataSourceSummary, SleepSegmentMs and ImportedMetrics use synthesized Codable. HRVSession.sourceSchemaVersion is transient (decoded, never encoded). The KeyedDecodingContainer extension at the end gives HRVSession's, SessionArchiveEntry's and SleepStageInterval's decoders lenient enum reads.",
