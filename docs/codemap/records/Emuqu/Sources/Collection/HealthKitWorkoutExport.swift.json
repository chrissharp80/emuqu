   "key": "func HealthKitWorkoutExport.distanceSamples(from:sport:startDate:)",
   "hash": "ab3354a4ccb72a95",
   "does": "Builds delta-distance samples for sports with a Health distance type: ticks sorted by offset, each increase over the last cumulative distance becomes a sample spanning from where the previous written delta ended (the workout start for the first) to this tick, so a delta that built up over non-advancing ticks covers all of them.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Collection/HealthKitWorkoutExport.swift::func HealthKitWorkoutExport.distanceType(for:)",
    "Emuqu/Sources/Collection/HealthKitWorkoutExport.swift::func HealthKitWorkoutExport.inTimeOrder(_:)",
    "Emuqu/Sources/Collection/HealthSampleFactory.swift::func HealthSampleFactory.quantitySample(type:value:unit:start:end:metadata:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+5",
     "cond": "sport has no distance type or HK type unavailable",
     "effect": "returns []"
    },
    {
     "at": "+10",
     "cond": "loop over time-ordered ticks",
     "effect": "per-tick processing"
    },
    {
     "at": "+11",
     "cond": "tick has no distanceMeters or distance not greater than the last emitted cumulative distance",
     "effect": "tick skipped (no sample; span start unchanged)"
    },
    {
     "at": "+13",
     "cond": "delta not finite or <= 0",
     "effect": "tick skipped; otherwise lastDistance updated and the span start moves to this tick"
    },
    {
     "at": "+21",
     "cond": "factory returned a sample",
     "effect": "appended; nil (invalid interval/value) dropped"
    }
   ],
   "flags": [],
