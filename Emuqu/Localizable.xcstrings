          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvíldarpúlsinn þinn lækkar, sem er jákvætt merki um aðlögun hjarta og æða."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua frequenza cardiaca a riposo sta diminuendo, un segnale positivo di adattamento cardiovascolare."
