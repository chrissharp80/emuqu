            "value" : "회복 결과가 나왔습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restitusjonen din er klar."
          }
        },
        "nl" : {
          "stringUnit" : {
