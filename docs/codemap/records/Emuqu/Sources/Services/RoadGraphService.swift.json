   "key": "func RoadGraphService.tile(for:)",
   "hash": "4c3aed9b43418e0f",
   "does": "Returns the road-graph tile for the 250 m cell containing a coordinate: a cached tile within TTL (6 h, or 10 min if empty); else joins an in-flight fetch for the cell; else, inside 1.1 s of the last request, returns whatever is cached (possibly expired or nil); else fetches, coalescing via inflight.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Services/RoadGraphService.swift::func RoadGraphService.cellKey(latitude:longitude:)",
    "Emuqu/Sources/Services/RoadGraphService.swift::func RoadGraphService.fetchTile(cellKey:centerLat:centerLon:cellLatIndex:cellLonIndex:)"
   ],
   "reads": [
    "mem:RoadGraphService.cache",
    "mem:RoadGraphService.inflight",
    "mem:RoadGraphService.lastRequestAt"
   ],
   "writes": [
    "mem:RoadGraphService.inflight",
    "net:Overpass"
   ],
   "branches": [
    {
     "at": "+2",
     "cond": "cached tile exists",
     "effect": "check age; else continue"
    },
    {
     "at": "+3",
     "cond": "tile younger than TTL (empty→10 min, else 6 h)",
     "effect": "return cached; else continue to refetch"
    },
    {
     "at": "+6",
     "cond": "fetch for this cell already in flight",
     "effect": "await and return its result"
    },
    {
