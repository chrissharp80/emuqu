  {
   "key": "func TrainingHealthQueries.collapseDuplicates(from:in:consumed:)",
   "hash": "4f073eae1483f296",
   "does": "From index i (the cluster's anchor), absorbs later unconsumed summaries starting within 30 min of the anchor that isSameSession with it (same type within 5 min with intersecting spans, or overlap >= 60 % of the shorter); keeps whichever absorbed copy has the higher data score. Every test is against the anchor, so membership does not depend on which copy currently scores best.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Collection/TrainingHealthQueries+Queries.swift::func TrainingHealthQueries.isSameSession(_:_:startGap:)",
    "Emuqu/Sources/Collection/TrainingHealthQueries+Queries.swift::func TrainingHealthQueries.workoutDataScore(_:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+3",
     "cond": "for each later unconsumed j",
     "effect": "test"
    },
    {
     "at": "+6",
     "cond": "gap from the anchor > 1800 s",
     "effect": "break"
    },
    {
     "at": "+7",
     "cond": "not isSameSession(anchor, other)",
     "effect": "continue (keep separate)"
    },
    {
     "at": "+9",
     "cond": "other's score > best's",
     "effect": "other becomes best"
    }
   ],
   "deps": {
    "Emuqu/Sources/Collection/TrainingHealthQueries+Queries.swift::func TrainingHealthQueries.isSameSession(_:_:startGap:)": "7fba87f92bf9c802",
    "Emuqu/Sources/Collection/TrainingHealthQueries+Queries.swift::func TrainingHealthQueries.workoutDataScore(_:)": "bb070e4a3e677749"
   }
  },
