    "Low (<100): Relaxed. Moderate (100-200): Normal. Elevated (200-300): Stressed. High (>300): Significant strain." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منخفض (<100): مسترخٍ. متوسط (100-200): طبيعي. مرتفع (200-300): متوتر. عالٍ (>300): إجهاد كبير."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lav (<100): Afslappet. Moderat (100-200): Normal. Forhøjet (200-300): Stresset. Høj (>300): Betydelig belastning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niedrig (<100): entspannt. Moderat (100-200): normal. Erhöht (200-300): gestresst. Hoch (>300): erhebliche Beanspruchung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bajo (<100): relajado. Moderado (100-200): normal. Elevado (200-300): estresado. Alto (>300): tensión importante."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matala (<100): rentoutunut. Kohtalainen (100-200): normaali. Koholla (200-300): stressaantunut. Korkea (>300): merkittävä rasitus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faible (<100) : détendu. Modéré (100-200) : normal. Élevé (200-300) : stressé. Très élevé (>300) : contrainte importante."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lágt (<100): afslappað. Miðlungs (100-200): eðlilegt. Hækkað (200-300): streita. Hátt (>300): umtalsvert álag."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basso (<100): rilassato. Moderato (100-200): normale. Elevato (200-300): stressato. Alto (>300): tensione significativa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低 (<100): リラックス。中 (100-200): 正常。高め (200-300): ストレス。高 (>300): 相当な負担。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "낮음 (<100): 이완. 보통 (100-200): 정상. 상승 (200-300): 스트레스. 높음 (>300): 상당한 부담."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lav (<100): Avslappet. Moderat (100-200): Normal. Forhøyet (200-300): Stresset. Høy (>300): Betydelig belastning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laag (<100): ontspannen. Matig (100-200): normaal. Verhoogd (200-300): gestrest. Hoog (>300): aanzienlijke belasting."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixo (<100): relaxado. Moderado (100-200): normal. Elevado (200-300): estressado. Alto (>300): tensão significativa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Низко (<100): расслабленно. Умеренно (100-200): норма. Повышено (200-300): стресс. Высоко (>300): значительное напряжение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Låg (<100): Avslappnad. Måttlig (100-200): Normal. Förhöjd (200-300): Stressad. Hög (>300): Betydande påfrestning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "低 (<100)：放松。中 (100-200)：正常。偏高 (200-300)：有压力。高 (>300)：负荷强度明显。"
          }
        }
      }
    },
