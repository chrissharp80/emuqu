    "At or above the 12 bpm convention for 1-minute recovery. Your own trend across sessions says more than one reading." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند عتبة 12 نبضة/دقيقة المتعارف عليها لاسترداد الدقيقة الواحدة أو أعلى منها. اتجاهك عبر الجلسات يقول أكثر من قراءة واحدة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På eller over 12 bpm-konventionen for restitution efter 1 minut. Din egen tendens på tværs af sessioner siger mere end én måling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf oder über der 12-bpm-Konvention für die 1-Minuten-Erholung. Dein eigener Verlauf über mehrere Einheiten sagt mehr als ein Einzelwert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En o por encima de la convención de 12 lpm para la recuperación en 1 minuto. Tu propia tendencia entre sesiones dice más que una sola lectura."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 minuutin palautumisen 12 bpm:n käytännön rajalla tai sen yli. Oma kehityksesi harjoitusten välillä kertoo enemmän kuin yksi lukema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au niveau ou au-dessus de la convention de 12 bpm pour la récupération à 1 minute. Votre propre tendance d’une séance à l’autre en dit plus qu’une seule mesure."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Við eða yfir 12 slaga viðmiðinu fyrir endurheimt á 1 mínútu. Þín eigin þróun milli æfinga segir meira en ein mæling."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pari o superiore alla convenzione dei 12 bpm per il recupero a 1 minuto. Il tuo andamento tra le sessioni dice più di una singola lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 分間回復の 12 bpm 慣例的基準以上です。1 回の値より、セッション間でのご自身の傾向のほうが多くを語ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1분 회복의 12bpm 관례 기준 이상입니다. 한 번의 측정값보다 여러 세션에 걸친 자신의 추세가 더 많은 것을 말해 줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "På eller over 12 bpm-konvensjonen for restitusjon etter 1 minutt. Din egen trend på tvers av økter sier mer enn én måling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op of boven de 12 bpm-conventie voor herstel na 1 minuut. Je eigen trend over sessies zegt meer dan één meting."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na convenção de 12 bpm para recuperação em 1 minuto ou acima. Sua própria tendência entre sessões diz mais do que uma leitura."
          }
        },
        "ru" : {
