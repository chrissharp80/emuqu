    {
     "at": "+2",
     "cond": "percent < 5",
     "effect": "Excellent, sage seal"
    },
    {
     "at": "+3",
     "cond": "5 ≤ percent < 10",
     "effect": "Good, sage seal outline"
    },
    {
     "at": "+4",
     "cond": "10 ≤ percent < 20",
     "effect": "Fair, gold triangle"
    },
    {
     "at": "+5",
     "cond": "default (≥20, or NaN)",
