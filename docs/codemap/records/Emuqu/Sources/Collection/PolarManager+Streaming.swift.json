   ],
   "branches": [
    {
     "at": "+2",
     "cond": "last reading exists and hr > 0",
     "effect": "currentHeartRate = its hr; else unchanged (only the LAST reading is checked)"
    },
    {
     "at": "+5",
     "cond": "isStreaming false",
     "effect": "return, no buffering"
