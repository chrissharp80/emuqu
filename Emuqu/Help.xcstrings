    "Highest rate in the full recording. Overnight spikes may indicate disrupted sleep, movement, or stress dreams." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعلى معدل في التسجيل الكامل. قد تشير القفزات الليلية إلى نوم متقطع أو حركة أو أحلام مُجهِدة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højeste værdi i hele optagelsen. Spidser om natten kan tyde på forstyrret søvn, bevægelse eller stressende drømme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höchste Frequenz der gesamten Aufnahme. Spitzen in der Nacht können auf gestörten Schlaf, Bewegung oder Stressträume hindeuten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frecuencia más alta de toda la grabación. Los picos nocturnos pueden indicar sueño alterado, movimiento o sueños estresantes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koko tallennuksen korkein syke. Yön aikaiset piikit voivat viitata katkonaiseen uneen, liikkeeseen tai stressaaviin uniin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fréquence la plus élevée sur l’ensemble de l’enregistrement. Des pics nocturnes peuvent indiquer un sommeil perturbé, des mouvements ou des rêves stressants."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hæsta gildi í allri upptökunni. Toppar yfir nóttina geta bent til truflaðs svefns, hreyfingar eða streitudrauma."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequenza più alta dell'intera registrazione. I picchi notturni possono indicare sonno disturbato, movimento o sogni agitati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録全体での最高値です。夜間の急上昇は、睡眠の乱れ、体動、ストレスのある夢を示している可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전체 기록에서 가장 높은 심박수. 야간의 급등은 수면 방해, 움직임, 스트레스성 꿈을 나타낼 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyeste puls i hele opptaket. Topper om natten kan tyde på forstyrret søvn, bevegelse eller urolige drømmer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoogste waarde in de volledige opname. Pieken ’s nachts kunnen wijzen op onrustige slaap, beweging of stressvolle dromen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A maior frequência em toda a gravação. Picos noturnos podem indicar sono interrompido, movimento ou sonhos estressantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Самый высокий пульс за всю запись. Ночные всплески могут указывать на нарушенный сон, движение или тревожные сны."
          }
        },
        "sv" : {
