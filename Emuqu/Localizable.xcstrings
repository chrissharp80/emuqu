    "Mathematically related to both RMSSD and SDNN; mostly useful as a sanity check on the Poincaré ellipse shape (SD2/SD1 ratio)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرتبط رياضيًا بكل من RMSSD وSDNN؛ ومفيد أساسًا للتحقق من شكل قطع بوانكاريه الناقص (نسبة SD2/SD1)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matematisk relateret til både RMSSD og SDNN; primært nyttig som kontrol af Poincaré-ellipsens form (SD2/SD1-forholdet)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mathematisch mit RMSSD und SDNN verwandt; vor allem nützlich als Plausibilitätsprüfung der Poincaré-Ellipsenform (Verhältnis SD2/SD1)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relacionado matemáticamente con RMSSD y SDNN; útil sobre todo como comprobación de la forma de la elipse de Poincaré (razón SD2/SD1)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matemaattisesti yhteydessä sekä RMSSD:hen että SDNN:ään; hyödyllinen lähinnä Poincarén ellipsin muodon tarkistuksena (SD2/SD1-suhde)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mathématiquement lié au RMSSD et au SDNN ; surtout utile pour vérifier la forme de l’ellipse de Poincaré (rapport SD2/SD1)."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stærðfræðilega tengt bæði RMSSD og SDNN; einkum gagnlegt til að sannreyna lögun Poincaré-sporbaugsins (SD2/SD1 hlutfall)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matematicamente legato sia a RMSSD sia a SDNN; utile soprattutto come verifica della forma dell’ellisse di Poincaré (rapporto SD2/SD1)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RMSSD と SDNN の双方と数学的に関連します。主にポアンカレ楕円の形（SD2/SD1 比）の妥当性確認に役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RMSSD 및 SDNN과 수학적으로 연관됩니다. 주로 푸앵카레 타원 형태(SD2/SD1 비)를 점검하는 데 유용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
