    "--" : {
      "shouldTranslate" : false
    },
    "0-5%: Low parasympathetic activity. 5-15%: Moderate — typical resting range. 15-25%+: Strong recovery tone. Tracks closely with RMSSD but is easier to intuit: \"15% of my heartbeats show strong recovery activity.\"" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0-5%: نشاط نظير ودي منخفض. 5-15%: متوسط — النطاق المعتاد أثناء الراحة. 15-25%+: نبرة تعافٍ قوية. يتتبع RMSSD عن كثب لكنه أسهل في الفهم: \"15% من نبضات قلبي تُظهر نشاط تعافٍ قويًا.\""
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0-5%: Lav parasympatisk aktivitet. 5-15%: Moderat — typisk hvileområde. 15-25%+: Stærk restitutionstonus. Følger RMSSD tæt, men er lettere at forstå intuitivt: \"15% af mine hjerteslag viser stærk restitutionsaktivitet.\""
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0-5%: Geringe parasympathische Aktivität. 5-15%: Mäßig — typischer Ruhebereich. 15-25%+: Starker Erholungstonus. Verläuft eng mit RMSSD, ist aber intuitiver: „15% meiner Herzschläge zeigen starke Erholungsaktivität.\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0-5%: actividad parasimpática baja. 5-15%: moderada — rango de reposo típico. 15-25%+: tono de recuperación fuerte. Sigue de cerca al RMSSD, pero es más intuitivo: «el 15% de mis latidos muestra una fuerte actividad de recuperación»."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0-5%: matala parasympaattinen aktiivisuus. 5-15%: kohtalainen — tyypillinen vaihteluväli levossa. 15-25%+: vahva palautumistonus. Seuraa tiiviisti RMSSD:tä, mutta on helpompi hahmottaa: \"15% sydämenlyönneistäni näyttää vahvaa palautumisaktiivisuutta.\""
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0-5% : activité parasympathique faible. 5-15% : modérée — plage de repos typique. 15-25%+ : tonus de récupération fort. Suit de près le RMSSD mais est plus intuitif : « 15% de mes battements montrent une forte activité de récupération. »"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0-5%: lítil sefkerfisvirkni. 5-15%: miðlungs — dæmigert bil í hvíld. 15-25%+: sterk endurheimtarspenna. Fylgir RMSSD náið en er auðskiljanlegra: \"15% hjartslaga minna sýna sterka endurheimtarvirkni.\""
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0-5%: attività parasimpatica bassa. 5-15%: moderata — intervallo di riposo tipico. 15-25%+: tono di recupero forte. Segue da vicino l'RMSSD ma è più intuitivo: \"il 15% dei miei battiti mostra una forte attività di recupero.\""
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0-5%: 副交感神経活動が低い。5-15%: 中程度 — 一般的な安静時の範囲。15-25%+: 強い回復傾向。RMSSD と密接に連動しますが、より直感的に理解できます：「心拍の 15% が強い回復活動を示している」。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0-5%: 부교감 활동이 낮음. 5-15%: 보통 — 일반적인 안정 시 범위. 15-25%+: 강한 회복 톤. RMSSD와 밀접하게 연동되지만 더 직관적으로 이해할 수 있습니다: \"내 심장 박동의 15%가 강한 회복 활동을 보인다.\""
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0-5%: Lav parasympatisk aktivitet. 5-15%: Moderat — typisk hvileområde. 15-25%+: Sterk restitusjonstonus. Følger RMSSD tett, men er lettere å forstå intuitivt: \"15% av hjerteslagene mine viser sterk restitusjonsaktivitet.\""
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0-5%: Lage parasympathische activiteit. 5-15%: Gemiddeld — normaal bereik in rust. 15-25%+: Sterke hersteltonus. Loopt nauw gelijk met RMSSD, maar is intuïtiever: \"15% van mijn hartslagen laat sterke herstelactiviteit zien.\""
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0-5%: atividade parassimpática baixa. 5-15%: moderada — faixa típica em repouso. 15-25%+: tônus de recuperação forte. Acompanha de perto o RMSSD, mas é mais intuitivo: \"15% dos meus batimentos mostram atividade de recuperação forte.\""
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0-5%: низкая парасимпатическая активность. 5-15%: умеренная — типичный диапазон в покое. 15-25%+: выраженный восстановительный тонус. Тесно связан с RMSSD, но понятнее интуитивно: «15% моих ударов сердца показывают сильную восстановительную активность»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0-5%: Låg parasympatisk aktivitet. 5-15%: Måttlig — typiskt viloområde. 15-25%+: Stark återhämtningstonus. Följer RMSSD nära men är lättare att förstå intuitivt: \"15% av mina hjärtslag visar stark återhämtningsaktivitet.\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "0-5%：副交感活动低。5-15%：中等 — 典型的静息范围。15-25%+：恢复张力强。与 RMSSD 高度相关，但更容易直观理解：“我有 15% 的心跳显示出强烈的恢复活动。”"
          }
        }
      }
    },
