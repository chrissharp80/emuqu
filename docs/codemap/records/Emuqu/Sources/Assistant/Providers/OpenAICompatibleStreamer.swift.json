  {
   "key": "func OpenAICompatibleStreamer.consumeSSE(_:providerID:continuation:)",
   "hash": "e585ea2948058e28",
   "does": "Reads a reply's SSE line sequence (the URL session's lines, or a test's) as server-sent events (SSEEvents: only non-empty data: payloads, task cancellation checked per line). [DONE] ends the reply through finishReply (flush open tool calls, .done) and returns; every other payload goes to handleChunk, which records a finish_reason and throws on a malformed event, an error object, a filtered or overloaded stop, or cut tool arguments. When the sequence ends, a cancelled task throws CancellationError, so Stop reads as cancellation. A stream that closes after a finish_reason but without [DONE] also ends through finishReply; one that closes with neither was cut and throws URLError(.networkConnectionLost) (ProviderStream maps it to a fallbackable .network), so open tool-call fragments never run and the partial text never reads as complete.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Assistant/Providers/ProviderStream.swift::init SSEEvents(_:)",
    "Emuqu/Sources/Assistant/Providers/ProviderStream.swift::func SSEEvents.Iterator.next()",
    "Emuqu/Sources/Assistant/Providers/OpenAICompatibleStreamer.swift::func OpenAICompatibleStreamer.finishReply(_:continuation:)",
    "Emuqu/Sources/Assistant/Providers/OpenAICompatibleStreamer.swift::func OpenAICompatibleStreamer.handleChunk(_:providerID:state:continuation:)",
    "ext:Task.checkCancellation"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+6",
     "cond": "for each event",
     "effect": "loop; sequence errors propagate."
    },
    {
     "at": "+7",
     "cond": "payload == \"[DONE]\"",
     "effect": "finishReply, return."
    },
    {
     "at": "+13",
     "cond": "task cancelled when the sequence ended",
     "effect": "throws CancellationError"
    },
    {
     "at": "+14",
     "cond": "stream closed with no finish_reason and no [DONE]",
     "effect": "throws URLError(.networkConnectionLost); otherwise finishReply."
    }
   ],
   "deps": {
