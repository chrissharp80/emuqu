   "key": "func HealthWriteAndObserve.exportSleepToHealthKit(sleepData:sessionId:)",
   "hash": "539af6c249771b63",
   "does": "Exports a night to Apple Health: requires sleep boundaries and some sleep, builds an inBed sample plus one sample per stage interval (asleepUnspecified/awake) tagged with ExternalUUID, and — when any sample is valid — saves them before removing this session's previous sleep export (replacePreviousSleepExport). A night with nothing valid to write leaves the previous export untouched.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Collection/HKTypes.swift::func HKTypes.category(_:caller:file:line:)",
    "Emuqu/Sources/Collection/HealthKitManager+SleepTrends.swift::func HealthWriteAndObserve.sleepExportSamples(sleepData:sleepType:sessionId:inBedStart:sleepEnd:)",
    "Emuqu/Sources/Collection/HealthKitManager+SleepTrends.swift::func HealthWriteAndObserve.replacePreviousSleepExport(with:sessionId:sleepType:)",
    "Emuqu/Sources/Utilities/DebugLog.swift::func debugLog(_:level:file:line:)",
    "Emuqu/Sources/Collection/HealthKitManager.swift::var HealthKitManager.isHealthKitAvailable"
   ],
   "reads": [
    "hk:sleepAnalysis"
   ],
   "writes": [
    "hk:sleepAnalysis"
   ],
   "branches": [
    {
     "at": "+1",
     "cond": "HealthKit unavailable",
     "effect": "throws notAvailable"
    },
    {
     "at": "+2",
     "cond": "sleepStart or sleepEnd nil",
     "effect": "logs 'No sleep boundaries' and returns without writing"
    },
    {
     "at": "+6",
     "cond": "no stage intervals AND 0 night-sleep minutes",
     "effect": "logs 'empty' and returns"
    },
    {
     "at": "+10",
     "cond": "sleepAnalysis type nil",
     "effect": "throws typeUnavailable"
    },
    {
     "at": "+15",
     "cond": "inBedStart nil",
     "effect": "?? sleepStart — inBed sample starts at sleepStart"
    },
    {
     "at": "+17",
     "cond": "no samples built (all intervals invalid)",
     "effect": "returns; the previous export stays in Health"
    }
   ],
   "deps": {
    "Emuqu/Sources/Analysis/SleepResolver.swift::func SleepResolver.inBedStart(ctx:sleepStages:)": "462c31feab84c606",
