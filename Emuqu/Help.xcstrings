            "value" : "Í appinu skaltu fara í Taka upp og ýta á Leita að tækjum — það ætti að birtast innan nokkurra sekúndna"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nell'app, vai su Registra e tocca Cerca dispositivi: dovrebbe comparire in pochi secondi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
