    "Listen to the second half of the workout, not the first." : {
      "comment" : "Suggestion to focus on the second half of a workout rather than the first.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع إلى النصف الثاني من التمرين، لا الأول."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyt til anden halvdel af træningen, ikke den første."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achte auf die zweite Hälfte des Trainings, nicht die erste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fíjate en la segunda mitad del entrenamiento, no en la primera."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuuntele harjoituksen toista puoliskoa, älä ensimmäistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écoutez la seconde moitié de la séance, pas la première."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlustaðu á seinni hluta æfingarinnar, ekki þann fyrri."
