    "Mildly elevated — alert but not strained. Could be caffeine, light activity, or mild stress." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرتفع قليلًا — متيقظ لكن غير مُجهَد. قد يكون السبب الكافيين أو نشاطًا خفيفًا أو توترًا بسيطًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let forhøjet — vågen, men ikke presset. Kan være koffein, let aktivitet eller mild stress."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leicht erhöht — wach, aber nicht belastet. Kann an Koffein, leichter Aktivität oder leichtem Stress liegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligeramente elevado: alerta pero sin tensión. Puede ser cafeína, actividad ligera o estrés leve."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lievästi koholla — valpas muttei rasittunut. Voi johtua kofeiinista, kevyestä aktiivisuudesta tai lievästä stressistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Légèrement élevé — vigilant mais pas sous tension. Peut être dû à la caféine, à une activité légère ou à un stress modéré."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lítillega hækkað — vakandi en ekki undir álagi. Gæti verið koffín, létt hreyfing eða væg streita."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leggermente elevato — vigile ma non sotto sforzo. Può dipendere da caffeina, attività leggera o stress lieve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やや高め — 覚醒しているが負担はかかっていない状態。カフェイン、軽い活動、軽いストレスの可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "약간 높음 — 각성 상태이지만 긴장된 것은 아닙니다. 카페인, 가벼운 활동, 가벼운 스트레스일 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Litt forhøyet — våken, men ikke anstrengt. Kan være koffein, lett aktivitet eller mildt stress."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licht verhoogd — alert maar niet overbelast. Kan cafeïne, lichte activiteit of milde stress zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levemente elevado — alerta, mas sem sobrecarga. Pode ser cafeína, atividade leve ou estresse leve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слегка повышено — бодрость без перенапряжения. Может быть кофеин, лёгкая активность или небольшой стресс."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lätt förhöjd — alert men inte ansträngd. Kan vara koffein, lätt aktivitet eller mild stress."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻度升高 — 清醒但不紧绷。可能是咖啡因、轻度活动或轻微压力所致。"
          }
        }
      }
    },
    "Min HR" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدنى معدل نبض"
          }
        },
        "da" : {
