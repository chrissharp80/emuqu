     "effect": "terracotta"
    },
    {
     "at": "+4",
     "cond": "case .moderateHigh",
     "effect": "softGold"
    },
    {
     "at": "+5",
     "cond": "case .moderate",
     "effect": "mist"
    },
    {
     "at": "+6",
     "cond": "case .pattern/.contributingFactor/.goodSign/.excellent",
     "effect": "sage"
    },
    {
