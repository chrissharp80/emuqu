        }
      }
    },
    "Your Tavily key is stored in the iOS Keychain on this device, never synced to iCloud. Search queries are sent to Tavily — see their privacy policy." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُخزَّن مفتاح Tavily الخاص بك في سلسلة مفاتيح iOS على هذا الجهاز، ولا يُزامَن أبدًا مع iCloud. تُرسَل استعلامات البحث إلى Tavily — راجع سياسة الخصوصية الخاصة بهم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Tavily-nøgle gemmes i iOS-nøgleringen på denne enhed og synkroniseres aldrig til iCloud. Søgeforespørgsler sendes til Tavily — se deres privatlivspolitik."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Tavily-Schlüssel wird im iOS-Schlüsselbund auf diesem Gerät gespeichert und nie mit iCloud synchronisiert. Suchanfragen werden an Tavily gesendet — siehe deren Datenschutzrichtlinie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave de Tavily se almacena en el Llavero de iOS de este dispositivo y nunca se sincroniza con iCloud. Las consultas de búsqueda se envían a Tavily; consulta su política de privacidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavily-avaimesi tallennetaan iOS:n avainnippuun tällä laitteella, eikä sitä koskaan synkronoida iCloudiin. Hakukyselyt lähetetään Tavilylle — katso heidän tietosuojakäytäntönsä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre clé Tavily est stockée dans le trousseau iOS de cet appareil et n'est jamais synchronisée avec iCloud. Les requêtes de recherche sont envoyées à Tavily — consultez leur politique de confidentialité."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavily-lykillinn þinn er geymdur í iOS-lyklakippunni á þessu tæki og er aldrei samstilltur við iCloud. Leitarfyrirspurnir eru sendar til Tavily — sjá persónuverndarstefnu þeirra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua chiave Tavily è memorizzata nel Portachiavi iOS su questo dispositivo e non viene mai sincronizzata con iCloud. Le query di ricerca vengono inviate a Tavily — consulta la loro informativa sulla privacy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavily キーはこのデバイスの iOS キーチェーンに保存され、iCloud に同期されることはありません。検索クエリは Tavily に送信されます — 同社のプライバシーポリシーをご覧ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavily 키는 이 기기의 iOS 키체인에 저장되며 iCloud에 동기화되지 않습니다. 검색 쿼리는 Tavily로 전송됩니다 — Tavily의 개인정보 처리방침을 참고하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavily-nøkkelen din lagres i iOS-nøkkelringen på denne enheten og synkroniseres aldri til iCloud. Søk sendes til Tavily — se personvernreglene deres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je Tavily-sleutel wordt op dit apparaat in de iOS-sleutelhanger opgeslagen en nooit met iCloud gesynchroniseerd. Zoekopdrachten worden naar Tavily verzonden — zie hun privacybeleid."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua chave do Tavily é armazenada no Chaveiro do iOS neste dispositivo e nunca é sincronizada com o iCloud. As consultas de busca são enviadas ao Tavily — consulte a política de privacidade deles."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш ключ Tavily хранится в Связке ключей iOS на этом устройстве и никогда не синхронизируется с iCloud. Поисковые запросы отправляются в Tavily — см. их политику конфиденциальности."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din Tavily-nyckel lagras i iOS-nyckelringen på den här enheten och synkroniseras aldrig till iCloud. Sökfrågor skickas till Tavily — se deras integritetspolicy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 Tavily 密钥存储在本设备的 iOS 钥匙串中，绝不会同步到 iCloud。搜索查询会发送给 Tavily——请查阅其隐私政策。"
          }
        }
      }
    },
    "Your timeline change couldn't be stored. Please try again." : {
