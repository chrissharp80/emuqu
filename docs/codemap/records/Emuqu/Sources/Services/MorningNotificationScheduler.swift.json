   "key": "func MorningNotificationScheduler.claimWakePush(today:sleepEnd:)",
   "hash": "ec55f85aa229ce92",
   "does": "Returns nil if today's wake push is settled (sent with this morning's reading, or one being built) or sleepEnd is not within the last 90 min; otherwise records today and marks it settled for now (so a concurrent call is turned away) and returns .first, or .replacingUnscored when a number-free push already went out today.",
   "entry": null,
   "calls": [],
   "reads": [
    "ud:MorningNotificationScheduler.wakeFiredDate.v1",
    "ud:MorningNotificationScheduler.wakeSettled.v1"
   ],
   "writes": [
    "ud:MorningNotificationScheduler.wakeFiredDate.v1",
    "ud:MorningNotificationScheduler.wakeSettled.v1"
   ],
   "branches": [
    {
     "at": "+4",
     "cond": "claimed today and settled",
     "effect": "return nil"
    },
    {
     "at": "+6",
     "cond": "age < 0 or > 90 min",
     "effect": "return nil; else claim"
    },
    {
     "at": "+9",
     "cond": "claimed earlier today (unsettled)",
     "effect": ".replacingUnscored; else .first"
    }
   ],
   "deps": {}
