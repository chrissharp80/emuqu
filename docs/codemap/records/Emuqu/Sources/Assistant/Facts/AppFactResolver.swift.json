   "key": "func PeriodParser.numericDayWindow(_:)",
   "hash": "8ba771123d331516",
   "does": "Strips 'last_' and normalizes '_days'/'_day' to 'd', then returns N when any candidate ends with 'd' and its prefix parses to an Int in 1...365.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+5",
     "cond": "for each candidate ending in 'd'",
     "effect": "tries to parse the prefix"
    },
    {
     "at": "+7",
     "cond": "prefix is an Int in 1...365",
     "effect": "returns it; otherwise continues; nil after all candidates"
    }
   ],
   "deps": {}
  },
