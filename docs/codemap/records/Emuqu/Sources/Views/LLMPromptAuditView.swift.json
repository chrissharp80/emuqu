  {
   "key": "func LLMPromptAuditView.entryUsageLine(_:)",
   "hash": "00f13d2a5c43c260",
   "does": "Shows 'Tokens: in X · cached Y (Z%) · out W' where Z = cached/(input+cached+cacheCreate)*100 truncated, or 'Failed' in caution color when there is no usage but an error, or nothing.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "entry.usage non-nil",
     "effect": "renders the token line"
    },
    {
     "at": "+5",
     "cond": "total input (input+cached+cacheCreate) > 0",
     "effect": "hit ratio = Int(cached/total*100) (truncated toward zero); when total is 0 the ratio is 0"
    },
    {
     "at": "+9",
     "cond": "usage nil and entry.errorDescription non-nil",
     "effect": "renders 'Failed'; when both are nil (in-flight or finished without usage) renders nothing"
    }
   ],
   "deps": {
    "Emuqu/Sources/Services/LanguageManager.swift::var LanguageManager.appBundle": "45e03a07330b7279",
