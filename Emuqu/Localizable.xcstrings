    "Today's HRV (%dms) is %.0f%% above your average. Your body is well-recovered." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV اليوم (%d مللي ثانية) أعلى بنسبة %.0f%% من متوسطك. جسمك متعافٍ جيدًا."
