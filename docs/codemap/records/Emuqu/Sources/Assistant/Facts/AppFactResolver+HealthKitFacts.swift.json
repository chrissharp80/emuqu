    "hk:HKQuantityType.heartRate"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "HealthKit available",
     "effect": "continues; else missing notRecorded 'HealthKit not available'"
    },
    {
     "at": "+6",
     "cond": "switch on the fetch result",
     "effect": "success → samples; failure → missing notRecorded 'HealthKit query failed: …'; nil (timeout) → missing notYetComputed 'didn't answer within 3 s … try again'"
    },
    {
     "at": "+13",
     "cond": "at least one sample",
     "effect": "returns newest; else missing notRecorded 'no HR samples in the last 24 hours'"
    }
