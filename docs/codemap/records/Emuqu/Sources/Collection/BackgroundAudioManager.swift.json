{
 "file": "Emuqu/Sources/Collection/BackgroundAudioManager.swift",
 "hash": "c3f3adba6319cb0b",
 "role": "Owns the AVAudioSession lifecycle for spoken workout cues: per-cue tokens, a serial transition queue that claims/activates and releases/deactivates the shared session via AudioSessionCoordinator, interruption handling, and a speech-synthesizer delegate (CueAudioSessionReleaser) that ends a cue's hold when its utterance finishes.",
 "types": [
  "BackgroundAudioManager: class (Sendable) — cue-scoped audio session manager",
  "BackgroundAudioManager.CueToken: struct — one cue's hold id",
  "BackgroundAudioManager.State: struct — held cue ids, last token id, wasInterrupted",
  "CueAudioSession: protocol — seam over the shared session (claim/release/hasActiveClaims/activate/deactivate)",
  "SystemCueAudioSession: struct — real AVAudioSession + AudioSessionCoordinator implementation",
  "CueAudioSessionReleaser: class (NSObject, AVSpeechSynthesizerDelegate) — maps utterances to cue tokens and ends them on finish/cancel"
 ],
 "state": [
  "static BackgroundAudioManager.shared (returned by CollectionServices.backgroundAudioManager, AppDependencies.swift:546)",
  "state: OSAllocatedUnfairLock<State>",
  "transitions: DispatchQueue 'com.emuqu.cue-audio-session' (.userInitiated)",
  "observers: NotificationTokens",
  "CueAudioSessionReleaser.pending: OSAllocatedUnfairLock<[ObjectIdentifier: CueToken]>",
  "notif:AVAudioSession.interruptionNotification (observed)"
 ],
