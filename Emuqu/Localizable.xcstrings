            "value" : "Tämä suorittaa analyysialgoritmit uudelleen olemassa olevalle RR-datallesi. Raakadatasi on turvassa eikä sitä muokata."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela relancera les algorithmes d'analyse sur vos données RR existantes. Vos données brutes sont en sécurité et ne seront pas modifiées."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þetta mun keyra greiningaralgrím aftur á núverandi RR-gögnum þínum. Hrágögnin þín eru örugg og verða ekki breytt."
