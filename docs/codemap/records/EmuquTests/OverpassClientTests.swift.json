   "key": "func StubOverpass.respond(to:)",
   "hash": "ea0c55b8d0b284f6",
   "does": "Stub transport: records the request host, tracks in-flight peak, optionally sleeps, pops the next scripted reply (200 when empty), throws notConnectedToInternet for .offline, else returns '{}' with the scripted status.",
   "entry": "closure:OverpassClient transport injected by the tests (OverpassClient(minRequestGap:transport:))",
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "request.url ?? file:///",
     "effect": "falls back to a file URL when the request has no URL"
    },
    {
     "at": "+2",
     "cond": "url.host ?? ''",
     "effect": "records '' when no host"
    },
    {
     "at": "+6",
     "cond": "delayNanoseconds > 0",
     "effect": "sleeps that long (throws on cancellation); else no delay"
    },
    {
     "at": "+7",
     "cond": "script empty",
     "effect": "replies .status(200); else removes and uses the first scripted reply"
    },
    {
     "at": "+8",
     "cond": "reply is .offline",
     "effect": "throws URLError(.notConnectedToInternet); .status continues"
    },
    {
     "at": "+9",
     "cond": "HTTPURLResponse init fails",
     "effect": "throws URLError(.badServerResponse); else returns ('{}', response)"
    }
   ],
   "deps": {
