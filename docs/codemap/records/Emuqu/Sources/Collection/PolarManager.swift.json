{
 "file": "Emuqu/Sources/Collection/PolarManager.swift",
 "hash": "0d11b5137c5f7180",
 "role": "Declares PolarDeviceType and the @Observable @MainActor PolarManager: the observable strap state (connection, recording, battery, firmware, streaming buffer), forwarders into StrapRecordingCoordinator / StrapBatteryUsageTracker / StrapPairingStore, PolarError, and lazy SDK setup with observer wiring.",
 "types": [
  "PolarDeviceType: enum — h10 / veritySense with display name, SF symbol, spec runtime hours",
  "PolarManager: class (@Observable @MainActor NSObject) — the strap link owner and state holder",
  "PolarManager.ConnectionState: enum — disconnected/scanning/connecting/connected",
  "PolarManager.RecordingState: enum — idle/starting/recording/stopping/fetching",
  "PolarManager.PolarError: enum (LocalizedError) — strap errors with user-facing descriptions (every case is constructed somewhere)"
 ],
 "state": [
