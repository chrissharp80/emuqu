    "mem:SessionState.reviewArchivedEntries",
    "mem:StreamingLifecycle.pausedSession"
   ],
   "branches": [
    {
     "at": "+2",
     "cond": "no currentSession, a different id, or the card is not the archive's copy (neither reviewArchivedSessionId nor the paused session)",
     "effect": "returns, nothing changed"
    },
    {
     "at": "+7",
