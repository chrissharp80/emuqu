   "key": "func TrailDiscoveryService.Difficulty.fromSacScale(_:)",
   "hash": "8457be8ad4069d60",
   "does": "Maps an OSM sac_scale value (lower-cased, whitespace-trimmed) to a Difficulty by exact match on the word values or T1-T6 codes; nil for anything else or nil input.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "value is 'hiking' or 't1'",
     "effect": ".easy"
    },
    {
     "at": "+3",
     "cond": "'mountain_hiking','demanding_mountain_hiking','t2','t3'",
     "effect": ".moderate"
    },
    {
     "at": "+4",
     "cond": "'alpine_hiking','demanding_alpine_hiking','t4','t5'",
     "effect": ".hard"
    },
    {
     "at": "+5",
     "cond": "'difficult_alpine_hiking','t6'",
     "effect": ".expert"
    },
    {
     "at": "+6",
     "cond": "default (nil input, unknown value)",
     "effect": "nil, so makeTrail falls through to mtb:scale"
    }
   ],
   "deps": {}
  },
  {
   "key": "func TrailDiscoveryService.Difficulty.fromMtbScale(_:)",
   "hash": "0d13f586567d5a1e",
   "does": "Maps mtb:scale to Difficulty by parsing only its first character as an Int (so '2+' → 2): 0-1 easy, 2 moderate, 3 hard, anything larger expert; nil when tag missing or first char not a digit.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "tag present and first character parses as Int",
     "effect": "continue to switch; otherwise nil (falls through to .unknown in makeTrail)"
    },
    {
     "at": "+3",
     "cond": "n is 0 or 1",
     "effect": ".easy"
    },
    {
     "at": "+4",
     "cond": "n == 2",
     "effect": ".moderate"
    },
    {
     "at": "+5",
     "cond": "n == 3",
     "effect": ".hard"
    },
    {
     "at": "+6",
     "cond": "default (4-9)",
     "effect": ".expert"
    }
   ],
   "deps": {}
  },
