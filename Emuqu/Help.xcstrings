            "value" : "Slaapstadia geven weer wat de Watch heeft geregistreerd (diep, REM, kern, wakker)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os estágios do sono refletem o que o Watch registrou (profundo, REM, core, acordado)"
          }
        },
        "ru" : {
