    },
    {
     "at": "+12",
     "cond": "series are not the same data",
     "effect": "returns .replaceWithNewData(existingCount,newCount)"
    },
    {
     "at": "+15",
     "cond": "no analysis result",
     "effect": "returns .reanalyzeNoResult"
    },
