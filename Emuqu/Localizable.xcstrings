    "Choose a background style that's comfortable for your eyes. The Dim and Dark themes are easier to read for some users." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر نمط خلفية مريح لعينيك. السمتان الخافتة والداكنة أسهل في القراءة لبعض المستخدمين."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg en baggrundsstil, der er behagelig for dine øjne. De dæmpede og mørke temaer er lettere at læse for nogle brugere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Hintergrundstil, der angenehm für deine Augen ist. Die Themen Gedimmt und Dunkel sind für manche Benutzer leichter zu lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un estilo de fondo cómodo para tus ojos. Los temas Tenue y Oscuro son más fáciles de leer para algunos usuarios."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse silmillesi mukava tausta. Himmennetty ja tumma teema ovat joillekin käyttäjille helpompia lukea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un style d'arrière-plan confortable pour vos yeux. Les thèmes Tamisé et Sombre sont plus faciles à lire pour certains utilisateurs."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veldu bakgrunnsstíl sem hentar augum þínum. Dökku og dimmdu þemun eru auðveldari að lesa fyrir suma notendur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli uno stile di sfondo confortevole per i tuoi occhi. I temi Attenuato e Scuro sono più facili da leggere per alcuni utenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目に優しい背景スタイルを選びましょう。薄暗いテーマとダークテーマは一部のユーザーにとって読みやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "눈에 편안한 배경 스타일을 선택하세요. 어두운 테마와 다크 테마는 일부 사용자에게 더 읽기 쉽습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velg en bakgrunnsstil som er behagelig for øynene dine. De dempede og mørke temaene er lettere å lese for noen brukere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een achtergrondstijl die prettig is voor uw ogen. De thema's Gedimd en Donker zijn voor sommige gebruikers beter leesbaar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um estilo de fundo confortável para seus olhos. Os temas Suave e Escuro são mais fáceis de ler para alguns usuários."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите стиль фона, комфортный для ваших глаз. Приглушённая и тёмная темы легче для чтения для некоторых пользователей."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Välj en bakgrundsstil som är bekväm för dina ögon. De dimmade och mörka temana är lättare att läsa för vissa användare."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一个对眼睛舒适的背景样式。柔和和深色主题对某些用户来说更易阅读。"
          }
        }
      }
    },
