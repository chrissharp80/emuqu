          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gegevens laten een opvallend patroon zien. De oorzaak is aan jou om uit te zoeken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
