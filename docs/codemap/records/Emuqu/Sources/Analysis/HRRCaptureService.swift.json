  {
   "key": "func HRRCaptureService.enforceMonotonicDrop(_:)",
   "hash": "f1d63714a6555563",
   "does": "Pure filter over offset-ordered samples: keeps the first sample, then drops any later sample whose drop is more than 10 bpm below the running maximum drop (logging it at warning), keeping and raising the max otherwise.",
   "entry": "Also called directly by XCTest (HRRCaptureServiceTests, HRRMonotonicDropTests).",
   "calls": [
    "Emuqu/Sources/Analysis/HRRCaptureService.swift::func HRRCaptureService.logContaminatedSample(_:priorMax:regressionTolerance:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+3",
     "cond": "for each sample",
     "effect": "evaluates against running max"
    },
    {
     "at": "+4",
     "cond": "no prior max yet",
     "effect": "keeps the sample and sets max = its drop"
    },
    {
     "at": "+9",
     "cond": "s.drop >= prior - 10",
     "effect": "false: logs contamination and skips the sample; true: keeps it"
    },
    {
     "at": "+14",
     "cond": "s.drop > prior",
     "effect": "raises running max; else max unchanged"
    }
