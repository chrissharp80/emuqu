    "Moderate — consider extending sleep duration to capture more REM cycles" : {
      "comment" : "A translation of \"Moderate — consider extending sleep duration to capture more REM cycles\".",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوسط — فكّر في إطالة مدة النوم لالتقاط دورات REM أكثر"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderat — overvej at forlænge søvnen for at få flere REM-cyklusser"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderat — erwäge, den Schlaf zu verlängern, um mehr REM-Zyklen zu bekommen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moderado — considera alargar el sueño para captar más ciclos REM"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kohtalainen — harkitse unen pidentämistä useampien REM-jaksojen saamiseksi"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modéré — envisagez d’allonger le sommeil pour capter davantage de cycles REM"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miðlungs — íhugaðu að lengja svefninn til að ná fleiri REM-lotum"
