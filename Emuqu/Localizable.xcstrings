    "Put on your Polar device and ensure good sensor contact" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارتدِ جهاز Polar وتأكد من اتصال جيد بالمستشعر"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag din Polar-enhed på og sørg for god sensorkontakt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg dein Polar-Gerät an und sorge für guten Sensorkontakt"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte tu dispositivo Polar y asegura un buen contacto del sensor"
