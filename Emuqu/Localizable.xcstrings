    "Around %@ is typical for your age band. %@. What matters most: your personal trend over weeks, not any single reading." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حوالي %@ هو المعتاد لفئتك العمرية. %@. الأهم هو اتجاهك الشخصي على مدى أسابيع، وليس أي قراءة منفردة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omkring %@ er typisk for din aldersgruppe. %@. Det vigtigste: din personlige tendens over uger, ikke en enkelt måling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa %@ ist für deine Altersgruppe typisch. %@. Am wichtigsten ist dein persönlicher Trend über Wochen, nicht eine einzelne Messung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alrededor de %@ es lo típico en tu franja de edad. %@. Lo que más importa: tu tendencia personal a lo largo de semanas, no una lectura aislada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noin %@ on tyypillistä ikäryhmällesi. %@. Tärkeintä on henkilökohtainen trendisi viikkojen aikana, ei yksittäinen mittaus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Environ %@ est typique pour votre tranche d'âge. %@. Ce qui compte le plus : votre tendance personnelle sur plusieurs semaines, pas une mesure isolée."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um %@ er dæmigert fyrir þinn aldurshóp. %@. Það sem skiptir mestu: þín eigin þróun yfir vikur, ekki einstök mæling."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Circa %@ è tipico per la tua fascia d'età. %@. Ciò che conta di più: la tua tendenza personale nell'arco di settimane, non una singola lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの年齢層では %@ 前後が一般的です。%@。最も重要なのは、1 回の測定値ではなく、数週間にわたるあなた自身のトレンドです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연령대에서는 %@ 정도가 일반적입니다. %@. 가장 중요한 것은 한 번의 측정값이 아니라 몇 주에 걸친 개인 추세입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rundt %@ er typisk for aldersgruppen din. %@. Det viktigste: din personlige trend over uker, ikke én enkelt måling."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rond %@ is gebruikelijk voor jouw leeftijdsgroep. %@. Wat het meest telt: je persoonlijke trend over weken, niet één losse meting."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerca de %@ é típico para a sua faixa etária. %@. O que mais importa: sua tendência pessoal ao longo de semanas, não uma leitura isolada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Около %@ — типично для вашей возрастной группы. %@. Главное — ваш личный тренд за недели, а не отдельное измерение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runt %@ är typiskt för din åldersgrupp. %@. Det viktigaste: din personliga trend över veckor, inte en enskild mätning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你所在的年龄段通常在 %@ 左右。%@。最重要的是你数周以来的个人趋势，而不是任何单次读数。"
          }
        }
      }
    },
