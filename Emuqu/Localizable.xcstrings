    "Earlier bedtime tonight helps tomorrow's reading recover." : {
      "comment" : "Bullet point in the \"What to do today\" section of the RecoveryScoreDetailView, advising to get to bed earlier to help recovery.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النوم مبكرًا الليلة يساعد قراءة الغد على التعافي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidligere sengetid i nat hjælper morgendagens måling med at komme sig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Früher schlafen gehen hilft der Messung von morgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acostarte antes esta noche ayudará a que la lectura de mañana se recupere."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiempi nukkumaanmeno tänä yönä auttaa huomista mittausta palautumaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se coucher plus tôt ce soir aidera la mesure de demain à remonter."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyrri háttatími í kvöld hjálpar mælingu morgundagsins að ná sér."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andare a letto prima stanotte aiuterà la lettura di domani a risalire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今夜早めに就寝すると、明日の測定値の回復に役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 밤 일찍 자면 내일 측정값 회복에 도움이 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidligere leggetid i natt hjelper morgendagens måling å ta seg opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eerder naar bed vannacht helpt de meting van morgen herstellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
