  {
   "key": "func CSVExporter.nearestSample(to:in:)",
   "hash": "4790810bb4256f45",
   "does": "Binary search for the first sample at or after the target second (samples are in offsetSec order); of it and the sample before it, returns the closer (the earlier on a tie) if within 5 s, else nil. O(log n) per fix.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "lo < hi",
     "effect": "halve the range (lower bound on offsetSec)"
    },
    {
     "at": "+4",
     "cond": "samples[mid].offsetSec < target",
     "effect": "lo = mid + 1; else hi = mid"
    },
    {
     "at": "+7",
     "cond": "no candidate (samples empty)",
     "effect": "returns nil"
    },
    {
     "at": "+8",
     "cond": "closest within 5 s",
     "effect": "returns it; else nil"
    }
   ],
   "deps": {}
  },
