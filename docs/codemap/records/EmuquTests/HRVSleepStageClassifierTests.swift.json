   "hash": "400dd7be67535a36",
   "does": "Test helper: synthesises a night of RR points in 90-min cycles: 2-min ~800 ms wake at each cycle start after the first, deep (~1154 ms ±15) for the first 30%/15% of a cycle, REM (~923 ms ±60) for the last 15%/30%, light (~1000 ms ±30) otherwise; RR clamped to 200–2000.",
   "entry": null,
   "calls": [
    "EmuquTests/HRVSleepStageClassifierTests.swift::func HRVSleepStageClassifierTests.deterministicOffset(step:min:max:)",
    "Emuqu/Sources/Models/RRModels.swift::init RRPoint(t_ms:rr_ms:wallClockMs:hr:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+15",
     "cond": "for each 90-min cycle (at least 1)",
     "effect": "generates the cycle"
    },
    {
     "at": "+21",
     "cond": "cycle < 2",
     "effect": "deep fraction 0.30, else 0.15"
    },
    {
     "at": "+25",
     "cond": "cycle < 2",
     "effect": "REM fraction 0.15, else 0.30"
    },
    {
     "at": "+31",
     "cond": "while currentMs < cycleEnd",
     "effect": "appends beats until cycle end"
    },
    {
     "at": "+32",
     "cond": "currentMs < awakeEnd and cycle > 0",
     "effect": "awake RR ~800 ms"
    },
    {
     "at": "+35",
     "cond": "currentMs < deepEnd",
     "effect": "deep RR ~1154 ms"
    },
    {
     "at": "+38",
     "cond": "currentMs >= remStart",
     "effect": "REM RR ~923 ms; else light RR ~1000 ms"
    }
   ],
