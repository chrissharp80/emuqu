   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "rounded score in 90...100",
     "effect": "excellent"
    },
    {
     "at": "+3",
     "cond": "75..<90",
     "effect": "good"
    },
    {
     "at": "+4",
     "cond": "60..<75",
     "effect": "fair"
    },
    {
     "at": "+5",
     "cond": "45..<60",
     "effect": "payAttention"
    },
    {
     "at": "+6",
     "cond": "30..<45",
     "effect": "low"
    },
    {
     "at": "+7",
     "cond": "anything else (<30, incl. NaN clamped to 0)",
     "effect": "veryLow"
    }
   ],
   "deps": {
