          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando há dados de exercício, uma barra de zona horizontal aparece abaixo do anel mostrando sua prontidão para treinar: Descanso / Fatigado / Moderado / Pronto."
