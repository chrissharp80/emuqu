            "value" : "Dette er %@%% over din baseline—du er i god form."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das liegt %@%% über deiner Baseline—du bist in Topform."
          }
        },
        "es" : {
          "stringUnit" : {
