    "Emuqu/Sources/Collection/RRCollector+Discard.swift::func CollectorSessionControl.removeKeptCopies(of:)",
    "Emuqu/Sources/Collection/RRCollector+Session.swift::func RRCollector.resetSession()",
    "Emuqu/Sources/Collection/RRCollector+Session.swift::func RRCollector.notifyArchiveChanged()"
   ],
   "reads": [
    "mem:RRCollector.pausedSession"
   ],
   "writes": [
    "archive:SessionArchive.delete",
    "ud:RRCollector.pausedSessionId",
    "mem:RRCollector.lastError"
   ],
   "branches": [
    {
     "at": "+1",
     "cond": "no pausedSession or its state is not .paused",
     "effect": "returns, nothing changed"
    },
    {
     "at": "+3",
     "cond": "each id in the paused chain",
     "effect": "archive delete, then backups removed"
    },
    {
     "at": "+6",
     "cond": "archive.delete throws",
     "effect": "returns keepPauseAfterFailedDelete(of: id, pausedId: paused.id, error:) without removing that id's or older ids' backups"
    }
   ],
