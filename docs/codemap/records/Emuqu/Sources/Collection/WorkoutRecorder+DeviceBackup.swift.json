   "key": "func WorkoutRecorder.deviceFetchDecision(streamingPointCount:elapsedSec:summedRRMs:)",
   "hash": "071d2ca5bfc6cf94",
   "does": "Pure density gate: fetch (nil density) when elapsed <=60 s, no streamed points, or integer mean RR <=300 ms; else expected beats = elapsed x (60000/avgRR)/60 and skipFetch when streamed/expected >= 0.95, otherwise fetch(density). Tested in WorkoutTickLogicTests.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+5",
     "cond": "elapsed <= 60 s or zero points",
     "effect": "fetch(nil)"
    },
    {
     "at": "+9",
     "cond": "avg RR <= 300 ms",
     "effect": "fetch(nil)"
    },
    {
     "at": "+15",
     "cond": "density >= 0.95",
     "effect": "skipFetch; else fetch(density)"
    }
   ],
   "flags": [],
   "deps": {}
  },
