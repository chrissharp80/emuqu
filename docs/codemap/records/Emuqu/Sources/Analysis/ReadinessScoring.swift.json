   "entry": null,
   "calls": [
    "Emuqu/Sources/Analysis/ReadinessScoring.swift::func ReadinessScoring.mapCapacityRatioToReadiness(_:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+5",
     "cond": "ctl < 3.2",
     "effect": "novel-load strain model using the UNSCALED raw acute fatigue; else capacity-ratio model with scaled fatigue"
    },
    {
     "at": "+16",
     "cond": "capacity ratio NaN",
     "effect": "return NaN; else mapCapacityRatioToReadiness"
    }
   ],
   "deps": {
    "Emuqu/Sources/Analysis/ReadinessScoring.swift::func ReadinessScoring.mapCapacityRatioToReadiness(_:)": "c73d8f4cc0baddaa",
