            "state" : "translated",
            "value" : "kadence %lld — uden for det sunde interval 165–190"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kadenz %lld — außerhalb des gesunden Bereichs 165–190"
          }
        },
        "es" : {
          "stringUnit" : {
