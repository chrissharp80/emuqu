    "Removes every sleep sample this app has written to Apple Health. Watch and other sources are untouched." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل جميع عيّنات النوم التي كتبها هذا التطبيق في Apple Health. لا يتأثر Watch والمصادر الأخرى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner alle søvnmålinger, som denne app har skrevet til Apple Health. Watch og andre kilder berøres ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt alle Schlafdaten, die diese App in Apple Health geschrieben hat. Watch und andere Quellen bleiben unberührt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina todas las muestras de sueño que esta app haya escrito en Apple Health. El Watch y otras fuentes no se ven afectados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaa kaikki uninäytteet, jotka tämä sovellus on kirjoittanut Apple Healthiin. Watchin ja muiden lähteiden tietoihin ei kosketa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime tous les échantillons de sommeil que cette app a écrits dans Apple Santé. Les données de la Watch et des autres sources ne sont pas touchées."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjarlægir öll svefnsýni sem þetta forrit hefur skrifað í Apple Health. Gögn frá Watch og öðrum heimildum eru ósnert."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove tutti i campioni di sonno che questa app ha scritto in Apple Salute. I dati di Watch e di altre fonti non vengono toccati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリが Apple ヘルスケアに書き込んだすべての睡眠サンプルを削除します。Apple Watch やその他のソースのデータには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱이 Apple 건강에 기록한 모든 수면 샘플을 제거합니다. Watch 및 기타 소스의 데이터는 그대로 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner alle søvnprøver denne appen har skrevet til Apple Health. Data fra Watch og andre kilder berøres ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert elk slaapmonster dat deze app naar Apple Health heeft geschreven. Gegevens van de Watch en andere bronnen blijven ongemoeid."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove todas as amostras de sono que este app gravou no Apple Saúde. Os dados do Watch e de outras fontes não são alterados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет все записи сна, которые это приложение записало в Apple Здоровье. Данные Watch и других источников не затрагиваются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar bort alla sömnprover som den här appen har skrivit till Apple Hälsa. Watch och andra källor påverkas inte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移除本应用写入 Apple 健康的所有睡眠样本。手表和其他来源的数据不受影响。"
          }
        }
      }
    },
    "Removes the workout-recording tab. Recovery-only users get a cleaner UI." : {
      "comment" : "A description of the \"Hide Fitness tab\" toggle in the Performance & Battery settings page.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيل علامة تبويب تسجيل التمرين. يحصل المستخدمون الذين يستعملون التعافي فقط على واجهة أبسط."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner fanen til træningsoptagelse. Brugere, der kun bruger restitution, får en renere brugerflade."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entfernt den Tab zur Trainingsaufzeichnung. Nutzer, die nur die Erholung verwenden, erhalten eine aufgeräumtere Oberfläche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina la pestaña de grabación de entrenamientos. Los usuarios que solo usan la recuperación obtienen una interfaz más limpia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistaa harjoituksen tallennusvälilehden. Vain palautumista käyttävät saavat selkeämmän käyttöliittymän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime l'onglet d'enregistrement des séances. Les utilisateurs axés sur la récupération uniquement bénéficient d'une interface plus épurée."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjarlægir flipann fyrir æfingaupptöku. Notendur sem nota aðeins endurheimt fá hreinna viðmót."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove la scheda di registrazione degli allenamenti. Gli utenti che usano solo il recupero ottengono un'interfaccia più pulita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークアウト記録タブを削除します。回復機能のみを使うユーザーは、よりすっきりしたUIになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동 기록 탭을 제거합니다. 회복 기능만 사용하는 사용자는 더 깔끔한 UI를 사용할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjerner fanen for treningsopptak. Brukere som bare bruker restitusjon, får et renere grensesnitt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert het tabblad voor workout-opname. Gebruikers die alleen herstel gebruiken, krijgen een rustigere interface."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove a aba de gravação de treinos. Usuários que usam só a recuperação têm uma interface mais limpa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
