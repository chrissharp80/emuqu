  {
   "key": "func MorningSessionPipeline.archiveForReview(_:)",
   "hash": "e508f07ce3ae730a",
   "does": "Pre-archives a .complete session before the user reviews it (crash safety), retires its raw backup when safe, bumps the archive signal, and remembers the id in sessionState.reviewArchivedSessionId when it was not already in the archive so Discard can remove it. A failed write is logged as an error and set as lastError; the night is then not in the archive, and the morning keeps its recording marker for it.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Storage/Archive+StoreForwarding.swift::var SessionArchive.entries",
    "Emuqu/Sources/Storage/Archive.swift::func SessionArchive.archive(_:)",
    "Emuqu/Sources/Collection/RRCollector+MorningProcessing.swift::func MorningSessionPipeline.retireRawBackupIfSafe(_:)",
    "Emuqu/Sources/Collection/ArchiveSignal.swift::func ArchiveSignal.notifyChanged()"
   ],
   "reads": [
    "archive:SessionArchive.entries"
   ],
   "writes": [
    "archive:SessionArchive.archive",
    "mem:SessionState.reviewArchivedSessionId",
    "mem:ArchiveSignal.version",
    "mem:SessionState.lastError"
   ],
   "branches": [
    {
     "at": "+1",
     "cond": "finalSession.state != .complete",
     "effect": "return without archiving"
    },
    {
     "at": "+8",
     "cond": "isNewEntry (id absent from archive index before the write)",
     "effect": "reviewArchivedSessionId = id; else unchanged"
    },
    {
     "at": "+9",
     "cond": "archive() throws",
     "effect": "logs error, sets lastError; no raw-backup retire, no signal"
    }
   ],
