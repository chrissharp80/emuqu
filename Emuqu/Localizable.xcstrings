    "Off completely between workouts; advertising stops the moment the workout ends." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوقف تمامًا بين التمارين؛ يتوقف الإعلان لحظة انتهاء التمرين."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helt slået fra mellem træninger; annonceringen stopper, så snart træningen slutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwischen Trainings komplett aus; das Senden endet, sobald das Training endet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado por completo entre entrenamientos; el anuncio se detiene en cuanto termina el entrenamiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täysin pois päältä harjoitusten välillä; mainostus loppuu heti, kun harjoitus päättyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entièrement désactivé entre les entraînements ; l’annonce s’arrête dès la fin de l’entraînement."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alveg slökkt á milli æfinga; auglýsing hættir um leið og æfingunni lýkur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completamente disattivato tra un allenamento e l’altro; l’annuncio si interrompe appena l’allenamento finisce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ワークアウトの合間は完全にオフです。ワークアウトが終了した瞬間にアドバタイズを停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "운동 사이에는 완전히 꺼져 있으며, 운동이 끝나는 즉시 신호 전송이 중단됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helt av mellom øktene; annonseringen stopper i det øyeblikket økten avsluttes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volledig uit tussen trainingen; het adverteren stopt zodra de training eindigt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totalmente desativado entre treinos; o anúncio para no momento em que o treino termina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полностью выключено между тренировками; передача прекращается сразу после окончания тренировки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helt avstängt mellan passen; annonseringen slutar i samma stund som passet avslutas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "体能训练之间完全关闭；体能训练一结束，广播即停止。"
          }
        }
      }
    },
