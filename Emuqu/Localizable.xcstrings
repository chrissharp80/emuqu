    "Well below your baseline — body is asking for rest." : {
      "comment" : "Subtitle for the \"HRV\" hero section, when the RMSSD is well below the user's baseline.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدنى بكثير من خط الأساس — الجسم يطلب الراحة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et godt stykke under din baseline — kroppen beder om hvile."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deutlich unter deiner Baseline — der Körper verlangt Ruhe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muy por debajo de tu línea base — el cuerpo pide descanso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selvästi perustasosi alle — keho pyytää lepoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien en dessous de votre référence — le corps demande du repos."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vel undir grunnlínu þinni — líkaminn biður um hvíld."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ben sotto la tua baseline — il corpo chiede riposo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベースラインを大きく下回る — 体は休養を求めています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기준선보다 크게 낮음 — 몸이 휴식을 요구합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godt under din baseline — kroppen ber om hvile."
          }
        },
        "nl" : {
          "stringUnit" : {
