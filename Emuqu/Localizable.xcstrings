    "Route recovered — distance is now %@." : {
      "comment" : "A message that appears when a crash-recovered workout's full GPS route is successfully pulled from Apple Health. The argument is the distance, formatted in U.S. Dollars.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
