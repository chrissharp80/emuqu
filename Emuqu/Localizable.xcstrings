    "Gemini is overloaded right now. Try again in a moment." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini مثقل بالطلبات الآن. حاول مرة أخرى بعد قليل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini er overbelastet lige nu. Prøv igen om lidt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemini ist gerade überlastet. Versuch es gleich noch einmal."
          }
        },
        "es" : {
