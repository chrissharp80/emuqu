     "at": "+4",
     "cond": "case .outAndBackReturning",
     "effect": "go to 50 m guard"
    },
    {
     "at": "+5",
     "cond": "farthest.meters > 50",
     "effect": "false: (nil,nil); true: projection"
    },
    {
     "at": "+8",
     "cond": "case .outAndBackOutbound",
     "effect": "(nil, elapsed)"
    },
    {
     "at": "+10",
     "cond": "default (loop, pointToPoint, unknown)",
     "effect": "(nil, nil)"
    }
   ],
