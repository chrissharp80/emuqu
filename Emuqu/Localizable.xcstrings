        }
      }
    },
    "Auto sends a short teaser until you have 30 nights of readings, then the score and guidance. Choose Full readout to get them in the notification from the start." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل الوضع التلقائي لمحة قصيرة إلى أن تجمع قراءات 30 ليلة، ثم يرسل الدرجة والإرشادات. اختر القراءة الكاملة لتصلك في الإشعار من البداية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto sender en kort smagsprøve, indtil du har 30 nætters målinger, derefter scoren og vejledningen. Vælg Fuld aflæsning for at få dem i notifikationen fra starten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Automatisch\" schickt eine kurze Vorschau, bis du 30 Nächte an Messungen hast, danach den Score und Empfehlungen. Wähle „Vollständige Anzeige\", um sie von Anfang an in der Mitteilung zu bekommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático envía un breve adelanto hasta que tengas 30 noches de lecturas, y después la puntuación y las recomendaciones. Elige Lectura completa para recibirlas en la notificación desde el principio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaattinen lähettää lyhyen esimaun, kunnes sinulla on 30 yön mittaukset, ja sen jälkeen pisteet ja ohjeet. Valitse Koko lukema, niin saat ne ilmoitukseen alusta asti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatique envoie un court aperçu jusqu'à ce que vous ayez 30 nuits de mesures, puis le score et les conseils. Choisissez Relevé complet pour les recevoir dans la notification dès le début."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjálfvirkt sendir stutta kynningu þar til þú átt 30 nætur af mælingum, síðan stigin og leiðbeiningar. Veldu Full aflestur til að fá þau í tilkynningunni frá byrjun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatico invia una breve anteprima finché non hai 30 notti di letture, poi il punteggio e i consigli. Scegli Lettura completa per riceverli nella notifica fin dall'inizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「自動」では、30 晩分の測定値がそろうまでは短い予告を送り、その後はスコアとガイダンスを送ります。最初から通知でそれらを受け取るには「詳細表示」を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동은 측정값이 30일 밤 쌓일 때까지 짧은 미리보기를 보내고, 그 후에는 점수와 가이드를 보냅니다. 처음부터 알림으로 받으려면 전체 판독을 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto sender en kort smakebit til du har 30 netter med målinger, deretter skåren og veiledningen. Velg Full avlesning for å få dem i varselet fra starten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch stuurt een korte teaser tot je 30 nachten aan metingen hebt, daarna de score en het advies. Kies Volledige uitlezing om ze vanaf het begin in de melding te krijgen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modo Auto envia uma prévia curta até você ter 30 noites de leituras; depois, a pontuação e as orientações. Escolha Leitura completa para recebê-las na notificação desde o início."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В режиме «Авто» приходит короткий анонс, пока у вас не наберётся 30 ночей измерений, затем — оценка и советы. Выберите «Полные показания», чтобы получать их в уведомлении с самого начала."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto skickar en kort försmak tills du har 30 nätters mätningar, därefter poängen och vägledningen. Välj Fullständig avläsning för att få dem i notisen från början."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“自动”会在你积累 30 晚读数之前只发送简短预告，之后再发送分数和建议。选择“完整读数”可从一开始就在通知中收到这些内容。"
          }
        }
      }
    },
