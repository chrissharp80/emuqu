    "Put on your Polar device — moisten the H10 electrodes or press the Verity Sense button to turn it on" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارتدِ جهاز Polar — رطّب أقطاب H10 أو اضغط زر Verity Sense لتشغيله"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag din Polar-enhed på — fugt H10-elektroderne, eller tryk på knappen på Verity Sense for at tænde den"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leg dein Polar-Gerät an — befeuchte die Elektroden des H10 oder drücke die Taste des Verity Sense, um ihn einzuschalten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponte tu dispositivo Polar: humedece los electrodos del H10 o pulsa el botón del Verity Sense para encenderlo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pue Polar-laitteesi — kostuta H10:n elektrodit tai käynnistä Verity Sense painamalla sen painiketta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez votre appareil Polar — humidifiez les électrodes du H10 ou appuyez sur le bouton du Verity Sense pour l’allumer"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Settu Polar tækið á þig — vættu rafskaut H10 eða ýttu á hnappinn á Verity Sense til að kveikja á honum"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indossa il dispositivo Polar: inumidisci gli elettrodi dell'H10 o premi il pulsante del Verity Sense per accenderlo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar デバイスを装着します — H10 は電極を湿らせ、Verity Sense はボタンを押して電源を入れます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar 기기를 착용하세요 — H10 전극을 적시거나 Verity Sense 버튼을 눌러 전원을 켜세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta på deg Polar-enheten — fukt elektrodene på H10 eller trykk på knappen på Verity Sense for å slå den på"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doe je Polar-apparaat om — maak de elektroden van de H10 vochtig of druk op de knop van de Verity Sense om hem aan te zetten"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque seu dispositivo Polar — umedeça os eletrodos do H10 ou pressione o botão do Verity Sense para ligá-lo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наденьте устройство Polar — смочите электроды H10 или нажмите кнопку Verity Sense, чтобы включить его"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta på din Polar-enhet — fukta H10:s elektroder eller tryck på knappen på Verity Sense för att slå på den"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戴上你的 Polar 设备 — 润湿 H10 电极，或按下 Verity Sense 按钮开机"
          }
        }
      }
    },
