   "key": "func WatchMessageDecoding.controlReplyStatus(_:sport:successStatus:)",
   "hash": "4f1490522e93e029",
   "does": "Status line for a phone reply to a control message: successStatus when ok == true; the bare unlock prompt for needsUnlock; otherwise \"iPhone: <worded code | phone error | 'unknown error'>\".",
   "entry": null,
   "calls": [
    "EmuquWatch Watch App/WatchMessageDecoding.swift::func WatchMessageDecoding.refusalText(code:sport:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "reply ok as Bool, default false via ??",
     "effect": "ok true: return successStatus; missing ok or false: refusal path"
    },
    {
     "at": "+1",
     "cond": "?? false",
     "effect": "a reply without an ok key is treated as refused"
    },
    {
     "at": "+3",
     "cond": "errorCode == needsUnlock and refusalText non-nil",
     "effect": "true: return the unlock prompt without the \"iPhone:\" prefix; false: continue"
    },
    {
     "at": "+5",
     "cond": "worded ?? error ?? 'unknown error'",
     "effect": "worded code text if known, else phone's error string, else localized \"unknown error\"; result prefixed \"iPhone: \""
    }
   ],
   "flags": [],
   "deps": {
    "EmuquWatch Watch App/WatchMessageDecoding.swift::func WatchMessageDecoding.refusalText(code:sport:)": "0dc15636bbf84cb2"
   }
