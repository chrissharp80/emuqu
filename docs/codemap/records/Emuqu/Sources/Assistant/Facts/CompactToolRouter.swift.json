   "key": "func CompactToolRouter.resolveReadTool(name:argsJSON:)",
   "hash": "3cf1208204a8949c",
   "does": "Parses argsJSON to [String:String]; if the name is in the uniform table, awaits that resolver; otherwise handles get_today, get_vitals, get_healthkit and lookup_fact directly via registry.resolveAsync; returns nil for any other name.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Assistant/Facts/CompactToolRouter+Resolvers.swift::func CompactToolRouter.parseArgs(_:)",
    "Emuqu/Sources/Assistant/Facts/CompactToolRouter.swift::var CompactToolRouter.uniformReadResolvers",
    "Emuqu/Sources/Assistant/Facts/FactResolverRegistry.swift::func FactResolverRegistry.resolveAsync(_:)",
    "Emuqu/Sources/Assistant/Facts/CompactToolRouter.swift::func CompactToolRouter.resolveHealthKitTool(field:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "name is one of the 17 uniform read tools",
     "effect": "awaits that resolver with the parsed args and returns its value"
    },
    {
     "at": "+6",
     "cond": "name == get_today",
     "effect": "resolves 'recovery.today.full'"
    },
    {
     "at": "+8",
     "cond": "name == get_vitals",
     "effect": "see 487"
    },
    {
     "at": "+9",
     "cond": "args has no 'date'",
     "effect": "returns .missing(.invalidParameter,'get_vitals requires date'); otherwise resolves 'vitals.by_date(<date>)' with the raw date string interpolated"
    },
    {
     "at": "+11",
     "cond": "name == get_healthkit",
     "effect": "calls resolveHealthKitTool with args['field']"
    },
    {
     "at": "+12",
     "cond": "args['field'] absent",
     "effect": "?? fallback '' → resolveHealthKitTool returns .missing(invalidParameter)"
    },
    {
     "at": "+13",
     "cond": "name == lookup_fact",
     "effect": "see 492"
    },
    {
     "at": "+14",
     "cond": "args has no 'key'",
     "effect": "returns .missing(.invalidParameter,'lookup_fact requires key'); otherwise resolves the raw key via registry.resolveAsync (actions are skipped by that path)"
    },
    {
     "at": "+16",
     "cond": "default: any other name",
     "effect": "returns nil so resolveTool forwards to registry.resolveTool"
    }
   ],
