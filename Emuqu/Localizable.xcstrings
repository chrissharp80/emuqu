            "value" : "Dein Training war diese Woche von Tag zu Tag ungewöhnlich gleichförmig"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu entrenamiento ha sido inusualmente similar día a día esta semana"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harjoittelusi on ollut tällä viikolla epätavallisen samankaltaista päivästä toiseen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre entraînement a été exceptionnellement similaire d'un jour à l'autre cette semaine"
