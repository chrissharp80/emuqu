    "Clip it into the armband and wear snugly on your forearm or upper arm" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّته في شريط الذراع وارتدِه بإحكام على ساعدك أو أعلى ذراعك"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sæt den i armbåndet, og bær den tætsiddende på underarmen eller overarmen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clip ihn in das Armband und trag ihn eng anliegend am Unter- oder Oberarm"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engánchalo al brazalete y llévalo ajustado en el antebrazo o la parte superior del brazo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiinnitä se käsivarsinauhaan ja pidä tiukasti kyynärvarressa tai olkavarressa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clipsez-le dans le brassard et portez-le bien ajusté sur l’avant-bras ou le haut du bras"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smelltu honum í armbandið og hafðu hann þéttan á framhandlegg eða upphandlegg"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggancialo alla fascia da braccio e indossalo ben aderente sull'avambraccio o sulla parte superiore del braccio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アームバンドに取り付け、前腕または上腕にぴったりと装着します"
