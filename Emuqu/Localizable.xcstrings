          }
        }
      }
    },
    "Your sleep was significantly shorter than your goal. Try to get to bed earlier tonight to recover." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كان نومك أقصر بكثير من هدفك. حاول النوم مبكرًا الليلة لتتعافى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din søvn var markant kortere end dit mål. Prøv at komme tidligere i seng i nat for at restituere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Schlaf war deutlich kürzer als dein Ziel. Geh heute Nacht früher ins Bett, um dich zu erholen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sueño fue bastante más corto que tu objetivo. Intenta acostarte antes esta noche para recuperarte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unesi jäi selvästi tavoitettasi lyhyemmäksi. Yritä mennä aiemmin nukkumaan tänä yönä palautuaksesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre sommeil a été nettement plus court que votre objectif. Couchez-vous plus tôt ce soir pour récupérer."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Svefninn þinn var talsvert styttri en markmiðið. Reyndu að fara fyrr að sofa í kvöld til að ná þér."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai dormito nettamente meno del tuo obiettivo. Prova ad andare a letto prima stanotte per recuperare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠が目標より大幅に短くなりました。回復のため今夜は早めに就寝しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면이 목표보다 크게 부족했습니다. 회복을 위해 오늘 밤은 더 일찍 잠자리에 드세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Søvnen din var betydelig kortere enn målet. Prøv å legge deg tidligere i natt for å restituere."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je sliep flink korter dan je doel. Ga vanavond eerder naar bed om te herstellen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu sono foi bem mais curto que a meta. Tente dormir mais cedo hoje para se recuperar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш сон оказался заметно короче цели. Сегодня лягте раньше, чтобы восстановиться."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din sömn var betydligt kortare än ditt mål. Försök gå och lägga dig tidigare i natt för att återhämta dig."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的睡眠明显短于目标。今晚试着早点上床以便恢复。"
          }
        }
      }
    },
    "Your strap disconnected before sleep. Rate how you feel so we can estimate your recovery." : {
      "comment" : "Message displayed in a Slider card when HRV data quality is poor (pre-sleep).",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع اتصال الحزام قبل النوم. قيّم شعورك حتى نتمكن من تقدير تعافيك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit pulsbælte blev afbrudt inden søvn. Vurdér hvordan du har det, så vi kan estimere din restitution."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Gurt hat sich vor dem Einschlafen getrennt. Bewerte dein Befinden, damit wir deine Erholung schätzen können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu banda se desconectó antes de dormir. Valora cómo te sientes para que podamos estimar tu recuperación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pantasi katkesi ennen nukahtamista. Arvioi olotilasi, jotta voimme arvioida palautumisesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre ceinture s’est déconnectée avant le sommeil. Évaluez vos sensations pour que nous estimions votre récupération."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ólin þín aftengdist fyrir svefn. Metið hvernig ykkur líður svo við getum áætlað endurheimtina."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fascia si è disconnessa prima del sonno. Valuta come ti senti così possiamo stimare il tuo recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就寝前にストラップの接続が切れました。回復を推定できるよう、体感を評価してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수면 전에 스트랩 연결이 끊겼습니다. 회복을 추정할 수 있도록 컨디션을 평가해 주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsbeltet ditt koblet fra før søvn. Vurder hvordan du føler deg så vi kan anslå restitusjonen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je band verbrak de verbinding vóór het slapen. Beoordeel hoe je je voelt zodat we je herstel kunnen schatten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua cinta desconectou antes de você dormir. Avalie como se sente para estimarmos sua recuperação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Датчик отключился до сна. Оцените самочувствие, чтобы мы могли оценить ваше восстановление."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt pulsband kopplade från före sömnen. Skatta hur du känner dig så kan vi uppskatta din återhämtning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心率带在你入睡前断开了。请自评感受，以便我们估算你的恢复。"
          }
        }
      }
    },
    "Your streamed data is safe. Device backup is optional." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بياناتك المُرسلة آمنة. النسخ الاحتياطي من الجهاز اختياري."
