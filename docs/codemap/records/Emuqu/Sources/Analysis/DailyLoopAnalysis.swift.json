   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+3",
     "cond": "workoutSession != nil && hrvZScore != nil",
     "effect": "false: .undetermined; true: switch"
    },
    {
     "at": "+5",
     "cond": "case (true,false,.easy)",
     "effect": "returns isCumulativelyLoaded ? .absorbing : .underloading"
    },
    {
     "at": "+7",
     "cond": "isCumulativelyLoaded ?:",
     "effect": "true: .absorbing; false: .underloading"
    },
    {
     "at": "+8",
     "cond": "case (true,false,.moderate|.hard)",
     "effect": ".absorbing"
    },
    {
     "at": "+10",
     "cond": "case (false,false,_)",
     "effect": ".sustainable"
    },
    {
     "at": "+12",
     "cond": "case (false,true,.easy)",
     "effect": ".backedOff"
    },
    {
     "at": "+14",
     "cond": "case (false,true,.moderate|.hard)",
     "effect": ".highStrain"
    },
    {
     "at": "+16",
     "cond": "default",
