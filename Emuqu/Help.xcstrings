          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Электродам для проводимости нужна влага. Сухие электроды = шумный сигнал = плохие данные. Достаточно нескольких капель воды."
          }
        },
        "sv" : {
          "stringUnit" : {
