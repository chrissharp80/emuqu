    "Off" : {
      "comment" : "\"Off\" is the label shown when the Polar strap is not connected, but the app thinks it is. This can happen if the user unpairs the strap, then closes and reopens the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
