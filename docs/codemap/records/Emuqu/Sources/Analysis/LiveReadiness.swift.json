  {
   "key": "func LiveReadiness.interpolatedLoad(morningSession:live:hoursSinceMorning:)",
   "hash": "e760e9d395ae6592",
   "does": "Interpolates ATL and CTL linearly from the session's frozen training snapshot (or analysisResult.trainingContext) to live values by hours/24 (clamped 0..1), computes ACR, picks morning ATL as freshness anchor unless a full day has passed, and carries the frozen morning ATL/CTL for morningReadiness.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+6",
     "cond": "trainingSnapshot nil (?? fallback)",
     "effect": "use analysisResult.trainingContext; both nil → morningContext nil"
    },
    {
     "at": "+7",
     "cond": "morningContext nil (?? 0)",
     "effect": "morningATL = 0 (and morningCTL = 0 at 172), so early-day ATL/CTL are pulled toward 0"
    },
    {
     "at": "+8",
     "cond": "morningContext nil (?? 0)",
     "effect": "morningCTL = 0"
    },
    {
     "at": "+19",
     "cond": "effectiveCTL > 0",
     "effect": "acr = ATL/CTL; else nil"
    },
    {
     "at": "+20",
     "cond": "dayFraction >= 1",
     "effect": "freshness anchor = interpolated ATL (bonus collapses to 0); else morningATL"
    }
   ],
   "deps": {
    "Emuqu/Sources/Assistant/Context/ContextBuilder.swift::func ContextBuilder.trainingSnapshot(session:fallback:)": "17877eae6dbfa445",
    "EmuquTests/TrainingAdviceGateTests.swift::var TrainingAdviceGateTests.Scenario.atl": "2847e9aa622619f6"
   }
  },
