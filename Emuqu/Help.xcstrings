        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als de AI traag is, weigert of slechte antwoorden geeft"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando a IA está lenta, se recusa a responder ou dá respostas ruins"
