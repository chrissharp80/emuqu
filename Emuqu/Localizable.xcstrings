          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш пульс покоя снижается — хороший признак сердечно-сосудистой адаптации."
          }
        },
        "sv" : {
          "stringUnit" : {
