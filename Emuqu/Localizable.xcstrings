        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Herstel:** Je hartslag daalde %lld bpm in de eerste minuut na de piek (%lld → %lld) en %lld bpm na twee minuten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Recuperação:** Sua FC caiu %lld bpm no primeiro minuto após o pico (%lld → %lld) e %lld bpm em dois minutos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Восстановление:** пульс снизился на %lld уд/мин за первую минуту после пика (%lld → %lld) и на %lld уд/мин за две минуты."
