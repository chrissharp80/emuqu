    "First-half vs second-half ratio of (pace ÷ HR). Values < 5 % indicate aerobic stability; > 7 % suggests cardiac drift from hydration / fuel / heat demand." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسبة النصف الأول إلى النصف الثاني لـ (الوتيرة ÷ النبض). القيم أقل من 5 % تدل على ثبات هوائي؛ وأكثر من 7 % توحي بانجراف قلبي بسبب الترطيب أو التغذية أو الحرارة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forholdet mellem første og anden halvdel af (tempo ÷ puls). Værdier < 5 % indikerer aerob stabilitet; > 7 % tyder på kardiel drift fra væske-, energi- eller varmebehov."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhältnis der ersten zur zweiten Hälfte von (Pace ÷ HF). Werte < 5 % zeigen aerobe Stabilität; > 7 % deuten auf kardialen Drift durch Flüssigkeits-, Energie- oder Hitzebedarf hin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razón entre la primera y la segunda mitad de (ritmo ÷ FC). Valores < 5 % indican estabilidad aeróbica; > 7 % sugieren deriva cardíaca por hidratación, energía o calor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ensimmäisen ja toisen puoliskon suhde arvosta (vauhti ÷ syke). Alle 5 % kertoo aerobisesta vakaudesta; yli 7 % viittaa sykkeen ryömintään nesteytyksen, energian tai kuumuuden vuoksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapport première/seconde moitié de (allure ÷ FC). Des valeurs < 5 % indiquent une stabilité aérobie ; > 7 % suggère une dérive cardiaque due à l’hydratation, au ravitaillement ou à la chaleur."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlutfall fyrri og seinni helmings af (hraði ÷ púls). Gildi undir 5 % benda til loftháðs stöðugleika; yfir 7 % bendir til hjartareks vegna vökva, næringar eða hita."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rapporto tra prima e seconda metà di (passo ÷ FC). Valori < 5 % indicano stabilità aerobica; > 7 % suggerisce deriva cardiaca da idratazione, alimentazione o caldo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（ペース ÷ 心拍）の前半と後半の比。5 % 未満は有酸素的な安定を示し、7 % 超は水分・補給・暑熱の要求による心拍ドリフトを示唆します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(페이스 ÷ 심박)의 전반부 대 후반부 비율. 5 % 미만은 유산소 안정성을, 7 % 초과는 수분·연료·더위로 인한 심박 드리프트를 시사합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forholdet mellom første og andre halvdel av (fart ÷ puls). Verdier < 5 % indikerer aerob stabilitet; > 7 % tyder på kardial drift fra væske-, energi- eller varmebehov."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verhouding eerste helft versus tweede helft van (tempo ÷ hartslag). Waarden < 5 % duiden op aerobe stabiliteit; > 7 % wijst op cardiale drift door hydratatie, voeding of hitte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razão entre primeira e segunda metade de (ritmo ÷ FC). Valores < 5 % indicam estabilidade aeróbia; > 7 % sugerem deriva cardíaca por hidratação, energia ou calor."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отношение первой и второй половины величины (темп ÷ пульс). Значения < 5 % указывают на аэробную стабильность; > 7 % — на кардиальный дрейф из-за жидкости, питания или жары."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvoten mellan första och andra halvan av (tempo ÷ puls). Värden < 5 % indikerar aerob stabilitet; > 7 % tyder på kardiell drift från vätska, energi eller värme."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（配速 ÷ 心率）在前半程与后半程的比值。低于 5 % 表示有氧稳定；高于 7 % 则提示因补水、补给或高温需求造成的心率漂移。"
          }
        }
      }
    },
