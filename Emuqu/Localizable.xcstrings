    "Writes detected sleep to Health only when Health has none for that night." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكتب النوم المكتشَف إلى صحتي فقط عندما لا يحتوي صحتي على بيانات لتلك الليلة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skriver kun registreret søvn til Health, når Health ikke har noget for den nat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt erkannten Schlaf nur dann in Health, wenn Health für diese Nacht keine Daten hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe el sueño detectado en Salud solo cuando Health no tiene datos de esa noche."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjoittaa havaitun unen Health-sovellukseen vain, kun Healthissa ei ole tietoja kyseiseltä yöltä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N'écrit le sommeil détecté dans Santé que lorsque Santé n'a aucune donnée pour cette nuit-là."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skrifar greindan svefn í Health aðeins þegar Health hefur engin gögn fyrir þá nótt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrive il sonno rilevato in Health solo quando Health non ha dati per quella notte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルスケアにその夜のデータがない場合にのみ、検出した睡眠を ヘルスケアに書き込みます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Health에 해당 날 밤의 데이터가 없을 때만 감지된 수면을 Health에 기록합니다."
          }
        },
        "nb" : {
