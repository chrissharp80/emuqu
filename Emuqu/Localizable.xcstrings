    "DFA α1 averaged %@ — the hard efforts pulled it below 0.50, so this counts as a hard day." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلغ متوسط DFA α1 ‏%@ — الجهود الشاقة خفّضته إلى ما دون 0.50، لذا يُعد هذا يومًا شاقًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DFA α1 lå i gennemsnit på %@ — de hårde indsatser trak den under 0,50, så det tæller som en hård dag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DFA α1 lag im Schnitt bei %@ – die harten Belastungen haben ihn unter 0,50 gedrückt, das zählt als harter Tag."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El DFA α1 promedió %@: los esfuerzos duros lo bajaron de 0,50, así que cuenta como día duro."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DFA α1:n keskiarvo oli %@ – kovat vedot painoivat sen alle 0,50, joten tämä lasketaan kovaksi päiväksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le DFA α1 était en moyenne de %@ — les efforts intenses l'ont fait passer sous 0,50, c'est donc une journée dure."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DFA α1 var að meðaltali %@ — erfiðu átökin drógu það undir 0,50, svo þetta telst erfiður dagur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il DFA α1 ha avuto una media di %@ — gli sforzi intensi l'hanno portato sotto 0,50, quindi conta come giornata dura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DFA α1の平均は%@ — 高強度の努力で0.50を下回ったため、ハードな日に数えられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DFA α1 평균이 %@였습니다. 강한 노력으로 0.50 아래로 떨어졌으니 힘든 날로 봅니다."
