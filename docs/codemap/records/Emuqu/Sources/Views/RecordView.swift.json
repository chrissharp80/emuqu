   "key": "func RecordView.restoreCaptureMode()",
   "hash": "fec4ea0fab2cef36",
   "does": "On appear: if paused and a persisted capture-mode flag exists, restores .both/.streaming from it; else if not overnight streaming, loads the user's default capture mode from settings (fallback .both for an unknown raw value); then coerces .both away for a Verity Sense.",
   "entry": "onAppear of body.",
   "calls": [
    "Emuqu/Sources/Collection/RRCollector+Lifecycle.swift::func RRCollector.getPersistedCaptureMode()",
    "Emuqu/Sources/Views/RecordView.swift::func RecordView.coerceCaptureModeForDevice()"
   ],
   "reads": [
    "mem:StreamingLifecycle.isPaused",
    "mem:StreamingLifecycle.isOvernightStreaming",
    "ud:RRCollector.persistedRecordingState",
    "file:user_settings.json (defaultCaptureMode)"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "streamingLifecycle.isPaused && persisted useDeviceInternalBackup != nil",
     "effect": "true: go to 228; false: check 229"
    },
    {
     "at": "+3",
     "cond": "useBackup",
     "effect": "true: extendedCaptureMode=.both; false: .streaming (internalCapture never restored)"
    },
    {
     "at": "+4",
     "cond": "!isOvernightStreaming",
     "effect": "true: load settings.defaultCaptureMode; false (actively streaming overnight): keep current @State (fresh view = .both even if the night is streaming-only)"
    },
    {
     "at": "+6",
     "cond": "ExtendedCaptureMode(rawValue:) ?? .both",
     "effect": "unknown/garbage stored raw value falls back to .both"
    }
   ],
   "deps": {
    "Emuqu/Sources/Collection/RRCollector+Forwarders.swift::var RRCollector.isOvernightStreaming": "93ba4e78eaebe055",
