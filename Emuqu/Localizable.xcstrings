            "value" : "케이던스 %lld — 건강한 범위 165–190 밖"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "kadens %lld — utenfor det sunne området 165–190"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "cadans %lld — buiten de gezonde band van 165–190"
          }
        },
        "pt-BR" : {
