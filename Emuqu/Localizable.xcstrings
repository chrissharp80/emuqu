    "HF power as a percentage of total LF+HF power. Removes VLF influence and normalizes for comparison." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قدرة HF كنسبة مئوية من إجمالي قدرة LF+HF. تزيل تأثير VLF وتُطبّع القيم للمقارنة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HF-effekt som procentdel af den samlede LF+HF-effekt. Fjerner VLF-indflydelse og normaliserer for sammenligning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HF-Leistung als Prozentsatz der Gesamtleistung LF+HF. Entfernt den VLF-Einfluss und normalisiert für Vergleiche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potencia HF como porcentaje de la potencia total LF+HF. Elimina la influencia de VLF y normaliza para comparar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HF-teho prosentteina kokonaistehosta LF+HF. Poistaa VLF:n vaikutuksen ja normalisoi vertailua varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puissance HF en pourcentage de la puissance totale LF+HF. Supprime l’influence VLF et normalise pour la comparaison."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HF-afl sem hlutfall af heildarafli LF+HF. Fjarlægir áhrif VLF og staðlar til samanburðar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potenza HF come percentuale della potenza totale LF+HF. Rimuove l’influenza VLF e normalizza per il confronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LF+HF の総パワーに対する HF パワーの割合。VLF の影響を除き、比較のために正規化します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "총 LF+HF 파워 대비 HF 파워의 백분율. VLF 영향을 제거하고 비교를 위해 정규화합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HF-effekt som prosent av samlet LF+HF-effekt. Fjerner VLF-påvirkning og normaliserer for sammenligning."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HF-vermogen als percentage van het totale LF+HF-vermogen. Verwijdert VLF-invloed en normaliseert voor vergelijking."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potência HF como porcentagem da potência total LF+HF. Remove a influência de VLF e normaliza para comparação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мощность HF в процентах от суммарной мощности LF+HF. Убирает влияние VLF и нормализует для сравнения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HF-effekt som andel av total LF+HF-effekt. Tar bort VLF-påverkan och normaliserar för jämförelse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HF 功率占 LF+HF 总功率的百分比。剔除 VLF 影响并归一化以便比较。"
          }
        }
      }
    },
