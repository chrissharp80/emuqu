   ],
   "reads": [
    "mem:SettingsManager.settings.dailyReportEnabled (read by rescheduleIfNeeded through AppDependencies.current, MorningNotificationScheduler.swift)",
    "mem:SettingsManager.settings.dailyReportFixedTime"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "newValue is true (report enabled)",
     "effect": "requests authorization and updates systemAuthDenied before rescheduling; false → only reschedules (which cancels)"
