   "key": "func ToolRetriever.stem(_:)",
   "hash": "57f031e9f8eeb6f4",
   "does": "Light suffix stripping: tokens ≥4 chars lose the first matching suffix of ['ing','ed','s','ly'] when at least 3 chars remain; after 'ing'/'ed' a doubled final b/d/g/m/n/p/t is undone (running → run, stopped → stop; falling stays fall). 'es' is not stripped, so times/zones/rates stem like time/zone/rate.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Assistant/Facts/ToolRetriever.swift::func ToolRetriever.undoubled(_:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "token.count < 4",
     "effect": "returns token unchanged"
    },
    {
     "at": "+2",
     "cond": "first of ing, ed, s, ly that is a suffix and leaves > 2 chars",
     "effect": "strips it; 'ing'/'ed' bases go through undoubled; none: token unchanged"
    },
    {
     "at": "+4",
     "cond": "suffix is ing or ed",
     "effect": "undoubled(base); else base"
    }
   ],
   "deps": {
