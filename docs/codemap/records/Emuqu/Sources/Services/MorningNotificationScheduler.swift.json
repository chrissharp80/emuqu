    "Emuqu/Sources/Services/MorningNotificationScheduler.swift::func MorningNotificationScheduler.deliverImmediately(title:body:today:sleepEnd:)"
   ],
   "reads": [
    "mem:AppDependencies.current.app.settingsManager.settings"
   ],
   "writes": [
    "ud:MorningNotificationScheduler.wakeSettled.v1"
   ],
   "branches": [
    {
     "at": "+2",
     "cond": "daily report disabled or delivery not .smart",
     "effect": "return"
    },
    {
     "at": "+5",
     "cond": "not authorized/provisional/ephemeral",
     "effect": "return"
    },
    {
     "at": "+7",
     "cond": "turned off while the authorization check awaited",
     "effect": "return"
    },
    {
     "at": "+9",
     "cond": "not a morning wake or claim fails (settled today / sleepEnd older than 90 min or in future)",
     "effect": "return"
    },
    {
     "at": "+14",
     "cond": "replacement claim and still no reading",
     "effect": "leave the day open, return without sending"
    }
   ],
