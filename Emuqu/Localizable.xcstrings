    "For daytime checks, post-workout recovery, or if you can't do overnight" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للفحوصات النهارية أو التعافي بعد التمرين أو إذا لم تستطع القيام بذلك أثناء الليل"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til dagskontrol, restitution efter træning, eller hvis du ikke kan tage natteoptagelse"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Tagesmessungen, Erholung nach dem Training oder wenn eine Nachtmessung nicht möglich ist"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para comprobaciones diurnas, recuperación post-entrenamiento, o si no puedes hacerlo durante la noche"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päiväseurantaan, harjoituksen jälkeiseen palautumiseen tai jos et voi mitata yön aikana"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les vérifications en journée, la récupération post-entraînement, ou si vous ne pouvez pas faire de mesure nocturne"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fyrir dagsmælingar, bata eftir æfingu eða ef þú getur ekki mælt yfir nótt"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per controlli diurni, recupero post-allenamento o se non è possibile effettuare il monitoraggio notturno"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日中のチェック、ワークアウト後の回復、または夜間記録ができない場合"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주간 확인, 운동 후 회복, 또는 야간 측정이 불가할 때 사용"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For dagtidskontroller, restitusjon etter trening, eller hvis du ikke kan gjøre nattopptak"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor controles overdag, herstel na training, of als u geen nachtmeting kunt doen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para verificações diurnas, recuperação pós-treino ou se você não pode fazer a noturna"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для дневных проверок, восстановления после тренировки или если ночная запись невозможна"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
