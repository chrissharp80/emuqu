    "%@ recording from %@ was interrupted. Your beats are backed up." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت مقاطعة تسجيل %1$@ الذي بدأ %2$@. نبضاتك محفوظة احتياطيًا."
