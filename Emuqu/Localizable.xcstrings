    "Deep sleep made up a typical share of the night." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شكّل النوم العميق حصة معتادة من الليل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dyb søvn udgjorde en typisk andel af natten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefschlaf machte einen typischen Anteil der Nacht aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sueño profundo ocupó una parte típica de la noche."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syvän unen osuus yöstä oli tyypillinen."
          }
        },
        "fr" : {
          "stringUnit" : {
