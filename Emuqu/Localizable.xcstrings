    "TSB %@ — fresh, ready for quality work." : {
      "comment" : "\"TSB\" is a term I made up to describe The argument is the string “%+.1f”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
