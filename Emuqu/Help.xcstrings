          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱에서 기록으로 이동해 기기 검색을 탭하세요 — 몇 초 안에 나타날 것입니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå til Opptak i appen og trykk Søk etter enheter — den bør dukke opp i løpet av sekunder"
          }
        },
        "nl" : {
          "stringUnit" : {
