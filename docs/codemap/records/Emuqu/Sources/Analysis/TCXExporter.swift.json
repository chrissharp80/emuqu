   "key": "func HRTrack.median(near:)",
   "hash": "27727e77aeb11d7d",
   "does": "Moves a start index back while the reading before it is still inside the window (a query earlier than the last) and forward past readings older than offset−3 s, collects readings up to offset+3 s, and returns their (upper) median; nil when none. Readings are sorted at init, so any query order is answered correctly; in-order queries stay linear.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "reading before start is within the window",
     "effect": "move start back"
    },
    {
     "at": "+2",
     "cond": "reading older than window",
     "effect": "advance start"
    },
    {
     "at": "+5",
     "cond": "reading within window",
     "effect": "collect"
    },
    {
     "at": "+9",
     "cond": "window empty",
     "effect": "nil; else sorted[count/2]"
    }
   ],
