  {
   "key": "func WorkoutLiveTrends.kilometreSplits(_:)",
   "hash": "49e076272155ea61",
   "does": "Walks samples and emits a split every time cumulative distance advances >= 1000 m from the split start: raw pace = elapsed sec / km; grade = rise over run from the split's start altitude to the last known altitude (carried forward), where the run is measured from the sample that supplied the start altitude (altDist) — the split start, or, when that had no altitude yet, the first later sample that has one.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Analysis/WorkoutLiveTrends.swift::func WorkoutLiveTrends.splitGrade(from:to:run:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+4",
     "cond": "for each sample",
     "effect": "iterates all samples"
    },
    {
     "at": "+5",
     "cond": "sample has no distanceMeters",
     "effect": "skip sample (continue)"
    },
    {
     "at": "+6",
     "cond": "altitudeMeters ?? lastAlt",
     "effect": "nil altitude carries the previous known altitude forward"
    },
    {
     "at": "+7",
     "cond": "split start altitude still nil and an altitude is now known",
     "effect": "set start altitude to lastAlt and altDist to this sample's distance"
    },
    {
     "at": "+12",
     "cond": "run since split start < 1000 m",
     "effect": "continue; else append split (grade over d - altDist) and reset start, altDist to this sample"
    }
   ],
   "deps": {
    "Emuqu/Sources/Analysis/WorkoutLiveTrends.swift::func WorkoutLiveTrends.splitGrade(from:to:run:)": "8da4adf2edd59f8c"
   }
  },
