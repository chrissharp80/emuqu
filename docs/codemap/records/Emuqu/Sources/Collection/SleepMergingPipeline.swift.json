   "key": "func SleepMergingPipeline.splitByGaps(_:gap:startOf:endOf:)",
   "hash": "92300686113ae40e",
   "does": "Sorts items by start and groups them, starting a new group when an item's start is >= gap seconds after the latest end seen in the current group (so an item nested inside a longer overlapping one does not open a false gap).",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+7",
     "cond": "no items",
     "effect": "returns []"
    },
    {
     "at": "+12",
     "cond": "loop over remaining sorted items",
     "effect": "each item either joins or starts a group"
    },
    {
     "at": "+13",
     "cond": "gap from the group's latest end to this item's start >= gap",
     "effect": "close current group, start a new one (latest end reset); otherwise append and extend the latest end"
    }
   ],
   "flags": [],
   "deps": {}
