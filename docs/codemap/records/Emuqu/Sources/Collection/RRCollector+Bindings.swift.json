   "hash": "bccd85332e299564",
   "does": "Pure off-main: among overnight archive entries whose end (entry.endDate, else its start) is within maxGap, returns the first paused session paused within maxGap, else the first complete one ended within maxGap. Filtering by the end, not the start, finds a night paused or finished minutes ago that began hours earlier.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Storage/Archive+StoreForwarding.swift::var SessionArchive.entries",
    "Emuqu/Sources/Storage/Archive.swift::func SessionArchive.retrieveLightweightOrLog(_:caller:)"
   ],
   "reads": [
    "archive:entries",
    "archive:session (lightweight)"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "maxGap <= 0",
     "effect": "returns nil"
    },
    {
     "at": "+7",
     "cond": "entry ended (endDate ?? date) before now - maxGap",
     "effect": "not loaded"
    },
    {
     "at": "+10",
     "cond": "paused session pausedDate nil",
     "effect": "treated as distantPast → excluded"
    },
    {
     "at": "+12",
     "cond": "a paused candidate exists",
     "effect": "returns it (paused wins)"
    },
    {
     "at": "+14",
     "cond": "complete session endDate nil",
     "effect": "treated as distantPast → excluded; none → nil"
    }
   ],
