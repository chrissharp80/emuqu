{
 "file": "Emuqu/Sources/Views/MorningResultsCharts.swift",
 "hash": "acf68b4ce9c02e66",
 "role": "Canvas-drawn HRV charts for the session detail screen (SessionHRVDetailView): Poincaré plot, RR tachogram, LF/HF stacked frequency bar with legend, heart-rate trace, plus file-scope helpers: window clamping, Poincaré pair extraction (poincareBeatPairs, internal so other renderers can share it), touch hit-testing, time labels, grid, trace paths, and the ScrubbableWindowChart frame (axis + hold-then-drag crosshair tooltip) the tachogram and HR chart share.",
 "types": [
  "PoincareGeometry: struct (private) — square plot geometry and RR→pixel scaling for the Poincaré plot",
  "PoincarePlotView: struct View — Poincaré scatter of consecutive non-artifact RR pairs with SD1/SD2 ellipse",
  "TachogramView: struct View — RR interval trace over the analysis window with press-and-drag crosshair tooltip",
  "FrequencyBandsView: struct View — VLF/LF/HF stacked bar + legend",
  "LegendItem: struct View — coloured dot + label/value pair",
  "HeartRateChartView: struct View — artifact-free bpm trace over the analysis window with mean line and crosshair tooltip",
  "ScrubbableWindowChart<Chart>: struct View (private) — chart over the window's time axis with a hold-then-drag crosshair and value tooltip; used by TachogramView and HeartRateChartView",
  "ChartXAxisLabels: struct View (private) — 5 wall-clock tick labels under the tachogram/HR chart"
 ],
