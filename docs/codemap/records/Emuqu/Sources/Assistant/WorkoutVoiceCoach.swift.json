   ],
   "reads": [
    "mem:SettingsManager.settings (coachAlertsEnabled, enableMileMarkerNotifications, enableTurnByTurnAlerts, enableTurnMarkerUpdates)",
    "mem:WorkoutVoiceCoach.isMuted"
   ],
   "writes": [
    "mem:WorkoutTriggerEngine history/cooldowns (via evaluate)"
   ],
   "branches": [
    {
     "at": "+4",
     "cond": "canSpeak (coachAlertsEnabled && !isMuted)",
     "effect": "true → every event from engine.evaluate is passed to dispatch(event:); false → events are discarded (non-spoken ones still consumed cooldowns and sit in engine history; spoken rules did not fire)."
    },
    {
     "at": "+5",
     "cond": "for each event in events",
     "effect": "dispatch each in order; empty array → nothing."
    },
    {
     "at": "+10",
     "cond": "enableTurnByTurnAlerts || enableTurnMarkerUpdates (both default false)",
     "effect": "true → tickRouteEngines; false → route engines skipped, ActiveRouteSession step index is not advanced by the coach."
