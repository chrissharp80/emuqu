      }
    },
    "Your recovery capacity is trending upward — keep doing what you're doing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قدرتك على التعافي في اتجاه صاعد — واصل ما تفعله."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din restitutionsevne er på vej op — bliv ved med det, du gør."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Erholungsfähigkeit zeigt nach oben — mach weiter so."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu capacidad de recuperación va en aumento — sigue así."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Palautumiskykysi on nousussa — jatka samaan malliin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre capacité de récupération est en hausse — continuez ainsi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endurheimtargeta þín er á uppleið — haltu áfram því sem þú ert að gera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua capacità di recupero è in crescita — continua così."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回復力が上向いています — 今の取り組みを続けましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회복 능력이 상승 추세입니다 — 지금처럼 계속하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restitusjonsevnen din er på vei opp — fortsett med det du gjør."
          }
        },
        "nl" : {
          "stringUnit" : {
