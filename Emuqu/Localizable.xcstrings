    "Your session data has been restored. Go to the Record tab to resume or finish." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت استعادة بيانات جلستك. انتقل إلى علامة التبويب تسجيل للاستئناف أو الإنهاء."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine sessionsdata er blevet gendannet. Gå til fanen Optag for at genoptage eller afslutte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Sitzungsdaten wurden wiederhergestellt. Geh zum Aufnahme-Tab, um fortzusetzen oder abzuschließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de tu sesión han sido restaurados. Ve a la pestaña Grabar para reanudar o finalizar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istuntotietosi on palautettu. Siirry Tallenna-välilehdelle jatkaaksesi tai lopettaaksesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les données de votre session ont été restaurées. Allez dans l'onglet Enregistrer pour reprendre ou terminer."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lotugögnin þín hafa verið endurheimtuð. Farðu í Taka upp-flipann til að halda áfram eða ljúka."
