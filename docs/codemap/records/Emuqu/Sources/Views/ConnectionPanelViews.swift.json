{
 "file": "Emuqu/Sources/Views/ConnectionPanelViews.swift",
 "hash": "9edd356eaa5f7a5e",
 "role": "Record-screen Polar strap connection panel: routes on PolarManager.connectionState to disconnected (known devices + scan, Bluetooth-denied banner), scanning (discovered list), connecting (cancel) and connected (device info + disconnect) sub-views; also hosts the shared ConnectionStatusBadge text/color mapping.",
 "types": [
  "ConnectionPanel: struct — outer panel (used by RecordView+Sections.swift:97)",
  "ConnectionPanelHeader: struct (private) — device name + status badge",
  "ConnectionStatusBadge: enum — (color,text) for connection state + feed health; also used by SensorManagementSheet and WorkoutPreflightView",
  "ConnectionPanelDisconnected: struct (private) — known devices, scan, Bluetooth-denied banner",
  "ConnectionPanelScanning: struct (private) — discovered devices + stop",
  "ConnectionPanelConnected: struct (private) — device id, on-device recording badge, DeviceInfoPanelObserving, disconnect",
  "KnownDeviceRow: struct (private) — swipe-to-delete known device row"
 ],
 "state": [
  "@State ConnectionPanelDisconnected.btAuthorization (CBCentralManager.authorization)",
  "@State KnownDeviceRow.offset / revealed",
  "KnownDeviceRow.deleteWidth = 70"
 ],
