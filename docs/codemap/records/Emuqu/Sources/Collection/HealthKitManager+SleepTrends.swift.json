    "Emuqu/Sources/Utilities/DebugLog.swift::func debugLog(_:level:file:line:)",
    "Emuqu/Sources/Collection/HealthKitManager.swift::var HealthKitManager.isHealthKitAvailable"
   ],
   "reads": [
    "hk:sleepAnalysis"
   ],
   "writes": [
    "hk:sleepAnalysis"
   ],
   "branches": [
    {
     "at": "+1",
     "cond": "HealthKit unavailable",
     "effect": "throws notAvailable"
    },
    {
     "at": "+2",
     "cond": "sleepStart or sleepEnd nil",
     "effect": "logs 'No sleep boundaries' and returns without writing"
    },
    {
     "at": "+6",
     "cond": "no stage intervals AND 0 night-sleep minutes",
     "effect": "logs 'empty' and returns"
    },
    {
     "at": "+10",
     "cond": "sleepAnalysis type nil",
     "effect": "throws typeUnavailable"
    },
    {
     "at": "+15",
     "cond": "inBedStart nil",
     "effect": "?? sleepStart — inBed sample starts at sleepStart"
    },
    {
     "at": "+17",
     "cond": "no samples built (all intervals invalid)",
     "effect": "returns; the previous export stays in Health"
    }
   ],
   "flags": [],
