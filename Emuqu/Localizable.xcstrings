        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säilytetään iPhonessasi ja yksityisessä iCloudissasi. Emuqulla ei ole omia palvelimia."
          }
        },
        "fr" : {
          "stringUnit" : {
