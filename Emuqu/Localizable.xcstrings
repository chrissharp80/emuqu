    "Sorry — I didn't finish that answer. Mind asking again, or rephrasing it?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عذرًا — لم أُكمل تلك الإجابة. هل تمانع أن تسأل مرة أخرى أو تعيد صياغة السؤال؟"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beklager — jeg nåede ikke at færdiggøre det svar. Vil du spørge igen eller omformulere det?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorry — ich konnte die Antwort nicht abschließen. Fragst du noch einmal oder formulierst es anders?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo siento, no terminé esa respuesta. ¿Puedes volver a preguntar o reformularlo?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteeksi — en saanut vastausta valmiiksi. Voisitko kysyä uudelleen tai muotoilla kysymyksen toisin?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désolé, je n’ai pas terminé cette réponse. Pouvez-vous reposer la question ou la reformuler ?"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Því miður — ég kláraði ekki svarið. Viltu spyrja aftur eða orða það öðruvísi?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scusa, non ho completato quella risposta. Puoi chiedere di nuovo o riformulare la domanda?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すみません、回答を最後まで作成できませんでした。もう一度質問するか、言い換えてみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "죄송합니다. 답변을 끝내지 못했어요. 다시 질문하거나 다르게 표현해 주시겠어요?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beklager – jeg fikk ikke fullført det svaret. Vil du spørre igjen eller omformulere det?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorry, ik heb dat antwoord niet afgemaakt. Wil je het opnieuw vragen of anders formuleren?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desculpe, não terminei essa resposta. Pode perguntar de novo ou reformular?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Извините, я не закончил ответ. Задайте вопрос ещё раз или сформулируйте его иначе."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Förlåt – jag hann inte slutföra svaret. Vill du fråga igen eller formulera om det?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抱歉，我没有完成这个回答。可以再问一次或换个说法吗？"
          }
        }
      }
    },
