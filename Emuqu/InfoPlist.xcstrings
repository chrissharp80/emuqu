{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Emuqu"
          }
        }
      },
      "shouldTranslate" : false
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Emuqu البلوتوث من أجل (1) الاتصال بجهاز قياس نبض القلب Polar H10 / Verity Sense لتسجيل HRV، و(2) الاتصال بمستشعرات القدرة والخطوة الاختيارية (Stryd foot pod، ومدرّب الدراجة FTMS، وجهاز التجديف Concept2 PM5) أثناء التمارين، و(3) بث نبض قلبك وقدرتك المباشرين اختياريًا إلى تطبيقات التدريب الداخلي مثل Zwift وTrainerRoad وRouvy عند تفعيل البث في الإعدادات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu bruger Bluetooth til (1) at forbinde til din Polar H10 / Verity Sense-pulsmåler til HRV-optagelse, (2) at forbinde til valgfrie watt- og skridtsensorer (Stryd foot pod, FTMS-cykeltræner, Concept2 PM5-romaskine) under træninger og (3) valgfrit at sende din aktuelle puls og watt videre til indendørs træningsapps som Zwift, TrainerRoad og Rouvy, når du slår udsendelse til i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu verwendet Bluetooth, um (1) sich mit deinem Polar H10 / Verity Sense Herzfrequenzsensor für HRV-Aufzeichnungen zu verbinden, (2) sich während Trainings mit optionalen Leistungs- und Schrittsensoren zu verbinden (Stryd Foot Pod, FTMS-Radtrainer, Concept2 PM5 Rudergerät) und (3) optional deine aktuelle Herzfrequenz und Leistung an Indoor-Trainings-Apps wie Zwift, TrainerRoad und Rouvy zu senden, wenn du die Übertragung in den Einstellungen aktivierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Emuqu uses Bluetooth to (1) connect to your Polar H10 / Verity Sense heart rate monitor for HRV recording, (2) connect to optional power and stride sensors (Stryd foot pod, FTMS bike trainer, Concept2 PM5 rower) during workouts, and (3) optionally broadcast your live heart rate and power back out to indoor-trainer apps like Zwift, TrainerRoad, and Rouvy when you enable the broadcaster in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu usa Bluetooth para (1) conectarse a tu monitor de frecuencia cardíaca Polar H10 / Verity Sense para grabar la HRV, (2) conectarse a sensores opcionales de potencia y zancada (Stryd foot pod, rodillo FTMS, remo Concept2 PM5) durante los entrenamientos y (3) opcionalmente transmitir tu frecuencia cardíaca y potencia en directo a apps de entrenamiento en interior como Zwift, TrainerRoad y Rouvy cuando activas la transmisión en Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu käyttää Bluetoothia (1) yhdistääkseen Polar H10 / Verity Sense -sykemittariisi HRV-tallennusta varten, (2) yhdistääkseen valinnaisiin teho- ja askelantureihin (Stryd foot pod, FTMS-pyörätrainer, Concept2 PM5 -soutulaite) harjoitusten aikana ja (3) halutessasi lähettääkseen reaaliaikaisen sykkeesi ja tehosi sisäharjoitussovelluksiin, kuten Zwift, TrainerRoad ja Rouvy, kun otat lähetyksen käyttöön asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu utilise le Bluetooth pour (1) se connecter à votre capteur de fréquence cardiaque Polar H10 / Verity Sense pour l’enregistrement de la HRV, (2) se connecter à des capteurs facultatifs de puissance et de foulée (Stryd foot pod, home trainer FTMS, rameur Concept2 PM5) pendant les séances et (3) diffuser, si vous le souhaitez, votre fréquence cardiaque et votre puissance en direct vers des apps d’entraînement en salle comme Zwift, TrainerRoad et Rouvy lorsque vous activez la diffusion dans Réglages."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu notar Bluetooth til að (1) tengjast Polar H10 / Verity Sense púlsmælinum þínum fyrir HRV-upptöku, (2) tengjast valfrjálsum afl- og skrefskynjurum (Stryd foot pod, FTMS-hjólaþjálfara, Concept2 PM5-róðravél) á æfingum og (3) senda, ef þú vilt, rauntímapúls og afl til innanhússþjálfunarforrita á borð við Zwift, TrainerRoad og Rouvy þegar þú kveikir á útsendingu í stillingum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu usa il Bluetooth per (1) collegarsi al tuo cardiofrequenzimetro Polar H10 / Verity Sense per la registrazione dell’HRV, (2) collegarsi a sensori opzionali di potenza e falcata (Stryd foot pod, rulli FTMS, vogatore Concept2 PM5) durante gli allenamenti e (3) trasmettere facoltativamente frequenza cardiaca e potenza in tempo reale ad app di allenamento indoor come Zwift, TrainerRoad e Rouvy quando attivi la trasmissione nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu は Bluetooth を使用して、(1) HRV 記録のために Polar H10 / Verity Sense 心拍センサーに接続し、(2) ワークアウト中にオプションのパワー・ストライドセンサー（Stryd フットポッド、FTMS バイクトレーナー、Concept2 PM5 ローイングマシン）に接続し、(3) 設定でブロードキャストをオンにした場合に、リアルタイムの心拍数とパワーを Zwift、TrainerRoad、Rouvy などの屋内トレーニングアプリに送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu는 Bluetooth를 사용해 (1) HRV 기록을 위해 Polar H10 / Verity Sense 심박 센서에 연결하고, (2) 운동 중 선택형 파워 및 보폭 센서(Stryd 풋 포드, FTMS 자전거 트레이너, Concept2 PM5 로잉 머신)에 연결하며, (3) 설정에서 브로드캐스트를 켜면 실시간 심박수와 파워를 Zwift, TrainerRoad, Rouvy 같은 실내 트레이닝 앱으로 선택적으로 전송합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu bruker Bluetooth til å (1) koble til Polar H10 / Verity Sense-pulsmåleren din for HRV-opptak, (2) koble til valgfrie watt- og skrittsensorer (Stryd foot pod, FTMS-sykkeltrener, Concept2 PM5-romaskin) under økter og (3) valgfritt sende sanntidspuls og watt videre til innendørs treningsapper som Zwift, TrainerRoad og Rouvy når du slår på kringkasting i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu gebruikt Bluetooth om (1) verbinding te maken met je Polar H10 / Verity Sense-hartslagmeter voor HRV-opnames, (2) tijdens trainingen verbinding te maken met optionele vermogens- en passensoren (Stryd foot pod, FTMS-fietstrainer, Concept2 PM5-roeier) en (3) desgewenst je live hartslag en vermogen door te sturen naar indoortrainingsapps zoals Zwift, TrainerRoad en Rouvy wanneer je uitzenden aanzet in Instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Emuqu usa Bluetooth para (1) se conectar ao seu monitor de frequência cardíaca Polar H10 / Verity Sense para gravar a VFC, (2) se conectar a sensores opcionais de potência e passada (Stryd foot pod, rolo FTMS, remo Concept2 PM5) durante os treinos e (3) opcionalmente transmitir sua frequência cardíaca e potência ao vivo para apps de treino indoor como Zwift, TrainerRoad e Rouvy quando você ativa a transmissão em Configurações."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu использует Bluetooth, чтобы (1) подключаться к вашему пульсометру Polar H10 / Verity Sense для записи ВСР, (2) подключаться к дополнительным датчикам мощности и шага (Stryd foot pod, велотренажёр FTMS, гребной тренажёр Concept2 PM5) во время тренировок и (3) по желанию передавать текущий пульс и мощность в приложения для тренировок в помещении, такие как Zwift, TrainerRoad и Rouvy, когда вы включаете трансляцию в Настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu använder Bluetooth för att (1) ansluta till din Polar H10 / Verity Sense-pulsmätare för HRV-inspelning, (2) ansluta till valfria effekt- och stegsensorer (Stryd foot pod, FTMS-cykeltränare, Concept2 PM5-roddmaskin) under pass och (3) valfritt sända din aktuella puls och effekt vidare till inomhusträningsappar som Zwift, TrainerRoad och Rouvy när du slår på sändning i Inställningar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu 使用蓝牙来：(1) 连接你的 Polar H10 / Verity Sense 心率监测器以记录 HRV；(2) 在运动期间连接可选的功率和步幅传感器（Stryd 足部传感器、FTMS 自行车骑行台、Concept2 PM5 划船机）；(3) 当你在设置中开启广播时，可选择将实时心率和功率发送到 Zwift、TrainerRoad、Rouvy 等室内训练应用。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Emuqu من Apple Health: النوم، ومعدل ضربات القلب، ومعدل ضربات القلب أثناء الراحة، وتعافي معدل ضربات القلب، وتقلّب معدل ضربات القلب، ومعدل التنفس، وأكسجين الدم، وحرارة المعصم أثناء النوم، وVO2 max، والتمارين ومساراتها، والطاقة النشطة، والخطوات، ومسافات المشي والجري وركوب الدراجة والتجديف، والطوابق المصعودة، ودقائق التمرين، وسرعة المشي والجري، والجهد البدني، ووزن الجسم، وتاريخ الميلاد، والجنس البيولوجي. تشكّل بيانات النوم والقلب والعلامات الحيوية صورة تعافيك الصباحية. وتحدد التمارين والنشاط وVO2 max حمل التدريب. وتتيح مسارات التمارين إعادة بناء تمرين تعطّل فيه GPS الهاتف من Apple Watch. ويملأ الوزن وتاريخ الميلاد والجنس ملفك الشخصي عندما تطلب ذلك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu læser fra Apple Health: søvn, puls, hvilepuls, pulsrestitution, pulsvariabilitet, respirationsfrekvens, iltmætning, håndledstemperatur under søvn, VO2 max, træninger og træningsruter, aktiv energi, skridt, gå-, løbe-, cykel- og rodistance, etager, træningsminutter, gå- og løbehastighed, fysisk anstrengelse, kropsvægt, fødselsdato og biologisk køn. Søvn-, hjerte- og vitaldata former dit morgenbillede af restitutionen. Træninger, aktivitet og VO2 max bestemmer træningsbelastningen. Træningsruter gør det muligt at genopbygge en træning, hvor telefonens GPS svigtede, fra dit Apple Watch. Vægt, fødselsdato og køn udfylder din profil, når du beder om det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu liest aus Apple Health: Schlaf, Herzfrequenz, Ruheherzfrequenz, Herzfrequenzerholung, Herzfrequenzvariabilität, Atemfrequenz, Blutsauerstoff, Handgelenktemperatur im Schlaf, VO2max, Trainings und Trainingsrouten, aktive Energie, Schritte, Geh-, Lauf-, Rad- und Ruderstrecke, erklommene Stockwerke, Trainingsminuten, Geh- und Laufgeschwindigkeit, körperliche Anstrengung, Körpergewicht, Geburtsdatum und biologisches Geschlecht. Schlaf-, Herz- und Vitaldaten bilden dein morgendliches Erholungsbild. Trainings, Aktivität und VO2max bestimmen die Trainingsbelastung. Mit Trainingsrouten lässt sich ein Training, bei dem das iPhone-GPS ausgefallen ist, aus deiner Apple Watch rekonstruieren. Gewicht, Geburtsdatum und Geschlecht füllen dein Profil aus, wenn du darum bittest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Emuqu reads from Apple Health: sleep, heart rate, resting heart rate, heart rate recovery, heart rate variability, respiratory rate, blood oxygen, sleeping wrist temperature, VO2 max, workouts and workout routes, active energy, steps, walking, running, cycling and rowing distance, flights climbed, exercise minutes, walking and running speed, physical effort, body weight, date of birth and biological sex. Sleep, heart and vitals data shape your morning recovery picture. Workouts, activity and VO2 max drive training load. Workout routes let a workout whose phone GPS failed be rebuilt from your Apple Watch. Weight, date of birth and sex fill in your profile when you ask."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu lee de Apple Health: sueño, frecuencia cardíaca, frecuencia cardíaca en reposo, recuperación de la frecuencia cardíaca, variabilidad de la frecuencia cardíaca, frecuencia respiratoria, oxígeno en sangre, temperatura de la muñeca durante el sueño, VO2 máx., entrenamientos y sus rutas, energía activa, pasos, distancia caminando, corriendo, en bicicleta y remando, pisos subidos, minutos de ejercicio, velocidad al caminar y correr, esfuerzo físico, peso corporal, fecha de nacimiento y sexo biológico. Los datos de sueño, corazón y constantes vitales forman tu imagen de recuperación de cada mañana. Los entrenamientos, la actividad y el VO2 máx. determinan la carga de entrenamiento. Las rutas permiten reconstruir desde tu Apple Watch un entrenamiento en el que falló el GPS del teléfono. El peso, la fecha de nacimiento y el sexo completan tu perfil cuando lo pides."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu lukee Apple Healthista: uni, syke, leposyke, sykkeen palautuminen, sykevälivaihtelu, hengitystiheys, veren happipitoisuus, ranteen lämpötila unen aikana, VO2 max, harjoitukset ja niiden reitit, aktiivinen energia, askeleet, kävely-, juoksu-, pyöräily- ja soutumatka, nousut kerrokset, harjoitusminuutit, kävely- ja juoksunopeus, fyysinen rasitus, paino, syntymäaika ja biologinen sukupuoli. Uni-, sydän- ja elintoimintotiedot muodostavat aamun palautumiskuvasi. Harjoitukset, aktiivisuus ja VO2 max määrittävät harjoituskuorman. Harjoitusreittien avulla harjoitus, jossa puhelimen GPS petti, voidaan rakentaa uudelleen Apple Watchista. Paino, syntymäaika ja sukupuoli täyttävät profiilisi, kun pyydät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu lit dans Apple Santé : sommeil, fréquence cardiaque, fréquence cardiaque au repos, récupération de la fréquence cardiaque, variabilité de la fréquence cardiaque, fréquence respiratoire, oxygène sanguin, température du poignet pendant le sommeil, VO2 max, séances et leurs itinéraires, énergie active, pas, distances à pied, en courant, à vélo et à l’aviron, étages montés, minutes d’exercice, vitesse de marche et de course, effort physique, poids, date de naissance et sexe biologique. Les données de sommeil, de cœur et de signes vitaux composent votre bilan de récupération du matin. Les séances, l’activité et la VO2 max déterminent la charge d’entraînement. Les itinéraires permettent de reconstruire depuis votre Apple Watch une séance dont le GPS du téléphone a échoué. Le poids, la date de naissance et le sexe complètent votre profil quand vous le demandez."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu les úr Apple Health: svefn, hjartslátt, hvíldarpúls, endurheimt hjartsláttar, breytileika hjartsláttar, öndunartíðni, súrefnismettun, úlnliðshita í svefni, VO2 max, æfingar og leiðir þeirra, virka orku, skref, göngu-, hlaupa-, hjóla- og róðrarvegalengd, hæðir, æfingamínútur, göngu- og hlaupahraða, líkamlegt álag, líkamsþyngd, fæðingardag og líffræðilegt kyn. Svefn-, hjarta- og lífsmarkagögn móta morgunmynd þína af endurheimt. Æfingar, virkni og VO2 max ráða æfingaálagi. Æfingaleiðir gera kleift að endurbyggja æfingu þar sem GPS símans brást úr Apple Watch. Þyngd, fæðingardagur og kyn fylla út prófílinn þinn þegar þú biður um það."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu legge da Apple Salute: sonno, frequenza cardiaca, frequenza cardiaca a riposo, recupero della frequenza cardiaca, variabilità della frequenza cardiaca, frequenza respiratoria, ossigeno nel sangue, temperatura del polso durante il sonno, VO2 max, allenamenti e relativi percorsi, energia attiva, passi, distanza a piedi, di corsa, in bici e a remi, piani saliti, minuti di esercizio, velocità di camminata e corsa, sforzo fisico, peso corporeo, data di nascita e sesso biologico. I dati di sonno, cuore e parametri vitali compongono il tuo quadro di recupero del mattino. Allenamenti, attività e VO2 max determinano il carico di allenamento. I percorsi permettono di ricostruire dal tuo Apple Watch un allenamento in cui il GPS del telefono non ha funzionato. Peso, data di nascita e sesso completano il tuo profilo quando lo chiedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu は Apple ヘルスケアから次のデータを読み取ります：睡眠、心拍数、安静時心拍数、心拍数の回復、心拍変動、呼吸数、血中酸素、睡眠中の手首皮膚温、VO2 max、ワークアウトとそのルート、アクティブエネルギー、歩数、ウォーキング・ランニング・サイクリング・ローイングの距離、上った階数、エクササイズ（分）、歩行・走行速度、身体的負荷、体重、生年月日、生物学的性別。睡眠・心臓・バイタルのデータは朝の回復状況の把握に使われます。ワークアウト、アクティビティ、VO2 max はトレーニング負荷の算出に使われます。ワークアウトのルートにより、iPhone の GPS が機能しなかったワークアウトを Apple Watch から復元できます。体重、生年月日、性別は、求められたときにプロフィールの入力に使われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu는 Apple 건강에서 다음 데이터를 읽습니다: 수면, 심박수, 안정 시 심박수, 심박수 회복, 심박 변이도, 호흡수, 혈중 산소, 수면 중 손목 온도, VO2 max, 운동 및 운동 경로, 활동 에너지, 걸음 수, 걷기·달리기·사이클링·로잉 거리, 오른 층수, 운동 시간, 걷기 및 달리기 속도, 신체 활동 강도, 체중, 생년월일, 생물학적 성별. 수면, 심장, 바이탈 데이터는 아침 회복 상태를 파악하는 데 쓰입니다. 운동, 활동, VO2 max는 훈련 부하를 결정합니다. 운동 경로를 이용해 iPhone GPS가 실패한 운동을 Apple Watch에서 다시 구성할 수 있습니다. 체중, 생년월일, 성별은 요청할 때 프로필을 채우는 데 쓰입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu leser fra Apple Health: søvn, puls, hvilepuls, pulsrestitusjon, pulsvariabilitet, respirasjonsfrekvens, oksygenmetning, håndleddstemperatur under søvn, VO2 max, økter og øktruter, aktiv energi, skritt, gå-, løpe-, sykkel- og rodistanse, etasjer, treningsminutter, gå- og løpehastighet, fysisk anstrengelse, kroppsvekt, fødselsdato og biologisk kjønn. Søvn-, hjerte- og vitaldata former morgenbildet av restitusjonen din. Økter, aktivitet og VO2 max bestemmer treningsbelastningen. Øktruter gjør det mulig å bygge opp igjen en økt der telefonens GPS sviktet, fra Apple Watch. Vekt, fødselsdato og kjønn fyller ut profilen din når du ber om det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu leest uit Apple Health: slaap, hartslag, rusthartslag, hartslagherstel, hartslagvariabiliteit, ademhalingsfrequentie, bloedzuurstof, polstemperatuur tijdens de slaap, VO2 max, trainingen en trainingsroutes, actieve energie, stappen, wandel-, hardloop-, fiets- en roeiafstand, beklommen verdiepingen, trainingsminuten, wandel- en hardloopsnelheid, fysieke inspanning, lichaamsgewicht, geboortedatum en biologisch geslacht. Slaap-, hart- en vitale gegevens vormen je ochtendbeeld van herstel. Trainingen, activiteit en VO2 max bepalen de trainingsbelasting. Met trainingsroutes kan een training waarbij de gps van je telefoon faalde, vanaf je Apple Watch worden hersteld. Gewicht, geboortedatum en geslacht vullen je profiel in wanneer je daarom vraagt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Emuqu lê do Apple Saúde: sono, frequência cardíaca, frequência cardíaca em repouso, recuperação da frequência cardíaca, variabilidade da frequência cardíaca, frequência respiratória, oxigênio no sangue, temperatura do pulso durante o sono, VO2 máx., treinos e suas rotas, energia ativa, passos, distância de caminhada, corrida, ciclismo e remo, andares subidos, minutos de exercício, velocidade de caminhada e corrida, esforço físico, peso corporal, data de nascimento e sexo biológico. Os dados de sono, coração e sinais vitais formam seu quadro de recuperação da manhã. Treinos, atividade e VO2 máx. determinam a carga de treino. As rotas permitem reconstruir a partir do Apple Watch um treino em que o GPS do telefone falhou. Peso, data de nascimento e sexo preenchem seu perfil quando você pede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu считывает из Apple Здоровье: сон, пульс, пульс в покое, восстановление пульса, вариабельность сердечного ритма, частоту дыхания, насыщение крови кислородом, температуру запястья во сне, VO2 max, тренировки и их маршруты, активную энергию, шаги, расстояние ходьбы, бега, езды на велосипеде и гребли, пройденные этажи, минуты упражнений, скорость ходьбы и бега, физическую нагрузку, вес, дату рождения и биологический пол. Данные о сне, сердце и жизненных показателях формируют утреннюю картину вашего восстановления. Тренировки, активность и VO2 max определяют тренировочную нагрузку. Маршруты тренировок позволяют восстановить с Apple Watch тренировку, в которой отказал GPS телефона. Вес, дата рождения и пол заполняют ваш профиль, когда вы просите об этом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu läser från Apple Hälsa: sömn, puls, vilopuls, pulsåterhämtning, pulsvariabilitet, andningsfrekvens, syremättnad, handledstemperatur under sömn, VO2 max, träningspass och deras rutter, aktiv energi, steg, gång-, löp-, cykel- och roddistans, trappor, träningsminuter, gång- och löphastighet, fysisk ansträngning, kroppsvikt, födelsedatum och biologiskt kön. Sömn-, hjärt- och vitaldata formar din morgonbild av återhämtningen. Pass, aktivitet och VO2 max styr träningsbelastningen. Passrutter gör att ett pass där telefonens GPS svek kan byggas upp igen från din Apple Watch. Vikt, födelsedatum och kön fyller i din profil när du ber om det."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu 会从 Apple 健康读取：睡眠、心率、静息心率、心率恢复、心率变异性、呼吸频率、血氧、睡眠时手腕温度、最大摄氧量、体能训练及其路线、活动能量、步数、步行、跑步、骑行和划船距离、爬楼层数、锻炼分钟数、步行和跑步速度、体力消耗、体重、出生日期和生理性别。睡眠、心脏和生命体征数据用于形成你每天早上的恢复情况。体能训练、活动和最大摄氧量用于计算训练负荷。体能训练路线可在手机 GPS 失效时，通过你的 Apple Watch 重建该次训练。体重、出生日期和性别会在你提出请求时用于填写个人资料。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ Emuqu التمارين التي تسجّلها في Apple Health، مع طاقتها النشطة ومسافتها ومسار GPS. إذا فعّلت التصدير إلى Apple Health في الإعدادات ← الأجهزة القابلة للارتداء، فإنه يكتب أيضًا HRV (SDNN) ومعدل ضربات القلب ومعدل ضربات القلب أثناء الراحة من تسجيلاتك، وفي الليالي التي لا يوجد فيها نوم في Apple Health، النوم الذي اكتشفه من نبض قلبك. ولكل نوع تصدير مفتاحه الخاص."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu gemmer de træninger, du optager, i Apple Health med deres aktive energi, distance og GPS-rute. Hvis du slår eksport til Apple Health til under Indstillinger → Bærbare enheder, skriver den også HRV (SDNN), puls og hvilepuls fra dine optagelser, og på nætter hvor Apple Health ikke har søvn, den søvn den har registreret ud fra din puls. Hver eksporttype har sin egen kontakt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu speichert die Trainings, die du aufzeichnest, mit aktiver Energie, Strecke und GPS-Route in Apple Health. Wenn du unter Einstellungen → Wearables den Export nach Apple Health aktivierst, schreibt es außerdem HRV (SDNN), Herzfrequenz und Ruheherzfrequenz aus deinen Aufzeichnungen und in Nächten, in denen Apple Health keinen Schlaf hat, den aus deiner Herzfrequenz erkannten Schlaf. Jeder Exporttyp hat einen eigenen Schalter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Emuqu saves the workouts you record to Apple Health, with their active energy, distance and GPS route. If you turn on Apple Health export in Settings → Wearables, it also writes HRV (SDNN), heart rate and resting heart rate from your recordings, and on nights Apple Health has no sleep, the sleep it detected from your heart rate. Each export type has its own switch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu guarda en Apple Health los entrenamientos que grabas, con su energía activa, distancia y ruta GPS. Si activas la exportación a Apple Health en Ajustes → Dispositivos vestibles, también escribe la HRV (SDNN), la frecuencia cardíaca y la frecuencia cardíaca en reposo de tus grabaciones y, las noches en que Apple Health no tiene sueño, el sueño detectado a partir de tu frecuencia cardíaca. Cada tipo de exportación tiene su propio interruptor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu tallentaa tallentamasi harjoitukset Apple Healthiin aktiivisen energian, matkan ja GPS-reitin kera. Jos otat Apple Health -viennin käyttöön kohdassa Asetukset → Puettavat laitteet, se kirjoittaa myös tallenteistasi HRV:n (SDNN), sykkeen ja leposykkeen sekä öinä, joilta Apple Healthissa ei ole unta, sykkeestäsi tunnistetun unen. Jokaisella vientityypillä on oma kytkimensä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu enregistre dans Apple Santé les séances que vous enregistrez, avec leur énergie active, leur distance et leur itinéraire GPS. Si vous activez l’export vers Apple Santé dans Réglages → Objets connectés, il écrit aussi la HRV (SDNN), la fréquence cardiaque et la fréquence cardiaque au repos de vos enregistrements et, les nuits où Apple Santé n’a pas de sommeil, le sommeil détecté à partir de votre fréquence cardiaque. Chaque type d’export a son propre interrupteur."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu vistar æfingarnar sem þú skráir í Apple Health, með virkri orku, vegalengd og GPS-leið. Ef þú kveikir á útflutningi í Apple Health í Stillingar → Klæðanlegur búnaður skrifar það líka HRV (SDNN), hjartslátt og hvíldarpúls úr upptökunum þínum og, þær nætur sem Apple Health hefur engan svefn, svefninn sem greindist út frá hjartslættinum. Hver útflutningstegund hefur sinn eigin rofa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu salva in Apple Salute gli allenamenti che registri, con energia attiva, distanza e percorso GPS. Se attivi l’esportazione verso Apple Salute in Impostazioni → Dispositivi indossabili, scrive anche HRV (SDNN), frequenza cardiaca e frequenza cardiaca a riposo dalle tue registrazioni e, nelle notti in cui Apple Salute non ha dati sul sonno, il sonno rilevato dalla tua frequenza cardiaca. Ogni tipo di esportazione ha un proprio interruttore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu は記録したワークアウトを、アクティブエネルギー、距離、GPS ルートとともに Apple ヘルスケアに保存します。設定 → ウェアラブルで Apple ヘルスケアへの書き出しをオンにすると、記録から HRV（SDNN）、心拍数、安静時心拍数も書き込み、Apple ヘルスケアに睡眠データがない夜には心拍数から検出した睡眠も書き込みます。書き出しの種類ごとに個別のスイッチがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu는 기록한 운동을 활동 에너지, 거리, GPS 경로와 함께 Apple 건강에 저장합니다. 설정 → 웨어러블에서 Apple 건강 내보내기를 켜면 기록의 HRV(SDNN), 심박수, 안정 시 심박수도 기록하며, Apple 건강에 수면 데이터가 없는 밤에는 심박수로 감지한 수면도 기록합니다. 내보내기 유형마다 별도의 스위치가 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu lagrer øktene du tar opp i Apple Health, med aktiv energi, distanse og GPS-rute. Hvis du slår på eksport til Apple Health under Innstillinger → Bærbare enheter, skriver den også HRV (SDNN), puls og hvilepuls fra opptakene dine, og på netter der Apple Health ikke har søvn, søvnen den har oppdaget fra pulsen din. Hver eksporttype har sin egen bryter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu slaat de trainingen die je opneemt op in Apple Health, met hun actieve energie, afstand en gps-route. Als je de export naar Apple Health aanzet in Instellingen → Wearables, schrijft het ook HRV (SDNN), hartslag en rusthartslag uit je opnames en, in nachten waarin Apple Health geen slaap heeft, de slaap die uit je hartslag is afgeleid. Elk exporttype heeft een eigen schakelaar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Emuqu salva no Apple Saúde os treinos que você grava, com energia ativa, distância e rota GPS. Se você ativar a exportação para o Apple Saúde em Configurações → Dispositivos vestíveis, ele também grava a VFC (SDNN), a frequência cardíaca e a frequência cardíaca em repouso das suas gravações e, nas noites em que o Apple Saúde não tem sono, o sono detectado a partir da sua frequência cardíaca. Cada tipo de exportação tem seu próprio botão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu сохраняет записанные вами тренировки в Apple Здоровье вместе с активной энергией, расстоянием и GPS-маршрутом. Если включить экспорт в Apple Здоровье в разделе Настройки → Носимые устройства, приложение также записывает ВСР (SDNN), пульс и пульс в покое из ваших записей, а в ночи, когда в Apple Здоровье нет данных о сне, — сон, определённый по пульсу. У каждого типа экспорта свой переключатель."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu sparar passen du spelar in i Apple Hälsa, med aktiv energi, distans och GPS-rutt. Om du slår på export till Apple Hälsa under Inställningar → Bärbara enheter skriver den också HRV (SDNN), puls och vilopuls från dina inspelningar och, nätter då Apple Hälsa saknar sömn, den sömn den upptäckt från din puls. Varje exporttyp har sitt eget reglage."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu 会将你记录的体能训练连同活动能量、距离和 GPS 路线保存到 Apple 健康。如果你在“设置 → 可穿戴设备”中开启导出到 Apple 健康，它还会写入你记录中的 HRV（SDNN）、心率和静息心率；在 Apple 健康没有睡眠数据的夜晚，还会写入根据心率检测到的睡眠。每种导出类型都有单独的开关。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Emuqu موقعك لتسجيل مسارات التمارين ومسارات Get Me Back (حتى مع إطفاء الشاشة، إلى أن توقفها)، والعثور على مسارات قريبة، ومعرفة الطقس المحلي للتمارين الخارجية، وذكر أسماء الشوارع القريبة في التحديثات المنطوقة ولمساعد الذكاء الاصطناعي. لا يُستخدم إلا أثناء فتح التطبيق أو تشغيل إحدى هذه الميزات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu bruger din placering til at registrere træningsruter og Get Me Back-spor (også med skærmen slukket, indtil du stopper), finde stier i nærheden, hente lokalt vejr til udendørs træning og nævne gader i nærheden i talte opdateringer og for AI-assistenten. Den bruges kun, mens appen er åben, eller en af disse kører."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu verwendet deinen Standort, um Trainingsrouten und Get Me Back-Spuren aufzuzeichnen (auch bei ausgeschaltetem Bildschirm, bis du stoppst), Wege in der Nähe zu finden, das lokale Wetter für Outdoor-Trainings abzurufen und nahe Straßen in gesprochenen Updates und für den KI-Assistenten zu nennen. Er wird nur verwendet, während die App geöffnet ist oder eine dieser Funktionen läuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Emuqu uses your location to record workout routes and Get Me Back trails (with the screen off too, until you stop), find nearby trails, get local weather for outdoor workouts, and name nearby streets in spoken updates and for the AI assistant. It’s used only while the app is open or one of these is running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu usa tu ubicación para registrar las rutas de entrenamiento y los rastros de Get Me Back (también con la pantalla apagada, hasta que los detengas), encontrar senderos cercanos, consultar el tiempo local en los entrenamientos al aire libre y nombrar calles cercanas en los avisos hablados y para el asistente de IA. Solo se usa mientras la app está abierta o una de estas funciones está en marcha."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu käyttää sijaintiasi tallentaakseen harjoitusreitit ja Get Me Back -reitit (myös näytön ollessa pois päältä, kunnes lopetat), löytääkseen lähellä olevia polkuja, hakeakseen paikallisen sään ulkoharjoituksiin ja mainitakseen lähikadut puhutuissa päivityksissä ja tekoälyavustajalle. Sitä käytetään vain, kun sovellus on auki tai jokin näistä on käynnissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu utilise votre position pour enregistrer les itinéraires de vos séances et les traces Get Me Back (écran éteint aussi, jusqu’à ce que vous arrêtiez), trouver des sentiers proches, obtenir la météo locale pendant les séances en extérieur et citer les rues proches dans les annonces vocales et pour l’assistant IA. Elle n’est utilisée que lorsque l’app est ouverte ou qu’une de ces fonctions est en cours."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu notar staðsetningu þína til að skrá æfingaleiðir og Get Me Back-slóðir (líka með slökkt á skjánum, þar til þú stöðvar), finna slóða í nágrenninu, sækja staðbundið veður fyrir útiæfingar og nefna nálægar götur í töluðum uppfærslum og fyrir gervigreindaraðstoðina. Hún er aðeins notuð meðan appið er opið eða eitthvað af þessu er í gangi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu usa la tua posizione per registrare i percorsi degli allenamenti e le tracce di Get Me Back (anche a schermo spento, finché non le interrompi), trovare sentieri vicini, ottenere il meteo locale negli allenamenti all’aperto e nominare le vie vicine negli aggiornamenti vocali e per l’assistente IA. Viene usata solo mentre l’app è aperta o una di queste funzioni è attiva."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu は位置情報を、ワークアウトのルートと Get Me Back の軌跡の記録（停止するまで画面オフでも継続）、近くのトレイル探し、屋外ワークアウトの現地の天気、音声アップデートと AI アシスタントでの近くの通り名の案内に使います。使用するのはアプリを開いているときか、これらの機能が動作中のときだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu는 위치를 사용해 운동 경로와 Get Me Back 궤적을 기록하고(멈출 때까지 화면이 꺼져 있어도 계속), 근처 트레일을 찾고, 야외 운동의 현지 날씨를 확인하고, 음성 업데이트와 AI 도우미에서 근처 거리 이름을 알려 줍니다. 앱이 열려 있거나 이 기능 중 하나가 실행 중일 때만 사용됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu bruker posisjonen din til å registrere treningsruter og Get Me Back-spor (også med skjermen av, til du stopper), finne stier i nærheten, hente lokalt vær for utendørstrening og nevne gater i nærheten i talte oppdateringer og for AI-assistenten. Den brukes bare mens appen er åpen eller en av disse kjører."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu gebruikt je locatie om trainingsroutes en Get Me Back-sporen vast te leggen (ook met het scherm uit, totdat je stopt), paden in de buurt te vinden, het lokale weer voor buitentrainingen op te halen en straten in de buurt te noemen in gesproken updates en voor de AI-assistent. Je locatie wordt alleen gebruikt als de app open is of een van deze functies actief is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Emuqu usa sua localização para registrar rotas de treino e trilhas do Get Me Back (também com a tela apagada, até você parar), encontrar trilhas próximas, obter o clima local em treinos ao ar livre e citar ruas próximas nas atualizações faladas e para o assistente de IA. Ela só é usada enquanto o app está aberto ou um desses recursos está em execução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu использует ваше местоположение, чтобы записывать маршруты тренировок и треки Get Me Back (и при выключенном экране, пока вы не остановите), находить тропы поблизости, узнавать местную погоду для тренировок на улице и называть ближайшие улицы в голосовых подсказках и для ИИ-ассистента. Оно используется только при открытом приложении или во время работы одной из этих функций."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu använder din plats för att registrera träningsrutter och Get Me Back-spår (även med skärmen av, tills du stoppar), hitta leder i närheten, hämta lokalt väder för utomhusträning och nämna gator i närheten i talade uppdateringar och för AI-assistenten. Den används bara när appen är öppen eller någon av dessa körs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu 使用你的位置来记录体能训练路线和 Get Me Back 轨迹（关闭屏幕后也会继续，直到你停止）、查找附近的步道、获取户外训练时的当地天气，以及在语音播报和 AI 助手中说出附近的街道名称。仅在应用打开或上述功能运行时使用。"
          }
        }
      }
    },
