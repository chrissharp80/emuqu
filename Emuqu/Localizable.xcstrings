        }
      }
    },
    "These nights are synthetic examples, not your recordings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الليالي أمثلة اصطناعية، وليست تسجيلاتك."
