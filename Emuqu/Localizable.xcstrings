    "Maintain / Build / Peak. Tells Flo what you are training for. Does not change the recovery score." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحفاظ / البناء / الذروة. يخبر Flo بما تتدرب من أجله. لا يغيّر درجة التعافي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedligehold / Opbyg / Top. Fortæller Flo, hvad du træner til. Ændrer ikke restitutionsscoren."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halten / Aufbauen / Spitze. Sagt Flo, wofür du trainierst. Ändert den Erholungs-Score nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantener / Progresar / Pico. Le indica a Flo para qué entrenas. No cambia la puntuación de recuperación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ylläpidä / Kehitä / Huippu. Kertoo Flolle, mihin harjoittelet. Ei muuta palautumispisteitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenir / Progresser / Pic. Indique à Flo pour quoi vous vous entraînez. Ne modifie pas le score de récupération."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viðhalda / Byggja upp / Hámark. Segir Flo hvað þú ert að æfa fyrir. Breytir ekki batastiginu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenere / Costruire / Picco. Dice a Flo per cosa ti stai allenando. Non cambia il punteggio di recupero."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "維持 / 強化 / ピーク。何のためにトレーニングしているかを Flo に伝えます。回復スコアは変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유지 / 향상 / 최고. Flo에게 무엇을 위해 훈련하는지 알려 줍니다. 회복 점수는 바뀌지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedlikehold / Bygg opp / Topp. Forteller Flo hva du trener mot. Endrer ikke restitusjonsskåren."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderhouden / Opbouwen / Piek. Vertelt Flo waarvoor je traint. Verandert de herstelscore niet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manter / Evoluir / Pico. Diz ao Flo para que você está treinando. Não altera a pontuação de recuperação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддержание / Развитие / Пик. Сообщает Flo, к чему вы готовитесь. Не меняет оценку восстановления."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bibehåll / Bygg / Topp. Berättar för Flo vad du tränar för. Ändrar inte återhämtningspoängen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保持 / 提升 / 峰值。告诉 Flo 你的训练目标。不会改变恢复评分。"
