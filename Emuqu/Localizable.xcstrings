    "Make sure your sensor is nearby and turned on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكد من أن المستشعر قريب ومُشغّل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sørg for, at din sensor er i nærheden og tændt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achte darauf, dass dein Sensor in der Nähe und eingeschaltet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que tu sensor esté cerca y encendido."
          }
        },
        "fi" : {
          "stringUnit" : {
