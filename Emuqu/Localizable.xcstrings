    "Mixed intensity: %@ easy, %@ at threshold, %@ very hard (α1 under 0.50)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شدة متنوعة: %1$@ سهل، و%2$@ عند العتبة، و%3$@ شاق جدًا (α1 أقل من 0.50)."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blandet intensitet: %@ let, %@ ved tærsklen, %@ meget hårdt (α1 under 0,50)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemischte Intensität: %@ locker, %@ an der Schwelle, %@ sehr hart (α1 unter 0,50)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensidad mixta: %@ suave, %@ en el umbral, %@ muy duro (α1 por debajo de 0,50)."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihteleva teho: %@ kevyesti, %@ kynnyksellä, %@ erittäin kovaa (α1 alle 0,50)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensité mixte : %@ facile, %@ au seuil, %@ très difficile (α1 sous 0,50)."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blönduð ákefð: %@ létt, %@ við þröskuld, %@ mjög erfitt (α1 undir 0,50)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensità mista: %@ facile, %@ in soglia, %@ molto duro (α1 sotto 0,50)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強度が混在：イージー%1$@、閾値%2$@、非常にハード%3$@（α1が0.50未満）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "혼합 강도: 쉬움 %1$@, 역치 %2$@, 매우 힘듦 %3$@(α1 0.50 미만)."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blandet intensitet: %@ lett, %@ ved terskelen, %@ svært hardt (α1 under 0,50)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemengde intensiteit: %@ licht, %@ op drempel, %@ zeer zwaar (α1 onder 0,50)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intensidade mista: %@ leve, %@ no limiar, %@ muito intenso (α1 abaixo de 0,50)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смешанная интенсивность: %@ легко, %@ на пороге, %@ очень тяжело (α1 ниже 0,50)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blandad intensitet: %@ lätt, %@ vid tröskeln, %@ mycket hårt (α1 under 0,50)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "混合强度：轻松 %1$@，阈值 %2$@，极高强度 %3$@（α1 低于 0.50）。"
          }
        }
      }
    },
