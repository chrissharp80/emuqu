            "value" : "Training Stress Balance (équilibre du stress d’entraînement) — CTL moins ATL. Positif = frais, négatif = fatigué."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Training Stress Balance — CTL mínus ATL. Jákvætt = ferskur, neikvætt = þreyttur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Training Stress Balance — CTL meno ATL. Positivo = fresco, negativo = affaticato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Training Stress Balance（トレーニングストレスバランス）— CTL から ATL を引いた値。プラス = フレッシュ、マイナス = 疲労。"
