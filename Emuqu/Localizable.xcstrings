          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O TSB está em %@ e a recuperação está forte — boa janela para intervalados ou uma sessão aeróbica longa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSB равен %@, восстановление хорошее — удачное время для интервалов или длинной аэробной тренировки."
          }
