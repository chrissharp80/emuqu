    "Strap refused to start streaming. Disconnect from the Record screen, reconnect, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض الحزام بدء البث. اقطع الاتصال من شاشة التسجيل، وأعد الاتصال، ثم حاول مرة أخرى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsbæltet afviste at starte streaming. Afbryd fra skærmen Optag, genforbind, og prøv så igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Gurt hat das Streaming verweigert. Trenne ihn im Aufnahme-Bildschirm, verbinde ihn neu und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La banda se negó a iniciar la transmisión. Desconéctala desde la pantalla Grabar, vuelve a conectarla e inténtalo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyö kieltäytyi aloittamasta suoratoistoa. Katkaise yhteys Tallenna-näkymästä, yhdistä uudelleen ja yritä sitten uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ceinture a refusé de démarrer la diffusion. Déconnectez-la depuis l’écran Enregistrer, reconnectez-la, puis réessayez."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ólin neitaði að hefja streymi. Aftengdu á upptökuskjánum, tengdu aftur og reyndu svo aftur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fascia ha rifiutato di avviare lo streaming. Disconnettila dalla schermata Registra, riconnettila, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストラップがストリーミングの開始を拒否しました。記録画面から切断して再接続し、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스트랩이 스트리밍 시작을 거부했습니다. 기록 화면에서 연결을 끊고 다시 연결한 후 다시 시도하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beltet nektet å starte strømming. Koble fra på Opptak-skjermen, koble til igjen og prøv på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De band weigerde te starten met streamen. Verbreek de verbinding via het scherm Opnemen, verbind opnieuw en probeer het dan nog eens."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cinta se recusou a iniciar a transmissão. Desconecte pela tela Gravar, reconecte e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Датчик отказался начинать передачу данных. Отключитесь на экране «Запись», подключитесь снова и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandet vägrade starta strömningen. Koppla från på skärmen Spela in, anslut igen och försök sedan på nytt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心率带拒绝开始传输数据。请从“记录”界面断开连接，重新连接后再试。"
          }
        }
      }
    },
    "Strap reported an error: %@. Try again, or remove the strap from the chest pad for 30 s to restart it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أبلغ الحزام عن خطأ: %@. حاول مرة أخرى، أو افصل الحزام عن وسادة الصدر لمدة 30 ث لإعادة تشغيله."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsbæltet rapporterede en fejl: %@. Prøv igen, eller tag pulsbæltet af brystpuden i 30 s for at genstarte det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Gurt hat einen Fehler gemeldet: %@. Versuche es erneut oder nimm den Gurt 30 s vom Brustpolster ab, um ihn neu zu starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La banda informó de un error: %@. Inténtalo de nuevo, o separa la banda de la almohadilla de pecho durante 30 s para reiniciarla."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyö ilmoitti virheestä: %@. Yritä uudelleen tai irrota vyö rintapehmusteesta 30 s:ksi käynnistääksesi sen uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ceinture a signalé une erreur : %@. Réessayez, ou retirez la ceinture de la sangle pectorale pendant 30 s pour la redémarrer."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ólin tilkynnti villu: %@. Reyndu aftur, eða taktu ólina af brjóstpúðanum í 30 s til að endurræsa hana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fascia ha segnalato un errore: %@. Riprova, oppure stacca la fascia dal sensore toracico per 30 s per riavviarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストラップがエラーを報告しました：%@。もう一度お試しいただくか、ストラップを胸パッドから 30 秒間外して再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스트랩에서 오류를 보고했습니다: %@. 다시 시도하거나, 스트랩을 가슴 패드에서 30초간 분리하여 재시작하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beltet rapporterte en feil: %@. Prøv igjen, eller ta beltet av brystputen i 30 s for å starte det på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De band meldde een fout: %@. Probeer het opnieuw, of haal de sensor 30 s van de borstband om hem te herstarten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cinta relatou um erro: %@. Tente novamente ou retire a cinta do sensor peitoral por 30 s para reiniciá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Датчик сообщил об ошибке: %@. Повторите попытку или отсоедините датчик от нагрудной площадки на 30 с, чтобы перезапустить его."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bandet rapporterade ett fel: %@. Försök igen, eller ta loss sensorn från bröstbandet i 30 s för att starta om den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心率带报告了一个错误：%@。请再试一次，或将心率带从胸带垫上取下 30 秒以重启。"
          }
        }
      }
    },
