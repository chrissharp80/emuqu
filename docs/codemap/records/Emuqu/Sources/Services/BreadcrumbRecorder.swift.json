  {
   "key": "func BreadcrumbRecorder.applyAuthorization(_:manager:)",
   "hash": "8757a94b111dee27",
   "does": "Publishes the status; on a decided status, consumes the pending engage and completes it when granted; when access is revoked while engaged, disengages (stops location/heading, trail stays on disk); else (if engaged and granted) restarts location and heading.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Services/BreadcrumbRecorder.swift::func BreadcrumbRecorder.engage(label:)",
    "Emuqu/Sources/Services/BreadcrumbRecorder.swift::func BreadcrumbRecorder.disengage()",
    "ext:CLLocationManager.startUpdatingLocation"
   ],
   "reads": [],
   "writes": [
    "mem:BreadcrumbRecorder.authorizationStatus"
   ],
   "branches": [
    {
     "at": "+3",
     "cond": "status not .notDetermined",
     "effect": "continue; otherwise return keeping pendingEngage"
    },
    {
     "at": "+7",
     "cond": "pending engage, granted, not engaged",
     "effect": "engage with the pending label and return"
    },
    {
     "at": "+11",
     "cond": "engaged and not granted (revoked)",
     "effect": "disengage and return"
    },
    {
     "at": "+15",
     "cond": "engaged and granted",
     "effect": "restart updates; otherwise return"
    },
    {
     "at": "+17",
     "cond": "heading available",
     "effect": "start heading"
    }
   ],
   "flags": [],
