    "The difference between minimum and maximum heart rate during the recording. Indicates the span of HR variation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الفرق بين أدنى وأعلى معدل نبض خلال التسجيل. يشير إلى مدى تباين النبض."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forskellen mellem laveste og højeste puls under optagelsen. Angiver spændet i pulsvariationen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Differenz zwischen minimaler und maximaler Herzfrequenz während der Aufzeichnung. Zeigt die Spannweite der HF-Schwankung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La diferencia entre la frecuencia cardíaca mínima y máxima durante la grabación. Indica la amplitud de la variación de FC."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennuksen minimi- ja maksimisykkeen erotus. Kertoo sykevaihtelun laajuuden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écart entre la fréquence cardiaque minimale et maximale pendant l’enregistrement. Indique l’amplitude de la variation de FC."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Munurinn á lægsta og hæsta púls í upptökunni. Gefur til kynna umfang púlsbreytileikans."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La differenza tra frequenza cardiaca minima e massima durante la registrazione. Indica l’ampiezza della variazione della FC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録中の最低心拍数と最高心拍数の差。心拍変動の幅を示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록 중 최저 심박수와 최고 심박수의 차이. 심박 변동의 폭을 나타냅니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forskjellen mellom laveste og høyeste puls under opptaket. Angir spennet i pulsvariasjonen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het verschil tussen de minimale en maximale hartslag tijdens de opname. Geeft de spreiding van de hartslagvariatie aan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A diferença entre a frequência cardíaca mínima e máxima durante a gravação. Indica a amplitude da variação da FC."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разница между минимальным и максимальным пульсом за запись. Показывает размах колебаний пульса."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skillnaden mellan lägsta och högsta puls under inspelningen. Anger spannet i pulsvariationen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录期间最低与最高心率之差。表示心率波动的幅度。"
          }
        }
      }
    },
