    "ext:String(localized:bundle:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "level == .easier",
     "effect": "sharpIncrease among reasons → load-above-usual copy; otherwise (heavy fatigue) → fatigue copy"
    },
    {
     "at": "+6",
     "cond": "reasons contain aboveUsual",
     "effect": "returns above-average copy"
    },
    {
     "at": "+9",
     "cond": "reasons contain monotonous",
     "effect": "returns monotony copy; else nil"
