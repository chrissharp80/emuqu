        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация iCloud — автоматическая синхронизация CloudKit с вашим личным Apple ID после каждого сохранения. Удаления тоже синхронизируются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-synk — Automatisk CloudKit-synk till ditt privata Apple-ID efter varje sparning. Raderingar synkas också."
