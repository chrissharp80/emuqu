   "key": "func StressAnalyzer.computeStressIndex(_:)",
   "hash": "831f59a62858ce5f",
   "does": "Baevsky SI from RR (ms): needs ≥20 beats (stressIndexMinRRCount), builds a 50 ms histogram anchored at min RR, Mo = modal-bin centre (s), AMo = modal count % of beats, MxDMn = range (s); returns AMo/(2·Mo·MxDMn), nil when not computable. Missing min/max or modal bin return nil (never a fabricated 0); they cannot be missing after the count guard.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Analysis/StressAnalysis.swift::func StressAnalyzer.stressIndexHistogram(_:minRR:maxRR:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "rr.count >= 20 and min/max exist",
     "effect": "false → nil"
    },
    {
     "at": "+4",
     "cond": "range > 0",
     "effect": "false (constant RR) → nil"
    },
    {
     "at": "+6",
     "cond": "histogram has a maximum and its first index",
     "effect": "false → nil (cannot happen: the histogram has at least one bin)"
    },
    {
     "at": "+12",
     "cond": "mo > 0",
     "effect": "false → nil; true → SI"
    }
   ],
