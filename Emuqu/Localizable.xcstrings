    "Optimal at rest: 0.75-1.0. >1.2: fatigue/stress. <0.75: high vagal activity. Used to assess aerobic fitness zones." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأمثل أثناء الراحة: 0.75-1.0. أكثر من 1.2: إرهاق/إجهاد. أقل من 0.75: نشاط مبهمي عالٍ. يُستخدم لتقييم مناطق اللياقة الهوائية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimalt i hvile: 0,75-1,0. >1,2: træthed/stress. <0,75: høj vagal aktivitet. Bruges til at vurdere aerobe konditionszoner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimal in Ruhe: 0,75-1,0. >1,2: Ermüdung/Stress. <0,75: hohe vagale Aktivität. Dient zur Bestimmung aerober Fitnesszonen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Óptimo en reposo: 0,75-1,0. >1,2: fatiga/estrés. <0,75: alta actividad vagal. Se usa para evaluar zonas de condición aeróbica."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimaalinen levossa: 0,75-1,0. >1,2: väsymys/stressi. <0,75: korkea vagaalinen aktiivisuus. Käytetään aerobisten kuntoalueiden arviointiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimal au repos : 0,75-1,0. >1,2 : fatigue/stress. <0,75 : forte activité vagale. Sert à évaluer les zones de condition aérobie."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kjörgildi í hvíld: 0,75-1,0. >1,2: þreyta/streita. <0,75: mikil vagus-virkni. Notað til að meta loftháð þreksvæði."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottimale a riposo: 0,75-1,0. >1,2: fatica/stress. <0,75: elevata attività vagale. Usato per valutare le zone di forma aerobica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安静時の最適値: 0.75-1.0。1.2 超: 疲労／ストレス。0.75 未満: 迷走神経活動が高い。有酸素能力ゾーンの評価に用います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안정 시 최적: 0.75-1.0. 1.2 초과: 피로/스트레스. 0.75 미만: 미주신경 활동 높음. 유산소 체력 구간 평가에 사용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimalt i hvile: 0,75-1,0. >1,2: tretthet/stress. <0,75: høy vagal aktivitet. Brukes til å vurdere aerobe formsoner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimaal in rust: 0,75-1,0. >1,2: vermoeidheid/stress. <0,75: hoge vagale activiteit. Wordt gebruikt om aerobe fitheidszones te beoordelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ideal em repouso: 0,75-1,0. >1,2: fadiga/estresse. <0,75: alta atividade vagal. Usado para avaliar zonas de condicionamento aeróbio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оптимум в покое: 0,75-1,0. >1,2: усталость/стресс. <0,75: высокая вагусная активность. Используется для оценки аэробных зон."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Optimalt i vila: 0,75-1,0. >1,2: trötthet/stress. <0,75: hög vagal aktivitet. Används för att bedöma aeroba konditionszoner."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静息时最佳：0.75-1.0。大于 1.2：疲劳/压力。小于 0.75：迷走活动高。用于评估有氧能力区间。"
          }
        }
      }
    },
