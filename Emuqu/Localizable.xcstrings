    "Finish a workout or an overnight recording to generate your first report. Reports stay here so you can revisit them later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أكمل تمرينًا أو تسجيلًا ليليًا لإنشاء تقريرك الأول. تبقى التقارير هنا لتعود إليها لاحقًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gennemfør en træning eller en natoptagelse for at lave din første rapport. Rapporterne bliver her, så du kan se dem igen senere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe ein Training oder eine Nachtaufnahme ab, um deinen ersten Bericht zu erstellen. Berichte bleiben hier, damit du sie später wieder ansehen kannst."
