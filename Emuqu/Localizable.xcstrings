        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中程度 — REM サイクルを増やすため睡眠時間の延長を検討しましょう"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
