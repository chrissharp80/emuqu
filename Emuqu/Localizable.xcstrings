    "Resp. Rate" : {
      "comment" : "Label for the \"Resp. Rate\" field in the Recovery Vitals section of the PDF report.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معدل التنفس"
          }
        },
        "da" : {
          "stringUnit" : {
