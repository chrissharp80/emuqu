    "Tight 4K context window — long conversations get oldest turns trimmed verbatim once the transcript hits 70% of budget" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نافذة سياق 4K ضيقة — في المحادثات الطويلة تُقتطع أقدم الأدوار حرفيًا عندما يبلغ النص 70% من الميزانية"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snævert 4K-kontekstvindue — i lange samtaler beskæres de ældste ture ordret, når transskriptionen når 70 % af budgettet"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enges 4K-Kontextfenster — bei langen Unterhaltungen werden die ältesten Beiträge wörtlich gekürzt, sobald das Transkript 70 % des Budgets erreicht"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ventana de contexto de 4K muy ajustada: en conversaciones largas se recortan literalmente los turnos más antiguos cuando la transcripción alcanza el 70 % del presupuesto"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiukka 4K:n kontekstiikkuna — pitkistä keskusteluista karsitaan vanhimmat vuorot sanatarkasti, kun keskustelu saavuttaa 70 % budjetista"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fenêtre de contexte limitée à 4K — dans les longues conversations, les échanges les plus anciens sont retirés tels quels dès que la transcription atteint 70 % du budget"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þröngur 4K samhengisgluggi — í löngum samtölum eru elstu umferðirnar klipptar burt orðrétt þegar samtalið nær 70% af hámarkinu"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finestra di contesto ridotta da 4K — nelle conversazioni lunghe i turni più vecchi vengono rimossi così come sono quando la trascrizione raggiunge il 70% del budget"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4K の狭いコンテキストウィンドウ — 長い会話では、トランスクリプトが予算の 70% に達すると、古いターンからそのまま削除されます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "좁은 4K 컨텍스트 창 — 대화 기록이 예산의 70%에 도달하면 긴 대화의 가장 오래된 턴이 원문 그대로 잘려 나갑니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trangt kontekstvindu på 4K — i lange samtaler fjernes de eldste turene ordrett når transkripsjonen når 70 % av budsjettet"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krap contextvenster van 4K — bij lange gesprekken worden de oudste beurten letterlijk ingekort zodra het transcript 70% van het budget bereikt"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Janela de contexto apertada de 4K — em conversas longas, os turnos mais antigos são removidos literalmente quando a transcrição atinge 70% do limite"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тесное контекстное окно 4K — в длинных разговорах самые старые реплики обрезаются дословно, когда расшифровка достигает 70% бюджета"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snävt kontextfönster på 4K — i långa samtal trimmas de äldsta turerna ordagrant när transkriptet når 70 % av budgeten"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有限的 4K 上下文窗口 — 当对话记录达到预算的 70% 时，长对话会原样裁剪最早的轮次"
          }
        }
      }
    },
