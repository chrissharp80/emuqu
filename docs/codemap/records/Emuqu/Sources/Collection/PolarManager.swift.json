   "key": "func PolarDeviceType.from(deviceName:)",
   "hash": "290740f8afeb7a20",
   "does": "Classifies a strap from its advertised BLE name: names containing 'sense', 'verity' or 'oh1' (case-insensitive) are .veritySense, everything else .h10.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "lowercased name contains 'sense' or 'verity' or 'oh1'",
     "effect": "true → .veritySense; false → .h10 (any other Polar device, e.g. an H9, is treated as an H10 and offered H10 exercise recording)"
    }
   ],
   "flags": [
    {
     "kind": "fragile",
     "sev": "low",
     "text": "Device type is guessed from the advertised name, and every non-matching Polar device (polarFilter admits all Polar models) is treated as an H10, so H10-only exercise-recording APIs are attempted on it; the OH1 is lumped with Verity Sense.",
