  {
   "key": "func WorkoutAIContextBuilder.attemptAutoRouteDetection(sport:)",
   "hash": "c75f93d42463a321",
   "does": "Saved-route auto-binding: once the GPS distance the location manager keeps (credited as fixes arrive, so the ticks between attempts cost nothing) reaches the later of 500 m (RouteLibrary.detectionTriggerMeters) and nextRouteDetectionAtMeters, schedules the next attempt another 500 m on, asks RouteLibrary.findMatch against the saved-route store with the live track, and on a match binds the planned route, marks it auto-detected and records the direction.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Collection/WorkoutRecorder.swift::var WorkoutRecorder.location",
    "Emuqu/Sources/Analysis/RouteLibrary.swift::func RouteLibrary.findMatch(currentTrack:sport:store:)",
    "Emuqu/Sources/Utilities/DebugLog.swift::func debugLog(_:level:file:line:)"
   ],
   "reads": [
    "mem:WorkoutLocationManager.distanceMeters",
    "mem:WorkoutLocationManager.track",
    "mem:SavedRouteStore",
    "mem:WorkoutRecorder.nextRouteDetectionAtMeters"
   ],
   "writes": [
    "mem:WorkoutRecorder.nextRouteDetectionAtMeters",
    "mem:WorkoutRecorder.plannedRoute",
    "mem:WorkoutRecorder.plannedRouteWasAutoDetected",
    "mem:WorkoutRecorder.plannedRouteDirection"
   ],
   "branches": [
    {
     "at": "+2",
     "cond": "GPS distance < max(500 m, nextRouteDetectionAtMeters)",
     "effect": "returns without trying"
    },
    {
     "at": "+5",
     "cond": "no matching saved route",
     "effect": "returns; next attempt after 500 m more"
    },
    {
     "at": "+15",
     "cond": "direction == .reverse",
     "effect": "log suffix \"(reverse)\"; else empty. The route is logged by the first 8 characters of its id, not its name"
    }
   ],
   "deps": {
    "Emuqu/Sources/Analysis/RouteLibrary.swift::func RouteLibrary.findMatch(currentTrack:sport:store:)": "928ed8fc26bfb64e",
    "Emuqu/Sources/Collection/WorkoutRecorder.swift::var WorkoutRecorder.location": "2e075cb0da2a67f9",
    "Emuqu/Sources/Collection/WorkoutRecorder.swift::var WorkoutRecorder.plannedRoute": "2a05f1704cdc4cfc",
