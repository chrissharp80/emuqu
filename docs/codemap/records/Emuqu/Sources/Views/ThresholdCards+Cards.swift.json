   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+6",
     "cond": "each clean reading at or after the 120 s warm-up",
     "effect": "loop; earlier readings are not fed in"
    },
    {
     "at": "+8",
     "cond": "no previous post-warm-up reading",
     "effect": "skip (records it as previous via defer)"
    }
   ],
