    "Shaded band = mean ±1 SD across these readings. Dots outside the band are the days worth a closer look." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النطاق المظلَّل = المتوسط ±1 SD عبر هذه القراءات. النقاط خارج النطاق هي الأيام التي تستحق نظرة أدق."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skraveret bånd = gennemsnit ±1 SD på tværs af disse målinger. Prikker uden for båndet er de dage, der er værd at se nærmere på."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schattiertes Band = Mittelwert ±1 SD über diese Messwerte. Punkte außerhalb des Bandes sind die Tage, die einen genaueren Blick wert sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banda sombreada = media ±1 SD de estas lecturas. Los puntos fuera de la banda son los días que merecen una mirada más detenida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varjostettu alue = keskiarvo ±1 SD näistä lukemista. Alueen ulkopuoliset pisteet ovat päiviä, joita kannattaa tarkastella lähemmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bande ombrée = moyenne ±1 SD sur ces mesures. Les points en dehors de la bande sont les jours méritant un examen plus attentif."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skyggð rönd = meðaltal ±1 SD yfir þessar mælingar. Punktar utan randar eru dagarnir sem vert er að skoða nánar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banda ombreggiata = media ±1 SD su queste letture. I punti fuori dalla banda sono i giorni che meritano un'analisi più approfondita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "陰影付きの帯 = これらの測定値の平均 ±1 SD。帯の外側の点は、より詳しく確認する価値のある日です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "음영 처리된 띠 = 이 측정값들의 평균 ±1 SD. 띠 밖의 점은 더 자세히 살펴볼 만한 날입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skyggelagt felt = gjennomsnitt ±1 SD over disse avlesningene. Prikker utenfor feltet er dagene som er verdt en nærmere titt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gearceerde band = gemiddelde ±1 SD over deze metingen. Punten buiten de band zijn de dagen die een nadere blik waard zijn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faixa sombreada = média ±1 SD entre essas leituras. Os pontos fora da faixa são os dias que merecem um olhar mais atento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затененная полоса = среднее ±1 SD по этим показаниям. Точки за пределами полосы — дни, заслуживающие более пристального внимания."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skuggat band = medelvärde ±1 SD över dessa avläsningar. Punkter utanför bandet är de dagar som är värda en närmare titt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "阴影带 = 这些读数的平均值 ±1 SD。带外的点是值得仔细查看的日子。"
          }
        }
      }
    },
