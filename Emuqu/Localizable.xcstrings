    "Higher values (5-25%) indicate greater parasympathetic activity and recovery. Very low values (<2%) suggest autonomic suppression." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القيم الأعلى (5-25%) تدل على نشاط نظير ودي أكبر وتعافٍ أفضل. القيم المنخفضة جدًا (<2%) توحي بكبت ذاتي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højere værdier (5-25%) indikerer større parasympatisk aktivitet og restitution. Meget lave værdier (<2%) tyder på autonom undertrykkelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höhere Werte (5-25%) zeigen mehr parasympathische Aktivität und Erholung an. Sehr niedrige Werte (<2%) sprechen für eine autonome Unterdrückung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
