  {
   "key": "func Verification.classifyArtifacts(points:flags:)",
   "hash": "3fd0447e0e611172",
   "does": "Over min(points, flags) indices flagged artifact: counts them, ectopic/extra/missed → ectopy count; technical → OOB low/high count by RR; artifact% = that bounded artifact count / points × 100.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Analysis/Verification.swift::func Verification.countOutOfBounds(_:low:high:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "flag isArtifact (index within both arrays)",
     "effect": "artifactCount += 1 and classified; else skipped"
    },
    {
     "at": "+5",
     "cond": "type ectopic/extra/missed",
     "effect": "ectopyCount += 1"
    },
    {
     "at": "+7",
     "cond": "type technical",
     "effect": "countOutOfBounds"
    },
    {
     "at": "+9",
     "cond": "type none or nil",
     "effect": "ignored"
    }
   ],
   "deps": {
    "Emuqu/Sources/Analysis/Verification.swift::func Verification.countOutOfBounds(_:low:high:)": "56c56c66320ff457"
   }
