   "key": "func RRWindowSweep.range(start:end:)",
   "hash": "4aa0540df93fcffd",
   "does": "Advances lo to the first point with t_ms >= start and hi to the first with t_ms >= end (never rewinding) and returns lo..<hi.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "lo < count && t_ms < start",
     "effect": "advance lo"
    },
    {
     "at": "+4",
     "cond": "hi < lo",
     "effect": "hi = lo"
    },
    {
     "at": "+5",
     "cond": "hi < count && t_ms < end",
     "effect": "advance hi"
    }
   ],
