    "Trend: Declining — sleep quality has dropped recently." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاتجاه: متراجع — انخفضت جودة النوم مؤخرًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendens: faldende — søvnkvaliteten er faldet på det seneste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trend: rückläufig — die Schlafqualität ist zuletzt gesunken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendencia: en descenso — la calidad del sueño ha bajado últimamente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trendi: laskeva — unen laatu on heikentynyt viime aikoina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendance : en baisse — la qualité du sommeil a chuté récemment."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þróun: lækkandi — svefngæði hafa versnað nýlega."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendenza: in calo — la qualità del sonno è peggiorata di recente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傾向: 低下中 — 最近、睡眠の質が落ちています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추세: 하락 — 최근 수면의 질이 떨어졌습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trend: synkende — søvnkvaliteten har falt i det siste."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trend: dalend — slaapkwaliteit is recent gedaald."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendência: em queda — a qualidade do sono caiu recentemente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренд: снижается — качество сна недавно упало."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trend: sjunkande — sömnkvaliteten har försämrats nyligen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "趋势：下降 — 近期睡眠质量变差。"
          }
        }
      }
    },
