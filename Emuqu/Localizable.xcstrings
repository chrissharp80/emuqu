    "Emuqu has no accounts and no server of its own, so the developer holds nothing to delete." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحتوي Emuqu على حسابات ولا خادم خاص به، لذا لا يحتفظ المطوّر بأي شيء يمكن حذفه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu har ingen konti og ingen egen server, så udvikleren opbevarer intet, der skal slettes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu hat keine Konten und keinen eigenen Server, daher speichert der Entwickler nichts, was gelöscht werden könnte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu no tiene cuentas ni servidor propio, así que el desarrollador no guarda nada que eliminar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqussa ei ole tilejä eikä omaa palvelinta, joten kehittäjällä ei ole mitään poistettavaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu n’a ni comptes ni serveur propre, le développeur ne détient donc rien à supprimer."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu er ekki með neina reikninga né eigin netþjón, svo forritarinn geymir ekkert sem hægt er að eyða."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu non ha account né un proprio server, quindi lo sviluppatore non detiene nulla da eliminare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu にはアカウントも独自のサーバーもないため、開発者が保有していて削除すべきものはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu에는 계정도 자체 서버도 없으므로 개발자가 보유하고 있어 삭제할 데이터가 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu har ingen kontoer og ingen egen server, så utvikleren har ingenting som kan slettes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu heeft geen accounts en geen eigen server, dus de ontwikkelaar bewaart niets dat verwijderd kan worden."
          }
        },
