  {
   "key": "func SleepHealthQueries.episodeSeconds(_:floorSeconds:)",
   "hash": "76d6f199d31f21c1",
   "does": "Unions an episode's start-sorted intervals so overlaps count once and returns the summed seconds if >= floorSeconds, else 0.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "episode empty",
     "effect": "returns 0"
    },
    {
     "at": "+3",
     "cond": "for each interval",
     "effect": "iterates"
    },
    {
     "at": "+4",
     "cond": "there is a merged last interval and this one starts at or before its end",
     "effect": "extends the last merged interval's end; else appends a new merged interval"
    },
    {
     "at": "+12",
     "cond": "merged duration >= floorSeconds",
