          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staðalfrávik púlsgilda. Mælir hversu mikið púlsinn sveiflaðist í upptökunni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La deviazione standard dei valori di frequenza cardiaca. Misura quanto la tua FC ha oscillato durante la registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
