   "hash": "8d738df8eb75450f",
   "does": "Advances the run accumulator with one delta: flat ignored, first graded step opens a run, same sign accumulates, opposite sign commits the current run and opens a new one.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Analysis/TopoElevationService.swift::func TopoElevationService.ClimbRun.commit(threshold:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "delta > 0 / delta < 0 (nested ?:)",
     "effect": "sign = 1, -1, or 0 for flat"
    },
    {
     "at": "+2",
     "cond": "sign == 0",
     "effect": "return without changing the run (flat is not a reversal)"
    },
    {
     "at": "+3",
     "cond": "no run open yet (runSign == 0)",
     "effect": "start a run with this delta"
    },
    {
     "at": "+6",
     "cond": "same sign as the open run",
     "effect": "accumulate; else (reversal) commit the run and start a new one with this delta"
    }
