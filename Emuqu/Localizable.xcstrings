    "Your data shows a notable pattern. The cause is for you to investigate." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُظهر بياناتك نمطًا لافتًا. معرفة السبب أمر متروك لك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine data viser et bemærkelsesværdigt mønster. Årsagen er op til dig at undersøge."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten zeigen ein auffälliges Muster. Der Ursache kannst du selbst nachgehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos muestran un patrón notable. La causa es algo que te toca investigar a ti."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedoissasi näkyy huomattava kuvio. Syyn selvittäminen jää sinulle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données montrent une tendance notable. C'est à vous d'en chercher la cause."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gögnin þín sýna eftirtektarvert mynstur. Það er þitt að kanna orsökina."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati mostrano un andamento degno di nota. Sta a te indagarne la causa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのデータには目立つパターンが見られます。その原因はご自身で確かめてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터에 눈에 띄는 패턴이 보입니다. 원인은 직접 살펴보세요."
          }
        },
        "nb" : {
          "stringUnit" : {
