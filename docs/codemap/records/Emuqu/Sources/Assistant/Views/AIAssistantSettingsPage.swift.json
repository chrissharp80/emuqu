    "Emuqu/Sources/Assistant/Keys/APIKeyStore.swift::var APIKeyStore.hasWebSearchRoute",
    "Emuqu/Sources/Utilities/AppDependencies.swift::var AppDependencies.app",
    "Emuqu/Sources/Utilities/AppDependencies.swift::var UtilityServices.settingsManager",
    "closure:onChange — AIAssistantSettingsPage.keysChanged",
    "Emuqu/Sources/Assistant/Views/AIAssistantSettingsPage.swift::func AIAssistantSettingsPage.keysChanged()",
    "Emuqu/Sources/Assistant/Keys/APIKeyStore.swift::func APIKeyStore.hasKey(for:)",
    "Emuqu/Sources/Utilities/DebugLog.swift::func debugLog(_:level:file:line:)"
   ],
   "reads": [],
   "writes": [
    "kc:com.chrissharp.flowrecovery.assistant.apikey/<provider>",
    "ud:assistant.consent.v8.<provider>",
    "ud:assistant.consent.v8.<provider>.grantedAt"
   ],
   "branches": [
    {
     "at": "+3",
     "cond": "keychain delete failed",
     "effect": "log warning"
    },
    {
     "at": "+9",
     "cond": "removed AND !APIKeyStore.hasWebSearchRoute (no Tavily key and no Anthropic key left)",
     "effect": "settings.enableWebSearch = false (persisted by SettingsManager didSet)"
    },
    {
     "at": "+13",
     "cond": "removed",
     "effect": "saveStatus .removed ('Key removed.'); else .idle (masked preview of the still-saved key)"
    }
   ],
   "deps": {
    "Emuqu/Sources/Assistant/Keys/APIKeyStore.swift::func APIKeyStore.hasKey(for:)": "bbe507a5eefd664e",
