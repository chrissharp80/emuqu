{
 "file": "Emuqu/Sources/Services/DemoSessionSeeder.swift",
 "hash": "4491b9dad97db79e",
 "role": "Deterministic generator of 21 synthetic overnight sessions (RR beats from a hypnogram + beat model) run through the app's own sleep estimator, analysis and scoring, archived with a fixed Demo tag; plus removal of sample nights. Invoked only by SampleDataLibrary on user request.",
 "types": [
  "DemoSessionSeeder: enum — seeding/removal namespace",
  "DemoSessionSeeder.NightPipeline: struct — injected analyze/estimateSleep closures",
  "DemoSessionSeeder.NightPlan: struct — per-night parameters (index, start, end, recovery, breaths/min, tags)",
  "DemoSessionSeeder.HardNight: struct (private) — scripted bad night",
  "DemoSessionSeeder.Hypnogram: struct — stage sequence as end offsets",
  "DemoSessionSeeder.StageTarget: struct (private) — per-stage beat modifiers",
  "DemoSessionSeeder.BeatModel: struct (private) — eased beat generator state",
  "DemoSessionSeeder.SampleRandom: struct — seeded SplitMix64 RNG"
 ],
 "state": [
  "demoTagId = 5A3D0000-DE30-4000-8000-000000000001 (static, fixed tag id)",
  "defaultNightCount = 21",
  "occupancyPadding = 3 h",
  "parallelNights = 3",
