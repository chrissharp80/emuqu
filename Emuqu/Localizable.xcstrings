    "You're ready for the summer heat — keep training outdoors a couple of times a week to hold it." : {
      "comment" : "A line in the HeatAcclimationCard explaining that the user is ready for the summer heat and to keep training outdoors.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت جاهز لحرّ الصيف — واصل التدريب في الخارج مرتين أسبوعيًا للحفاظ على ذلك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er klar til sommervarmen — fortsæt med at træne udendørs et par gange om ugen for at holde det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist bereit für die Sommerhitze — trainiere weiterhin ein paar Mal pro Woche draußen, um das zu halten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás listo para el calor del verano — sigue entrenando al aire libre un par de veces por semana para mantenerlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet valmis kesähelteeseen — jatka ulkoharjoittelua pari kertaa viikossa säilyttääksesi tason."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes prêt pour la chaleur estivale — continuez à vous entraîner dehors deux fois par semaine pour la maintenir."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú ert tilbúinn fyrir sumarhitann — haltu áfram að æfa utandyra tvisvar í viku til að viðhalda því."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei pronto per il caldo estivo — continua ad allenarti all’aperto un paio di volte a settimana per mantenerlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夏の暑さへの準備は万全です — 週に 2 回ほど屋外で練習を続けて維持しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여름 더위에 대비가 되었습니다 — 주 2회 정도 야외 훈련을 이어가 유지하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er klar for sommervarmen — fortsett å trene ute et par ganger i uken for å holde på det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent klaar voor de zomerhitte — blijf een paar keer per week buiten trainen om dat vast te houden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está pronto para o calor do verão — continue treinando ao ar livre algumas vezes por semana para manter."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы готовы к летней жаре — продолжайте тренироваться на улице пару раз в неделю, чтобы сохранить это."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du är redo för sommarvärmen — fortsätt träna utomhus ett par gånger i veckan för att behålla det."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已为夏季高温做好准备 — 每周保持两次左右的户外训练即可维持。"
          }
        }
      }
    },
