    "Hide if you only use Emuqu for HRV / overnight recovery and don't record workouts." : {
      "comment" : "A description of the \"Hide Fitness tab\" setting, for users who only use Emuqu for HRV or overnight recovery and don't record workouts.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخفِ هذا إذا كنت تستخدم Emuqu لقياس HRV / التعافي الليلي فقط ولا تسجّل التمارين."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul, hvis du kun bruger Emuqu til HRV/restitution om natten og ikke optager træninger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausblenden, wenn du Emuqu nur für HRV / nächtliche Erholung nutzt und keine Trainings aufzeichnest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta esto si solo usas Emuqu para HRV / recuperación nocturna y no registras entrenamientos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piilota, jos käytät Emuqua vain HRV:hen / yölliseen palautumiseen etkä tallenna harjoituksia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquez si vous utilisez Emuqu uniquement pour le HRV / la récupération nocturne et n'enregistrez pas de séances."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faldu ef þú notar Emuqu aðeins fyrir HRV / endurheimt yfir nótt og tekur ekki upp æfingar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nascondi se usi Emuqu solo per HRV / recupero notturno e non registri allenamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu を HRV や夜間の回復のみに使用し、ワークアウトを記録しない場合は非表示にします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu를 HRV / 야간 회복에만 사용하고 운동을 기록하지 않는 경우 숨기세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skjul hvis du bare bruker Emuqu til HRV / restitusjon over natten og ikke registrerer økter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verberg dit als je Emuqu alleen gebruikt voor HRV / nachtelijk herstel en geen workouts opneemt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculte se você usa o Emuqu apenas para HRV / recuperação noturna e não registra treinos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скройте, если используете Emuqu только для ВСР / ночного восстановления и не записываете тренировки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dölj om du bara använder Emuqu för HRV / återhämtning över natten och inte spelar in träningspass."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你只用 Emuqu 进行 HRV / 夜间恢复而不记录训练，可将其隐藏。"
          }
        }
      }
