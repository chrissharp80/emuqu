          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例如：腿沉、太热、开始太快"
          }
        }
      }
    },
    "e.g. tell me when 30 minutes have passed" : {
      "localizations" : {
