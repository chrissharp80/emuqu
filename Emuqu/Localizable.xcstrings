    "Note: ascent filter applies to saved routes only — OSM doesn't include elevation per-trail. Discover-tab results filter by length above." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملاحظة: مرشّح الصعود ينطبق على المسارات المحفوظة فقط — لا يتضمّن OSM الارتفاع لكل مسار. تُصفّى نتائج تبويب الاستكشاف حسب الطول أعلاه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bemærk: stigningsfilteret gælder kun gemte ruter — OSM indeholder ikke højde pr. sti. Resultater på Opdag-fanen filtreres efter længde ovenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: Der Anstiegsfilter gilt nur für gespeicherte Routen — OSM enthält keine Höhenangaben pro Weg. Ergebnisse im Tab „Entdecken“ werden oben nach Länge gefiltert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: el filtro de ascenso solo se aplica a las rutas guardadas — OSM no incluye la elevación por sendero. Los resultados de la pestaña Descubrir se filtran por longitud arriba."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Huomaa: noususuodatin koskee vain tallennettuja reittejä — OSM ei sisällä korkeustietoa polkukohtaisesti. Löydä-välilehden tulokset suodatetaan pituuden mukaan yllä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remarque : le filtre de dénivelé s'applique uniquement aux itinéraires enregistrés — OSM n'inclut pas l'altitude par sentier. Les résultats de l'onglet Découvrir sont filtrés par longueur ci-dessus."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Athugið: hækkunarsían gildir aðeins um vistaðar leiðir — OSM inniheldur ekki hæð fyrir hverja slóð. Niðurstöður á Uppgötva-flipanum eru síaðar eftir lengd að ofan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: il filtro del dislivello si applica solo ai percorsi salvati — OSM non include l'altitudine per ogni sentiero. I risultati della scheda Scopri sono filtrati per lunghezza qui sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：獲得標高フィルタは保存済みルートにのみ適用されます — OSM はトレイルごとの標高を含みません。発見タブの結果は上記の距離でフィルタされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참고: 상승 필터는 저장된 경로에만 적용됩니다 — OSM에는 트레일별 고도가 포함되지 않습니다. 둘러보기 탭 결과는 위의 길이로 필터링됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merk: stigningsfilteret gjelder bare lagrede ruter — OSM inkluderer ikke høyde per sti. Resultater i Oppdag-fanen filtreres etter lengde ovenfor."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let op: het stijgingsfilter geldt alleen voor opgeslagen routes — OSM bevat geen hoogte per pad. Resultaten op het tabblad Ontdekken worden hierboven op lengte gefilterd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observação: o filtro de subida se aplica apenas a rotas salvas — o OSM não inclui altitude por trilha. Os resultados da aba Descobrir são filtrados por comprimento acima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Примечание: фильтр по набору высоты применяется только к сохранённым маршрутам — OSM не содержит данных о высоте по каждой тропе. Результаты на вкладке «Обзор» фильтруются по длине выше."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obs: stigningsfiltret gäller endast sparade rutter — OSM inkluderar inte höjd per led. Resultat på fliken Upptäck filtreras efter längd ovan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "注意：爬升筛选仅适用于已保存的路线 — OSM 不包含每条小径的海拔数据。发现标签页的结果按上方的长度筛选。"
          }
        }
      }
    },
