    "Uncommon at rest. Read it next to your other metrics rather than on its own" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير شائع أثناء الراحة. اقرأه مع مقاييسك الأخرى لا بمفرده"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usædvanligt i hvile. Læs det sammen med dine andre målinger frem for alene"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Ruhe ungewöhnlich. Lies den Wert im Zusammenhang mit deinen anderen Metriken statt für sich allein"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poco habitual en reposo. Léelo junto a tus otras métricas y no por sí solo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harvinainen levossa. Lue se muiden mittareidesi rinnalla eikä yksinään"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inhabituel au repos. À lire avec vos autres métriques plutôt qu’isolément"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Óalgengt í hvíld. Lestu það í samhengi við aðrar mælingar frekar en eitt og sér"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poco comune a riposo. Leggilo insieme alle altre metriche, non da solo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安静時にはあまり見られません。単独ではなく、他の指標と合わせて読み取ってください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안정 시에는 드뭅니다. 단독으로 보지 말고 다른 지표와 함께 읽으세요"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvanlig i hvile. Les det sammen med de andre måltallene dine i stedet for alene"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ongebruikelijk in rust. Lees het samen met je andere waarden in plaats van los"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incomum em repouso. Leia junto com suas outras métricas, e não isoladamente"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нетипично в покое. Оценивайте рядом с другими показателями, а не отдельно"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovanligt i vila. Läs det tillsammans med dina andra mått snarare än för sig"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静息时不常见。请结合你的其他指标来看，而不要单独解读"
          }
        }
      }
    },
