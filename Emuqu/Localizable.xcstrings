          "stringUnit" : {
            "state" : "translated",
            "value" : "Du låg över anaerob tröskel hela passet (%lld min vid α1 < 0,50). Mycket hög fysiologisk kostnad — endast korta, intensiva insatser."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整场训练你都处于无氧阈以上（α1 < 0.50 持续 %lld 分钟）。生理代价非常高 — 只适合短时高强度。"
          }
        }
      }
    },
    "You're connected. Sleep + vitals + workouts will start populating tonight." : {
      "comment" : "A confirmation message displayed when HealthKit",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت متصل الآن. ستبدأ بيانات النوم + العلامات الحيوية + التمارين بالظهور الليلة."
          }
        },
        "da" : {
