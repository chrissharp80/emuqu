          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gegevens zijn opgeslagen. De coach analyseert zodra je weer verbinding hebt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
