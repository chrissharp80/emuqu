    },
    "Well above your usual range. A good day to train hard if you want to." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعلى بكثير من نطاقك المعتاد. يوم جيد للتدريب بقوة إن أردت."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et godt stykke over dit sædvanlige område. En god dag at træne hårdt, hvis du har lyst."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deutlich über deinem üblichen Bereich. Ein guter Tag für hartes Training, wenn du willst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muy por encima de tu rango habitual. Un buen día para entrenar fuerte si te apetece."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selvästi tavanomaisen vaihteluvälisi yläpuolella. Hyvä päivä kovalle harjoitukselle, jos haluat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bien au-dessus de votre plage habituelle. Une bonne journée pour vous entraîner dur si vous le souhaitez."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vel yfir venjulegu bili þínu. Góður dagur til að æfa stíft ef þú vilt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ben al di sopra del tuo intervallo abituale. Un buon giorno per allenarti duro, se vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつもの範囲を大きく上回っています。その気があれば、ハードにトレーニングするのに良い日です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평소 범위보다 훨씬 높습니다. 원한다면 강하게 훈련하기 좋은 날입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godt over det vanlige området ditt. En god dag å trene hardt hvis du vil."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruim boven je gebruikelijke bereik. Een goede dag om hard te trainen als je dat wilt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bem acima da sua faixa habitual. Um bom dia para treinar forte, se você quiser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значительно выше вашего обычного диапазона. Хороший день для тяжёлой тренировки, если хотите."
          }
