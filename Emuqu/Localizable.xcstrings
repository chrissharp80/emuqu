          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DFA α1 se mantuvo por encima de 0,75 todo el rato — territorio de base aeróbica pura, justo lo que busca el trabajo en Z2."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DFA α1 pysyi yli 0,75 koko ajan — puhdasta aerobista peruskuntoaluetta, juuri sitä mihin Z2-työ tähtää."
