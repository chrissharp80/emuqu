   "reads": [
    "archive:SessionArchive.entries",
    "archive:SessionArchive.retrieveLightweight"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+7",
     "cond": "baseline nights < count",
     "effect": "keep reading; stop at 60 distinct baseline nights"
    },
    {
     "at": "+8",
     "cond": "decode fails",
     "effect": "skipped"
    },
    {
     "at": "+11",
     "cond": "night before the reported one and isBaselineCandidate",
     "effect": "its nightKey counts toward the 60"
    }
