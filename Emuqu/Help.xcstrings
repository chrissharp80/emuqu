        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando hai almeno un segnale vitale (frequenza respiratoria, temperatura del polso od ossigeno nel sangue). I pesi compositi sono HRV 60%, Sonno 25% e Parametri vitali 15%."
          }
        },
        "ja" : {
          "stringUnit" : {
