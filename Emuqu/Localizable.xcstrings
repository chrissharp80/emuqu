    "Pa:Hr decoupling %@ > 7 %% benchmark — review for dehydration, heat stress, or insufficient base fitness for this duration." : {
      "comment" : "A flag to add to a workout PDF if the The argument is the string “%+.1f %%”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انفكاك Pa:Hr %@ يتجاوز معيار 7 %% — راجع احتمال الجفاف أو الإجهاد الحراري أو نقص القاعدة اللياقية لهذه المدة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr-afkobling %@ over 7 %%-benchmarket — vurdér dehydrering, varmestress eller utilstrækkelig grundform til denne varighed."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr-Entkopplung %@ über dem 7 %%-Richtwert — prüfe Dehydrierung, Hitzestress oder eine für diese Dauer unzureichende Grundlagenfitness."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desacoplamiento Pa:Hr %@ por encima del valor de referencia del 7 %% — revisa deshidratación, estrés por calor o base aeróbica insuficiente para esta duración."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr-irtikytkentä %@ ylittää 7 %%:n vertailuarvon — tarkastele kuivumista, lämpökuormaa tai riittämätöntä peruskuntoa tälle kestolle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découplage Pa:Hr %@ au-dessus du repère de 7 %% — examinez déshydratation, stress thermique ou base aérobie insuffisante pour cette durée."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pa:Hr-aftenging %@ yfir 7 %% viðmiði — skoðaðu vökvaskort, hitaálag eða ónógan grunn fyrir þessa lengd."
          }
        },
        "it" : {
