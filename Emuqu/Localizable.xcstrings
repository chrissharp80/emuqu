    "VO2max personalizes your age-adjusted HRV ranges. Override if you have a lab-tested value." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُخصص VO2max نطاقات HRV المعدّلة حسب العمر. تجاوز القيمة إذا كان لديك قيمة مختبرة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO2max personaliserer dine aldersjusterede HRV-intervaller. Tilsidesæt, hvis du har en laboratorietestet værdi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO2max personalisiert deine altersangepassten HRV-Bereiche. Überschreibe den Wert, wenn du einen laborgetesteten Wert hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El VO2max personaliza tus rangos de HRV ajustados por edad. Introduce un valor manual si tienes uno medido en laboratorio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO2max mukauttaa ikävakioituja HRV-alueita. Ohita, jos sinulla on laboratoriotestiarvo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le VO2max personnalise vos plages HRV ajustées à l'âge. Remplacez si vous avez une valeur testée en laboratoire."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO2max sérsniður aldursaðlöguð HRV-svið. Hnektu ef þú hefur rannsóknarstofugildi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il VO2max personalizza gli intervalli HRV corretti per età. Sovrascrivere se si dispone di un valore testato in laboratorio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO2maxは年齢調整されたHRV範囲をパーソナライズします。ラボ測定値がある場合は上書きしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO2max는 나이 조정 HRV 범위를 개인화합니다. 실험실 측정값이 있으면 재정의하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO2max personaliserer dine aldersjusterte HRV-spenn. Overstyr hvis du har en labtestet verdi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO2max personaliseert uw leeftijdsafhankelijke HRV-bereiken. Overschrijf als u een laboratoriumwaarde heeft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O VO2max personaliza suas faixas de HRV ajustadas por idade. Substitua se tiver um valor testado em laboratório."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO2max персонализирует ваши возрастные диапазоны ВСР. Переопределите, если у вас есть лабораторно подтверждённое значение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO2max anpassar dina åldersjusterade HRV-intervall. Överstyr om du har ett laboratorietest-värde."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO2max用于个性化你的年龄调整HRV范围。如有实验室测试值可覆盖。"
          }
        }
      }
    },
    "VO₂max · max aerobic power, short-duration tolerance" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VO₂max · أقصى قدرة هوائية، تحمل قصير المدة"
          }
        },
        "da" : {
