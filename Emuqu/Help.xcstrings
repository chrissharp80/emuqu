        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نسبة الوقت في السرير الذي كنت فيه نائمًا فعلًا، مُقيَّمة مقابل معايير معدّلة حسب العمر إذا كان تاريخ ميلادك مضبوطًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andel af tiden i sengen, hvor du faktisk sov, vurderet mod aldersjusterede normer, hvis din fødselsdag er angivet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteil der Zeit im Bett, in der du tatsächlich geschlafen hast, bewertet anhand altersangepasster Normen, wenn dein Geburtstag eingetragen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porcentaje del tiempo en la cama que estuviste realmente dormido, puntuado según normas ajustadas por edad si has indicado tu fecha de nacimiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosenttiosuus sängyssä vietetystä ajasta, jonka todella nukuit, pisteytettynä ikäkorjattuja normeja vasten, jos syntymäpäiväsi on asetettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourcentage du temps passé au lit pendant lequel vous dormiez réellement, évalué par rapport à des normes ajustées à l’âge si votre date de naissance est renseignée."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlutfall tímans í rúminu sem þú svafst í raun, metið miðað við aldursleiðrétt viðmið ef afmælisdagurinn þinn er skráður."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percentuale del tempo a letto in cui hai effettivamente dormito, valutata rispetto a norme per età se hai impostato la data di nascita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ベッドにいた時間のうち実際に眠っていた時間の割合で、誕生日が設定されていれば年齢補正した基準に照らして評価されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "침대에 있던 시간 중 실제로 잠든 시간의 비율이며, 생일이 설정되어 있으면 연령 보정 기준으로 점수를 매깁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prosentandelen av tiden i sengen da du faktisk sov, vurdert mot aldersjusterte normer hvis bursdagen din er angitt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Percentage van de tijd in bed dat je echt sliep, beoordeeld tegen leeftijdsnormen als je geboortedatum is ingesteld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porcentagem do tempo na cama em que você realmente dormiu, avaliada em relação às normas ajustadas para a idade se sua data de nascimento estiver definida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доля времени в постели, когда вы действительно спали; оценивается по возрастным нормам, если указана дата рождения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Andel av tiden i sängen som du faktiskt sov, bedömd mot åldersjusterade normer om din födelsedag är angiven."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "卧床时间中实际睡着的百分比；如果设置了生日，会按年龄调整后的常模评分。"
          }
        }
      }
    },
