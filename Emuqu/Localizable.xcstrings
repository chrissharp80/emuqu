    "e.g. heavy legs, too hot, started too fast" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثال: ثقل في الساقين، حر شديد، بدأت بسرعة كبيرة"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "f.eks. tunge ben, for varmt, startede for hurtigt"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "z. B. schwere Beine, zu heiß, zu schnell gestartet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "p. ej. piernas pesadas, demasiado calor, empecé demasiado rápido"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "esim. raskaat jalat, liian kuuma, lähdin liian kovaa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "p. ex. jambes lourdes, trop chaud, parti trop vite"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "t.d. þungir fætur, of heitt, byrjaði of hratt"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ad es. gambe pesanti, troppo caldo, partito troppo veloce"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "例：脚が重い、暑すぎる、最初に飛ばしすぎた"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "예: 다리가 무거움, 너무 더움, 너무 빨리 시작함"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "f.eks. tunge bein, for varmt, startet for raskt"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "bijv. zware benen, te warm, te snel gestart"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ex.: pernas pesadas, calor demais, comecei rápido demais"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "напр. тяжёлые ноги, слишком жарко, слишком быстрый старт"
          }
        },
        "sv" : {
