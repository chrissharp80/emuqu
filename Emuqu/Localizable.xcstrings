    "Streaming only. Waking analysis uses BLE data and skips strap memory fetch." : {
      "comment" : "Help text explaining the \"Live stream only\" extended capture mode.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بث فقط. يستخدم تحليل الاستيقاظ بيانات BLE ويتخطى جلب ذاكرة الحزام."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun streaming. Vågneanalysen bruger BLE-data og springer hentning fra pulsbæltets hukommelse over."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Streaming. Die Aufwach-Analyse nutzt BLE-Daten und überspringt das Auslesen des Gurtspeichers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo transmisión. El análisis al despertar usa datos BLE y omite la descarga de la memoria de la banda."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain suoratoisto. Herätysanalyysi käyttää BLE-dataa ja ohittaa pannan muistin noudon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diffusion uniquement. L’analyse au réveil utilise les données BLE et ignore la mémoire de la ceinture."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aðeins streymi. Vöknunargreining notar BLE-gögn og sleppir sókn í minni ólarinnar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo streaming. L’analisi al risveglio usa i dati BLE e salta il recupero dalla memoria della fascia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストリーミングのみ。起床時の解析は BLE データを使い、ストラップのメモリ取得は行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스트리밍 전용. 기상 분석은 BLE 데이터를 사용하며 스트랩 메모리 가져오기는 건너뜁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun strømming. Våknings-analysen bruker BLE-data og hopper over henting fra pulsbeltets minne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen streamen. De ontwaakanalyse gebruikt BLE-gegevens en slaat het ophalen uit het bandgeheugen over."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas streaming. A análise ao acordar usa dados BLE e ignora a busca na memória da cinta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Только потоковая передача. Утренний анализ использует данные BLE и пропускает чтение памяти датчика."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast strömning. Uppvaknandeanalysen använder BLE-data och hoppar över hämtning ur pulsbandets minne."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅串流。醒来后的分析使用 BLE 数据，不读取心率带内存。"
          }
        }
      }
    },
