  {
   "key": "func FTPAutoEstimator.bestTwentyMinuteMeanPower(_:)",
   "hash": "22e967800d7238e1",
   "does": "Builds a per-second power array and slides a 1200-s window over it, returning the highest mean of power readings among windows where >= 1080 seconds carry a reading; nil if the series is shorter than 1200 s or no window qualifies.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Analysis/FTPAutoEstimator.swift::func FTPAutoEstimator.perSecondPower(_:)",
    "Emuqu/Sources/Analysis/FTPAutoEstimator.swift::func FTPAutoEstimator.RollingPower.add(_:)",
    "Emuqu/Sources/Analysis/FTPAutoEstimator.swift::func FTPAutoEstimator.RollingPower.remove(_:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+3",
     "cond": "perSecond.count >= 1200",
     "effect": "false: nil; true: scans"
    },
    {
     "at": "+7",
     "cond": "for each second",
     "effect": "adds the reading to the rolling window"
    },
    {
     "at": "+9",
     "cond": "second >= window",
     "effect": "removes the reading leaving the window; else window still filling"
    },
    {
     "at": "+10",
     "cond": "window full (second >= 1199) and readings >= 1080",
     "effect": "false: continue; true: best = max(best ?? 0, mean)"
    },
    {
     "at": "+11",
     "cond": "best ?? 0",
     "effect": "0 used as the seed when no window has qualified yet"
    }
   ],
   "flags": [],
   "deps": {
    "Emuqu/Sources/Analysis/FTPAutoEstimator.swift::func FTPAutoEstimator.RollingPower.add(_:)": "5cd28b3328c5acce",
    "Emuqu/Sources/Analysis/FTPAutoEstimator.swift::func FTPAutoEstimator.RollingPower.remove(_:)": "c402751b2f9ac913",
