    "Could not recover any sessions. The backup data may be incomplete or corrupted." : {
      "comment" : "Message displayed when no sessions are successfully recovered from a backup.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر استرداد أي جلسات. قد تكون بيانات النسخة الاحتياطية ناقصة أو تالفة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunne ikke gendanne nogen sessioner. Backup-data er måske ufuldstændige eller beskadigede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es konnten keine Sitzungen wiederhergestellt werden. Die Sicherungsdaten sind möglicherweise unvollständig oder beschädigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo recuperar ninguna sesión. Los datos de la copia de seguridad pueden estar incompletos o dañados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhtään istuntoa ei voitu palauttaa. Varmuuskopion tiedot voivat olla puutteellisia tai vioittuneita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune séance n’a pu être récupérée. Les données de sauvegarde sont peut-être incomplètes ou corrompues."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekki tókst að endurheimta neinar lotur. Afritsgögnin gætu verið ófullkomin eða skemmd."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile recuperare alcuna sessione. I dati di backup potrebbero essere incompleti o corrotti."
          }
        },
        "ja" : {
