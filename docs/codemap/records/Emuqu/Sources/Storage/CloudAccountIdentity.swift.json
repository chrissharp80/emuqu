   ],
   "reads": [
    "mem:CloudKitSyncState.uploadedSessionIds",
    "ck:HRVSession records (isDeleted only)"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "nothing uploaded",
     "effect": "absent, no request"
    },
    {
     "at": "+6",
     "cond": "records fetched",
     "effect": "attribution(of:): found / absent / unknown"
