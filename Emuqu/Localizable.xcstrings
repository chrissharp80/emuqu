    "Athletic range for adults — but recovery reads this vs. your OWN recent baseline, not the absolute value" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نطاق رياضي للبالغين — لكن التعافي يقرأ هذا مقارنةً بخط أساسك أنت الأخير، لا بالقيمة المطلقة"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atletisk interval for voksne — men restitutionen læser dette mod DIN egen seneste baseline, ikke den absolutte værdi"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sportlicher Bereich für Erwachsene — die Erholung bewertet dies jedoch gegenüber DEINER eigenen jüngsten Baseline, nicht dem Absolutwert"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rango atlético para adultos — pero la recuperación lo compara con TU propia línea base reciente, no con el valor absoluto"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urheilijoiden vaihteluväli aikuisilla — mutta palautuminen suhteuttaa tämän SINUN omaan viimeaikaiseen perustasoosi, ei absoluuttiseen arvoon"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plage athlétique chez l’adulte — mais la récupération le compare à VOTRE propre référence récente, pas à la valeur absolue"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Íþróttabil fyrir fullorðna — en endurheimt les þetta á móti ÞINNI eigin nýlegu grunnlínu, ekki algildu gildi"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intervallo atletico per adulti — ma il recupero lo confronta con la TUA baseline recente, non con il valore assoluto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成人のアスリート域 — ただし回復指標は絶対値ではなく、あなた自身の直近ベースラインと比較して判断します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "성인의 운동선수 범위 — 다만 회복은 절대값이 아니라 당신 자신의 최근 기준선과 비교해 해석합니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atletisk område for voksne — men restitusjonen leser dette mot DIN egen nylige baseline, ikke absoluttverdien"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atletisch bereik voor volwassenen — maar herstel weegt dit tegen JOUW eigen recente basislijn, niet de absolute waarde"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faixa atlética para adultos — mas a recuperação lê isso frente à SUA própria linha de base recente, não ao valor absoluto"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спортивный диапазон для взрослых — но восстановление оценивает это относительно ВАШЕЙ собственной недавней базовой линии, а не абсолютного значения"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atletiskt intervall för vuxna — men återhämtningen läser detta mot DIN egen senaste baslinje, inte absolutvärdet"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成年人的运动员范围 — 但恢复指标看的是相对你自己近期基线的变化，而非绝对值"
          }
        }
      }
    },
