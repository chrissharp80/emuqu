    "The Verity Sense sends data in batches. The first reading usually arrives within 15-30 seconds." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل Verity Sense البيانات على دفعات. عادة ما تصل القراءة الأولى خلال 15-30 ثانية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
