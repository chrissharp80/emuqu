    "Your iPhone advertises as \"Emuqu\" so the receiving app can identify it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعلن iPhone عن نفسه باسم \"Emuqu\" حتى يتمكن التطبيق المستقبِل من التعرف عليه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din iPhone annoncerer sig som \"Emuqu\", så den modtagende app kan genkende den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein iPhone gibt sich als „Emuqu“ zu erkennen, damit die empfangende App es identifizieren kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu iPhone se anuncia como \"Emuqu\" para que la app receptora pueda identificarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone mainostaa itseään nimellä ”Emuqu”, jotta vastaanottava appi voi tunnistaa sen."
