    "Your HRV varies a lot day-to-day. This could mean inconsistent sleep or recovery patterns." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV لديك يتفاوت كثيرًا من يوم لآخر. قد يعني ذلك أنماط نوم أو تعافٍ غير منتظمة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din HRV svinger meget fra dag til dag. Det kan tyde på uregelmæssig søvn eller restitution."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine HRV schwankt von Tag zu Tag stark. Das kann auf unregelmäßigen Schlaf oder unregelmäßige Erholung hindeuten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu HRV varía mucho de un día a otro. Puede indicar un sueño o una recuperación irregulares."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV:si vaihtelee paljon päivästä toiseen. Se voi kertoa epäsäännöllisestä unesta tai palautumisesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre HRV varie beaucoup d'un jour à l'autre. Cela peut indiquer un sommeil ou une récupération irréguliers."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV hjá þér sveiflast mikið milli daga. Það gæti bent til óreglulegs svefns eða endurheimtar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua HRV varia molto da un giorno all'altro. Potrebbe indicare sonno o recupero irregolari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV が日によって大きく変動しています。睡眠や回復のパターンが不規則な可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV가 날마다 크게 달라집니다. 수면이나 회복 패턴이 일정하지 않다는 뜻일 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HRV-en din varierer mye fra dag til dag. Det kan tyde på ujevn søvn eller restitusjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je HRV wisselt sterk van dag tot dag. Dat kan wijzen op onregelmatige slaap- of herstelpatronen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua HRV varia muito de um dia para o outro. Isso pode indicar padrões de sono ou de recuperação irregulares."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша ВСР сильно меняется изо дня в день. Это может означать нерегулярный сон или восстановление."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din HRV varierar mycket från dag till dag. Det kan tyda på ojämn sömn eller återhämtning."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 HRV 每天波动很大。这可能意味着睡眠或恢复模式不规律。"
          }
        }
      }
    },
