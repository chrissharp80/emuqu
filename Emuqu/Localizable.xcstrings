    "Crossed aerobic threshold at %lld:%@ at %lld bpm. %lld min at threshold, %lld min easy." : {
      "comment" : "A card explaining a workout detail: the point in time when the user crossed the aerobic threshold, along with some context about that point. The argument is the string “%02d”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجاوزت العتبة الهوائية عند %lld:%@ بمعدل %lld نبضة/دقيقة. %lld دقيقة عند العتبة، و%lld دقيقة خفيفة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krydsede den aerobe tærskel ved %lld:%@ ved %lld bpm. %lld min ved tærskel, %lld min let."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aerobe Schwelle bei %lld:%@ mit %lld bpm überschritten. %lld Min an der Schwelle, %lld Min locker."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Crossed aerobic threshold at %1$lld:%2$@ at %3$lld bpm. %4$lld min at threshold, %5$lld min easy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cruce del umbral aeróbico a las %lld:%@ con %lld lpm. %lld min en umbral, %lld min suaves."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aerobinen kynnys ylitettiin kohdassa %lld:%@ sykkeellä %lld bpm. %lld min kynnyksellä, %lld min kevyttä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuil aérobie franchi à %lld:%@ à %lld bpm. %lld min au seuil, %lld min en aisance."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fór yfir loftháðan þröskuld við %lld:%@ á %lld slögum/mín. %lld mín við þröskuld, %lld mín rólegt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soglia aerobica superata a %lld:%@ a %lld bpm. %lld min in soglia, %lld min facili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld:%@、%lld bpm で有酸素性作業閾値を超えました。閾値域 %lld 分、イージー %lld 分。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld:%@에 %lld bpm으로 유산소 역치를 넘었습니다. 역치에서 %lld분, 이지 %lld분."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krysset aerob terskel ved %lld:%@ på %lld bpm. %lld min ved terskel, %lld min rolig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aerobe drempel gepasseerd om %lld:%@ bij %lld bpm. %lld min op drempel, %lld min rustig."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limiar aeróbio cruzado em %lld:%@ a %lld bpm. %lld min em limiar, %lld min leves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аэробный порог пересечён на %lld:%@ при %lld уд/мин. %lld мин на пороге, %lld мин легко."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passerade aerob tröskel vid %lld:%@ på %lld bpm. %lld min på tröskel, %lld min lugnt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %lld:%@、%lld bpm 时越过有氧阈。阈值区 %lld 分钟，轻松 %lld 分钟。"
          }
        }
      }
    },
    "Crossed aerobic threshold at %lld:%@%@. %lld min above anaerobic threshold. Mixed-intensity session." : {
      "comment" : "A narrative about a workout session, including the time it took to cross the aerobic threshold, the duration of time spent in each heart rate zone, and any other relevant details. The argument is the string “%02d”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجاوزت العتبة الهوائية عند %lld:%@%@. %lld دقيقة فوق العتبة اللاهوائية. جلسة بشدة مختلطة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krydsede den aerobe tærskel ved %lld:%@%@. %lld min over den anaerobe tærskel. Session med blandet intensitet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aerobe Schwelle bei %lld:%@%@ überschritten. %lld Min über der anaeroben Schwelle. Einheit mit gemischter Intensität."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Crossed aerobic threshold at %1$lld:%2$@%3$@. %4$lld min above anaerobic threshold. Mixed-intensity session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cruce del umbral aeróbico a las %lld:%@%@. %lld min por encima del umbral anaeróbico. Sesión de intensidad mixta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aerobinen kynnys ylitettiin kohdassa %lld:%@%@. %lld min anaerobisen kynnyksen yli. Sekaintensiteettiharjoitus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuil aérobie franchi à %lld:%@%@. %lld min au-dessus du seuil anaérobie. Séance à intensité mixte."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
