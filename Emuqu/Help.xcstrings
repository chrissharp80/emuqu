    "Deletes propagate across devices — delete on one, gone on all" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمتد الحذف عبر الأجهزة — احذف على جهاز فيختفي من الجميع"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sletninger slår igennem på tværs af enheder — slet på én, væk på alle"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löschungen werden auf alle Geräte übertragen — auf einem gelöscht, überall weg"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las eliminaciones se propagan entre dispositivos: borras en uno y desaparece en todos"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistot leviävät laitteiden välillä — poista yhdellä, poistuu kaikilta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les suppressions se propagent entre les appareils — supprimé sur l’un, supprimé sur tous"
