    "Train as planned. Once a few overnight readings build up, this section will get more specific." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدرّب كما خططت. بمجرد تراكم بضع قراءات ليلية سيصبح هذا القسم أكثر تحديدًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træn som planlagt. Når der er samlet nogle natmålinger, bliver dette afsnit mere specifikt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trainiere wie geplant. Sobald sich ein paar nächtliche Messungen angesammelt haben, wird dieser Abschnitt konkreter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrena según lo previsto. Cuando se acumulen algunas lecturas nocturnas, esta sección será más concreta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harjoittele suunnitellusti. Kun yömittauksia kertyy muutama, tämä osio tarkentuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entraînez-vous comme prévu. Dès que quelques mesures nocturnes se seront accumulées, cette section sera plus précise."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Æfðu eins og áætlað var. Þegar nokkrar næturmælingar hafa safnast verður þessi hluti nákvæmari."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allenati come previsto. Quando si saranno accumulate alcune letture notturne, questa sezione diventerà più precisa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定どおりトレーニングしましょう。夜間測定がいくつかたまると、このセクションはより具体的になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획대로 훈련하세요. 야간 측정이 몇 번 쌓이면 이 섹션이 더 구체적으로 바뀝니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tren som planlagt. Når noen nattmålinger har samlet seg, blir denne delen mer konkret."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Train zoals gepland. Zodra er een paar nachtmetingen zijn, wordt dit onderdeel specifieker."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treine conforme o planejado. Quando algumas leituras noturnas se acumularem, esta seção ficará mais específica."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренируйтесь по плану. Когда накопится несколько ночных измерений, этот раздел станет конкретнее."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Träna som planerat. När några nattmätningar har samlats blir det här avsnittet mer specifikt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按计划训练。积累几次夜间读数后，这部分会更具体。"
          }
        }
      }
    },
    "Train as planned. Steady rhythm is producing fitness — don't disrupt it for novelty." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدرّب كما خططت. الإيقاع الثابت يبني اللياقة — لا تخلّ به من أجل التغيير."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træn som planlagt. Den stabile rytme bygger form — bryd den ikke for nyhedens skyld."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trainiere wie geplant. Der stetige Rhythmus baut Fitness auf – unterbrich ihn nicht nur für Abwechslung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrena según lo previsto. El ritmo constante está construyendo forma: no lo rompas por probar algo nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harjoittele suunnitellusti. Tasainen rytmi kehittää kuntoa – älä riko sitä vaihtelun vuoksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entraînez-vous comme prévu. Ce rythme régulier construit la condition — ne le cassez pas par goût de la nouveauté."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Æfðu eins og áætlað var. Stöðugur taktur byggir upp form — ekki rjúfa hann bara til tilbreytingar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allenati come previsto. Il ritmo costante sta costruendo la forma: non interromperlo per il gusto della novità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "予定どおりトレーニングしましょう。安定したリズムが体力を伸ばしています — 目新しさのために崩さないように。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계획대로 훈련하세요. 꾸준한 리듬이 체력을 만들고 있습니다. 새로움을 위해 깨뜨리지 마세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tren som planlagt. Den jevne rytmen bygger form – ikke bryt den for variasjonens skyld."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Train zoals gepland. Het stabiele ritme bouwt fitheid op — verstoor het niet voor de afwisseling."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treine conforme o planejado. O ritmo constante está construindo condicionamento — não o quebre por novidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренируйтесь по плану. Ровный ритм развивает форму — не нарушайте его ради разнообразия."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Träna som planerat. Den stadiga rytmen bygger form – bryt den inte för omväxlingens skull."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按计划训练。稳定的节奏正在提升体能——别为了新鲜感打乱它。"
          }
        }
      }
    },
    "Train today as planned. The loop story sharpens once a baseline of overnight readings is in place." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدرّب اليوم كما خططت. تتضح صورة الحلقة بمجرد توفر خط أساس من القراءات الليلية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træn i dag som planlagt. Billedet af loopet bliver skarpere, når der er en baseline af natmålinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trainiere heute wie geplant. Das Bild wird klarer, sobald es einen Ausgangswert aus nächtlichen Messungen gibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrena hoy según lo previsto. El análisis del ciclo se afina en cuanto haya una referencia de lecturas nocturnas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harjoittele tänään suunnitellusti. Kuva tarkentuu, kun yömittauksista on muodostunut perustaso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entraînez-vous aujourd'hui comme prévu. L'analyse de la boucle s'affine dès qu'une référence de mesures nocturnes est établie."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Æfðu í dag eins og áætlað var. Myndin skerpist þegar grunnlína næturmælinga liggur fyrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allenati oggi come previsto. Il quadro si fa più preciso quando c'è una base di letture notturne."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は予定どおりトレーニングしましょう。夜間測定のベースラインがそろえば、ループの分析がより明確になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 계획대로 훈련하세요. 야간 측정 기준선이 생기면 루프 분석이 더 정확해집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tren i dag som planlagt. Bildet blir skarpere når det finnes en baseline fra nattmålinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Train vandaag zoals gepland. Het beeld wordt scherper zodra er een basislijn van nachtmetingen is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treine hoje conforme o planejado. A análise do ciclo fica mais precisa quando houver uma linha de base de leituras noturnas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тренируйтесь сегодня по плану. Картина станет точнее, когда накопится базовую линию по ночным измерениям."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Träna i dag som planerat. Bilden blir skarpare när det finns en baslinje av nattmätningar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今天照计划训练。一旦有了夜间读数基线，循环分析会更清晰。"
          }
        }
      }
    },
    "Train upward. Flo lets your load climb before calling the ramp fast." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدرّب صعودًا. يسمح Flo لعبئك بالارتفاع قبل أن يعتبر الزيادة سريعة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træn opad. Flo lader din belastning stige, før stigningen kaldes for hurtig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufwärts trainieren. Flo lässt deine Belastung steigen, bevor der Anstieg als zu schnell gilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrenar al alza. Flo deja que tu carga suba antes de considerar el aumento demasiado rápido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kehity. Flo antaa kuormasi kasvaa ennen kuin kutsuu nousua liian nopeaksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progresser. Flo laisse votre charge augmenter avant de juger la hausse trop rapide."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Æfa upp á við. Flo leyfir álaginu að aukast áður en aukningin er kölluð of hröð."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allenati in crescita. Flo lascia salire il tuo carico prima di considerare l'aumento troppo rapido."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上を目指す。Flo は負荷の増加が速いと判断する前に、負荷が上がるのを許容します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "상향 훈련. Flo는 증가 속도가 빠르다고 판단하기 전에 부하가 오르도록 둡니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tren oppover. Flo lar belastningen stige før økningen kalles for rask."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Train naar boven. Flo laat je belasting stijgen voordat de opbouw te snel wordt genoemd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evoluir. O Flo deixa sua carga subir antes de dizer que a progressão está rápida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
