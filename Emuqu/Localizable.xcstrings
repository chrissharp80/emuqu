    "Overnight breathing rate from Apple Watch accelerometer. Normal adult range during sleep: 12–20 breaths/min. " : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معدل التنفس الليلي من مقياس تسارع Apple Watch. النطاق الطبيعي للبالغين أثناء النوم: 12–20 نفسًا/دقيقة. "
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natlig vejrtrækningsfrekvens fra Apple Watch-accelerometeret. Normalt voksenområde under søvn: 12–20 vejrtrækninger/min. "
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nächtliche Atemfrequenz vom Beschleunigungssensor der Apple Watch. Normalbereich bei Erwachsenen im Schlaf: 12–20 Atemzüge/Min. "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frecuencia respiratoria nocturna del acelerómetro del Apple Watch. Rango normal en adultos durante el sueño: 12–20 respiraciones/min. "
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yöllinen hengitystiheys Apple Watchin kiihtyvyysanturista. Aikuisen normaali vaihteluväli unessa: 12–20 hengitystä/min. "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fréquence respiratoire nocturne mesurée par l’accéléromètre de l’Apple Watch. Plage normale chez l’adulte pendant le sommeil : 12–20 respirations/min. "
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öndunartíðni að nóttu úr hröðunarnema Apple Watch. Eðlilegt bil fullorðinna í svefni: 12–20 andardrættir/mín. "
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequenza respiratoria notturna dall’accelerometro di Apple Watch. Intervallo normale negli adulti durante il sonno: 12–20 respiri/min. "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch の加速度センサーによる夜間の呼吸数。成人の睡眠中の正常範囲: 12〜20 回/分。 "
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch 가속도계로 측정한 야간 호흡수. 성인의 수면 중 정상 범위: 분당 12–20회. "
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nattlig pustefrekvens fra Apple Watch-akselerometeret. Normalt voksenområde under søvn: 12–20 åndedrag/min. "
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachtelijke ademhalingsfrequentie via de versnellingsmeter van de Apple Watch. Normaal bereik bij volwassenen tijdens de slaap: 12–20 ademhalingen/min. "
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequência respiratória noturna pelo acelerômetro do Apple Watch. Faixa normal em adultos durante o sono: 12–20 respirações/min. "
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ночная частота дыхания по акселерометру Apple Watch. Норма у взрослых во сне: 12–20 вдохов/мин. "
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
