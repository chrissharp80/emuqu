          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os dados da sua sessão foram restaurados. Vá para a aba Gravar para retomar ou finalizar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
