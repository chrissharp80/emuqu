        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skoðaðu ATL, CTL og TSB hjá mér. Er ég á góðu álagssvæði, að æfa of lítið, undir miklu álagi eða að ná mér?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda i miei ATL, CTL e TSB. Sono in una buona zona di carico, mi alleno troppo poco, sono sotto forte carico o sto recuperando freschezza?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私の ATL、CTL、TSB を見てください。トレーニング負荷は良いゾーンにありますか？練習不足、高負担、それとも回復中ですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 ATL, CTL, TSB를 봐 줘. 좋은 훈련 부하 구간이야, 훈련이 부족해, 부하가 높아, 아니면 회복 중이야?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se på ATL, CTL og TSB-en min. Er jeg i en god belastningssone, undertrent, under høy belastning eller i ferd med å bli uthvilt?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kijk naar mijn ATL, CTL en TSB. Zit ik in een goede belastingszone, train ik te weinig, is de belasting hoog of word ik frisser?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja meus ATL, CTL e TSB. Estou numa boa zona de carga, treinando pouco, sob carga alta ou recuperando o frescor?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посмотри на мои ATL, CTL и TSB. Я в хорошей зоне нагрузки, недотренирован(а), под высокой нагрузкой или восстанавливаюсь?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titta på min ATL, CTL och TSB. Är jag i en bra belastningszon, undertränad, under hög belastning eller på väg att bli utvilad?"
