   "entry": null,
   "calls": [
    "Tools/validation/port_sleep_stage_classifier.py::def feature_window"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+5",
     "cond": "window start < end",
     "effect": "loop"
    },
    {
     "at": "+7",
     "cond": "point before window",
     "effect": "advance lo"
    },
    {
     "at": "+9",
     "cond": "hi < lo",
     "effect": "hi = lo"
    },
    {
     "at": "+11",
     "cond": "point before window end",
     "effect": "advance hi"
    },
    {
     "at": "+14",
     "cond": "features computed",
     "effect": "append"
    }
