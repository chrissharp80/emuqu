    "None of your recent workouts have a GPS track. Indoor / treadmill workouts can't export GPX." : {
      "comment" : "Message shown when the user attempts to export a GPX file but their most recent workout doesn't have a GPS track.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحتوي أي من تمارينك الأخيرة على مسار GPS. لا يمكن تصدير GPX لتمارين الداخل أو جهاز المشي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen af dine seneste træninger har et GPS-spor. Indendørs-/løbebåndstræninger kan ikke eksportere GPX."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keines deiner letzten Trainings hat einen GPS-Track. Indoor-/Laufband-Trainings lassen sich nicht als GPX exportieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguno de tus entrenamientos recientes tiene traza GPS. Los entrenamientos en interior o cinta no pueden exportarse a GPX."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
