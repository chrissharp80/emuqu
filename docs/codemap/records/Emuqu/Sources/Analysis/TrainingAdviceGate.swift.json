   "key": "func TrainingAdviceGate.ratioReasons(_:)",
   "hash": "83a180fd3a1c7644",
   "does": "ACWR reason: requires finite ACWR and CTL ≥ RecoveryScoreConstants.Readiness.ctlThreshold (missing CTL counts as infinite); ACWRBand >1.5 → sharpIncrease, 1.3–1.5 → aboveUsual, else none.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Collection/TrainingMetrics.swift::init ACWRBand(ratio:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "acwr present and finite",
     "effect": "false → []"
    },
    {
     "at": "+2",
     "cond": "ctl ≥ ctlThreshold (nil → infinity passes)",
     "effect": "false → []"
    },
    {
     "at": "+5",
     "cond": "band sharpIncrease",
     "effect": "→ [.sharpIncrease]"
    },
    {
     "at": "+6",
     "cond": "band aboveUsual",
     "effect": "→ [.aboveUsual]"
    },
    {
     "at": "+7",
     "cond": "belowUsual/maintenance/inRange",
     "effect": "→ []"
    }
   ],
   "deps": {
