   "key": "func CloudPullCoordinator.processRemoteRecord(_:forgotten:)",
   "hash": "f0de69e549b98fe2",
   "does": "Per record: non-UUID name, or a session deleted forever here (in forgotten) → nothing (never imported, refreshed or marked uploaded); tombstone (isDeleted == 1) not locally restored → delete local copy; a record kept on another device (isDeleted == keptOnDeviceMarker) → a copy held here counts as uploaded, nothing imported or refreshed; otherwise a restore made on another device after this one's deletion is adopted first (adoptRestoreIfNewer); already held or intentionally deleted → refreshIfRemoteIsNewer; else fetch asset and import as new, passing the record's change tag.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Storage/TrashRestoreCoordinator.swift::func TrashRestoreCoordinator.isRestored(_:)",
    "Emuqu/Sources/Storage/CloudKitSyncManager+Pull.swift::func CloudPullCoordinator.handleDeletedRecord(sessionId:sessionIdString:)",
    "Emuqu/Sources/Storage/CloudKitSyncManager+Pull.swift::func CloudPullCoordinator.isKnownLocally(_:)",
    "Emuqu/Sources/Storage/CloudKitSessionFreshness.swift::func CloudPullCoordinator.refreshIfRemoteIsNewer(_:sessionId:)",
    "Emuqu/Sources/Storage/CloudKitSyncManager+Pull.swift::func CloudPullCoordinator.assetURL(for:)",
    "Emuqu/Sources/Storage/CloudKitSyncManager+Pull.swift::func CloudPullCoordinator.importPulledSession(from:sessionId:sessionIdString:version:)",
    "Emuqu/Sources/Storage/CloudKitSyncManager+Pull.swift::func CloudPullCoordinator.adoptRestoreIfNewer(_:sessionId:)"
   ],
   "reads": [
    "ck:HRVSession.isDeleted",
    "ud:restoredFromTrash list (TrashRestoreCoordinator)",
    "ck:CKRecord.recordChangeTag"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "record name not a UUID, or the session was deleted forever here",
     "effect": "RecordOutcome() (ignored)"
    },
    {
     "at": "+3",
     "cond": "?? — isDeleted missing or not Int64",
     "effect": "treated as 0 (live)"
    },
    {
     "at": "+7",
     "cond": "isDeleted == 1 and the session not restored locally from Trash",
     "effect": "handleDeletedRecord; a locally restored one falls through so its upload overrides the tombstone"
    },
    {
     "at": "+11",
     "cond": "isDeleted == keptOnDeviceMarker",
     "effect": "isKnownLocally (marks a held copy uploaded); RecordOutcome()"
    },
    {
     "at": "+16",
     "cond": "isKnownLocally",
     "effect": "refreshIfRemoteIsNewer"
    },
    {
     "at": "+17",
     "cond": "no asset obtainable",
     "effect": "RecordOutcome() (retried next pull)"
    }
   ],
   "deps": {
