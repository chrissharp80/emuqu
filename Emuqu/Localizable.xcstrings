    "Tag your readings to track patterns (alcohol, travel, illness, etc.). Swipe to delete." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع علامات على قراءاتك لتتبع الأنماط (كحول، سفر، مرض، إلخ). اسحب للحذف."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag dine målinger for at spore mønstre (alkohol, rejser, sygdom osv.). Swipe for at slette."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagge deine Messungen, um Muster zu verfolgen (Alkohol, Reisen, Krankheit usw.). Zum Löschen wischen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etiqueta tus lecturas para seguir patrones (alcohol, viajes, enfermedad, etc.). Desliza para eliminar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merkitse mittauksiasi seurataksesi kaavoja (alkoholi, matkailu, sairaus jne.). Pyyhkäise poistaaksesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taguez vos mesures pour suivre des tendances (alcool, voyage, maladie, etc.). Balayez pour supprimer."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merktu mælingarnar þínar til að fylgjast með mynstrum (áfengi, ferðalög, veikindi o.s.frv.). Strjúktu til að eyða."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagga le letture per monitorare i pattern (alcol, viaggi, malattia, ecc.). Scorrere per eliminare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パターン（アルコール、旅行、病気など）を追跡するために測定にタグ付け。スワイプで削除。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "패턴(음주, 여행, 질병 등)을 추적하기 위해 측정에 태그를 지정하세요. 밀어서 삭제할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagg målingene dine for å spore mønstre (alkohol, reise, sykdom osv.). Sveip for å slette."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tag uw metingen om patronen bij te houden (alcohol, reizen, ziekte, enz.). Veeg om te verwijderen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque suas leituras com tags para rastrear padrões (álcool, viagem, doença, etc.). Deslize para excluir."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмечайте измерения тегами для отслеживания закономерностей (алкоголь, путешествия, болезнь и т.д.). Смахните для удаления."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tagga dina mätningar för att spåra mönster (alkohol, resor, sjukdom, etc.). Svep för att radera."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为读数添加标签以追踪模式（饮酒、旅行、生病等）。滑动删除。"
          }
        }
      }
    },
