            "value" : "La synchronisation iCloud se fait vers VOTRE conteneur CloudKit privé — aucun serveur tiers"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud samstilling fer í ÞÍNA einka CloudKit-geymslu — engir netþjónar þriðju aðila"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione iCloud va nel TUO contenitore CloudKit privato — nessun server di terze parti"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
