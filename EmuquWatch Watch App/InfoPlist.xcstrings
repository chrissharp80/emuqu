{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "Bundle display name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Emuqu"
          }
        }
      },
      "shouldTranslate" : false
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "EmuquWatch Watch App"
          }
        }
      },
      "shouldTranslate" : false
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Emuqu البلوتوث على Apple Watch للاتصال مباشرة بجهاز Polar H10 أو Polar Verity Sense أو أي حزام صدر أو سوار آخر يدعم ملف Heart Rate القياسي. يتيح الاتصال المباشر للساعة قراءة معدل ضربات القلب وفواصل RR مباشرة عندما يكون iPhone خارج النطاق أو في غرفة أخرى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu bruger Bluetooth på dit Apple Watch til at forbinde direkte til din Polar H10, Polar Verity Sense eller en anden brystrem eller armrem med standard Heart Rate-profil. Den direkte forbindelse lader dit Watch læse puls og RR-intervaller live, når din iPhone er uden for rækkevidde eller i et andet rum."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu verwendet Bluetooth auf deiner Apple Watch, um sich direkt mit deinem Polar H10, Polar Verity Sense oder einem anderen Brustgurt oder Armband mit Standard-Herzfrequenzprofil zu verbinden. So kann die Watch Herzfrequenz und RR-Intervalle live lesen, wenn dein iPhone außer Reichweite oder in einem anderen Raum ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Emuqu uses Bluetooth on your Apple Watch to connect directly to your Polar H10, Polar Verity Sense, or other standard Heart Rate Profile chest strap or arm band. Direct connection lets the Watch read live HR + RR intervals when your iPhone is out of range or in another room."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu usa Bluetooth en tu Apple Watch para conectarse directamente a tu Polar H10, Polar Verity Sense u otra banda de pecho o brazalete con el perfil estándar de frecuencia cardíaca. La conexión directa permite que el Watch lea la frecuencia cardíaca y los intervalos RR en directo cuando tu iPhone está fuera de alcance o en otra habitación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu käyttää Apple Watchin Bluetoothia yhdistääkseen suoraan Polar H10:een, Polar Verity Senseen tai muuhun vakiomuotoista sykeprofiilia käyttävään sykevyöhön tai käsivarsinauhaan. Suora yhteys antaa Watchin lukea sykkeen ja RR-välit reaaliajassa, kun iPhone on kantaman ulkopuolella tai toisessa huoneessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu utilise le Bluetooth de votre Apple Watch pour se connecter directement à votre Polar H10, Polar Verity Sense ou toute autre ceinture pectorale ou brassard au profil de fréquence cardiaque standard. La connexion directe permet à la Watch de lire la fréquence cardiaque et les intervalles RR en direct lorsque votre iPhone est hors de portée ou dans une autre pièce."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu notar Bluetooth á Apple Watch til að tengjast beint við Polar H10, Polar Verity Sense eða annað brjóstbelti eða armband með stöðluðum púlsprófíl. Bein tenging leyfir úrinu að lesa púls og RR-bil í rauntíma þegar iPhone er utan drægni eða í öðru herbergi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu usa il Bluetooth sul tuo Apple Watch per collegarsi direttamente al tuo Polar H10, Polar Verity Sense o a un’altra fascia toracica o da braccio con profilo di frequenza cardiaca standard. Il collegamento diretto permette al Watch di leggere in tempo reale frequenza cardiaca e intervalli RR quando l’iPhone è fuori portata o in un’altra stanza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu は Apple Watch の Bluetooth を使用して、Polar H10、Polar Verity Sense、または標準の心拍プロファイルに対応したその他の胸部ストラップやアームバンドに直接接続します。直接接続により、iPhone が範囲外や別の部屋にあるときでも、Watch がリアルタイムの心拍数と RR 間隔を読み取れます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu는 Apple Watch의 Bluetooth를 사용해 Polar H10, Polar Verity Sense 또는 표준 심박 프로필을 지원하는 기타 가슴 스트랩이나 암밴드에 직접 연결합니다. 직접 연결하면 iPhone이 범위를 벗어났거나 다른 방에 있을 때도 Watch가 실시간 심박수와 RR 간격을 읽을 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu bruker Bluetooth på Apple Watch til å koble direkte til Polar H10, Polar Verity Sense eller et annet brystbelte eller armbånd med standard pulsprofil. Direkte tilkobling lar Watch lese puls og RR-intervaller i sanntid når iPhonen er utenfor rekkevidde eller i et annet rom."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu gebruikt Bluetooth op je Apple Watch om rechtstreeks verbinding te maken met je Polar H10, Polar Verity Sense of een andere borstband of armband met het standaard hartslagprofiel. Dankzij de directe verbinding kan de Watch live hartslag en RR-intervallen lezen als je iPhone buiten bereik is of in een andere kamer ligt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Emuqu usa o Bluetooth do Apple Watch para se conectar diretamente ao seu Polar H10, Polar Verity Sense ou outra cinta peitoral ou braçadeira com o perfil padrão de frequência cardíaca. A conexão direta permite que o Watch leia a frequência cardíaca e os intervalos RR ao vivo quando o iPhone está fora de alcance ou em outro cômodo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu использует Bluetooth на Apple Watch, чтобы напрямую подключаться к Polar H10, Polar Verity Sense или другому нагрудному либо наручному датчику со стандартным профилем пульса. Прямое подключение позволяет часам считывать пульс и RR-интервалы в реальном времени, когда iPhone вне зоны досягаемости или в другой комнате."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu använder Bluetooth på din Apple Watch för att ansluta direkt till din Polar H10, Polar Verity Sense eller ett annat bröstband eller armband med standardprofilen för puls. Direktanslutningen låter din Watch läsa puls och RR-intervall i realtid när din iPhone är utom räckhåll eller i ett annat rum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu 使用 Apple Watch 上的蓝牙直接连接你的 Polar H10、Polar Verity Sense 或其他支持标准心率配置文件的胸带或臂带。直接连接可让手表在 iPhone 超出范围或在另一个房间时实时读取心率和 RR 间期。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Privacy - Health Share Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Emuqu معدل ضربات القلب على Apple Watch أثناء التمرين. ويُبث نبض المعصم إلى iPhone في الوقت الفعلي ويسد الفجوة إذا انقطع حزام Polar."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu læser puls på dit Apple Watch under en træning. Pulsen fra håndleddet sendes til din iPhone i realtid og udfylder hullet, hvis din Polar-rem falder ud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu liest während eines Trainings die Herzfrequenz auf deiner Apple Watch. Die Herzfrequenz vom Handgelenk wird in Echtzeit an dein iPhone übertragen und springt ein, wenn dein Polar-Gurt ausfällt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Emuqu reads heart rate on your Apple Watch during a workout. Wrist heart rate streams to your iPhone in real time and fills in if your Polar strap drops out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu lee la frecuencia cardíaca en tu Apple Watch durante un entrenamiento. La frecuencia cardíaca de la muñeca se transmite a tu iPhone en tiempo real y cubre los huecos si tu banda Polar se desconecta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu lukee sykkeen Apple Watchistasi harjoituksen aikana. Ranteesta mitattu syke välittyy iPhoneesi reaaliajassa ja paikkaa katkokset, jos Polar-vyösi yhteys katkeaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu lit la fréquence cardiaque sur votre Apple Watch pendant une séance. La fréquence cardiaque du poignet est transmise en temps réel à votre iPhone et prend le relais si votre ceinture Polar décroche."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu les hjartslátt á Apple Watch á meðan æfingu stendur. Púls frá úlnlið streymir í iPhone í rauntíma og fyllir í eyður ef Polar-beltið dettur út."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu legge la frequenza cardiaca sul tuo Apple Watch durante un allenamento. La frequenza cardiaca dal polso arriva all’iPhone in tempo reale e copre i vuoti se la fascia Polar si disconnette."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu はワークアウト中に Apple Watch の心拍数を読み取ります。手首の心拍数はリアルタイムで iPhone に送られ、Polar ストラップの接続が途切れたときに補います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu는 운동 중에 Apple Watch의 심박수를 읽습니다. 손목 심박수는 iPhone으로 실시간 전송되며 Polar 스트랩 연결이 끊기면 빈 구간을 채웁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu leser puls på Apple Watch under en økt. Pulsen fra håndleddet strømmer til iPhonen i sanntid og fyller inn hvis Polar-beltet faller ut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu leest tijdens een training je hartslag op je Apple Watch. De hartslag van je pols wordt in realtime naar je iPhone gestuurd en vult gaten op als je Polar-band wegvalt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Emuqu lê a frequência cardíaca no seu Apple Watch durante um treino. A frequência cardíaca do pulso é transmitida ao iPhone em tempo real e cobre as falhas se a sua cinta Polar cair."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время тренировки Emuqu считывает пульс с Apple Watch. Пульс с запястья передаётся на iPhone в реальном времени и восполняет пропуски, если нагрудный датчик Polar отключится."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu läser pulsen på din Apple Watch under ett pass. Pulsen från handleden strömmas till din iPhone i realtid och fyller i om ditt Polar-bälte tappar anslutningen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu 在运动期间读取 Apple Watch 上的心率。手腕心率会实时传输到你的 iPhone，并在 Polar 心率带断开时补上数据。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ Emuqu جلسة تمرين Apple Health على الساعة حتى يستمر بث نبض المعصم إلى iPhone أثناء التمرين. تُحذف جلسة الساعة عند التوقف؛ ويحفظ iPhone التمرين."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu starter en Apple Health-træningssession på dit Watch, så pulsen fra håndleddet bliver ved med at strømme til din iPhone under træningen. Watch-sessionen kasseres, når du stopper; din iPhone gemmer træningen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu startet eine Apple Health-Trainingssitzung auf deiner Watch, damit die Herzfrequenz vom Handgelenk während des Trainings weiter an dein iPhone übertragen wird. Die Watch-Sitzung wird beim Beenden verworfen; dein iPhone speichert das Training."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Emuqu starts an Apple Health workout session on your Watch so wrist heart rate keeps streaming to your iPhone during exercise. The Watch session is discarded when you stop; your iPhone saves the workout."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu inicia una sesión de entrenamiento de Apple Health en tu Watch para que la frecuencia cardíaca de la muñeca siga llegando a tu iPhone durante el ejercicio. La sesión del Watch se descarta al detenerla; tu iPhone guarda el entrenamiento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu käynnistää Watchissa Apple Health -harjoitusistunnon, jotta ranteesta mitattu syke välittyy iPhoneesi koko harjoituksen ajan. Watchin istunto hylätään, kun lopetat; iPhone tallentaa harjoituksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu lance une séance d’entraînement Apple Santé sur votre Watch pour que la fréquence cardiaque du poignet continue d’arriver sur votre iPhone pendant l’effort. La séance de la Watch est abandonnée quand vous arrêtez ; votre iPhone enregistre la séance."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu ræsir Apple Health-æfingalotu á úrinu svo púls frá úlnlið haldi áfram að streyma í iPhone á æfingu. Lotunni á úrinu er hent þegar þú hættir; iPhone vistar æfinguna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu avvia una sessione di allenamento di Apple Salute sul tuo Watch così la frequenza cardiaca dal polso continua ad arrivare all’iPhone durante l’esercizio. La sessione del Watch viene scartata quando ti fermi; l’iPhone salva l’allenamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu は Watch で Apple ヘルスケアのワークアウトセッションを開始し、運動中も手首の心拍数が iPhone に送られ続けるようにします。Watch のセッションは停止時に破棄され、ワークアウトは iPhone に保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu는 운동 중에도 손목 심박수가 iPhone으로 계속 전송되도록 Watch에서 Apple 건강 운동 세션을 시작합니다. Watch 세션은 중지하면 폐기되며, 운동은 iPhone이 저장합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu starter en Apple Health-treningsøkt på Watch slik at pulsen fra håndleddet fortsetter å strømme til iPhonen under trening. Watch-økten forkastes når du stopper; iPhonen lagrer økten."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu start een Apple Health-trainingssessie op je Watch zodat de hartslag van je pols tijdens het sporten naar je iPhone blijft stromen. De Watch-sessie wordt weggegooid als je stopt; je iPhone bewaart de training."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Emuqu inicia uma sessão de treino do Apple Saúde no seu Watch para que a frequência cardíaca do pulso continue chegando ao iPhone durante o exercício. A sessão do Watch é descartada quando você para; o iPhone salva o treino."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu запускает на часах тренировку Apple Здоровье, чтобы пульс с запястья продолжал поступать на iPhone во время упражнений. Сессия на часах удаляется, когда вы останавливаетесь; тренировку сохраняет iPhone."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu startar ett Apple Hälsa-träningspass på din Watch så att pulsen från handleden fortsätter att strömma till din iPhone under träningen. Watch-passet kasseras när du stoppar; din iPhone sparar passet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu 会在 Apple Watch 上开始一次 Apple 健康体能训练，以便运动时手腕心率持续传输到 iPhone。你停止后，手表上的这次训练会被丢弃，训练记录由 iPhone 保存。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}