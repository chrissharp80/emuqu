        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hæsta viðvarandi HRV í svefni — lífeðlisfræðilegt þak þitt, aðskilið frá viðbúnaði."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'HRV più alto sostenuto durante il sonno — il Suo tetto fisiologico, separato dalla prontezza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "睡眠中の最も高い持続HRV — 準備状態とは別の生理的上限。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
