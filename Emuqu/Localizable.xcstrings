        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu er for brukere som er 13 år eller eldre — du bekrefter dette når du godtar helseforbeholdet ved første oppstart."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu is bedoeld voor gebruikers van 13 jaar en ouder — je bevestigt dit wanneer je bij de eerste start de gezondheidsdisclaimer accepteert."
