    "Your notes, tags and morning check-ins on your recordings, which can mention symptoms or mood" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملاحظاتك ووسومك وتسجيلات الصباح على تسجيلاتك، والتي قد تذكر أعراضًا أو حالة مزاجية"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine noter, tags og morgenindtjekninger på dine optagelser, som kan nævne symptomer eller humør"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Notizen, Tags und morgendlichen Check-ins zu deinen Aufzeichnungen, die Symptome oder Stimmungen erwähnen können"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus notas, etiquetas y registros matutinos de tus grabaciones, que pueden mencionar síntomas o estado de ánimo"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muistiinpanosi, tunnisteesi ja aamukirjauksesi tallenteisiisi, joissa voi mainita oireita tai mielialaa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
