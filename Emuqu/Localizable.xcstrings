    "Auto: derived from age, resting HR, and observed max. Manual: edit any value below — the override sticks until you clear it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلقائي: مُشتق من العمر ومعدل ضربات القلب أثناء الراحة والحد الأقصى المرصود. يدوي: عدّل أي قيمة أدناه — يظل التجاوز سارياً حتى تمسحه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto: udledt af alder, hvile-HR og observeret maks. Manuel: rediger en hvilken som helst værdi nedenfor — tilsidesættelsen gælder, indtil du rydder den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto: abgeleitet aus Alter, Ruhe-HF und beobachtetem Maximum. Manuell: Bearbeite einen beliebigen Wert unten — die Überschreibung bleibt bestehen, bis du sie löschst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto: derivado de la edad, la FC en reposo y el máximo observado. Manual: edita cualquier valor abajo — la modificación se mantiene hasta que la borres."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto: johdettu iästä, leposykkeestä ja havaitusta maksimista. Manuaalinen: muokkaa mitä tahansa arvoa alla — ohitus pysyy, kunnes tyhjennät sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto : déduit de l'âge, de la FC au repos et du maximum observé. Manuel : modifiez n'importe quelle valeur ci-dessous — le réglage manuel reste actif jusqu'à ce que vous l'effaciez."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjálfvirkt: leitt af aldri, hvíldarpúls og mældu hámarki. Handvirkt: breyttu hvaða gildi sem er hér að neðan — yfirskráningin helst þar til þú hreinsar hana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto: derivato da età, FC a riposo e massimo osservato. Manuale: modifica qualsiasi valore qui sotto — la modifica resta finché non la cancelli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動：年齢、安静時心拍数、観測された最大値から算出されます。手動：以下の任意の値を編集できます。クリアするまで上書きが維持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동: 나이, 안정 시 심박수, 관측된 최대값에서 산출됩니다. 수동: 아래의 값을 편집하세요 — 지울 때까지 재정의가 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto: utledet fra alder, hvile-HR og observert maks. Manuell: rediger en hvilken som helst verdi nedenfor — overstyringen gjelder til du fjerner den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto: afgeleid van leeftijd, rust-HR en waargenomen maximum. Handmatig: bewerk een willekeurige waarde hieronder — de aanpassing blijft tot je deze wist."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto: derivado da idade, FC em repouso e máximo observado. Manual: edite qualquer valor abaixo — a substituição permanece até você limpá-la."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Авто: вычисляется по возрасту, пульса покоя и наблюдаемому максимуму. Вручную: измените любое значение ниже — переопределение сохраняется, пока вы его не сбросите."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto: härleds från ålder, vilo-HR och observerat max. Manuellt: ändra valfritt värde nedan — överstyrningen gäller tills du rensar den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动：根据年龄、静息心率和观测到的最大值推算。手动：编辑下方任意数值——该覆盖值将一直生效，直到你清除它。"
          }
        }
      }
    },
    "Automatic follows your device region; otherwise metric or imperial" : {
      "comment" : "A hint explaining that the \"Distance & Pace\" setting automatically adapts to the user's device region, falling back to either metric or imperial units if necessary.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلقائي يتبع منطقة جهازك؛ وإلا فالنظام المتري أو الإمبراطوري"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisk følger din enheds region; ellers metrisk eller imperisk"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch richtet sich nach der Region deines Geräts; andernfalls metrisch oder imperial"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automático sigue la región de tu dispositivo; de lo contrario, métrico o imperial"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automaattinen seuraa laitteesi aluetta; muutoin metrinen tai brittiläinen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatique suit la région de votre appareil ; sinon métrique ou impérial"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjálfvirkt fylgir svæði tækisins; annars metrakerfi eða breskt kerfi"
