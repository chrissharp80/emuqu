    "Bluetooth keeps the recording running while your phone is locked. Don't force-quit the app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُبقي البلوتوث التسجيل مستمرًا أثناء قفل هاتفك. لا تُغلق التطبيق إغلاقًا قسريًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth holder optagelsen kørende, mens telefonen er låst. Tving ikke appen til at lukke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth hält die Aufnahme am Laufen, während dein iPhone gesperrt ist. Beende die App nicht erzwungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth mantiene la grabación en marcha mientras el teléfono está bloqueado. No fuerces el cierre de la app."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth pitää tallennuksen käynnissä puhelimen ollessa lukittuna. Älä pakota appia sulkeutumaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le Bluetooth maintient l'enregistrement pendant que votre téléphone est verrouillé. Ne forcez pas la fermeture de l'app."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth heldur upptökunni gangandi meðan síminn er læstur. Ekki þvinga forritið til að loka."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il Bluetooth mantiene attiva la registrazione mentre il telefono è bloccato. Non forzare la chiusura dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneがロックされている間も、Bluetoothが記録を継続します。アプリを強制終了しないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰이 잠겨 있는 동안에도 Bluetooth가 기록을 계속 유지합니다. 앱을 강제 종료하지 마세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth holder opptaket i gang mens telefonen er låst. Ikke tving appen til å avslutte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth houdt de opname actief terwijl je telefoon vergrendeld is. Sluit de app niet geforceerd af."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Bluetooth mantém a gravação ativa enquanto o celular está bloqueado. Não force o fechamento do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth продолжает запись, пока телефон заблокирован. Не закрывайте приложение принудительно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bluetooth håller inspelningen igång medan telefonen är låst. Tvångsavsluta inte appen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手机锁屏时，蓝牙会让记录继续进行。请不要强制退出应用。"
          }
        }
      }
    },
