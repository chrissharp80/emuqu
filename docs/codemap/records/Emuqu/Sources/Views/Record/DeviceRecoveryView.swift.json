 "file": "Emuqu/Sources/Views/Record/DeviceRecoveryView.swift",
 "hash": "9779f6b2690a776c",
 "role": "Three record-tab cards for strap data handling: RecoverableDataCard (offer to recover a recording left on the strap, or delete it after a confirmation), FetchProgressCard (stage/progress/cancel UI for a strap download) and RetryFetchCard (failed-download card with retry/cancel/dismiss). Pure presentation; all actions arrive as closures.",
 "types": [
  "RecoverableDataCard: struct — View; recover / discard prompt for data found on the strap",
  "FetchProgressCard: struct — View; shows StrapFetchProgress stage, attempt, bar, percentage, Cancel",
  "RetryFetchCard: struct — View; failed fetch card with humanised reason, Retry, Cancel retry, Dismiss"
 ],
 "state": [],
