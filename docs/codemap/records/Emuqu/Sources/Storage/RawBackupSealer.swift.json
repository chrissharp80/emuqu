    "Emuqu/Sources/Storage/RawBackupSealer.swift::func RawBackupSealer.writeEntry(_:to:sessionId:)",
    "dyn:SealableBackupStore.appendPointFiles → Emuqu/Sources/Storage/RawRRBackup+Streaming.swift::func RawRRBackup.appendPointFiles(of:)",
    "Emuqu/Sources/Storage/RawBackupSealer.swift::func RawBackupSealer.resealPointFiles(_:)",
    "Emuqu/Sources/Storage/PendingEncryptionLedger.swift::func PendingEncryptionLedger.record(_:in:)",
    "Emuqu/Sources/Storage/PendingEncryptionLedger.swift::func PendingEncryptionLedger.clear(_:in:)",
    "Emuqu/Sources/Utilities/DebugLog.swift::func debugLog(_:level:file:line:)"
   ],
   "reads": [
    "mem:RawRRBackup.index",
    "mem:RawRRBackup.indexReadFailed",
    "file:RRBackup/backup_index.json",
    "file:RRBackup/<uuid>_<t>.json",
    "file:RRBackup/<uuid>_points.jsonl"
   ],
   "writes": [
    "file:RRBackup/<uuid>_<t>.json",
    "file:RRBackup/<uuid>_<t>.json (superseded plaintext, deleted)",
    "file:RRBackup/<uuid>_points.jsonl (resealed)",
    "file:RRBackup/backup_index.json",
    "mem:RawRRBackup.index",
    "ud:storage.pendingReencryption.rawBackupIDs",
    "file:Application Support/PendingEncryption/<store key>.json (no file protection)"
   ],
   "branches": [
    {
     "at": "+4",
     "cond": "no row and no file of the session in this store",
     "effect": "return; left queued"
    },
    {
     "at": "+6",
     "cond": "a one-shot file is indexed",
     "effect": "decode it and rewrite it via writeEntry"
    },
    {
