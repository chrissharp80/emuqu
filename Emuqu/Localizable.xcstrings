        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSBは%@で回復も良好です — インターバルや長めの有酸素セッションに適したタイミングです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSB가 %@이고 회복도 좋습니다. 인터벌이나 긴 유산소 세션을 하기 좋은 때입니다."
