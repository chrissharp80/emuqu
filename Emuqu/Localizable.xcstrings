          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þessi merki eru athuganir á lífeðlisfræði þinni, ekki merki um neitt ástand."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi segnali sono osservazioni della tua fisiologia, non segni di alcuna condizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのシグナルはあなたの生理状態の観察結果であり、何らかの状態の兆候ではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
