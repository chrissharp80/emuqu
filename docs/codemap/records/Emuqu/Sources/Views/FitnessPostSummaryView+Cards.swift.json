  {
   "key": "func FitnessSummaryCards.paceDeltaCaption(secPerKmDelta:unitsResolved:)",
   "hash": "cb79d4d281a2cb69",
   "does": "Converts the sec/km delta to sec/mi for imperial and words it as 'N s/mi|km faster|slower than usual'.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "unitsResolved == .imperial",
     "effect": "delta * 1.609344; else unchanged"
    },
    {
     "at": "+5",
     "cond": "imperial & faster (delta < 0)",
     "effect": "'N s/mi faster than usual'"
    },
    {
     "at": "+6",
     "cond": "imperial & not faster",
     "effect": "'N s/mi slower than usual' (also for 0)"
    },
    {
     "at": "+7",
     "cond": "metric & faster",
     "effect": "'N s/km faster than usual'"
    },
    {
     "at": "+8",
     "cond": "metric & not faster",
     "effect": "'N s/km slower than usual' (also for 0)"
    }
   ],
