  {
   "key": "func SleepDetailV2View.buildInsights(sleep:)",
   "hash": "6b69dc3aa3f53180",
   "does": "Up to 3 insight strings: duration (<85% of target → short, >110% → catch-up), efficiency (≥95 excellent, <80 low, measured only), then the deep-share line.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Models/SleepData.swift::var SleepData.totalSleepIncludingNapMinutes",
    "Emuqu/Sources/Analysis/SleepScienceAnalyzer.swift::var SleepData.measuredSleepEfficiency",
    "Emuqu/Sources/Views/SleepDetailV2View+Breakdown.swift::func SleepDetailV2View.deepShareInsight(_:)",
    "Emuqu/Sources/Services/LanguageManager.swift::var LanguageManager.appBundle"
   ],
   "reads": [
    "mem:LanguageManager.shared.bundle"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+4",
     "cond": "24h hours < 0.85 × target",
     "effect": "adds short-sleep insight"
    },
    {
     "at": "+6",
     "cond": "else if > 1.1 × target",
     "effect": "adds slept-more insight; otherwise none"
    },
    {
     "at": "+9",
     "cond": "measured efficiency ≥ 95",
     "effect": "adds excellent-efficiency insight"
    },
    {
     "at": "+11",
     "cond": "else measured efficiency < 80",
     "effect": "adds low-efficiency insight; unmeasured or 80–95 adds none"
    },
    {
