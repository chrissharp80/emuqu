        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het systeem voor ruwe back-ups staat in de App Group-container, die blijft bestaan, zelfs als je de app verwijdert en opnieuw installeert. Je gegevens staan daar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
