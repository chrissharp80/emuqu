          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engin nýleg æfing hjá þér er með GPS-slóð. Ekki er hægt að flytja út GPX fyrir innanhúss- eða hlaupabrettisæfingar."
