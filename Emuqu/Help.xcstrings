    "Positive TSB = recent load is below your chronic base — the bookkeeping equivalent of fresh" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSB موجب = الحمل الحديث أقل من قاعدتك المزمنة — ما يعادل حسابيًا أنك منتعش"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positiv TSB = nylig belastning er under din kroniske base — regnskabsmæssigt svarer det til at være frisk"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positive TSB = die jüngste Belastung liegt unter deiner chronischen Basis — rechnerisch das Gleiche wie „frisch“"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSB positivo = la carga reciente está por debajo de tu base crónica: el equivalente contable de estar fresco"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positiivinen TSB = viimeaikainen kuormitus on kroonisen pohjasi alapuolella — kirjanpidollisesti levännyt"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TSB positif = la charge récente est inférieure à votre base chronique — l’équivalent comptable d’être frais"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jákvætt TSB = nýlegt álag er undir langtímagrunninum — bókhaldslega jafngildi þess að vera ferskur"
