   "does": "Pure: drops non-positive intervals, sorts by start, walks them splitting into episodes whenever the gap since the running max end exceeds episodeGapSeconds, adds each episode's unioned duration if >= floorSeconds, and returns total minutes (truncated). Tested by NapSleepCreditTests via the HealthKitManager forwarder.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Collection/HealthKitManager+Sleep.swift::func SleepHealthQueries.episodeSeconds(_:floorSeconds:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+8",
     "cond": "no positive intervals",
     "effect": "returns 0"
    },
    {
     "at": "+12",
     "cond": "for each interval",
     "effect": "iterates intervals in start order"
    },
    {
     "at": "+13",
     "cond": "there is a previous end AND the gap from it exceeds episodeGapSeconds",
     "effect": "closes the current episode (adds episodeSeconds) and starts a new one; else extends the current episode"
    },
    {
     "at": "+18",
     "cond": "lastEnd nil (first interval)",
     "effect": "?? iv.end — lastEnd initialised to the interval's end; otherwise max(lastEnd, iv.end)"
    }
