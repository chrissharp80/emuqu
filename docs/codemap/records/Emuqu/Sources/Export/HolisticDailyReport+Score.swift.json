   "key": "func HolisticDailyReport.readinessTier(for:loadLevel:goHardAllowed:)",
   "hash": "fd5c65417ae706bd",
   "does": "Maps a 0-10 readiness to a localized tier on the ScoreVerdict ladder of value×10: Excellent → 'Tier 1 — go hard' only with goHardAllowed and a clear gate load, else Tier 2; Good → Tier 2; Fair → Tier 3; Pay attention → Tier 4; Low/Very low → Tier 5. When the gate says ease off (.easier), Excellent/Good/Fair read 'Tier 3 — moderate only (load elevated)'.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Models/ScoreVerdict.swift::init ScoreVerdict(score:)",
    "Emuqu/Sources/Services/LanguageManager.swift::var LanguageManager.appBundle"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+4",
     "cond": "Excellent, goHardAllowed and load clear",
     "effect": "Tier 1"
    },
    {
     "at": "+6",
     "cond": "Excellent (otherwise) or Good",
     "effect": "load .easier → Tier 3 (load elevated); else Tier 2"
    },
    {
     "at": "+8",
     "cond": "Fair",
     "effect": "load .easier → Tier 3 (load elevated); else Tier 3"
    },
    {
     "at": "+10",
     "cond": "Pay attention",
     "effect": "Tier 4"
    },
    {
     "at": "+12",
     "cond": "Low / Very low",
     "effect": "Tier 5"
    }
   ],
   "flags": [],
   "deps": {
