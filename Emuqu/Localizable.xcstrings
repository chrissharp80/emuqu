        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "값이 높을수록(5-25%) 부교감 활동과 회복이 좋습니다. 매우 낮은 값(<2%)은 자율신경 억제를 시사합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyere verdier (5-25%) indikerer større parasympatisk aktivitet og restitusjon. Svært lave verdier (<2%) tyder på autonom undertrykkelse."
