    "Wrist HR fallback not started: %@. Open Emuqu on your iPhone to verify Apple Health permissions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يبدأ قياس النبض من المعصم كبديل: %@. افتح Emuqu على الـ iPhone للتحقق من أذونات Apple Health."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puls fra håndleddet blev ikke startet: %@. Åbn Emuqu på din iPhone for at tjekke Apple Health-tilladelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Herzfrequenz am Handgelenk als Rückfall nicht gestartet: %@. Öffne Emuqu auf dem iPhone, um die Apple Health-Berechtigungen zu prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se inició la FC de muñeca como alternativa: %@. Abre Emuqu en tu iPhone para revisar los permisos de Apple Health."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ranteen syke ei käynnistynyt varajärjestelmäksi: %@. Avaa Emuqu iPhonessa ja tarkista Apple Health -oikeudet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La FC au poignet n’a pas démarré en secours : %@. Ouvrez Emuqu sur votre iPhone pour vérifier les autorisations Apple Santé."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Púls frá úlnlið fór ekki í gang til vara: %@. Opnaðu Emuqu í iPhone til að staðfesta Apple Health-heimildir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La FC da polso di riserva non è partita: %@. Apri Emuqu sull’iPhone per verificare i permessi Apple Salute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手首の心拍（フォールバック）を開始できませんでした: %@。iPhone で Emuqu を開き、Apple ヘルスケア の権限を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "손목 심박수 대체 측정을 시작하지 못했습니다: %@. iPhone에서 Emuqu를 열어 Apple 건강 권한을 확인하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puls fra håndleddet startet ikke som reserve: %@. Åpne Emuqu på iPhone for å sjekke Apple Health-tillatelser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hartslag via de pols als terugval niet gestart: %@. Open Emuqu op je iPhone om de Apple Health-rechten te controleren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A FC de pulso alternativa não iniciou: %@. Abra o Emuqu no seu iPhone para verificar as permissões do Apple Saúde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервное измерение пульса на запястье не запустилось: %@. Откройте Emuqu на iPhone и проверьте разрешения Apple Здоровье."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puls från handleden startade inte som reserv: %@. Öppna Emuqu på din iPhone för att kontrollera Apple Hälsa-behörigheter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "腕式心率备用测量未启动：%@。请在 iPhone 上打开 Emuqu 检查 Apple 健康 权限。"
          }
        }
      }
    },
