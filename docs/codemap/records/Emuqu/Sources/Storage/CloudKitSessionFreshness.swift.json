   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+3",
     "cond": "remote has no sleepStart, sleepEnd and segments",
     "effect": "keepSleep(local)"
    },
    {
     "at": "+5",
     "cond": "same sleep window as local",
     "effect": "sleepSnapshot = remote ?? local; different window → remote snapshot (nil after strip → backfill)"
    },
    {
     "at": "+6",
     "cond": "remote.sleepSnapshot ?? local.sleepSnapshot",
     "effect": "falls back to local snapshot when remote has none"
    },
    {
