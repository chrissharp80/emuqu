  "active: Subscription?"
 ],
 "toplevel": "lazy var central creates CBCentralManager(delegate: self, queue: .main) on first access. Owned as PolarManager.standardHeartRate (PolarManager.swift:432) and used by StrapAPI.startHrStreaming.",
