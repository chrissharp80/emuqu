    "% of consecutive RR pairs that differ by > 50 ms — a coarse vagal-tone proxy." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "% من أزواج RR المتتالية التي تختلف بأكثر من 50 مللي ثانية — مؤشر تقريبي للنبرة المبهمية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "% af på hinanden følgende RR-par, der afviger > 50 ms — en grov proxy for vagal tonus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "% aufeinanderfolgender RR-Paare mit > 50 ms Unterschied — ein grober Näherungswert für den Vagustonus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "% de pares RR consecutivos que difieren > 50 ms — una medida aproximada del tono vagal."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "% peräkkäisistä RR-pareista, jotka eroavat > 50 ms — karkea vagaalitonuksen mittari."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "% de paires RR consécutives différant de > 50 ms — un indicateur grossier du tonus vagal."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "% samfelldra RR-para sem munar > 50 ms — grófur mælikvarði á vagus-tón."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "% di coppie RR consecutive che differiscono di > 50 ms — un indicatore grezzo del tono vagale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連続する RR ペアのうち差が 50 ms を超える割合 — 迷走神経緊張の粗い代理指標。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연속 RR 쌍 중 50 ms 초과로 차이 나는 비율 — 미주신경 긴장도의 대략적 대리지표."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "% av påfølgende RR-par som avviker > 50 ms — et grovt mål på vagal tonus."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "% opeenvolgende RR-paren die > 50 ms verschillen — een ruwe maat voor vagale tonus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "% de pares RR consecutivos que diferem > 50 ms — uma aproximação grosseira do tônus vagal."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "% последовательных пар RR с разницей > 50 мс — грубый показатель вагусного тонуса."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "% av på varandra följande RR-par som skiljer sig > 50 ms — ett grovt mått på vagal tonus."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相邻 RR 间期差值大于 50 ms 的比例 — 迷走张力的粗略替代指标。"
          }
        }
      }
    },
