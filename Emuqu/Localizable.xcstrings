    "8–11 bpm: below the 12 bpm convention. One session says little; compare across sessions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8–11 نبضة/دقيقة: أقل من عتبة 12 نبضة/دقيقة المتعارف عليها. جلسة واحدة لا تقول الكثير؛ قارن بين الجلسات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8–11 bpm: under 12 bpm-konventionen. Én session siger ikke meget; sammenlign på tværs af sessioner."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8–11 bpm: unter der 12-bpm-Konvention. Eine einzelne Einheit sagt wenig; vergleiche über mehrere Einheiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "8–11 lpm: por debajo de la convención de 12 lpm. Una sola sesión dice poco; compara entre sesiones."
          }
        },
        "fi" : {
