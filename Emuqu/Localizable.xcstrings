    },
    "You can change this anytime in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك تغيير هذا في أي وقت من الإعدادات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ændre dette når som helst i indstillingerne."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst dies jederzeit in den Einstellungen ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiar esto en cualquier momento en Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit muuttaa tämän milloin tahansa Asetuksista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez modifier cela à tout moment dans les Réglages."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú getur breytt þessu hvenær sem er í Stillingum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Può modificare questo in qualsiasi momento nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定からいつでも変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 언제든지 변경할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan endre dette når som helst i innstillingene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U kunt dit op elk moment wijzigen in Instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode alterar isso a qualquer momento nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете изменить это в любое время в настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ändra detta när som helst i Inställningar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以随时在设置中更改。"
          }
        }
      }
    },
    "You can revoke any of them at any time in your device's Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك إلغاء أي منها في أي وقت من إعدادات جهازك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan når som helst tilbagekalde dem i din enheds Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst jede davon jederzeit in den Einstellungen deines Geräts widerrufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes revocar cualquiera de ellos en cualquier momento en los Ajustes de tu dispositivo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit peruuttaa minkä tahansa niistä milloin tahansa laitteesi asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez révoquer chacune d’elles à tout moment dans les Réglages de votre appareil."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú getur afturkallað hverja þeirra hvenær sem er í Stillingum tækisins."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi revocarli in qualsiasi momento nelle Impostazioni del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらはいつでもデバイスの設定で取り消すことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기의 설정에서 언제든지 이러한 권한을 취소할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan trekke tilbake hvilken som helst av dem når som helst i enhetens Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt elk ervan op elk moment intrekken in de Instellingen van je apparaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode revogar qualquer uma delas a qualquer momento nos Ajustes do seu dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Любое из них можно отозвать в любой момент в Настройках устройства."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan återkalla vilken som helst av dem när som helst i enhetens Inställningar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以随时在设备的“设置”中撤销其中任何一项。"
          }
        }
      }
    },
    "You can turn this off any time in Settings → Wearables. The next workout won't broadcast." : {
      "comment" : "A message explaining that the BLE broadcast can be disabled at any time in the app settings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك إيقاف هذا في أي وقت من الإعدادات ← الأجهزة القابلة للارتداء. لن يتم بثّ التمرين التالي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan slå dette fra når som helst under Indstillinger → Wearables. Den næste træning sendes ikke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst dies jederzeit unter Einstellungen → Wearables deaktivieren. Das nächste Training wird nicht übertragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes desactivar esto en cualquier momento en Ajustes → Dispositivos vestibles. El próximo entrenamiento no se transmitirá."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit poistaa tämän käytöstä milloin tahansa kohdassa Asetukset → Wearables. Seuraavaa harjoitusta ei lähetetä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez désactiver cela à tout moment dans Réglages → Objets connectés. La prochaine séance ne sera pas diffusée."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú getur slökkt á þessu hvenær sem er í Stillingar → Wearables. Næsta æfing verður ekki send út."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi disattivarlo in qualsiasi momento in Impostazioni → Wearables. Il prossimo allenamento non verrà trasmesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは設定 → ウェアラブル でいつでもオフにできます。次のワークアウトはブロードキャストされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 → Wearables에서 언제든지 이 기능을 끌 수 있습니다. 다음 운동은 전송되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan slå dette av når som helst i Innstillinger → Wearables. Neste økt kringkastes ikke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt dit op elk moment uitschakelen via Instellingen → Wearables. De volgende training wordt niet uitgezonden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode desativar isto a qualquer momento em Ajustes → Wearables. O próximo treino não será transmitido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете отключить это в любой момент в разделе Настройки → Носимые устройства. Следующая тренировка не будет транслироваться."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan stänga av detta när som helst i Inställningar → Wearables. Nästa pass sänds inte."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以随时在设置 → 可穿戴设备 中关闭此项。下次训练将不会广播。"
          }
        }
      }
    },
    "You can withdraw it at any time in Settings → Flo → the provider → Withdraw consent, and removing the provider's key withdraws it too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك سحبها في أي وقت من الإعدادات ← Flo ← المزوّد ← سحب الموافقة، كما أن إزالة مفتاح المزوّد تسحبها أيضًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan når som helst trække det tilbage under Indstillinger → Flo → udbyderen → Træk samtykke tilbage, og hvis du fjerner udbyderens nøgle, trækkes det også tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst sie jederzeit unter Einstellungen → Flo → Anbieter → Einwilligung widerrufen zurückziehen, und das Entfernen des Anbieterschlüssels widerruft sie ebenfalls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes retirarlo en cualquier momento en Ajustes → Flo → el proveedor → Retirar el consentimiento, y eliminar la clave del proveedor también lo retira."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voit peruuttaa sen milloin tahansa kohdassa Asetukset → Flo → palveluntarjoaja → Peruuta suostumus, ja palveluntarjoajan avaimen poistaminen peruuttaa sen myös."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez le retirer à tout moment dans Réglages → Flo → le fournisseur → Retirer le consentement, et supprimer la clé du fournisseur le retire également."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú getur afturkallað það hvenær sem er í Stillingar → Flo → þjónustuaðilinn → Afturkalla samþykki, og það afturkallast líka ef lykill þjónustuaðilans er fjarlægður."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi revocarlo in qualsiasi momento in Impostazioni → Flo → il provider → Revoca il consenso, e anche rimuovere la chiave del provider lo revoca."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定 → Flo → プロバイダー → 同意を取り消す でいつでも撤回できます。プロバイダーのキーを削除した場合も撤回されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 → Flo → 해당 제공업체 → 동의 철회에서 언제든지 철회할 수 있으며, 제공업체의 키를 제거해도 철회됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan trekke det tilbake når som helst i Innstillinger → Flo → leverandøren → Trekk tilbake samtykke, og det trekkes også tilbake hvis du fjerner leverandørens nøkkel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt die op elk moment intrekken via Instellingen → Flo → de aanbieder → Toestemming intrekken, en het verwijderen van de sleutel van de aanbieder trekt die ook in."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode retirá-lo a qualquer momento em Configurações → Flo → o provedor → Retirar consentimento, e remover a chave do provedor também o retira."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его можно отозвать в любой момент в Настройки → Flo → провайдер → Отозвать согласие; удаление ключа провайдера тоже отзывает его."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan återkalla det när som helst i Inställningar → Flo → leverantören → Återkalla samtycke, och om du tar bort leverantörens nyckel återkallas det också."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以随时在“设置 → Flo → 该提供方 → 撤回同意”中撤回，移除该提供方的密钥也会撤回同意。"
          }
        }
      }
    },
    "You climbed %@." : {
