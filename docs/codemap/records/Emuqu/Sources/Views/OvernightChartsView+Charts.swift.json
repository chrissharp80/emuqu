  {
   "key": "func OvernightHRChartCanvas.nearestPolarSample(toMs:)",
   "hash": "86f22d3032a01e7c",
   "does": "Linear scan of allHrValues (or hrValues when empty) for the RR point whose t_ms is closest to target; time from absoluteTimeWallClock, falling back to series.startDate.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Models/RRModels.swift::func RRSeries.absoluteTimeWallClock(at:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "session.rrSeries == nil",
     "effect": "return nil"
    },
    {
     "at": "+3",
     "cond": "allHrValues empty",
     "effect": "use hrValues"
    },
    {
     "at": "+5",
     "cond": "for each (index, hr)",
     "effect": "scan"
    },
    {
     "at": "+6",
     "cond": "index >= points.count",
     "effect": "skip"
    },
    {
     "at": "+8",
     "cond": "closest nil or dist smaller",
     "effect": "replace candidate; else continue"
    },
    {
     "at": "+8",
     "cond": "closest == nil",
     "effect": "?? true accepts the first"
    },
    {
     "at": "+9",
     "cond": "absoluteTimeWallClock nil",
     "effect": "use series.startDate"
    }
   ],
   "flags": [],
   "deps": {
    "Emuqu/Sources/Models/RRModels.swift::func RRSeries.absoluteTimeWallClock(at:)": "b828c96564df6c4f"
   }
  },
