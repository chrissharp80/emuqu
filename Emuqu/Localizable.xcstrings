    "iCloud copies of your data — synced sessions, in-progress recording backups, and the settings backup are deleted from your private iCloud database (requires an internet connection)" : {
      "comment" : "Explanation of what gets deleted when the user deletes all their data, specifically the iCloud copies of their data.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نُسخ بياناتك على iCloud — الجلسات المتزامنة، والنسخ الاحتياطية للتسجيلات الجارية، والنسخة الاحتياطية للإعدادات — تُحذف من قاعدة بيانات iCloud الخاصة بك (يتطلب اتصالًا بالإنترنت)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-kopier af dine data — synkroniserede sessioner, sikkerhedskopier af igangværende optagelser og indstillingssikkerhedskopien slettes fra din private iCloud-database (kræver en internetforbindelse)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-Kopien deiner Daten – synchronisierte Sitzungen, Backups laufender Aufzeichnungen und das Einstellungs-Backup werden aus deiner privaten iCloud-Datenbank gelöscht (erfordert eine Internetverbindung)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias en iCloud de tus datos —sesiones sincronizadas, copias de seguridad de grabaciones en curso y la copia de seguridad de los ajustes— se eliminan de tu base de datos privada de iCloud (requiere conexión a internet)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietojesi iCloud-kopiot — synkronoidut istunnot, käynnissä olevien tallennusten varmuuskopiot ja asetusten varmuuskopio — poistetaan yksityisestä iCloud-tietokannastasi (vaatii internet-yhteyden)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les copies iCloud de vos données — sessions synchronisées, sauvegardes d'enregistrements en cours et sauvegarde des réglages — sont supprimées de votre base de données iCloud privée (nécessite une connexion internet)"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-afrit af gögnunum þínum — samstilltar lotur, öryggisafrit af yfirstandandi upptökum og stillingaafritið — eru eytt úr einkagagnagrunninum þínum á iCloud (krefst nettengingar)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le copie su iCloud dei tuoi dati — sessioni sincronizzate, backup delle registrazioni in corso e backup delle impostazioni — vengono eliminate dal tuo database iCloud privato (richiede una connessione a internet)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データの iCloud コピー（同期されたセッション、進行中の記録のバックアップ、設定のバックアップ）は、プライベートな iCloud データベースから削除されます（インターネット接続が必要です）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터의 iCloud 사본 — 동기화된 세션, 진행 중인 기록 백업, 설정 백업 — 이 비공개 iCloud 데이터베이스에서 삭제됩니다 (인터넷 연결 필요)"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-kopier av dataene dine — synkroniserte økter, sikkerhetskopier av pågående opptak og innstillingssikkerhetskopien — slettes fra din private iCloud-database (krever internettforbindelse)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-kopieën van je gegevens — gesynchroniseerde sessies, back-ups van lopende opnames en de back-up van instellingen — worden uit je privé iCloud-database verwijderd (vereist een internetverbinding)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cópias dos seus dados no iCloud — sessões sincronizadas, backups de gravações em andamento e o backup das configurações — são excluídas do seu banco de dados privado do iCloud (requer conexão com a internet)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копии ваших данных в iCloud — синхронизированные сессии, резервные копии текущих записей и резервная копия настроек — удаляются из вашей личной базы данных iCloud (требуется подключение к интернету)"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-kopior av dina data — synkroniserade sessioner, säkerhetskopior av pågående inspelningar och säkerhetskopian av inställningar — raderas från din privata iCloud-databas (kräver internetanslutning)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的数据的 iCloud 副本——已同步的记录、进行中的录制备份以及设置备份——将从你的私人 iCloud 数据库中删除（需要互联网连接）"
          }
        }
      }
    },
    "iCloud copies stay until you use Delete All My Data or remove them in your iCloud settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى نسخ iCloud حتى تستخدم «حذف جميع بياناتي» أو تزيلها من إعدادات iCloud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-kopier bevares, indtil du bruger Slet alle mine data eller fjerner dem i dine iCloud-indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-Kopien bleiben erhalten, bis du „Alle meine Daten löschen“ verwendest oder sie in deinen iCloud-Einstellungen entfernst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias en iCloud se mantienen hasta que uses Eliminar todos mis datos o las elimines en tus ajustes de iCloud."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-kopiot säilyvät, kunnes käytät toimintoa Poista kaikki tietoni tai poistat ne iCloud-asetuksistasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les copies iCloud sont conservées jusqu’à ce que vous utilisiez Supprimer toutes mes données ou que vous les supprimiez dans vos réglages iCloud."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afrit í iCloud haldast þar til þú notar Eyða öllum gögnunum mínum eða fjarlægir þau í iCloud-stillingunum þínum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le copie su iCloud restano finché non usi Elimina tutti i miei dati o non le rimuovi dalle impostazioni di iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 上のコピーは、「すべてのデータを削除」を使用するか iCloud の設定で削除するまで残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 사본은 내 데이터 모두 삭제를 사용하거나 iCloud 설정에서 제거할 때까지 남아 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopier i iCloud blir liggende til du bruker Slett alle dataene mine eller fjerner dem i iCloud-innstillingene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieën in iCloud blijven bestaan totdat je Al mijn gegevens verwijderen gebruikt of ze verwijdert in je iCloud-instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cópias no iCloud permanecem até você usar Excluir todos os meus dados ou removê-las nas configurações do iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копии в iCloud сохраняются, пока вы не воспользуетесь функцией «Удалить все мои данные» или не удалите их в настройках iCloud."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopior i iCloud finns kvar tills du använder Radera alla mina data eller tar bort dem i dina iCloud-inställningar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud 中的副本会一直保留，直到你使用“删除我的所有数据”或在 iCloud 设置中移除它们。"
          }
        }
      }
    },
