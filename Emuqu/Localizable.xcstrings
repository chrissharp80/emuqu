    "Apple Intelligence is on-device. If you'd rather not share with %@, switch to Apple Intelligence in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل Apple Intelligence على الجهاز. إذا كنت تفضّل عدم المشاركة مع %@، فبدّل إلى Apple Intelligence من الإعدادات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence kører på enheden. Hvis du helst ikke vil dele med %@, kan du skifte til Apple Intelligence i Indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence läuft auf dem Gerät. Wenn du nichts mit %@ teilen möchtest, wechsle in den Einstellungen zu Apple Intelligence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence funciona en el dispositivo. Si prefieres no compartir con %@, cambia a Apple Intelligence en Ajustes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence toimii laitteella. Jos et halua jakaa palvelun %@ kanssa, vaihda asetuksista Apple Intelligenceen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence fonctionne sur l’appareil. Si vous préférez ne rien partager avec %@, basculez sur Apple Intelligence dans les Réglages."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence keyrir í tækinu. Ef þú kýst að deila ekki með %@ skaltu skipta yfir í Apple Intelligence í Stillingum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence funziona sul dispositivo. Se preferisci non condividere con %@, passa ad Apple Intelligence in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence は端末内で動作します。%@ と共有したくない場合は、設定で Apple Intelligence に切り替えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence는 기기에서 실행됩니다. %@와 공유하고 싶지 않다면 설정에서 Apple Intelligence로 전환하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence kjører på enheten. Hvis du helst ikke vil dele med %@, bytt til Apple Intelligence i Innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence draait op het apparaat. Wil je liever niets delen met %@, schakel dan in Instellingen over naar Apple Intelligence."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Apple Intelligence roda no dispositivo. Se preferir não compartilhar com o %@, mude para Apple Intelligence em Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence работает на устройстве. Если вы не хотите делиться с %@, переключитесь на Apple Intelligence в настройках."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence körs på enheten. Om du hellre inte vill dela med %@ kan du byta till Apple Intelligence i Inställningar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 在设备端运行。如果你不想与 %@ 共享，可在设置中切换到 Apple Intelligence。"
          }
        }
      }
    },
    "Apple Intelligence runs entirely on this iPhone. No data leaves the device. Requires iOS 26 with Apple Intelligence enabled." : {
      "comment" : "A description of the on-device Apple Intelligence feature.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل Apple Intelligence بالكامل على هذا الـ iPhone. لا تغادر أي بيانات الجهاز. يتطلب iOS 26 مع تفعيل Apple Intelligence."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence kører udelukkende på denne iPhone. Ingen data forlader enheden. Kræver iOS 26 med Apple Intelligence aktiveret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence läuft vollständig auf diesem iPhone. Keine Daten verlassen das Gerät. Erfordert iOS 26 mit aktivierter Apple Intelligence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence se ejecuta por completo en este iPhone. Ningún dato sale del dispositivo. Requiere iOS 26 con Apple Intelligence activado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence toimii kokonaan tässä iPhonessa. Tiedot eivät poistu laitteesta. Vaatii iOS 26:n, jossa Apple Intelligence on käytössä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence fonctionne entièrement sur cet iPhone. Aucune donnée ne quitte l'appareil. Nécessite iOS 26 avec Apple Intelligence activé."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence keyrir alfarið á þessum iPhone. Engin gögn fara úr tækinu. Krefst iOS 26 með Apple Intelligence virkjað."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence funziona interamente su questo iPhone. Nessun dato lascia il dispositivo. Richiede iOS 26 con Apple Intelligence attivato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence はこの iPhone 上で完全に動作します。データはデバイスの外に出ません。Apple Intelligence を有効にした iOS 26 が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence는 이 iPhone에서 전적으로 실행됩니다. 데이터가 기기를 벗어나지 않습니다. Apple Intelligence가 활성화된 iOS 26이 필요합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence kjører helt på denne iPhone. Ingen data forlater enheten. Krever iOS 26 med Apple Intelligence aktivert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence draait volledig op deze iPhone. Er verlaten geen gegevens het apparaat. Vereist iOS 26 met Apple Intelligence ingeschakeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Apple Intelligence é executado inteiramente neste iPhone. Nenhum dado sai do dispositivo. Requer iOS 26 com o Apple Intelligence ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence работает полностью на этом iPhone. Данные не покидают устройство. Требуется iOS 26 с включённым Apple Intelligence."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence körs helt på denna iPhone. Inga data lämnar enheten. Kräver iOS 26 med Apple Intelligence aktiverat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Intelligence 完全在此 iPhone 上运行。没有数据离开设备。需要已启用 Apple Intelligence 的 iOS 26。"
