    "Recent load is above your usual range — listen to your body" : {
      "comment" : "Insight into the risk of injury if a recent training load is above one's usual capacity.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحمل الأخير أعلى من نطاقك المعتاد — أنصت إلى جسدك"
