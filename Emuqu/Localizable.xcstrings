    },
    "This will recompute scores for all recorded sessions. This may take a while if you have a lot of data." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيعيد هذا حساب الدرجات لجميع الجلسات المسجلة. قد يستغرق هذا بعض الوقت إذا كان لديك الكثير من البيانات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette genberegner scorer for alle registrerede sessioner. Det kan tage et stykke tid, hvis du har mange data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scores werden für alle aufgezeichneten Sitzungen neu berechnet. Dies kann bei vielen Daten eine Weile dauern."
