    },
    "The app is not directed at children, and the developer does not knowingly collect personal data from anyone under 13." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التطبيق غير موجّه للأطفال، ولا يجمع المطوّر عن علم بيانات شخصية من أي شخص دون 13 عامًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appen er ikke rettet mod børn, og udvikleren indsamler ikke bevidst personoplysninger fra personer under 13 år."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App richtet sich nicht an Kinder, und der Entwickler erhebt nicht wissentlich personenbezogene Daten von Personen unter 13 Jahren."
