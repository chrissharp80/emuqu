    "Internal SDK error (invalid argument). Try again; if it persists, send a diagnostic from Settings → Troubleshooting." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خطأ داخلي في SDK (وسيط غير صالح). حاول مرة أخرى؛ وإذا استمر، أرسل تقريرًا تشخيصيًا من الإعدادات ← استكشاف الأخطاء."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intern SDK-fejl (ugyldigt argument). Prøv igen; hvis det fortsætter, så send en fejlrapport fra Indstillinger → Fejlfinding."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interner SDK-Fehler (ungültiges Argument). Versuch es erneut; falls es bleibt, sende einen Fehlerbericht über Einstellungen → Fehlerbehebung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error interno del SDK (argumento no válido). Inténtalo de nuevo; si persiste, envía un diagnóstico desde Ajustes → Solución de problemas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisäinen SDK-virhe (virheellinen argumentti). Yritä uudelleen; jos ongelma jatkuu, lähetä diagnostiikka kohdasta Asetukset → Vianetsintä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erreur interne du SDK (argument non valide). Réessayez ; si le problème persiste, envoyez un diagnostic depuis Réglages → Dépannage."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
