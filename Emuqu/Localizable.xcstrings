        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Engar vistaðar leiðir fyrir %@ enn. Vistaðu fyrsta gönguferðina þína í lokin og hún birtist hér."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun percorso salvato per %@ al momento. Salva la tua prima camminata alla fine e apparirà qui."
