        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koop de volledige app — eenmalige aankoop, geen abonnementen"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compre o app completo — compra única, sem assinaturas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Купите полную версию приложения — разовая покупка, без подписок"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Köp hela appen — engångsköp, inga prenumerationer"
