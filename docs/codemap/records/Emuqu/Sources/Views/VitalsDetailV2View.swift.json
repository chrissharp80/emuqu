    "mem:VitalsDetailV2View.refreshedVitals"
   ],
   "branches": [
    {
     "at": "+2",
     "cond": "no latest overnight session",
     "effect": "returns without fetching; screen uses the passed-in vitals only"
    },
    {
     "at": "+3",
     "cond": "latest endDate nil",
     "effect": "reference = startDate"
    },
