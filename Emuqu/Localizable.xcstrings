        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De band is niet volledig ingesteld. Houd hem om en dicht bij de telefoon en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cinta não terminou a configuração. Mantenha-a ligada e perto do telefone e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Датчик не завершил настройку. Не снимайте его и держите рядом с телефоном, затем повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
