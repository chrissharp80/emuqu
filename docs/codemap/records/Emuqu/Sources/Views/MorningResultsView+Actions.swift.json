  {
   "key": "func MorningResultsView.saveTagsAndNotesIfChanged()",
   "hash": "218f660cf1f6ea28",
   "does": "When onUpdateTags is set: compares the card's tags and notes (vm.selectedTags, vm.notes) with what was last stored — the last hand-off (savedTagsAndNotes) or else vm.session's own tags/notes — and, if they differ, calls onUpdateTags(tags, notes or nil when empty) and records them as savedTagsAndNotes. No-op otherwise.",
   "entry": "Done button and MorningResultsView.withLifecycle's onDisappear",
   "calls": [
    "closure:onUpdateTags — set by HistoryView.sessionDetailContent to persist via HistoryView.onUpdateTags; nil from RecordView and ImportDataView"
   ],
   "reads": [
    "mem:MorningResultsViewModel.selectedTags",
    "mem:MorningResultsViewModel.notes",
    "mem:MorningResultsView.savedTagsAndNotes"
   ],
   "writes": [
    "mem:MorningResultsView.savedTagsAndNotes"
   ],
   "branches": [
    {
     "at": "+1",
     "cond": "onUpdateTags nil",
     "effect": "returns"
    },
    {
     "at": "+3",
     "cond": "savedTagsAndNotes nil",
     "effect": "baseline is vm.session tags/notes"
    },
    {
     "at": "+4",
     "cond": "current == stored",
     "effect": "returns without a hand-off"
    },
    {
     "at": "+5",
     "cond": "notes empty",
     "effect": "passes nil notes"
    }
   ],
   "deps": {}
  },
