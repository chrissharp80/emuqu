  {
   "key": "func OnboardingHealthPage.requestHealthAuthorization()",
   "hash": "71a10bfaaf72ec3f",
   "does": "Sets requesting and clears authError; awaits HealthKitManager.requestAuthorization (clears the skip key, prompts if not yet requested this process). If it throws: logs a warning, sets authError to the localized 'Apple Health authorization failed: <reason>', requesting=false and returns without probing or setting didAttempt, so the page keeps Connect (retry possible) and shows the reason. Otherwise sets grantedScopes = await grantedScopeSummary(), requesting=false, didAttempt=true.",
   "entry": "Task from connectHealthButton tap.",
   "calls": [
    "Emuqu/Sources/Collection/HealthKitManager.swift::func HealthKitManager.requestAuthorization()",
    "Emuqu/Sources/Collection/HealthKitManager.swift::func HealthKitManager.grantedScopeSummary()",
    "Emuqu/Sources/Utilities/DebugLog.swift::func debugLog(_:level:file:line:)",
    "Emuqu/Sources/Services/LanguageManager.swift::var LanguageManager.appBundle"
   ],
   "reads": [
    "hk:sleepAnalysis",
    "hk:heartRate",
    "hk:respiratoryRate/oxygenSaturation/appleSleepingWristTemperature",
    "hk:workoutType"
   ],
   "writes": [
    "ud:healthAccessSkippedInOnboarding (removed inside requestAuthorization)",
    "mem:HealthKitManager.authorizationRequested (set on success)",
    "mem:OnboardingHealthPage.authError"
   ],
   "branches": [
    {
     "at": "+6",
     "cond": "hk.requestAuthorization throws",
     "effect": "log warning, authError = localized failure reason, requesting = false, return (no scope probe, didAttempt stays false)"
    }
   ],
