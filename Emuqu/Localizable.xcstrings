            "value" : "انقر على حزامك. يخبرك Emuqu بما يكون جسمك مستعدًا له اليوم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på dit bælte. Emuqu fortæller dig, hvad din krop er klar til i dag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf deinen Gurt. Emuqu sagt dir, wofür dein Körper heute bereit ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca tu banda. Emuqu te dice para qué está listo tu cuerpo hoy."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napauta pantaasi. Emuqu kertoo, mihin kehosi on tänään valmis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez votre ceinture. Emuqu vous dit ce pour quoi votre corps est prêt aujourd'hui."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pikkaðu á beltið þitt. Emuqu segir þér fyrir hverju líkaminn þinn er tilbúinn í dag."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca la tua fascia. Emuqu ti dice a cosa è pronto il tuo corpo oggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストラップをタップしてください。Emuqu が今日あなたの体が何に対応できるかを教えてくれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스트랩을 탭하세요. Flow가 오늘 몸이 무엇을 할 준비가 되었는지 알려줍니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk på stroppen din. Emuqu forteller deg hva kroppen din er klar for i dag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op je band. Emuqu vertelt je waar je lichaam vandaag klaar voor is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque na sua cinta. O Emuqu informa para o que seu corpo está pronto hoje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь датчика. Emuqu подскажет, к чему ваше тело готово сегодня."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck på ditt band. Emuqu berättar vad din kropp är redo för idag."
          }
