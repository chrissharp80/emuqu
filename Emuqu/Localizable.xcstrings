    "In your normal range. Listen to how you feel today." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضمن نطاقك الطبيعي. استمع إلى ما تشعر به اليوم."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inden for dit normale område. Lyt til, hvordan du har det i dag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In deinem normalen Bereich. Achte darauf, wie du dich heute fühlst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tu rango normal. Escucha cómo te sientes hoy."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Normaalilla vaihteluvälilläsi. Kuuntele, miltä tänään tuntuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans votre plage normale. Écoutez vos sensations aujourd'hui."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innan venjulegs bils þíns. Hlustaðu á hvernig þér líður í dag."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel tuo intervallo normale. Ascolta come ti senti oggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつもの範囲内です。今日の体調に耳を傾けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평소 범위 안에 있습니다. 오늘 몸 상태에 귀를 기울이세요."
          }
        },
        "nb" : {
