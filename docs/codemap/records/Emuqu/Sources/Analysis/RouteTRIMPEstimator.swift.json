    "Emuqu/Sources/Analysis/RouteTRIMPEstimator.swift::func RouteTRIMPEstimator.targetDistance(recordedDistance:savedDistance:distanceMayBeTruncated:)"
   ],
   "reads": [
    "archive:SessionArchive.entries/retrieveLightweight",
    "mem:SavedRouteStore.routes"
   ],
   "writes": [],
   "branches": [
    {
     "at": "+9",
     "cond": "track matches a saved route and track has a first timestamp",
     "effect": "false: nil (no estimate)"
    },
    {
     "at": "+13",
     "cond": "ratios empty",
     "effect": "priorAvgRatio = nil; else arithmetic mean"
    },
    {
     "at": "+16",
     "cond": "prior average and recorded ratio exist and recorded >= 0.7 × prior",
     "effect": "returns nil (case 1, measured stands)"
    },
    {
     "at": "+21",
     "cond": "no prior average and target distance == recorded distance",
     "effect": "returns nil (no extrapolation to make)"
    },
    {
     "at": "+22",
     "cond": "scaledEstimate non-nil",
     "effect": "false (no prior and no recorded ratio): nil; true: Estimate"
    }
   ],
