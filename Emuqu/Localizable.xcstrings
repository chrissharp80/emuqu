    "Required to connect the Polar strap. iOS asks for this the first time you connect a sensor; if it's Denied here, the strap can't connect until you re-enable it in iOS Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مطلوب لتوصيل حزام Polar. يطلبه iOS أول مرة تصل فيها مستشعرًا؛ وإن كان مرفوضًا هنا فلن يتمكن الحزام من الاتصال حتى تعيد تفعيله من إعدادات iOS."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nødvendig for at forbinde Polar-bæltet. iOS beder om dette første gang du forbinder en sensor; er det Afvist her, kan bæltet ikke forbinde, før du slår det til igen i iOS-indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erforderlich, um den Polar-Gurt zu verbinden. iOS fragt das beim ersten Verbinden eines Sensors ab; ist es hier abgelehnt, kann sich der Gurt erst wieder verbinden, wenn du es in den iOS-Einstellungen aktivierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesario para conectar la banda Polar. iOS lo pide la primera vez que conectas un sensor; si aquí está denegado, la banda no podrá conectarse hasta que lo reactives en los Ajustes de iOS."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarvitaan Polar-pannan yhdistämiseen. iOS kysyy tätä, kun yhdistät sensorin ensimmäistä kertaa; jos se on tässä evätty, panta ei voi yhdistyä ennen kuin sallit sen iOS-asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nécessaire pour connecter la ceinture Polar. iOS le demande la première fois que vous connectez un capteur ; si c’est refusé ici, la ceinture ne pourra pas se connecter tant que vous ne le réactivez pas dans les Réglages iOS."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nauðsynlegt til að tengja Polar-ólina. iOS spyr um þetta í fyrsta sinn sem þú tengir nema; sé því hafnað hér getur ólin ekki tengst fyrr en þú kveikir aftur á því í iOS-stillingum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessario per collegare la fascia Polar. iOS lo chiede la prima volta che colleghi un sensore; se qui è negato, la fascia non potrà connettersi finché non lo riattivi nelle Impostazioni iOS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar ストラップの接続に必要です。iOS はセンサーを初めて接続するときにこれを尋ねます。ここで拒否されていると、iOS の設定で再度有効にするまでストラップは接続できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar 스트랩 연결에 필요합니다. iOS는 센서를 처음 연결할 때 이를 요청합니다. 여기서 거부되어 있으면 iOS 설정에서 다시 허용하기 전까지 스트랩이 연결되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nødvendig for å koble til Polar-beltet. iOS spør om dette første gang du kobler til en sensor; er det avvist her, kan ikke beltet koble til før du slår det på igjen i iOS-innstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nodig om de Polar-band te verbinden. iOS vraagt dit de eerste keer dat je een sensor koppelt; staat het hier op Geweigerd, dan kan de band pas verbinden als je het weer inschakelt in de iOS-instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necessário para conectar a cinta Polar. O iOS pede isso na primeira vez que você conecta um sensor; se estiver negado aqui, a cinta não conseguirá conectar até você reativar nos Ajustes do iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Требуется для подключения ремня Polar. iOS запрашивает это при первом подключении датчика; если здесь стоит запрет, ремень не подключится, пока вы не включите разрешение в настройках iOS."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krävs för att ansluta Polar-bandet. iOS frågar om detta första gången du ansluter en sensor; är det nekat här kan bandet inte ansluta förrän du slår på det igen i iOS-inställningarna."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接 Polar 心率带所必需。首次连接传感器时 iOS 会请求该权限；若此处为“已拒绝”，需在 iOS 设置中重新开启后才能连接心率带。"
          }
        }
      }
    },
    "Requires iOS 26 with Apple Intelligence enabled." : {
      "comment" : "Reason why the Apple Intelligence AI provider is currently unavailable.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
