  {
   "key": "func VitalsScoring.restingHRSubScore(vitals:baselineStats:)",
   "hash": "af88825ecde50248",
   "does": "Sleep/resting-HR sub-score: 100 minus rhrPenaltyPerSD (10) per SD the HR sits above meanHRBaseline, floored at 0 and never above 100 (below-baseline clamps to 0 excess). Nil without HR, baseline>0 and SD>0.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+4",
     "cond": "restingHeartRate, meanHRBaseline>0 and meanHRSD>0 all present",
     "effect": "compute max(0, 100 - max(0,(rhr-baseline)/sd)*10); otherwise return nil (sub-score dropped)"
    }
   ],
   "deps": {}
  },
  {
