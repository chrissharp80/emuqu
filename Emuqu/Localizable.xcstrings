    "Session data integrity check failed — the file may be corrupted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل التحقق من سلامة بيانات الجلسة — قد يكون الملف تالفًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integritetskontrol af sessionsdata mislykkedes — filen kan være beskadiget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Integritätsprüfung der Sitzungsdaten fehlgeschlagen – die Datei ist möglicherweise beschädigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falló la comprobación de integridad de los datos de la sesión: el archivo puede estar dañado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Istuntotietojen eheystarkistus epäonnistui — tiedosto voi olla vioittunut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
