          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tallennustietoja ei voitu lukea vyöstä: %@. Yritä uudelleen; tiedot ovat vyössä, kunnes aloitat uuden tallennuksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de lire les données d’enregistrement de la ceinture : %@. Réessayez ; les données restent sur la ceinture jusqu’à ce que vous lanciez un nouvel enregistrement."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekki tókst að lesa upptökugögn af ólinni: %@. Reyndu aftur; gögnin eru enn á ólinni þar til þú byrjar nýja upptöku."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere i dati di registrazione dalla fascia: %@. Riprova; i dati restano sulla fascia finché non avvii una nuova registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ストラップから記録データを読み取れませんでした：%@。もう一度お試しください。新しい記録を開始するまで、データはストラップに残っています。"
          }
        },
        "ko" : {
          "stringUnit" : {
