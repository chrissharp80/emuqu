    "ACWR has zero peer-reviewed validation in walking, hiking, recreational training, or masters athletes 40+." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يملك ACWR أي تحقق خاضع لمراجعة الأقران في المشي أو التنزه الجبلي أو التدريب الترفيهي أو لدى الرياضيين المخضرمين فوق 40 عامًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ACWR har ingen fagfællebedømt validering for gang, vandring, motionstræning eller masters-atleter over 40."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ACWR ist bei Wandern, Bergwandern, Freizeittraining und Masters-Athleten ab 40 nicht durch begutachtete Studien validiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ACWR no tiene ninguna validación revisada por pares en caminatas, senderismo, entrenamiento recreativo ni deportistas máster de 40 años o más."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ACWR:llä ei ole lainkaan vertaisarvioitua validointia kävelyssä, vaelluksessa, kuntoliikunnassa eikä yli 40-vuotiailla masters-urheilijoilla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ACWR n'a aucune validation évaluée par les pairs pour la marche, la randonnée, l'entraînement de loisir ou les athlètes masters de 40 ans et plus."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ACWR hefur enga ritrýnda staðfestingu í göngu, fjallgöngu, almennri þjálfun eða hjá öldungaíþróttafólki eldra en 40 ára."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ACWR non ha alcuna validazione sottoposta a revisione paritaria per camminata, escursionismo, allenamento amatoriale o atleti master over 40."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ACWR は、ウォーキング、ハイキング、レクリエーションとしてのトレーニング、40 歳以上のマスターズアスリートにおいて、査読付きの検証が一切ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ACWR은 걷기, 하이킹, 레크리에이션 트레이닝, 40세 이상 마스터즈 선수에 대해 동료 심사를 거친 검증이 전혀 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ACWR har ingen fagfellevurdert validering for gåing, fotturer, mosjonstrening eller masters-utøvere over 40."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ACWR is nergens peer-reviewed gevalideerd voor wandelen, hiken, recreatief trainen of masters-atleten van 40+."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ACWR não tem nenhuma validação revisada por pares em caminhada, trilhas, treino recreativo ou atletas master acima de 40 anos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У ACWR нет ни одной рецензируемой валидации для ходьбы, походов, любительских тренировок или спортсменов-ветеранов старше 40 лет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ACWR saknar helt referentgranskad validering för promenader, vandring, motionsträning och masters-idrottare över 40."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ACWR 在步行、徒步、休闲训练或 40 岁以上的大师级运动员中没有任何同行评审的验证。"
          }
        }
      }
    },
