            "state" : "translated",
            "value" : "Herstellen mislukt — zorg dat de band is verbonden en probeer het opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível recuperar — verifique se a cinta está conectada e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось восстановить — убедитесь, что ремень подключён, и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunde inte återställa — kontrollera att remmen är ansluten och försök igen."
          }
