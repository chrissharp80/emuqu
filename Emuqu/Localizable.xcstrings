    "Distance recovered from Apple Health — now %@. (No GPS route was recorded, so the map still shows only the part the phone captured.)" : {
      "comment" : "A message that appears when the user recovers the distance of a workout from Apple Health, but not the full GPS route. The argument is the distance, formatted in U.S. Dollars.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم استرداد المسافة من Apple Health — الآن %@. (لم يتم تسجيل مسار GPS، لذا لا تزال الخريطة تعرض الجزء الذي التقطه الهاتف فقط.)"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance gendannet fra Apple Health — nu %@. (Ingen GPS-rute blev optaget, så kortet viser stadig kun den del, telefonen registrerede.)"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distanz aus Apple Health wiederhergestellt — jetzt %@. (Es wurde keine GPS-Route aufgezeichnet, daher zeigt die Karte weiterhin nur den vom Telefon erfassten Teil.)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distancia recuperada de Apple Health: ahora %@. (No se registró ninguna ruta GPS, por lo que el mapa solo muestra la parte que captó el teléfono.)"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etäisyys palautettu Apple Healthista — nyt %@. (GPS-reittiä ei tallennettu, joten kartta näyttää edelleen vain puhelimen tallentaman osuuden.)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance récupérée depuis Apple Santé — désormais %@. (Aucun itinéraire GPS n'a été enregistré, la carte n'affiche donc que la partie captée par le téléphone.)"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vegalengd endurheimt úr Apple Health — núna %@. (Engin GPS-leið var skráð, svo kortið sýnir enn aðeins þann hluta sem síminn náði.)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distanza recuperata da Apple Health — ora %@. (Non è stato registrato alcun percorso GPS, quindi la mappa mostra solo la parte acquisita dal telefono.)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health から距離を復元しました — 現在 %@。(GPSルートが記録されていないため、地図には電話機が取得した部分のみが表示されます。)"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health에서 거리를 복구했습니다 — 현재 %@. (GPS 경로가 기록되지 않아 지도에는 여전히 휴대폰이 캡처한 부분만 표시됩니다.)"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distanse gjenopprettet fra Apple Health — nå %@. (Ingen GPS-rute ble registrert, så kartet viser fremdeles bare den delen telefonen fanget opp.)"
          }
        },
        "nl" : {
          "stringUnit" : {
