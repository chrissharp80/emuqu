     "at": "+1",
     "cond": "no baseline",
     "effect": "population bands"
    },
    {
     "at": "+2",
     "cond": "rr < 12",
     "effect": "'Low'"
    },
    {
     "at": "+3",
     "cond": "rr <= 16",
     "effect": "'Normal range'"
    },
    {
     "at": "+4",
     "cond": "rr <= 18",
     "effect": "'Upper normal' else 'Elevated'"
    },
    {
     "at": "+9",
