    "Pair a Polar H10 or Verity Sense. You can always do this later from the Record tab." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بإقران Polar H10 أو Verity Sense. يمكنك دائماً القيام بذلك لاحقاً من علامة التبويب تسجيل."
          }
        },
        "da" : {
          "stringUnit" : {
