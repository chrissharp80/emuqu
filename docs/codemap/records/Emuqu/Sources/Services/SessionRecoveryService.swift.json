{
 "file": "Emuqu/Sources/Services/SessionRecoveryService.swift",
 "hash": "fd8916ecef015adb",
 "role": "Main-actor service with the recovery algorithms behind RRCollector/SessionRecoveryCoordinator: lost-session detection from raw backups (with iCloud pull), trash listing/restore/permanent delete (with the outcome the Trash reports), backup retrieval with pause/resume parent merge, and windowed analysis.",
 "types": [
  "SessionRecoveryService: class (@MainActor final) — recovery logic over SessionArchive, RawRRBackup, CloudKitSyncManager",
  "SessionRecoveryService.PatchAction: enum — addMissingData/reanalyzeNoResult/reanalyzeNoFlags/replaceWithNewData",
  "SessionRecoveryService.BackupData: struct — backup entry, merged series, artifact flags, session start, end date",
  "TrashDeletionOutcome: struct (Equatable, Sendable) — sessions kept in the Trash, and sessions removed whose Apple Health HRV could not be deleted"
 ],
 "state": [
  "ud:sessionRecoveryLastCloudPull (standard suite; last iCloud backup pull time, seconds since 1970)",
  "mem:SessionRecoveryService.minRecoverableBeatCount = 120",
  "mem:SessionRecoveryService.cloudPullMinInterval = 300 s"
 ],
