   "key": "func RespirationAnalyzer.isBreathingPeak(psd:peakBin:band:freqRes:)",
   "hash": "6d98252f20c81e48",
   "does": "Whether the band's largest bin is breathing: the bins within ±peakHalfWidthHz (0.02 Hz, at least one bin) of it hold at least peakConcentrationMinimum (40 %) of the band's power, and it is at least peakHeightMinimum (5 %) of the strongest bin from 0.04 Hz to the band's top. Rejects white or 1/f noise (power spread over the band) and leakage from a slower rhythm (a band peak a millionth of the slow peak). Thresholds from synthetic five-minute windows: 95-100 % of breathing kept, 0-3 % of noise passed.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+6",
     "cond": "near-peak power >= 40 % of band power AND peak >= 5 % of the strongest bin above 0.04 Hz",
     "effect": "true; else false"
    }
   ],
