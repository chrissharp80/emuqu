    "MetricKit + real-time memory / thermal sampling. Captures the iOS-level reason for any background termination during a recording session." : {
      "comment" : "A description of the system diagnostics feature, which uses MetricKit to capture reasons for background app termination.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit + أخذ عينات للذاكرة / الحرارة في الوقت الفعلي. يلتقط السبب على مستوى iOS لأي إنهاء في الخلفية أثناء جلسة تسجيل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit + realtidsovervågning af hukommelse / termisk tilstand. Registrerer iOS-niveau-årsagen til enhver baggrundsafslutning under en optagelsessession."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit + Echtzeit-Erfassung von Speicher / Temperatur. Erfasst den iOS-Grund für jede Hintergrundbeendigung während einer Aufzeichnungssitzung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit + muestreo de memoria / térmico en tiempo real. Captura el motivo a nivel de iOS de cualquier cierre en segundo plano durante una sesión de grabación."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit + reaaliaikainen muistin / lämpötilan näytteistys. Tallentaa iOS-tason syyn mille tahansa taustasulkemiselle tallennusistunnon aikana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit + échantillonnage en temps réel de la mémoire / température. Capture la raison au niveau iOS de toute fermeture en arrière-plan pendant une session d'enregistrement."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit + rauntímamæling á minni / hita. Skráir iOS-ástæðu fyrir hvers kyns lokun í bakgrunni meðan á upptökulotu stendur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit + campionamento in tempo reale di memoria / temperatura. Acquisisce il motivo a livello di iOS di qualsiasi chiusura in background durante una sessione di registrazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit + リアルタイムのメモリ / 温度サンプリング。記録セッション中のバックグラウンド終了について、iOS レベルの理由を捕捉します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit + 실시간 메모리 / 발열 샘플링. 기록 세션 중 발생하는 모든 백그라운드 종료에 대한 iOS 수준의 원인을 포착합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit + sanntidsmåling av minne / temperatur. Fanger opp iOS-nivå-årsaken til enhver bakgrunnsavslutning under en opptaksøkt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit + realtime bemonstering van geheugen / temperatuur. Legt de iOS-reden vast voor elke achtergrondbeëindiging tijdens een opnamesessie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit + amostragem em tempo real de memória / temperatura. Captura o motivo no nível do iOS para qualquer encerramento em segundo plano durante uma sessão de gravação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit + выборка памяти / температуры в реальном времени. Фиксирует причину на уровне iOS для любого завершения работы в фоновом режиме во время сессии записи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit + sampling av minne / temperatur i realtid. Registrerar orsaken på iOS-nivå till varje bakgrundsavslut under en inspelningssession."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MetricKit + 实时内存 / 温度采样。捕获录制记录期间任何后台终止的 iOS 层面原因。"
          }
        }
      }
    },
