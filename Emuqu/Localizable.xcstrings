    "Kept on your iPhone and in your private iCloud. Emuqu has no servers of its own." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ على iPhone الخاص بك وفي iCloud الخاص بك. ليس لدى Emuqu خوادم خاصة به."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemt på din iPhone og i din private iCloud. Emuqu har ingen egne servere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeichert auf deinem iPhone und in deiner privaten iCloud. Emuqu hat keine eigenen Server."
          }
        },
        "es" : {
          "stringUnit" : {
