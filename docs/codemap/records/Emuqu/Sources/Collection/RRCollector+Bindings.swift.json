   ],
   "branches": [
    {
     "at": "+1",
     "cond": "not overnight streaming",
     "effect": "returns WITHOUT clearing reconnectExhausted (flag stays true until PolarManager resets it on the next streaming start)"
    },
    {
     "at": "+2",
     "cond": "overnightDeviceBackupActive",
