        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leposykkeesi laskee, mikä on myönteinen merkki sydän- ja verenkiertoelimistön sopeutumisesta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
