    "Go to Settings → iCloud & Data → Import RR Data to bring in data from other apps and devices." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتقل إلى الإعدادات → iCloud والبيانات → استيراد بيانات RR لجلب البيانات من تطبيقات وأجهزة أخرى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gå til Indstillinger → iCloud og data → Importer RR-data for at hente data fra andre apps og enheder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehe zu Einstellungen → iCloud & Daten → RR-Daten importieren, um Daten aus anderen Apps und Geräten zu übernehmen."
          }
        },
        "es" : {
          "stringUnit" : {
