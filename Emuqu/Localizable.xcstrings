    "No saved routes for %@ yet. Save your first walk at the end and it appears here." : {
      "comment" : "A description below the \"Find a trail\" button, explaining that the user hasn't saved any routes yet.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد مسارات محفوظة لـ %@ بعد. احفظ أول نزهة لك في النهاية وستظهر هنا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen gemte ruter for %@ endnu. Gem din første gåtur til sidst, så vises den her."
          }
        },
        "de" : {
          "stringUnit" : {
