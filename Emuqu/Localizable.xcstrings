        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "睡眠中の 30 秒ウィンドウ %lld 個から構成されています。これはあなた自身の範囲からの偏差の観察であって、医学的評価ではありません。ベースラインにすでに慢性的な不規則性が含まれている場合、その不規則性はベースラインに取り込まれているため「安定」と判定されます。"
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "수면 중 30초 구간 %lld개로 산출되었습니다. 사용자 본인의 범위에서 벗어난 정도를 관찰한 것이며 의학적 평가가 아닙니다. 기준선에 이미 만성적인 불규칙성이 포함된 사용자는 그 불규칙성이 기준선에 흡수되어 있으므로 '일관됨'으로 나옵니다."
                }
              }
            }
          }
        },
        "nb" : {
          "variations" : {
            "plural" : {
