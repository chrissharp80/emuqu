    "Actual temperature with deviation from your 7-day baseline. More than 0.5°C above baseline is a notable deviation." : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "درجة الحرارة الفعلية مع الانحراف عن خط الأساس لـ 7 أيام. الارتفاع بأكثر من 0.5°C فوق خط الأساس انحراف لافت."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faktisk temperatur med afvigelse fra din 7-dages baseline. Mere end 0,5 °C over baseline er en bemærkelsesværdig afvigelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tatsächliche Temperatur mit Abweichung von deiner 7-Tage-Baseline. Mehr als 0,5 °C über der Baseline ist eine auffällige Abweichung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatura real con la desviación respecto a tu línea base de 7 días. Más de 0,5 °C por encima de la línea base es una desviación destacable."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todellinen lämpötila ja poikkeama 7 päivän perustasostasi. Yli 0,5 °C perustason yläpuolella on huomattava poikkeama."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Température réelle avec l’écart par rapport à votre référence sur 7 jours. Plus de 0,5 °C au-dessus de la référence est un écart notable."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raunverulegur hiti ásamt frávikum frá 7 daga grunngildinu þínu. Meira en 0,5°C yfir grunngildi er eftirtektarvert frávik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatura reale con lo scostamento dalla tua linea di base a 7 giorni. Più di 0,5 °C sopra la linea di base è uno scostamento rilevante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実際の温度と、7 日間のベースラインからの偏差です。ベースラインより 0.5°C 以上高い場合は注目すべき偏差です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실제 온도와 7일 기준선 대비 편차. 기준선보다 0.5°C 이상 높으면 눈여겨볼 만한 편차입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faktisk temperatur med avvik fra 7-dagers grunnlinjen din. Mer enn 0,5 °C over grunnlinjen er et merkbart avvik."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkelijke temperatuur met afwijking van je 7-daagse basislijn. Meer dan 0,5 °C boven de basislijn is een opvallende afwijking."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temperatura real com o desvio em relação à sua linha de base de 7 dias. Mais de 0,5 °C acima da linha de base é um desvio digno de nota."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фактическая температура и отклонение от вашего базового уровня за 7 дней. Превышение базового уровня более чем на 0,5 °C — заметное отклонение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faktisk temperatur med avvikelse från din 7-dagars baslinje. Mer än 0,5 °C över baslinjen är en anmärkningsvärd avvikelse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实际温度及其相对于你 7 天基线的偏差。高于基线 0.5°C 以上属于值得注意的偏差。"
          }
        }
      }
    },
    "Acute Training Load — 7-day exponentially weighted average. Represents recent fatigue." : {
