    "Polar straps only push battery on change. Replace the cell soon." : {
      "comment" : "A warning message explaining that Polar straps only update the battery status when it actually changes, and that users should replace the battery soon if the status is still \"unknown\".",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحزمة Polar تُرسل مستوى البطارية فقط عند تغيّره. استبدل البطارية قريبًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar-remme sender kun batteristatus ved ændring. Udskift cellen snart."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar-Gurte senden den Batteriestand nur bei Änderung. Tausche die Batterie bald aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las bandas Polar solo envían el nivel de batería cuando cambia. Cambia la pila pronto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar-pannat lähettävät akun tilan vain muutoksen yhteydessä. Vaihda paristo pian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les ceintures Polar n'envoient le niveau de batterie qu'en cas de changement. Remplacez la pile bientôt."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar-ólar senda aðeins rafhlöðustöðu við breytingu. Skiptu um rafhlöðuna fljótlega."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fasce Polar inviano il livello della batteria solo quando cambia. Sostituisci la pila a breve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar ストラップはバッテリー残量が変化したときにのみ送信します。早めに電池を交換してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar 스트랩은 배터리 잔량이 변할 때만 전송합니다. 곧 전지를 교체하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar-stropper sender batterinivå kun ved endring. Bytt cellen snart."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar-banden sturen het batterijniveau alleen bij wijziging. Vervang de batterij binnenkort."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cintas Polar só enviam o nível da bateria quando ele muda. Troque a pilha em breve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ремни Polar передают уровень заряда только при изменении. Замените батарейку в ближайшее время."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar-band skickar batterinivå endast vid förändring. Byt batteriet snart."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Polar 心率带仅在电量变化时上报。请尽快更换电池。"
          }
        }
      }
    },
