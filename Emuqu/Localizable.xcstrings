    "Deleted sessions stay here for 90 days unless you remove them sooner." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الجلسات المحذوفة هنا لمدة 90 يوماً ما لم تزلها قبل ذلك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slettede sessioner bliver her i 90 dage, medmindre du fjerner dem før."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelöschte Sitzungen bleiben hier 90 Tage, es sei denn, du entfernst sie früher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las sesiones eliminadas permanecen aquí durante 90 días, a menos que las quites antes."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistetut istunnot pysyvät täällä 90 päivää, ellet poista niitä aiemmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
