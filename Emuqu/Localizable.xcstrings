          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un estímulo de calor sólido (%lld%% de una dosis completa) — esta carrera hizo avanzar tu aclimatación al calor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
