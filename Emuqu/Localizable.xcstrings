    "Speaking — tap the speaker button to interrupt" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحدث — اضغط زر مكبر الصوت للمقاطعة"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taler — tryk på højttalerknappen for at afbryde"
