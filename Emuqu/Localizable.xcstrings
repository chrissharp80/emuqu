    "Your training has been heavier than usual — easier days help your body absorb it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كان تدريبك أثقل من المعتاد — الأيام الأخف تساعد جسمك على استيعابه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din træning har været hårdere end normalt — lettere dage hjælper kroppen med at optage den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Training war härter als sonst – leichtere Tage helfen deinem Körper, es zu verarbeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu entrenamiento ha sido más exigente de lo habitual: los días más suaves ayudan a tu cuerpo a asimilarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harjoittelusi on ollut tavallista raskaampaa — kevyemmät päivät auttavat kehoasi omaksumaan sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre entraînement a été plus soutenu que d'habitude — des journées plus légères aident votre corps à l'assimiler."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Æfingarnar þínar hafa verið þyngri en venjulega — léttari dagar hjálpa líkamanum að vinna úr þeim."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo allenamento è stato più pesante del solito: giorni più leggeri aiutano il corpo ad assorbirlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トレーニングがいつもより重めでした。軽めの日を入れると、体がその負荷を吸収しやすくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "평소보다 훈련 강도가 높았습니다. 가벼운 날을 두면 몸이 그 부하를 흡수하는 데 도움이 됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Treningen din har vært tyngre enn vanlig — lettere dager hjelper kroppen med å ta den opp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je training was zwaarder dan normaal — lichtere dagen helpen je lichaam om het te verwerken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu treino tem sido mais pesado que o normal — dias mais leves ajudam seu corpo a absorvê-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши тренировки были тяжелее обычного — более лёгкие дни помогут телу их усвоить."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din träning har varit tyngre än vanligt — lättare dagar hjälper kroppen att ta upp den."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的训练比平时更重——安排轻松一些的日子有助于身体吸收这些负荷。"
          }
        }
      }
    },
