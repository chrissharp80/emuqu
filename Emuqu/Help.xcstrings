        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Emuqu usa uma compra única vitalícia — pague uma vez e é seu para sempre. Sem assinaturas, sem cobranças recorrentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emuqu — это разовая пожизненная покупка: платите один раз и владеете навсегда. Никаких подписок и регулярных списаний."
          }
        },
        "sv" : {
          "stringUnit" : {
