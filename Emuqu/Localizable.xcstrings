            "state" : "translated",
            "value" : "Assurez-vous que votre capteur est à proximité et allumé."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gakktu úr skugga um að skynjarinn sé nálægt og kveiktur."
