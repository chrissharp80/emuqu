    "%@ session from %@ was interrupted. Your data was backed up and can be saved to your archive." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقفت جلسة %1$@ بتاريخ %2$@. نُسخت بياناتك احتياطيًا ويمكن حفظها في أرشيفك."
