    },
    "Your data is stored in the app's private container on your device, and leaves it only through the features this policy describes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُخزَّن بياناتك في الحاوية الخاصة بالتطبيق على جهازك، ولا تغادره إلا عبر الميزات التي تصفها هذه السياسة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine data gemmes i appens private container på din enhed og forlader den kun via de funktioner, som denne politik beskriver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten werden im privaten Container der App auf deinem Gerät gespeichert und verlassen es nur über die in dieser Richtlinie beschriebenen Funktionen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos se guardan en el contenedor privado de la app en tu dispositivo y solo salen de él a través de las funciones que describe esta política."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietosi tallennetaan sovelluksen yksityiseen säilöön laitteellasi, ja ne poistuvat sieltä vain tässä käytännössä kuvattujen toimintojen kautta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données sont stockées dans le conteneur privé de l’app sur votre appareil et n’en sortent que par les fonctionnalités décrites dans cette politique."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gögnin þín eru geymd í einkageymslu forritsins í tækinu þínu og fara þaðan aðeins í gegnum þá eiginleika sem þessi stefna lýsir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati sono archiviati nel contenitore privato dell’app sul tuo dispositivo e lo lasciano solo tramite le funzioni descritte in questa informativa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのデータはデバイス上のアプリ専用コンテナに保存され、本ポリシーに記載された機能を通じてのみデバイスの外に出ます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자의 데이터는 기기의 앱 전용 컨테이너에 저장되며, 이 방침에 설명된 기능을 통해서만 기기를 벗어납니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dataene dine lagres i appens private beholder på enheten din, og forlater den bare gjennom funksjonene denne erklæringen beskriver."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gegevens worden opgeslagen in de privécontainer van de app op je apparaat en verlaten het alleen via de functies die dit beleid beschrijft."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dados são armazenados no contêiner privado do app no seu dispositivo e só saem dele pelos recursos que esta política descreve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши данные хранятся в частном контейнере приложения на вашем устройстве и покидают его только через функции, описанные в этой политике."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina data lagras i appens privata behållare på din enhet och lämnar den bara via de funktioner som den här policyn beskriver."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的数据存储在你设备上本应用的私有容器中，只会通过本政策所述的功能离开设备。"
          }
        }
      }
    },
    "Your data stays on the strap until a new recording starts. You can try again later if Bluetooth keeps dropping." : {
      "comment" : "A footnote explaining that the user's data is stored on the device and can be retried later.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى بياناتك على الحزام حتى يبدأ تسجيل جديد. يمكنك المحاولة مرة أخرى لاحقاً إذا استمر انقطاع Bluetooth."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine data forbliver på remmen, indtil en ny optagelse starter. Du kan prøve igen senere, hvis Bluetooth bliver ved med at falde ud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten bleiben auf dem Gurt, bis eine neue Aufzeichnung beginnt. Du kannst es später erneut versuchen, wenn Bluetooth immer wieder abbricht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos permanecen en la banda hasta que comienza una nueva grabación. Puedes volver a intentarlo más tarde si el Bluetooth sigue cortándose."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tietosi säilyvät pannassa, kunnes uusi tallennus alkaa. Voit yrittää myöhemmin uudelleen, jos Bluetooth katkeilee jatkuvasti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données restent sur la ceinture jusqu'au démarrage d'un nouvel enregistrement. Vous pouvez réessayer plus tard si le Bluetooth continue de se déconnecter."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gögnin þín haldast á ólinni þar til ný upptaka hefst. Þú getur reynt aftur síðar ef Bluetooth heldur áfram að detta út."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati restano sulla fascia finché non inizia una nuova registrazione. Puoi riprovare più tardi se il Bluetooth continua a cadere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データは新しい記録が始まるまでストラップに保持されます。Bluetooth が切れ続ける場合は、後でもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터는 새 기록이 시작될 때까지 스트랩에 유지됩니다. Bluetooth가 계속 끊기면 나중에 다시 시도할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dataene dine blir værende på remmen til et nytt opptak starter. Du kan prøve igjen senere hvis Bluetooth fortsetter å falle ut."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gegevens blijven op de band tot een nieuwe opname start. Je kunt het later opnieuw proberen als Bluetooth steeds wegvalt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dados permanecem na cinta até que uma nova gravação comece. Você pode tentar novamente mais tarde se o Bluetooth continuar caindo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши данные остаются на ремне до начала новой записи. Вы можете повторить попытку позже, если Bluetooth продолжает отключаться."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina data stannar på bandet tills en ny inspelning startar. Du kan försöka igen senare om Bluetooth fortsätter att tappa anslutningen."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在开始新的记录之前，你的数据会保留在心率带上。如果蓝牙持续断开，你可以稍后重试。"
          }
        }
      }
    },
    "Your data up to the disconnect has been saved. Tap \"I'm Up\" to process what was captured." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم حفظ بياناتك حتى لحظة انقطاع الاتصال. انقر على \"لقد استيقظت\" لمعالجة ما تم التقاطه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine data indtil afbrydelsen er gemt. Tryk \"Jeg er oppe\" for at behandle det, der blev optaget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten bis zur Verbindungsunterbrechung wurden gespeichert. Tippe auf „Ich bin wach“, um die erfassten Daten zu verarbeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos hasta la desconexión se han guardado. Toca \"Ya desperté\" para procesar lo capturado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datasi yhteyden katkeamiseen asti on tallennettu. Napauta \"Olen hereillä\" käsitelläksesi kerätyn datan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données jusqu'à la déconnexion ont été enregistrées. Appuyez sur « Je suis debout » pour traiter ce qui a été capturé."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gögnin þín fram að aftengingu hafa verið vistuð. Ýttu á \"Ég er vakandi\" til að vinna úr því sem tókst."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I Suoi dati fino alla disconnessione sono stati salvati. Toccare \"Sono sveglio\" per elaborare quanto acquisito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切断までのデータは保存されました。「起きました」をタップしてキャプチャされたデータを処理してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결 해제까지의 데이터가 저장되었습니다. \"일어났어요\"를 탭하여 캡처된 데이터를 처리하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dataene frem til frakoblingen er lagret. Trykk «Jeg er oppe» for å behandle det som ble fanget."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw gegevens tot aan de verbreking zijn opgeslagen. Tik op \"Ik ben wakker\" om te verwerken wat is vastgelegd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dados até a desconexão foram salvos. Toque em \"Acordei\" para processar o que foi capturado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши данные до момента отключения сохранены. Нажмите «Я встал(а)» для обработки записанных данных."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Din data fram till frånkopplingen har sparats. Tryck på \"Jag är uppe\" för att bearbeta det som fångades."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "断开连接前的数据已保存。点击“我醒了”处理已采集的数据。"
          }
        }
      }
    },
    "Your data, securely synced across devices" : {
