    "Heart-rate recovery samples captured. Bigger 1-min drop = stronger parasympathetic reactivation." : {
      "comment" : "Narrative text below the \"Heart-rate recovery\" card, describing the general trend of heart-rate recovery over time.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم التقاط عيّنات تعافي معدل النبض. انخفاض أكبر خلال دقيقة = إعادة تنشيط نظير ودي أقوى."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøver på pulsrestitution registreret. Større fald på 1 min = stærkere parasympatisk reaktivering."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proben zur Herzfrequenzerholung erfasst. Größerer Abfall in 1 Min = stärkere parasympathische Reaktivierung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestras de recuperación de FC capturadas. Mayor caída en 1 min = reactivación parasimpática más fuerte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sykepalautumisen näytteet tallennettu. Suurempi pudotus minuutissa = vahvempi parasympaattinen uudelleenaktivoituminen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échantillons de récupération FC enregistrés. Une baisse plus grande à 1 min = réactivation parasympathique plus forte."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sýni um púlsendurheimt skráð. Meira fall á 1 mín = sterkari endurvirkjun sefkerfis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Campioni di recupero FC acquisiti. Maggiore calo a 1 min = riattivazione parasimpatica più forte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心拍回復のサンプルを取得しました。1 分間の低下が大きいほど副交感神経の再活性化が強いことを示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심박 회복 표본을 수집했습니다. 1분 감소폭이 클수록 부교감 재활성화가 강함을 뜻합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prøver på pulsrestitusjon registrert. Større fall på 1 min = sterkere parasympatisk reaktivering."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hartslagherstelmonsters vastgelegd. Grotere daling in 1 min = sterkere parasympathische reactivering."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amostras de recuperação de FC capturadas. Queda maior em 1 min = reativação parassimpática mais forte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Образцы восстановления пульса записаны. Большее падение за 1 мин = более сильная парасимпатическая реактивация."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prover på pulsåterhämtning insamlade. Större fall på 1 min = starkare parasympatisk reaktivering."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已采集心率恢复样本。1 分钟下降越大，表示副交感再激活越强。"
          }
        }
      }
    },
    "Heart-rate strap dropped out before the end. TRIMP and zones are computed only from the beats that were recorded." : {
      "comment" : "Explanation of why the TRIMP and zones displayed in the workout summary are based only on the beats that were actually recorded during the workout, rather than including any that might have happened after the workout ended.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع حزام النبض قبل النهاية. تُحسب TRIMP والمناطق من النبضات المسجَّلة فقط."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsbæltet faldt ud før slutningen. TRIMP og zoner beregnes kun ud fra de slag, der blev registreret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Herzfrequenzgurt fiel vor dem Ende aus. TRIMP und Zonen werden nur aus den aufgezeichneten Schlägen berechnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La banda de FC se desconectó antes del final. El TRIMP y las zonas se calculan solo con los latidos registrados."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sykepanta katkesi ennen loppua. TRIMP ja alueet lasketaan vain tallentuneista lyönneistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ceinture cardio a décroché avant la fin. Le TRIMP et les zones sont calculés uniquement à partir des battements enregistrés."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Púlsólin datt út fyrir lokin. TRIMP og svæði eru reiknuð aðeins út frá skráðum slögum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fascia cardio si è disconnessa prima della fine. TRIMP e zone sono calcolati solo dai battiti registrati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心拍ストラップが終了前に切断されました。TRIMP とゾーンは記録できた拍のみから計算しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "심박 스트랩이 종료 전에 끊겼습니다. TRIMP와 존은 기록된 박동만으로 계산됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsbeltet falt ut før slutten. TRIMP og soner beregnes bare fra slagene som ble registrert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De hartslagband viel voor het einde weg. TRIMP en zones worden alleen berekend uit de vastgelegde slagen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cinta de FC caiu antes do fim. TRIMP e zonas são calculados apenas com os batimentos que foram registrados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Датчик отключился до конца. TRIMP и зоны рассчитаны только по записанным ударам."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsbandet tappade kontakten före slutet. TRIMP och zoner beräknas endast från de slag som registrerades."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "心率带在结束前掉线。TRIMP 与心率区间仅基于已记录的心搏计算。"
          }
        }
      }
    },
