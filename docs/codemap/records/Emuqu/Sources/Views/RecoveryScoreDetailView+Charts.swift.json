   "key": "func RecoveryScoreCharts.buildRMSSDSeries(series:flags:sessionStartDate:)",
   "hash": "172babea934b94b4",
   "does": "Static, nonisolated: walks the RR series with a two-pointer pass producing one RMSSD point per 5-minute window stepped by 1 minute, keeping only windows windowRMSSD accepts; timestamps = sessionStartDate + window start.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Views/RecoveryScoreDetailView+Charts.swift::func RecoveryScoreCharts.windowRMSSD(points:flags:lo:hi:)"
   ],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+5",
     "cond": "series is nil/empty or first/last t_ms missing",
     "effect": "returns []"
    },
    {
     "at": "+14",
     "cond": "startMs <= lastT - windowMs (loop)",
     "effect": "iterates windows; recordings shorter than 5 minutes produce no points"
    },
    {
     "at": "+15",
     "cond": "lo < count and points[lo].t_ms < startMs (inner loop)",
     "effect": "advances lo to first beat at/after window start"
    },
    {
     "at": "+16",
     "cond": "hi < lo",
     "effect": "hi bumped to lo"
    },
    {
     "at": "+17",
     "cond": "hi < count and points[hi].t_ms < startMs+windowMs (inner loop)",
     "effect": "advances hi to first beat at/after window end"
    },
    {
     "at": "+18",
     "cond": "windowRMSSD returns a value",
     "effect": "true: point appended; false: window skipped (gap in trace)"
    }
   ],
