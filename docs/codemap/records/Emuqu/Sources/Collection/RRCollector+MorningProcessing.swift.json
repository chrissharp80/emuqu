   "key": "func MorningSessionPipeline.freezeTrainingSnapshot(on:freshContext:)",
   "hash": "cea6b13bd2039f77",
   "does": "Ensures finalSession.trainingSnapshot is set once: copies it from the archived copy of the same id when present, else uses freshContext or the sync createTrainingContext(); then mirrors the frozen snapshot into analysisResult.trainingContext.",
   "entry": null,
   "calls": [
    "Emuqu/Sources/Storage/Archive.swift::func SessionArchive.retrieveOrLog(_:caller:)",
