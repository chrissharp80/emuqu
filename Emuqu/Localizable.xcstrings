    "Always consult a qualified healthcare provider before making decisions about your health, fitness, or medical care." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استشر دائمًا مقدم رعاية صحية مؤهل قبل اتخاذ قرارات بشأن صحتك أو لياقتك أو رعايتك الطبية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konsulter altid en kvalificeret sundhedsudbyder, før du træffer beslutninger om dit helbred, din kondition eller din medicinske behandling."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konsultiere immer eine qualifizierte medizinische Fachperson, bevor du Entscheidungen über deine Gesundheit, Fitness oder medizinische Versorgung triffst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta siempre a un profesional de la salud cualificado antes de tomar decisiones sobre tu salud, tu condición física o tu atención médica."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota aina yhteyttä pätevään terveydenhuollon ammattilaiseen ennen kuin teet päätöksiä terveydestäsi, kunnostasi tai sairaanhoidostasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez toujours un professionnel de santé qualifié avant de prendre des décisions concernant votre santé, votre condition physique ou vos soins médicaux."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ráðfærðu þig alltaf við hæfan heilbrigðisstarfsmann áður en þú tekur ákvarðanir um heilsu þína, líkamsrækt eða læknismeðferð."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultare sempre un professionista sanitario qualificato prima di prendere decisioni sulla propria salute, forma fisica o assistenza medica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "健康、フィットネス、または医療に関する決定を下す前に、必ず資格のある医療専門家に相談してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건강, 체력 또는 의료 관련 결정을 내리기 전에 항상 자격을 갖춘 의료 전문가와 상담하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakt alltid en kvalifisert helsepersonell før du tar beslutninger om helsen, formen eller den medisinske behandlingen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raadpleeg altijd een gekwalificeerde zorgverlener voordat u beslissingen neemt over uw gezondheid, fitness of medische zorg."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre consulte um profissional de saúde qualificado antes de tomar decisões sobre sua saúde, condicionamento físico ou cuidados médicos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всегда консультируйтесь с квалифицированным медицинским специалистом, прежде чем принимать решения о своём здоровье, физической подготовке или медицинском обслуживании."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rådgör alltid med en kvalificerad vårdgivare innan du fattar beslut om din hälsa, kondition eller medicinska vård."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在做出有关健康、体能或医疗保健的决定之前，请始终咨询合格的医疗保健提供者。"
          }
        }
      }
    },
