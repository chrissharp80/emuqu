   "key": "func StrapRecordingPolicy.retryStep(after:attempt:justStopped:)",
   "hash": "c1cac77632d229a8",
   "does": "Retry schedule: give up at attempt ≥ 9 or on deterministic failures, or on nothingListed when not just stopped; attempts 1-3 pause 500 ms, 4-6 pause 1000 ms, 7-8 reset the link.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "attempt >= maxDownloadAttempts (9) or failure == .deterministic",
     "effect": ".giveUp"
    },
    {
     "at": "+2",
     "cond": "failure == .nothingListed and not justStopped",
     "effect": ".giveUp"
    },
    {
     "at": "+3",
     "cond": "attempt <= 3",
     "effect": ".pause(500 ms)"
    },
    {
     "at": "+4",
     "cond": "attempt <= 6",
     "effect": ".pause(1000 ms); otherwise .resetLink"
    }
   ],
   "flags": [],
   "deps": {
    "Emuqu/Sources/Utilities/Errors.swift::func attempt(_:file:line:_:)": "52c0205fd3b71bf5"
   }
