    "Ask about pace, HR, α1, splits — anything live%@. Tap a suggestion below or type a question." : {
      "comment" : "Text to be displayed in the \"Ask about your recovery\" body text when there is an active workout. The string inside the parentheses is a list of one or more descriptive words about the workout, separated by \" ·",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسأل عن الوتيرة أو النبض أو α1 أو الأشواط — أي شيء مباشر%@. اضغط اقتراحًا أدناه أو اكتب سؤالًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spørg om fart, puls, α1, mellemtider — hvad som helst live%@. Tryk på et forslag nedenfor, eller skriv et spørgsmål."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag nach Pace, Puls, α1, Splits — alles live%@. Tippe unten auf einen Vorschlag oder stelle eine Frage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta por ritmo, FC, α1, parciales — cualquier cosa en directo%@. Toca una sugerencia abajo o escribe una pregunta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kysy vauhdista, sykkeestä, α1:stä, väliajoista — mitä tahansa livenä%@. Napauta ehdotusta alta tai kirjoita kysymys."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posez des questions sur l’allure, la FC, α1, les splits — tout en direct%@. Touchez une suggestion ci-dessous ou écrivez une question."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spurðu um hraða, púls, α1, millitíma — hvað sem er í rauntíma%@. Bankaðu á tillögu hér að neðan eða skrifaðu spurningu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi di passo, FC, α1, parziali — qualsiasi cosa in diretta%@. Tocca un suggerimento qui sotto o scrivi una domanda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペース、心拍、α1、スプリットなど、リアルタイムの内容を何でも%@。下の候補をタップするか、質問を入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "페이스, 심박, α1, 랩 등 실시간 정보는 무엇이든 물어보세요%@. 아래 제안을 탭하거나 질문을 입력하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spør om fart, puls, α1, mellomtider — hva som helst live%@. Trykk på et forslag under, eller skriv et spørsmål."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag naar tempo, hartslag, α1, splits — alles live%@. Tik hieronder op een suggestie of typ een vraag."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte sobre ritmo, FC, α1, parciais — qualquer coisa ao vivo%@. Toque numa sugestão abaixo ou digite uma pergunta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спрашивайте о темпе, пульсе, α1, отрезках — о чём угодно в реальном времени%@. Нажмите подсказку ниже или введите вопрос."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fråga om fart, puls, α1, mellantider — vad som helst live%@. Tryck på ett förslag nedan eller skriv en fråga."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以问配速、心率、α1、分段 — 任何实时内容%@。点按下方建议或直接输入问题。"
          }
        }
      }
    },
    "Ask about your recovery" : {
      "comment" : "A prompt that encourages the user to ask about their recovery.",
      "extractionState" : "manual",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
