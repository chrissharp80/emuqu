{
 "file": "EmuquTests/AssistantProviderReplyTests.swift",
 "hash": "d0c31115e714affc",
 "role": "Five XCTest suites for what reaches the user from an AI provider: out-of-credit detection and purchase-free error text (App Store 3.1.1), Apple Intelligence tool ranking/fitting within a 1,024-token tool budget, trimming of Apple replies that hit the token cap (AppleReplyTrimmer/AppleReplyRelay), which chat exchange lets Apple's cached session be reused (AppleExchange), and how the request audit keeps a long streamed reply (LLMRequestAudit).",
 "types": [
  "ProviderAccountReplyTests: class — XCTestCase for credit-failure detection and error copy",
  "AppleToolRankingTests: class — XCTestCase for ToolRetriever ranking/fitting",
  "AppleReplyTrimmerTests: class — XCTestCase for AppleReplyTrimmer and AppleReplyRelay",
  "AppleExchangeTests: class — XCTestCase for AppleExchange.before (when Apple's cached session may be reused)",
  "LLMRequestAuditResponseTests: class (@MainActor) — XCTestCase for LLMRequestAudit.append's cut-back"
 ],
 "state": [],
 "toplevel": "AppleToolRankingTests.budget = 1024; AppleReplyTrimmerTests.longBody = a sentence repeated 60 times. appleCost has an #if canImport(FoundationModels) / #available(iOS 26) branch. AppleExchangeTests.question = a user turn \"How did I sleep?\".",
 "units": [
