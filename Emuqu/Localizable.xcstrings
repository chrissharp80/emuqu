    "Hydrate and fuel well to back up the work." : {
      "comment" : "Action to take to support recovery when the recovery score is low.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشرب الماء وتغذَّ جيدًا لتدعم هذا الجهد."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drik rigeligt og spis godt for at understøtte arbejdet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinke und iss gut, um die Arbeit zu unterstützen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidrátate y come bien para respaldar el trabajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juo ja syö hyvin tukeaksesi tehtyä työtä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hydratez-vous et mangez bien pour soutenir l’effort."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drekktu og borðaðu vel til að styðja við vinnuna."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Idratati e mangia bene per sostenere il lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水分と栄養をしっかり摂って 練習を支えましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수분과 영양을 충분히 섭취해 훈련을 뒷받침하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drikk og spis godt for å støtte opp om arbeidet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drink en eet goed om het werk te ondersteunen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidrate-se e coma bem para sustentar o trabalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пейте и питайтесь хорошо, чтобы поддержать работу."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drick och ät ordentligt för att stötta arbetet."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "补足水分与能量，为这份训练兜底。"
          }
        }
      }
    },
    "Hydrate, eat enough, and get to bed early." : {
      "comment" : "Suggestion to hydrate, eat enough, and get to bed early based on a low recovery score.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشرب الماء، وتناول ما يكفي، ونم مبكرًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drik rigeligt, spis nok, og gå tidligt i seng."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trinke, iss genug und geh früh ins Bett."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hidrátate, come suficiente y acuéstate temprano."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juo, syö riittävästi ja mene aikaisin nukkumaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hydratez-vous, mangez suffisamment et couchez-vous tôt."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drekktu, borðaðu nóg og farðu snemma að sofa."
