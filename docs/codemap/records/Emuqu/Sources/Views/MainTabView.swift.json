  "MainTabView: struct (View) — app root tabs and dashboard data owner",
  "MainTabView.SendReportKind: enum — recovery | daily | workout send-report menu items",
  "MainTabView.Tab: enum — the five tab ids (dashboard, record, fitness, coach, more)",
  "MainTabView.AskFloPrompt: private struct — title/icon/prompt for the Ask Flo menu",
  "DashboardLoadTiming: struct — timestamps of one dashboard reload for slow-load logging"
 ],
 "state": [
  "@State selectedTab, dashboardPath/recordPath/fitnessPath/coachPath/morePath, sessions, totalSessionCount, seedScore, seedSummary, selectedReportSession, refreshTask, lastDashboardReloadAt, dashboardReloadInFlight/Pending/DebounceScheduled/Deferred, scrollToTopToken, launchWorkStarted, preparingReportKind, pendingReportMailURL, reportPrepError (all view-local)",
