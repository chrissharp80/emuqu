      "comment" : "Subtitle for the \"Get Me Back\" card when no trail is active.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضع دبوسًا عند نقطة البداية. تجوّل بحرية؛ سهم البوصلة يعيدك. يعمل دون اتصال."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sætter en nål, hvor du starter. Gå frit; kompasnålen fører dig tilbage. Offline."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt eine Stecknadel an deinen Startpunkt. Geh frei umher; der Kompasspfeil führt dich zurück. Offline."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca un marcador donde empiezas. Camina libremente; la flecha de la brújula te guía de vuelta. Sin conexión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asettaa nastan lähtöpaikkaasi. Kävele vapaasti; kompassin nuoli opastaa takaisin. Toimii ilman verkkoa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Place un repère à votre point de départ. Marchez librement ; la flèche de la boussole vous ramène. Hors ligne."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setur nælu þar sem þú byrjar. Gakktu frjáls; áttavitaörin leiðir þig til baka. Án nettengingar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piazza un segnaposto dove parti. Cammina liberamente; la freccia della bussola ti riporta indietro. Offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出発地点にピンを立てます。自由に歩いても、コンパスの矢印が戻り道を示します。オフラインで動作。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출발 지점에 핀을 찍습니다. 자유롭게 걸어도 나침반 화살표가 되돌아가는 길을 안내합니다. 오프라인 작동."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setter en nål der du starter. Gå fritt; kompassnålen fører deg tilbake. Frakoblet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plaatst een speld waar je start. Loop vrij rond; de kompaspijl leidt je terug. Offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca um ponto onde você começa. Ande à vontade; a seta da bússola leva você de volta. Offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставит метку в точке старта. Гуляйте свободно — стрелка компаса приведёт обратно. Работает офлайн."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sätter en nål där du startar. Gå fritt; kompassnålen leder dig tillbaka. Offline."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你出发的位置放置一个标记。随意行走，指南针箭头会带你回来。可离线使用。"
          }
        }
      }
    },
