   ],
   "writes": [],
   "branches": [
    {
     "at": "+2",
     "cond": "imperial (distance closure)",
     "effect": "true: m/1609.344 (miles); false: m/1000 (km)"
    },
    {
     "at": "+3",
     "cond": "imperial (elevation closure)",
     "effect": "true: m×UnitConstants.feetPerMeter; false: metres unchanged"
    },
    {
     "at": "+4",
