    "You can also contact the developer through the App Store listing." : {
      "comment" : "A footnote explaining how users can contact the app developer outside of the app.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك أيضًا التواصل مع المطوّر عبر صفحة App Store."
          }
        },
        "da" : {
          "stringUnit" : {
