  {
   "key": "func WorkoutLiveTrends.hrDriftPercent(samples:)",
   "hash": "3c248638a9f811eb",
   "does": "HR drift: mean HR of samples with offset >= 3q minus mean HR of samples with offset < q (q = last offset / 4), as a percent of the first-quarter mean.",
   "entry": null,
   "calls": [],
   "reads": [],
   "writes": [],
   "branches": [
    {
     "at": "+1",
     "cond": "no samples or last offset < 420 s",
     "effect": "return nil; else continue"
    },
    {
     "at": "+3",
     "cond": "q <= 0",
     "effect": "return nil (unreachable in practice since offset>=420 gives q>=105)"
    },
    {
     "at": "+6",
     "cond": "fewer than 30 HR readings in first or last quarter",
     "effect": "return nil"
    },
    {
     "at": "+9",
     "cond": "first-quarter mean <= 0",
     "effect": "return nil; else return percent change"
    }
   ],
   "deps": {}
  },
