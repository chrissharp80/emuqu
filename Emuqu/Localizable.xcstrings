    "Helps spot patterns when subjective feeling diverges from your HR data." : {
      "comment" : "A footnote explaining the purpose of the optional note field in the workout feeling prompt.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يساعد على رصد الأنماط عندما يختلف شعورك الذاتي عن بيانات النبض الخاصة بك."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjælper med at finde mønstre, når din subjektive følelse afviger fra dine HR-data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilft, Muster zu erkennen, wenn dein subjektives Empfinden von deinen HF-Daten abweicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuda a detectar patrones cuando tu sensación subjetiva difiere de tus datos de FC."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auttaa havaitsemaan kaavoja, kun subjektiivinen tuntemus poikkeaa HR-tiedoistasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aide à repérer des tendances quand votre ressenti diverge de vos données FC."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hjálpar til við að greina mynstur þegar huglæg líðan víkur frá HR-gögnunum þínum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiuta a individuare schemi quando la sensazione soggettiva diverge dai tuoi dati HR."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主観的な感覚がHRデータと食い違うときにパターンを見つけるのに役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주관적인 느낌이 HR 데이터와 다를 때 패턴을 파악하는 데 도움이 됩니다."
